+  AllowJavascript();
+  CHECK_EQ(2U, args.size());
+  const base::Value& callback_id = args[0];
+  CHECK(args[1].is_dict());
+
+  helium_persona::PersonaService* service = GetPersonaService(profile_);
+  CHECK(service);
+  ResolveJavascriptCallback(callback_id,
+                            service->SavePersona(args[1].GetDict()));
+}
+
+void PersonaHandler::HandleImportPersonas(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(2U, args.size());
+  const base::Value& callback_id = args[0];
+  CHECK(args[1].is_list());
+
+  helium_persona::PersonaService* service = GetPersonaService(profile_);
+  CHECK(service);
+  ResolveJavascriptCallback(callback_id,
+                            service->ImportPersonas(args[1].GetList()));
+}
+
+void PersonaHandler::HandleSetActivePersona(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(2U, args.size());
+  const base::Value& callback_id = args[0];
+  CHECK(args[1].is_string());
+
+  helium_persona::PersonaService* service = GetPersonaService(profile_);
+  CHECK(service);
+  ResolveJavascriptCallback(
+      callback_id, service->SetActivePersona(args[1].GetString()));
+}
+
+void PersonaHandler::HandleClonePresetIntoProfile(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(2U, args.size());
+  const base::Value& callback_id = args[0];
+  CHECK(args[1].is_string());
+
+  helium_persona::PersonaService* service = GetPersonaService(profile_);
+  CHECK(service);
+  ResolveJavascriptCallback(
+      callback_id, service->ClonePresetIntoProfile(args[1].GetString()));
+}
+
+void PersonaHandler::HandleDeletePersona(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(2U, args.size());
+  const base::Value& callback_id = args[0];
+  CHECK(args[1].is_string());
+
+  helium_persona::PersonaService* service = GetPersonaService(profile_);
+  CHECK(service);
+  ResolveJavascriptCallback(callback_id,
+                            service->DeletePersona(args[1].GetString()));
+}
+
+void PersonaHandler::HandleGetLaunchSelectionMode(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1U, args.size());
+  const base::Value& callback_id = args[0];
+
+  helium_persona::PersonaService* service = GetPersonaService(profile_);
+  CHECK(service);
+  ResolveJavascriptCallback(callback_id, base::Value(service->GetLaunchSelectionMode()));
+}
+
+void PersonaHandler::HandleSetLaunchSelectionMode(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(2U, args.size());
+  const base::Value& callback_id = args[0];
+  CHECK(args[1].is_string());
+
