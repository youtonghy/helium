+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import {
+  assertDeepEquals,
+  assertEquals,
+  assertNotEquals,
+  assertTrue,
+} from 'chrome://webui-test/chai_assert.js';
+
+import {
+  createPersonaDraft,
+  parsePersonaImportPayload,
+  preparePersonaForSave,
+} from 'chrome://settings/privacy_page/persona_config.js';
+
+suite('PersonaConfig', () => {
+  test('converts every editable numeric field', () => {
+    const draft = createPersonaDraft({
+      id: 'persona-test',
+      displayName: 'Numeric Persona',
+      hardware: {
+        hardwareConcurrency: '12',
+        deviceMemory: '32',
+        maxTouchPoints: '5',
+      },
+      screen: {
+        width: '1920',
+        height: '1080',
+        availLeft: '-1920',
+        availTop: '0',
+        availWidth: '1920',
+        availHeight: '1040',
+        outerWidth: '1920',
+        outerHeight: '1040',
+        deviceScaleFactor: '1.25',
+      },
+      mediaDevices: {
+        audioBaseLatency: '0.01',
+        audioOutputLatency: '0.02',
+      },
+      network: {downlinkMax: '25'},
+      advanced: {
+        fingerprintRotation: {rotationIntervalDays: '30'},
+      },
+    });
+
+    const result = preparePersonaForSave(draft, {
+      fontFamilies: 'Arial, Helvetica',
+      fontAliases: 'sans-serif',
+      uaChBrands: 'Chromium/149, Not/A)Brand/24',
+      uaChFormFactors: 'Desktop',
+    });
+
+    assertDeepEquals({}, result.fieldErrors);
+    assertEquals('Numeric Persona', result.persona.name);
+    assertEquals(12, result.persona.hardware.hardwareConcurrency);
+    assertEquals(32, result.persona.hardware.deviceMemory);
+    assertEquals(5, result.persona.hardware.maxTouchPoints);
+    assertEquals(1920, result.persona.screen.width);
+    assertEquals(-1920, result.persona.screen.availLeft);
+    assertEquals(1.25, result.persona.screen.deviceScaleFactor);
+    assertEquals(0.01, result.persona.mediaDevices.audioBaseLatency);
+    assertEquals(0.02, result.persona.mediaDevices.audioOutputLatency);
+    assertEquals(25, result.persona.network.downlinkMax);
+    assertEquals(
+        30,
+        result.persona.advanced.fingerprintRotation.rotationIntervalDays);
+    assertDeepEquals(['Arial', 'Helvetica'], result.persona.fonts.families);
+    assertDeepEquals(['sans-serif'], result.persona.fonts.aliases);
+    assertDeepEquals(['Desktop'], result.persona.uaCh.formFactors);
+  });
+
+  test('round trips UA-CH brand names containing slashes', () => {
+    const result = preparePersonaForSave(createPersonaDraft({
+      id: 'persona-test',
+      displayName: 'Brand Persona',
+    }), {
+      fontFamilies: '',
+      fontAliases: '',
+      uaChBrands: 'Chromium/149, Not/A)Brand/24',
+      uaChFormFactors: 'Desktop',
+    });
+
+    assertDeepEquals([
+      {brand: 'Chromium', version: '149'},
+      {brand: 'Not/A)Brand', version: '24'},
+    ], result.persona.uaCh.brands);
+  });
+
+  test('supplies effective screen fallbacks', () => {
+    const draft = createPersonaDraft({
+      id: 'persona-test',
+      displayName: 'Screen Persona',
+      screen: {width: 1536, height: 864},
+    });
+
+    assertEquals(1536, draft.screen.availWidth);
+    assertEquals(864, draft.screen.availHeight);
+    assertNotEquals(0, draft.screen.outerWidth);
+    assertNotEquals(0, draft.screen.outerHeight);
+  });
+
+  test('preserves nested defaults on partial overrides', () => {
+    const draft = createPersonaDraft({
+      gpu: {vendor: 'Intel Inc.'},
+      advanced: {allowGeolocation: true},
+    });
+
+    assertEquals('Intel Inc.', draft.gpu.vendor);
+    assertEquals('string', typeof draft.gpu.renderer);
+    assertNotEquals('', draft.gpu.renderer);
+    assertEquals(true, draft.advanced.allowGeolocation);
+    assertEquals(true, draft.advanced.clientHintsEnabled);
+    assertEquals(
+        'site_profile', draft.advanced.fingerprintRotation.scope);
+  });
+
+  test('accepts legacy arrays and v1 import bundles', () => {
+    const personas = [{id: 'persona-test'}];
+
+    assertDeepEquals(personas, parsePersonaImportPayload(personas));
+    assertDeepEquals(personas, parsePersonaImportPayload({
+      schema: 'helium.persona/v1',
+      personas,
+    }));
+  });
+
+  test('rejects unknown import schemas', () => {
+    let error: Error|null = null;
+    try {
+      parsePersonaImportPayload({
+        schema: 'helium.persona/v2',
+        personas: [{id: 'persona-test'}],
+      });
+    } catch (caught) {
+      error = caught as Error;
+    }
+    assertTrue(!!error);
+    assertTrue(/unsupported persona schema/i.test(error!.message));
+  });
+
+  test('reports invalid numeric fields', () => {
+    const draft = createPersonaDraft({
+      id: 'persona-test',
+      displayName: 'Invalid Persona',
+      screen: {width: 'not-a-number'},
+    });
+
+    const result = preparePersonaForSave(draft, {
+      fontFamilies: '',
+      fontAliases: '',
+      uaChBrands: 'Chromium/149',
+      uaChFormFactors: 'Desktop',
+    });
+
+    assertEquals('string', typeof result.fieldErrors['screen.width']);
+  });
+
+  test('rejects unsupported device memory buckets', () => {
+    const draft = createPersonaDraft({
+      id: 'persona-test',
+      displayName: 'Invalid Memory Persona',
+      hardware: {deviceMemory: '24'},
+    });
+
+    const result = preparePersonaForSave(draft, {
+      fontFamilies: '',
+      fontAliases: '',
+      uaChBrands: 'Chromium/149',
+      uaChFormFactors: 'Desktop',
+    });
+
+    assertEquals(
+        'string', typeof result.fieldErrors['hardware.deviceMemory']);
+  });
+});
