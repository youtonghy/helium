+    const path = target.dataset['path'] || '';
+    const optionId = target.dataset['optionId'] || '';
+    if (!path || !optionId) {
+      return;
+    }
+    this.set(`customFieldSelections_.${optionId}`, target.value);
+    if (target.value === CUSTOM_OPTION_VALUE) {
+      return;
+    }
+    this.set(path, this.coerceOptionValue_(path, target.value));
+    this.applyOptionSideEffects_(optionId, target.value);
+    this.hasUnsavedChanges_ = true;
+  }
+
+  private onCustomOptionInput_(event: Event) {
+    if (this.isDefaultPersona_(this.editablePersona_.id)) {
+      return;
+    }
+    const target = event.currentTarget as HTMLInputElement;
+    const path = target.dataset['path'] || '';
+    const optionId = target.dataset['optionId'] || '';
+    if (!path || !optionId) {
+      return;
+    }
+    this.set(path, this.coerceOptionValue_(path, target.value));
+    this.applyOptionSideEffects_(optionId, target.value);
+    this.hasUnsavedChanges_ = true;
