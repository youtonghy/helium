+
+  private syncAdvancedToggleItems_() {
+    this.advancedToggleItems_ = ADVANCED_TOGGLE_DEFINITIONS.map(definition => {
+      return {...definition, value: Boolean(this.get(definition.path))};
+    });
+  }
+
+  private onAdvancedToggleChange_(event: Event) {
+    if (this.isDefaultPersona_(this.editablePersona_.id)) {
+      return;
+    }
+    const target = event.currentTarget as HTMLElement&{checked: boolean};
+    const path = target.dataset['path'] || '';
+    if (!path) {
+      return;
+    }
+    this.set(path, target.checked);
+    this.hasUnsavedChanges_ = true;
+  }
+
+  private onDraftChanged_() {
+    if (this.isDefaultPersona_(this.editablePersona_.id)) {
+      return;
+    }
+    this.hasUnsavedChanges_ = true;
+    this.saveStatus_ = '';
+    this.saveStatusIsError_ = false;
+  }
+
+  private coerceOptionValue_(path: string, value: string) {
+    if (path.includes('hardwareConcurrency') ||
+        path.includes('deviceMemory')) {
+      return Number(value);
+    }
+    return value;
+  }
+
+  private getPresetsForRegion_(region: string, presets: PersonaRecord[]) {
+    const ids = PRESET_REGION_IDS[region] || [];
+    return presets.filter((preset: PersonaRecord) => {
+      return preset && ids.includes(preset.id);
+    });
+  }
+
+  private computeEditSectionDesc_(displayName: string) {
+    return this.i18n('personaSectionEditDesc', displayName || '');
+  }
+
+  private formatFieldErrors_(fieldErrors: any, fallback: string) {
+    if (!fieldErrors || typeof fieldErrors !== 'object') {
+      return fallback;
+    }
+    const messages = Object.keys(fieldErrors)
+                         .map(key => {
+                           const value = fieldErrors[key];
+                           if (value === undefined || value === null || value === '') {
+                             return '';
+                           }
+                           return `${key}: ${value}`;
+                         })
+                         .filter(message => !!message);
+    return messages.length ? `${fallback}: ${messages.join('; ')}` : fallback;
+  }
+
+  private downloadPersonas_(personas: PersonaRecord[], filename: string) {
+    const blob = new Blob([JSON.stringify({
+                            schema: PERSONA_EXPORT_SCHEMA,
+                            exportedAt: new Date().toISOString(),
+                            personas,
+                          }, null, 2)],
+                          {type: 'application/json'});
+    const url = URL.createObjectURL(blob);
+    const anchor = document.createElement('a');
+    anchor.href = url;
+    anchor.download = filename;
+    anchor.click();
+    URL.revokeObjectURL(url);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-persona-page': SettingsPersonaPageElement;
+  }
+}
+
+customElements.define(SettingsPersonaPageElement.is, SettingsPersonaPageElement);
