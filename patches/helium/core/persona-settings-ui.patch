+
+  const screen = {...defaults.screen, ...inputScreen};
+  screen.availWidth = Object.hasOwn(inputScreen, 'availWidth') ?
+      screen.availWidth : screen.width;
+  screen.availHeight = Object.hasOwn(inputScreen, 'availHeight') ?
