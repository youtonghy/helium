+
+  private async runPendingRequest_<T>(request: () => Promise<T>): Promise<T|null> {
+    if (this.pending_) {
+      return null;
+    }
+    this.pending_ = true;
+    try {
+      return await request();
+    } catch (_error) {
+      return null;
+    } finally {
+      this.pending_ = false;
+    }
+  }
+
+  private async runPersonaMutation_(
+      request: () => Promise<PersonaPageResponse>,
+      onSuccess?: (response: PersonaPageResponse) => void,
+      onFailure?: (response?: PersonaPageResponse) => void):
+      Promise<PersonaPageResponse|null> {
+    const response = await this.runPendingRequest_(request);
+    if (!response || !response.ok) {
+      if (onFailure) {
+        onFailure(response || undefined);
+      } else {
+        this.showMutationError_(response?.fieldErrors);
+      }
+      return response;
+    }
+    this.importStatus_ = '';
+    this.importStatusIsError_ = false;
+    onSuccess?.(response);
+    this.applyPersonaState_(response.state);
+    return response;
+  }
