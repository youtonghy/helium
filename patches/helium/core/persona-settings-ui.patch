+      ...asObject(input['mediaDevices']),
+    },
+    network: {...defaults.network, ...asObject(input['network'])},
+    advanced: {
+      ...DEFAULT_ADVANCED,
+      ...advancedInput,
+      fingerprintRotation: {
+        ...DEFAULT_ADVANCED.fingerprintRotation,
+        ...asObject(advancedInput['fingerprintRotation']),
+      },
+    },
+  } as PersonaRecord;
+}
+
+export function preparePersonaForSave(
+    input: PersonaRecord, textFields: PersonaTextFields):
+    PersonaSerializationResult {
+  const persona = clone(input);
+  const fieldErrors: Record<string, string> = {};
+
+  persona.displayName = (persona.displayName || '').trim();
+  persona.name = persona.displayName;
+  if (!persona.id) {
+    fieldErrors['id'] = 'A saved persona must have an ID.';
+  }
+  if (!persona.displayName) {
+    fieldErrors['displayName'] = 'Enter a profile name.';
+  }
+
+  persona.fonts.families = splitCsv(textFields.fontFamilies);
+  persona.fonts.aliases = splitCsv(textFields.fontAliases);
+  persona.uaCh.brands = parseUaChBrands(textFields.uaChBrands);
+  persona.uaCh.formFactors = splitCsv(textFields.uaChFormFactors);
+  if (!persona.uaCh.brands.length) {
+    fieldErrors['uaCh.brands'] = 'Enter at least one brand/version pair.';
+  }
+  if (!persona.uaCh.formFactors.length) {
+    fieldErrors['uaCh.formFactors'] = 'Enter at least one form factor.';
+  }
+
+  for (const field of NUMERIC_FIELDS) {
+    const rawValue = getPath(persona, field.path);
+    const value = typeof rawValue === 'string' && !rawValue.trim() ?
+        Number.NaN :
+        Number(rawValue);
+    if (!Number.isFinite(value) || (field.integer && !Number.isInteger(value)) ||
+        value < field.min || value > field.max ||
+        (field.allowedValues && !field.allowedValues.includes(value))) {
+      fieldErrors[field.path] = field.allowedValues ?
+          `Choose a supported value: ${field.allowedValues.join(', ')}.` :
+          `Enter a value from ${field.min} to ${field.max}.`;
+      continue;
+    }
+    setPath(persona, field.path, value);
+  }
+
+  return {persona, fieldErrors};
+}
+
+export function parsePersonaImportPayload(payload: unknown): PersonaRecord[] {
+  if (Array.isArray(payload)) {
+    return payload as PersonaRecord[];
+  }
+  const bundle = asObject(payload);
+  if (bundle['schema'] !== PERSONA_EXPORT_SCHEMA) {
+    throw new Error('Unsupported persona schema.');
+  }
+  if (!Array.isArray(bundle['personas'])) {
+    throw new Error('Persona bundle does not contain a personas array.');
+  }
+  return bundle['personas'] as PersonaRecord[];
+}
