+
+function clone<T>(value: T): T {
+  return JSON.parse(JSON.stringify(value)) as T;
+}
+
+function asObject(value: unknown): Record<string, any> {
+  return value && typeof value === 'object' && !Array.isArray(value) ?
+      value as Record<string, any> :
+      {};
+}
+
+function splitCsv(value: string): string[] {
+  return (value || '')
+      .split(',')
+      .map(part => part.trim())
+      .filter(Boolean);
+}
+
+function parseUaChBrands(value: string): PersonaUaChBrand[] {
+  return splitCsv(value).map(entry => {
+    const separator = entry.lastIndexOf('/');
+    if (separator <= 0 || separator === entry.length - 1) {
+      return null;
+    }
+    return {
+      brand: entry.slice(0, separator).trim(),
+      version: entry.slice(separator + 1).trim(),
+    };
+  }).filter((entry): entry is PersonaUaChBrand =>
+      !!entry?.brand && !!entry.version);
+}
+
+function getPath(root: Record<string, any>, path: string): unknown {
+  return path.split('.').reduce<unknown>((value, key) => {
+    return asObject(value)[key];
+  }, root);
+}
+
+function setPath(root: Record<string, any>, path: string, value: unknown) {
+  const parts = path.split('.');
+  const finalKey = parts.pop()!;
+  const parent = parts.reduce<Record<string, any>>((current, key) => {
+    return current[key] = asObject(current[key]);
+  }, root);
+  parent[finalKey] = value;
+}
+
+export function createPersonaDraft(
+    inputValue: Record<string, any> = {}): PersonaRecord {
+  const input = asObject(inputValue);
+  const inputScreen = asObject(input['screen']);
+  const defaults = {
+    id: '',
+    name: '',
+    displayName: '',
+    icon: 'macos',
+    enabled: true,
+    userAgent: '',
+    platform: 'macOS',
+    navigatorVendor: 'Google Inc.',
