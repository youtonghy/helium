+
+  private async onImportFileChange_(event: Event) {
+    const input = event.target as HTMLInputElement;
+    const file = input.files?.[0];
+    input.value = '';
+    if (!file) {
+      return;
+    }
+
+    try {
+      const payload = JSON.parse(await file.text());
+      const personas = parsePersonaImportPayload(payload);
+      if (!personas.length) {
+        this.importStatus_ = this.i18n('personaImportNoProfiles');
+        this.importStatusIsError_ = true;
+        return;
+      }
+      if (!this.confirmDiscardChanges_()) {
+        return;
+      }
+
+      await this.runPersonaMutation_(
+          () => PersonaBrowserProxyImpl.getInstance().importPersonas({
+            schema: PERSONA_EXPORT_SCHEMA,
+            personas,
+          }),
+          response => {
+            this.importStatus_ = this.i18n(
+                'personaImportResult', String(response.importedCount || 0),
+                String(response.skippedCount || 0));
+            this.importStatusIsError_ = false;
+          },
+          response => {
+            this.importStatus_ = response ?
+                this.i18n(
+                    'personaImportResult',
+                    String(response.importedCount || 0),
+                    String(response.skippedCount || 0)) :
+                this.i18n('personaImportFailed');
+            this.importStatusIsError_ = true;
+          });
+    } catch (error) {
+      this.importStatus_ = this.i18n('personaImportFailed');
+      this.importStatusIsError_ = true;
+    }
+  }
