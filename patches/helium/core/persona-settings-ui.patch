+          'personaImportResult', String(response.importedCount || 0),
+          String(response.skippedCount || 0));
+      this.applyPersonaResponse_(response);
+    } catch (error) {
+      this.importStatus_ = this.i18n('personaImportFailed');
+    }
+  }
+
+  private onPresetChange_(event: Event) {
+    this.selectedPresetId_ = (event.target as HTMLSelectElement).value;
+  }
+
+  private async onApplyPresetClick_() {
+    if (!this.selectedPresetId_) {
+      return;
+    }
+
+    const response =
+        await PersonaBrowserProxyImpl.getInstance().clonePresetIntoProfile(
+            this.selectedPresetId_);
+    if (response.ok) {
+      this.selectedProfileId_ = response.state?.activePersonaId || '';
+    }
+    this.applyPersonaResponse_(response);
+  }
+
+  private async onLaunchSelectionModeChange_(event: Event) {
+    const mode = (event.target as HTMLSelectElement).value;
+    this.launchSelectionMode_ =
+        await PersonaBrowserProxyImpl.getInstance().setLaunchSelectionMode(
+            mode);
+    await this.refreshProfiles_();
+  }
+
+  private async onRefreshFingerprintsClick_() {
+    await PersonaBrowserProxyImpl.getInstance().refreshFingerprints();
+    await this.refreshProfiles_();
+  }
+
+  private onUaChPlatformChange_(event: Event) {
+    this.set(
+        'editablePersona_.uaCh.platform',
+        (event.target as HTMLSelectElement).value);
+  }
+
+  private onTimezoneChange_(event: Event) {
+    this.set(
+        'editablePersona_.region.timezone',
+        (event.target as HTMLSelectElement).value);
+  }
+
+  private onLocaleChange_(event: Event) {
+    const locale = (event.target as HTMLSelectElement).value;
+    this.set('editablePersona_.region.locale', locale);
+    this.set('editablePersona_.region.acceptLanguage', `${locale},en;q=0.9`);
+  }
+
+  private onOptionFieldChange_(event: Event) {
+    const target = event.target as HTMLSelectElement;
+    const path = target.dataset['path'] || '';
+    const optionId = target.dataset['optionId'] || '';
+    if (!path || !optionId) {
+      return;
+    }
+    this.set(`customFieldSelections_.${optionId}`, target.value);
+    if (target.value === CUSTOM_OPTION_VALUE) {
+      return;
+    }
+    this.set(path, this.coerceOptionValue_(path, target.value));
+    if (optionId === 'locale') {
+      this.set(
+          'editablePersona_.region.acceptLanguage',
+          `${target.value},en;q=0.9`);
+    }
+    if (optionId === 'platform') {
+      this.set('editablePersona_.uaCh.platform', target.value);
+    }
+  }
+
+  private onCustomOptionInput_(event: Event) {
+    const target = event.currentTarget as HTMLInputElement;
+    const path = target.dataset['path'] || '';
+    const optionId = target.dataset['optionId'] || '';
+    if (!path || !optionId) {
+      return;
+    }
+    this.set(path, this.coerceOptionValue_(path, target.value));
+  }
+
+  private getFieldOptions_(optionId: string) {
+    return getOptions(optionId);
+  }
+
+  private getSelectValue_(path: string, optionId: string) {
+    const value = this.get(path);
+    return hasOption(optionId, value) ? String(value) : CUSTOM_OPTION_VALUE;
+  }
+
+  private isCustomSelected_(optionId: string) {
+    return this.customFieldSelections_[optionId] === CUSTOM_OPTION_VALUE;
+  }
+
+  private isSelectedProfile_(personaId: string, selectedProfileId: string) {
+    return personaId === selectedProfileId;
+  }
+
+  private isActiveProfile_(personaId: string, activePersonaId: string) {
+    return personaId === activePersonaId;
+  }
+
+  private canDeleteProfile_(personaId: string) {
+    return personaId !== 'default';
+  }
+
+  private computeProfileStatus_(personaId: string, activePersonaId: string) {
+    if (personaId === 'default') {
+      return personaId === activePersonaId ? 'Active system real' :
+                                             'System real';
+    }
+    return personaId === activePersonaId ? 'Active' : 'Saved';
+  }
+
+  private computeProfileSummary_(persona: PersonaRecord) {
+    if (persona?.id === 'default') {
+      return 'No Persona | Real system fingerprint';
+    }
+    const platform = persona?.platform || persona?.uaCh?.platform || 'Unknown';
+    const locale = persona?.region?.locale || 'en-US';
+    return `${platform} | ${locale}`;
+  }
+
+  private computeLastUsedText_(lastUsedAt: string) {
+    return lastUsedAt || 'Never';
+  }
+
+  private syncCustomSelections_() {
+    const selections: Record<string, string> = {};
+    const fieldPaths = {
+      timezone: 'editablePersona_.region.timezone',
+      locale: 'editablePersona_.region.locale',
+      platform: 'editablePersona_.platform',
+      gpuVendor: 'editablePersona_.gpu.vendor',
+      gpuRenderer: 'editablePersona_.gpu.renderer',
+      networkType: 'editablePersona_.network.type',
+      hardwareConcurrency: 'editablePersona_.hardware.hardwareConcurrency',
+      deviceMemory: 'editablePersona_.hardware.deviceMemory',
+    };
+    for (const [optionId, path] of Object.entries(fieldPaths)) {
+      selections[optionId] = this.getSelectValue_(path, optionId);
+    }
+    this.customFieldSelections_ = selections;
+  }
+
+  private coerceOptionValue_(path: string, value: string) {
+    if (path.includes('hardwareConcurrency') ||
+        path.includes('deviceMemory')) {
+      return Number(value);
+    }
+    return value;
+  }
+
+  private downloadPersonas_(personas: PersonaRecord[], filename: string) {
+    const blob = new Blob([JSON.stringify({
+                            schema: PERSONA_EXPORT_SCHEMA,
+                            exportedAt: new Date().toISOString(),
+                            personas,
+                          }, null, 2)],
+                          {type: 'application/json'});
+    const url = URL.createObjectURL(blob);
+    const anchor = document.createElement('a');
+    anchor.href = url;
+    anchor.download = filename;
+    anchor.click();
+    URL.revokeObjectURL(url);
+  }
+
+}
+
