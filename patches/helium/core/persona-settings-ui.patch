+          'editablePersona_.region.acceptLanguage',
+          value ? `${value},en;q=0.9` : '');
+    }
+    if (optionId === 'platform') {
+      this.set('editablePersona_.uaCh.platform', value);
+      this.set(
+          'customFieldSelections_.uaChPlatform',
+          hasOption('uaChPlatform', value) ? value : CUSTOM_OPTION_VALUE);
