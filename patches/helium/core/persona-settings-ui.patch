+
+  private computeProfileStatus_(personaId: string, activePersonaId: string) {
+    if (personaId === 'default') {
+      return personaId === activePersonaId ?
+          this.i18n('personaStatusActiveSystem') :
+          this.i18n('personaStatusSystem');
+    }
+    return personaId === activePersonaId ? this.i18n('personaStatusActive') :
+                                           this.i18n('personaStatusSaved');
