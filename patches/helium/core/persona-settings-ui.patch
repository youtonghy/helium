+
+  private computeProfileSummary_(persona: PersonaRecord) {
+    if (persona?.id === 'default') {
+      return this.i18n('personaSystemSummary');
+    }
+    const platform = persona?.platform || persona?.uaCh?.platform ||
+        this.i18n('personaUnknownValue');
+    const locale = persona?.region?.locale || 'en-US';
+    return `${platform} | ${locale}`;
