+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+import type {
+  PersonaImportBundle,
+  PersonaRecord,
+  PersonaState,
+} from './persona_config.js';
+
+export interface PersonaPageResponse {
+  ok: boolean;
+  state: PersonaState;
+  fieldErrors: Record<string, unknown>;
+  personaId?: string;
+  importedCount?: number;
+  skippedCount?: number;
+}
+
+export interface PersonaProfilesResponse {
+  profiles: PersonaRecord[];
+  activePersonaId: string;
+  lastUsedPersonaId?: string;
+  launchSelectionMode?: string;
+}
+
+export interface PersonaBrowserProxy {
+  getPersonaState(): Promise<PersonaState>;
+  getPersonaProfiles(): Promise<PersonaProfilesResponse>;
+  createPersonaProfile(displayName: string): Promise<PersonaPageResponse>;
+  savePersona(persona: PersonaRecord): Promise<PersonaPageResponse>;
+  importPersonas(bundle: PersonaImportBundle): Promise<PersonaPageResponse>;
+  setActivePersona(personaId: string): Promise<PersonaPageResponse>;
+  clonePresetIntoProfile(presetId: string): Promise<PersonaPageResponse>;
+  deletePersona(personaId: string): Promise<PersonaPageResponse>;
+  getLaunchSelectionMode(): Promise<string>;
+  setLaunchSelectionMode(mode: string): Promise<string>;
+  refreshFingerprints(): Promise<PersonaState>;
+}
+
+let instance: PersonaBrowserProxy|null = null;
+
+export class PersonaBrowserProxyImpl implements PersonaBrowserProxy {
+  getPersonaState() {
+    return sendWithPromise<PersonaState>('getPersonaState');
+  }
+  getPersonaProfiles() {
+    return sendWithPromise<PersonaProfilesResponse>('getPersonaProfiles');
+  }
+  createPersonaProfile(displayName: string) {
+    return sendWithPromise<PersonaPageResponse>(
+        'createPersonaProfile', displayName);
+  }
+  savePersona(persona: PersonaRecord) {
+    return sendWithPromise<PersonaPageResponse>('savePersona', persona);
+  }
+  importPersonas(bundle: PersonaImportBundle) {
+    return sendWithPromise<PersonaPageResponse>('importPersonas', bundle);
+  }
+  setActivePersona(personaId: string) {
+    return sendWithPromise<PersonaPageResponse>(
+        'setActivePersona', personaId);
+  }
+  clonePresetIntoProfile(presetId: string) {
+    return sendWithPromise<PersonaPageResponse>(
+        'clonePresetIntoProfile', presetId);
+  }
+  deletePersona(personaId: string) {
+    return sendWithPromise<PersonaPageResponse>('deletePersona', personaId);
+  }
+  getLaunchSelectionMode() {
+    return sendWithPromise<string>('getLaunchSelectionMode');
+  }
+  setLaunchSelectionMode(mode: string) {
+    return sendWithPromise<string>('setLaunchSelectionMode', mode);
+  }
+  refreshFingerprints() {
+    return sendWithPromise<PersonaState>('refreshFingerprints');
+  }
+  static getInstance(): PersonaBrowserProxy {
+    return instance || (instance = new PersonaBrowserProxyImpl());
+  }
+  static setInstance(proxy: PersonaBrowserProxy) {
+    instance = proxy;
+  }
+}
