+TEST_F(WebOTPServiceTest, BindDeniedSettlesReceiveWithUnhandledRequest) {
+  mojo::Remote<WebOTPService> remote;
+  content::WebOTPService::BindDenied(remote.BindNewPipeAndPassReceiver());
+
+  base::RunLoop loop;
+  SmsStatus result_status = SmsStatus::kSuccess;
+  optional<string> result_otp = string("should-be-cleared");
+  remote->Receive(BindLambdaForTesting(
+      [&](SmsStatus status, const optional<string>& otp) {
+        result_status = status;
+        result_otp = otp;
+        loop.Quit();
+      }));
+  loop.Run();
+
+  EXPECT_EQ(SmsStatus::kUnhandledRequest, result_status);
+  EXPECT_FALSE(result_otp.has_value());
+  EXPECT_TRUE(remote.is_connected());
+}
