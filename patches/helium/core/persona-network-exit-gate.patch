+TEST_F(NetworkContextTest, NetworkPersonaRequestGateCancelsDirectSockets) {
+  std::unique_ptr<NetworkContext> network_context =
+      CreateContextWithParams(CreateNetworkContextParamsForTesting());
+
+  mojo::Remote<mojom::UDPSocket> socket;
+  network_context->CreateUDPSocket(socket.BindNewPipeAndPassReceiver(),
+                                   mojo::NullRemote());
+  socket.FlushForTesting();
+
+  base::RunLoop socket_disconnected;
+  socket.set_disconnect_handler(socket_disconnected.QuitClosure());
+  base::test::TestFuture<bool> blocked;
+  network_context->SetNetworkPersonaRequestsBlocked(true,
+                                                    blocked.GetCallback());
+  EXPECT_TRUE(blocked.Get());
+  socket_disconnected.Run();
+
+  mojo::Remote<mojom::UDPSocket> rejected_socket;
+  auto rejected_receiver = rejected_socket.BindNewPipeAndPassReceiver();
+  base::RunLoop rejected_socket_disconnected;
+  rejected_socket.set_disconnect_handler(
+      rejected_socket_disconnected.QuitClosure());
+  network_context->CreateUDPSocket(std::move(rejected_receiver),
+                                   mojo::NullRemote());
+  rejected_socket_disconnected.Run();
+
+  mojo::Remote<mojom::RestrictedUDPSocket> restricted_socket;
+  base::test::TestFuture<int32_t, const std::optional<net::IPEndPoint>&>
+      restricted_result;
+  network_context->CreateRestrictedUDPSocket(
+      net::IPEndPoint(net::IPAddress::IPv4Localhost(), 0),
+      mojom::RestrictedUDPSocketMode::BOUND,
+      net::MutableNetworkTrafficAnnotationTag(TRAFFIC_ANNOTATION_FOR_TESTS),
+      /*params=*/nullptr, restricted_socket.BindNewPipeAndPassReceiver(),
+      mojo::NullRemote(), /*allow_multicast=*/false,
+      /*allow_source_specific_multicast=*/false,
+      restricted_result.GetCallback());
+  EXPECT_EQ(net::ERR_NETWORK_ACCESS_REVOKED, restricted_result.Get<0>());
+  EXPECT_FALSE(restricted_result.Get<1>().has_value());
+
+  base::test::TestFuture<bool> released;
+  network_context->SetNetworkPersonaRequestsBlocked(false,
+                                                    released.GetCallback());
+  EXPECT_TRUE(released.Get());
+  mojo::Remote<mojom::UDPSocket> released_socket;
+  network_context->CreateUDPSocket(
+      released_socket.BindNewPipeAndPassReceiver(), mojo::NullRemote());
+  released_socket.FlushForTesting();
+  EXPECT_TRUE(released_socket.is_connected());
