+
+#include "net/base/network_persona_template.h"
+
+#include <array>
+#include <ranges>
+
+namespace net {
+namespace {
+
+// These variants are captured from this Chromium 149 network stack with the
+// production ML-DSA feature disabled and enabled respectively.
+constexpr std::array<NetworkPersonaTemplate, 2> kTemplates = {{
+    {
+        .id = kChromium149DefaultTemplateId,
+        .chrome_major = 149,
+        .platform = "macOS",
+        .capture_source = "Chromium 149.0.7827.114; TlsMldsaSignatures=off",
+        .client_hello_fixture =
+            "network_persona/chromium_149_macos_default_client_hello.hex",
+        .client_hello_fixture_sha256 =
+            "d8c27051142c86b70c6b902dc51b3c501f94ffe18deb95786e537ceba6db0cad",
+        .tls_signature_profile = TlsSignatureProfile::kChromium149Default,
+        .http2_settings = {{{1, 65536}, {2, 0}, {4, 6291456}, {6, 262144}}},
+        .http2_connection_window = 15728640,
+        .http2_pseudo_header_order = "masp",
+        .http3_settings_order = {1, 6, 7},
+    },
+    {
+        .id = kChromium149MldsaTemplateId,
+        .chrome_major = 149,
+        .platform = "macOS",
+        .capture_source = "Chromium 149.0.7827.114; TlsMldsaSignatures=on",
+        .client_hello_fixture =
+            "network_persona/chromium_149_macos_mldsa_client_hello.hex",
+        .client_hello_fixture_sha256 =
+            "78e038414e7d2c5f38e414db2632d156b9cbf34f278f803e6a370adc120cf443",
+        .tls_signature_profile = TlsSignatureProfile::kChromium149Mldsa,
+        .http2_settings = {{{1, 65536}, {2, 0}, {4, 6291456}, {6, 262144}}},
+        .http2_connection_window = 15728640,
+        .http2_pseudo_header_order = "masp",
+        .http3_settings_order = {1, 6, 7},
+    },
+}};
+
+}  // namespace
+
+const NetworkPersonaTemplate* FindNetworkPersonaTemplate(uint32_t template_id) {
+  const auto it = std::ranges::find(kTemplates, template_id,
+                                    &NetworkPersonaTemplate::id);
+  return it == kTemplates.end() ? nullptr : &*it;
+}
+
+std::vector<uint32_t> GetCompatibleNetworkPersonaTemplateIds(
+    int chrome_major) {
+  std::vector<uint32_t> ids;
+  for (const NetworkPersonaTemplate& network_template : kTemplates) {
+    if (network_template.chrome_major == chrome_major) {
+      ids.push_back(network_template.id);
+    }
+  }
+  return ids;
+}
+
