+std::unique_ptr<spdy::SpdySerializedFrame> CreateOrderedSettingsFrame(
+    const std::vector<std::pair<spdy::SpdySettingsId, uint32_t>>& settings) {
+  const size_t payload_size = settings.size() * 6;
+  const size_t frame_size = spdy::kFrameHeaderSize + payload_size;
+  auto data = std::make_unique<char[]>(frame_size);
+  data[0] = static_cast<char>(payload_size >> 16);
+  data[1] = static_cast<char>(payload_size >> 8);
+  data[2] = static_cast<char>(payload_size);
+  data[3] = static_cast<char>(spdy::SpdyFrameType::SETTINGS);
+  data[4] = 0;
+  data[5] = 0;
+  data[6] = 0;
+  data[7] = 0;
+  data[8] = 0;
+  size_t offset = spdy::kFrameHeaderSize;
+  for (const auto& [id, value] : settings) {
+    data[offset++] = static_cast<char>(id >> 8);
+    data[offset++] = static_cast<char>(id);
+    data[offset++] = static_cast<char>(value >> 24);
+    data[offset++] = static_cast<char>(value >> 16);
+    data[offset++] = static_cast<char>(value >> 8);
+    data[offset++] = static_cast<char>(value);
+  }
+  return std::make_unique<spdy::SpdySerializedFrame>(std::move(data),
+                                                      frame_size);
+}
