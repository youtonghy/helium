+
+bool ExtractFixtureData(std::string* fixture) {
+  constexpr std::string_view kDataMarker = "# DATA\n";
+  const size_t marker = fixture->find(kDataMarker);
+  const size_t metadata = fixture->find("\n#");
+  if (marker == std::string::npos || metadata == std::string::npos ||
+      metadata > marker) {
+    return false;
+  }
+  fixture->erase(metadata + 1);
+  return true;
+}
+
+TEST(NetworkPersonaTemplateTest, CatalogContainsCapturedChromium149Variants) {
+  const NetworkPersonaTemplate* default_variant =
+      FindNetworkPersonaTemplate(kChromium149DefaultTemplateId);
+  ASSERT_TRUE(default_variant);
+  EXPECT_EQ(149, default_variant->chrome_major);
+  EXPECT_EQ(TlsSignatureProfile::kChromium149Default,
+            default_variant->tls_signature_profile);
+
+  const NetworkPersonaTemplate* mldsa_variant =
+      FindNetworkPersonaTemplate(kChromium149MldsaTemplateId);
+  ASSERT_TRUE(mldsa_variant);
+  EXPECT_EQ(149, mldsa_variant->chrome_major);
+  EXPECT_EQ(TlsSignatureProfile::kChromium149Mldsa,
+            mldsa_variant->tls_signature_profile);
+
+  EXPECT_NE(default_variant->client_hello_fixture_sha256,
+            mldsa_variant->client_hello_fixture_sha256);
+  EXPECT_EQ((std::array<uint64_t, 3>{1, 6, 7}),
+            default_variant->http3_settings_order);
+  EXPECT_EQ(default_variant->http3_settings_order,
+            mldsa_variant->http3_settings_order);
+}
+
+TEST(NetworkPersonaTemplateTest, RejectsNativeAndUnknownTemplateIds) {
+  EXPECT_FALSE(FindNetworkPersonaTemplate(0));
+  EXPECT_FALSE(FindNetworkPersonaTemplate(1));
+  EXPECT_FALSE(FindNetworkPersonaTemplate(999999));
+}
+
+TEST(NetworkPersonaTemplateTest, CompatibleIdsAreVersionScoped) {
+  const auto chromium_149 = GetCompatibleNetworkPersonaTemplateIds(149);
+  EXPECT_EQ(2u, chromium_149.size());
+  EXPECT_TRUE(std::ranges::contains(chromium_149,
+                                    kChromium149DefaultTemplateId));
+  EXPECT_TRUE(std::ranges::contains(chromium_149,
+                                    kChromium149MldsaTemplateId));
+  EXPECT_TRUE(GetCompatibleNetworkPersonaTemplateIds(148).empty());
+}
+
+TEST(NetworkPersonaTemplateTest, RawClientHelloFixturesMatchCatalogHashes) {
+  for (uint32_t template_id : {kChromium149DefaultTemplateId,
+                               kChromium149MldsaTemplateId}) {
+    const NetworkPersonaTemplate* network_template =
+        FindNetworkPersonaTemplate(template_id);
+    ASSERT_TRUE(network_template);
+    std::string fixture;
+    ASSERT_TRUE(base::ReadFileToString(
+        GetTestNetDataDirectory().AppendASCII(network_template->client_hello_fixture),
+        &fixture));
+    ASSERT_TRUE(ExtractFixtureData(&fixture));
+    EXPECT_EQ(network_template->client_hello_fixture_sha256,
+              base::HexEncodeLower(crypto::hash::Sha256(fixture)));
+  }
+}
+
+}  // namespace
+}  // namespace net
