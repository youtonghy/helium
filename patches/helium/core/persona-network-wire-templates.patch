+void HttpNetworkSession::ApplyNetworkPersonaHttp2Profile(
+    const std::optional<NetworkPersonaConfig>& config) {
+  spdy::SettingsMap settings = AddDefaultHttp2Settings(params_.http2_settings);
+  std::vector<std::pair<spdy::SpdySettingsId, uint32_t>> settings_order;
+  size_t connection_window = params_.spdy_session_max_recv_window_size;
+  if (config && config->template_id != 0) {
+    const NetworkPersonaTemplate* network_template =
+        FindNetworkPersonaTemplate(config->template_id);
+    CHECK(network_template);
+    settings.clear();
+    for (const NetworkPersonaHttp2Setting& setting :
+         network_template->http2_settings) {
+      const auto id = static_cast<spdy::SpdySettingsId>(setting.id);
+      settings[id] = setting.value;
+      settings_order.emplace_back(id, setting.value);
+    }
+    settings = AddDefaultHttp2Settings(std::move(settings));
+    connection_window = network_template->http2_connection_window;
+  }
+  spdy_session_pool_.ApplyNetworkPersonaHttp2Profile(
+      connection_window, std::move(settings), std::move(settings_order));
+}
