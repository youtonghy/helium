+std::vector<uint16_t> GetClientHelloExtensionOrder(
+    const SSL_CLIENT_HELLO* client_hello) {
+  CBS extensions;
+  CBS_init(&extensions, client_hello->extensions,
+           client_hello->extensions_len);
+  std::vector<uint16_t> order;
+  while (CBS_len(&extensions) > 0) {
+    uint16_t type = 0;
+    CBS body;
+    if (!CBS_get_u16(&extensions, &type) ||
+        !CBS_get_u16_length_prefixed(&extensions, &body)) {
+      return {};
+    }
+    if ((type & 0x0f0f) != 0x0a0a) {
+      order.push_back(type);
+    }
+  }
+  return order;
+}
+
+std::vector<uint16_t> GetClientHelloSignatureAlgorithms(
+    const SSL_CLIENT_HELLO* client_hello) {
+  const uint8_t* data = nullptr;
+  size_t length = 0;
+  if (!SSL_early_callback_ctx_extension_get(
+          client_hello, TLSEXT_TYPE_signature_algorithms, &data, &length)) {
+    return {};
+  }
+  CBS extension;
+  CBS algorithms;
+  CBS_init(&extension, data, length);
+  if (!CBS_get_u16_length_prefixed(&extension, &algorithms) ||
+      CBS_len(&extension) != 0) {
+    return {};
+  }
+  std::vector<uint16_t> result;
+  while (CBS_len(&algorithms) > 0) {
+    uint16_t algorithm = 0;
+    if (!CBS_get_u16(&algorithms, &algorithm)) {
+      return {};
+    }
+    result.push_back(algorithm);
+  }
+  return result;
+}
+
+struct CapturedClientHelloProfile {
+  std::vector<uint16_t> extension_order;
+  std::vector<uint16_t> signature_algorithms;
+};
+
+std::optional<CapturedClientHelloProfile> LoadCapturedClientHelloProfile(
+    std::string_view fixture_name) {
+  std::string encoded;
+  if (!base::ReadFileToString(
+          GetTestNetDataDirectory()
+              .AppendASCII("network_persona")
+              .AppendASCII(fixture_name),
+          &encoded)) {
+    return std::nullopt;
+  }
+  constexpr std::string_view kDataMarker = "# DATA\n";
+  const size_t marker = encoded.find(kDataMarker);
+  const size_t metadata = encoded.find("\n#");
+  if (marker == std::string::npos || metadata == std::string::npos ||
+      metadata > marker) {
+    return std::nullopt;
+  }
+  encoded.erase(metadata + 1);
+  std::erase_if(encoded,
+                [](char value) { return base::IsAsciiWhitespace(value); });
+  std::vector<uint8_t> bytes;
+  if (!base::HexStringToBytes(encoded, &bytes)) {
+    return std::nullopt;
+  }
+
+  CBS hello;
+  CBS session_id;
+  CBS cipher_suites;
+  CBS compression_methods;
+  CBS extensions;
+  CBS_init(&hello, bytes.data(), bytes.size());
+  uint16_t legacy_version = 0;
+  if (!CBS_get_u16(&hello, &legacy_version) || !CBS_skip(&hello, 32) ||
+      !CBS_get_u8_length_prefixed(&hello, &session_id) ||
+      !CBS_get_u16_length_prefixed(&hello, &cipher_suites) ||
+      !CBS_get_u8_length_prefixed(&hello, &compression_methods) ||
+      !CBS_get_u16_length_prefixed(&hello, &extensions) ||
+      CBS_len(&hello) != 0) {
+    return std::nullopt;
+  }
+
+  CapturedClientHelloProfile profile;
+  while (CBS_len(&extensions) > 0) {
+    uint16_t type = 0;
+    CBS body;
+    if (!CBS_get_u16(&extensions, &type) ||
+        !CBS_get_u16_length_prefixed(&extensions, &body)) {
+      return std::nullopt;
+    }
+    if ((type & 0x0f0f) != 0x0a0a) {
+      profile.extension_order.push_back(type);
+    }
+    if (type != TLSEXT_TYPE_signature_algorithms) {
+      continue;
+    }
+    CBS algorithms;
+    if (!CBS_get_u16_length_prefixed(&body, &algorithms) ||
+        CBS_len(&body) != 0) {
+      return std::nullopt;
+    }
+    while (CBS_len(&algorithms) > 0) {
+      uint16_t algorithm = 0;
+      if (!CBS_get_u16(&algorithms, &algorithm)) {
+        return std::nullopt;
+      }
+      profile.signature_algorithms.push_back(algorithm);
+    }
+  }
+  return profile;
+}
