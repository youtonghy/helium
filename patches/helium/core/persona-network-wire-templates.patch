+#ifndef NET_THIRD_PARTY_QUICHE_SRC_QUICHE_QUIC_CORE_QUIC_WIRE_SERIALIZATION_H_
+#define NET_THIRD_PARTY_QUICHE_SRC_QUICHE_QUIC_CORE_QUIC_WIRE_SERIALIZATION_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace quic {
+
+// Optional connection-scoped controls for non-cryptographic wire
+// randomization. This must never be used for connection IDs, key material,
+// tokens, or other security-sensitive randomness.
+struct QuicWireSerializationOptions {
+  std::array<uint8_t, 32> transport_parameter_seed = {};
+  std::array<uint8_t, 32> http3_seed = {};
+  std::vector<uint64_t> http3_settings_order;
+};
+
+class QuicWireDeterministicRandom {
+ public:
+  explicit QuicWireDeterministicRandom(
+      const std::array<uint8_t, 32>& deterministic_seed) {
+    for (uint8_t byte : deterministic_seed) {
+      state_ = (state_ ^ byte) * 0x100000001b3ULL;
+    }
+  }
+
+  uint64_t NextUint64() {
+    // SplitMix64 is used only to decorrelate non-security-sensitive wire
+    // ordering and GREASE values.
+    uint64_t value = (state_ += 0x9e3779b97f4a7c15ULL);
+    value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    value = (value ^ (value >> 27)) * 0x94d049bb133111ebULL;
+    return value ^ (value >> 31);
+  }
+
+  void FillBytes(void* output, size_t length) {
+    auto* bytes = static_cast<uint8_t*>(output);
+    while (length > 0) {
+      const uint64_t value = NextUint64();
+      const size_t chunk = length < sizeof(value) ? length : sizeof(value);
+      for (size_t i = 0; i < chunk; ++i) {
+        bytes[i] = static_cast<uint8_t>(value >> (i * 8));
+      }
+      bytes += chunk;
+      length -= chunk;
+    }
+  }
+
+ private:
+  uint64_t state_ = 0xcbf29ce484222325ULL;
+};
+
+}  // namespace quic
