+std::array<uint8_t, 32> DeriveNetworkPersonaQuicSeed(
+    const NetworkPersonaConfig& config,
+    std::string_view domain) {
+  std::string input(
+      reinterpret_cast<const char*>(config.deterministic_seed.data()),
+      config.deterministic_seed.size());
+  for (int shift = 56; shift >= 0; shift -= 8) {
+    input.push_back(
+        static_cast<char>((config.generation >> shift) & 0xff));
+  }
+  input.append(domain);
+  return crypto::hash::Sha256(input);
+}
