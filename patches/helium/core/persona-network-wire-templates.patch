+TEST_F(SSLClientSocketTest, NetworkPersonaControlsClientHelloProfile) {
+  std::vector<std::vector<uint16_t>> extension_orders;
+  std::vector<std::vector<uint16_t>> signature_algorithms;
+  SSLServerConfig server_config;
+  server_config.client_hello_callback_for_testing =
+      base::BindLambdaForTesting([&](const SSL_CLIENT_HELLO* client_hello) {
+        extension_orders.push_back(
+            GetClientHelloExtensionOrder(client_hello));
+        signature_algorithms.push_back(
+            GetClientHelloSignatureAlgorithms(client_hello));
+        return true;
+      });
+  ASSERT_TRUE(
+      StartEmbeddedTestServer(EmbeddedTestServer::CERT_OK, server_config));
+
+  auto connect = [&](uint32_t template_id, uint64_t generation) {
+    SSLConfig ssl_config;
+    NetworkPersonaConfig persona_config;
+    persona_config.template_id = template_id;
+    persona_config.generation = generation;
+    persona_config.deterministic_seed.fill(0x42);
+    ssl_config.network_persona_config = persona_config;
+    int rv;
+    EXPECT_TRUE(CreateAndConnectSSLClientSocket(ssl_config, &rv));
+    EXPECT_THAT(rv, IsOk());
+    sock_.reset();
+  };
+
+  connect(kChromium149DefaultTemplateId, 7);
+  connect(kChromium149DefaultTemplateId, 7);
+  connect(kChromium149DefaultTemplateId, 8);
+  connect(kChromium149MldsaTemplateId, 8);
+
+  ASSERT_EQ(4u, extension_orders.size());
+  ASSERT_EQ(4u, signature_algorithms.size());
+  EXPECT_EQ(extension_orders[0], extension_orders[1]);
+  EXPECT_NE(extension_orders[1], extension_orders[2]);
+  EXPECT_FALSE(std::ranges::contains(signature_algorithms[2],
+                                     SSL_SIGN_ML_DSA_44));
+  EXPECT_TRUE(std::ranges::contains(signature_algorithms[3],
+                                    SSL_SIGN_ML_DSA_44));
+  EXPECT_TRUE(std::ranges::contains(signature_algorithms[3],
+                                    SSL_SIGN_ML_DSA_65));
+  EXPECT_TRUE(std::ranges::contains(signature_algorithms[3],
+                                    SSL_SIGN_ML_DSA_87));
+
+  const auto default_capture = LoadCapturedClientHelloProfile(
+      "chromium_149_macos_default_client_hello.hex");
+  const auto mldsa_capture = LoadCapturedClientHelloProfile(
+      "chromium_149_macos_mldsa_client_hello.hex");
+  ASSERT_TRUE(default_capture);
+  ASSERT_TRUE(mldsa_capture);
+  EXPECT_EQ(default_capture->extension_order, extension_orders[0]);
+  EXPECT_EQ(default_capture->signature_algorithms, signature_algorithms[0]);
+  EXPECT_EQ(mldsa_capture->extension_order, extension_orders[3]);
+  EXPECT_EQ(mldsa_capture->signature_algorithms, signature_algorithms[3]);
+}
