+void CertNetFetcherURLLoader::SetNetworkAccessState(
+    uint64_t network_access_generation,
+    bool blocked) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  bool changed = false;
+  {
+    base::AutoLock lock(network_access_lock_);
+    changed = network_access_generation_ != network_access_generation ||
+              network_access_blocked_ != blocked;
+    network_access_generation_ = network_access_generation;
+    network_access_blocked_ = blocked;
+  }
+  if (changed && impl_) {
+    impl_->ResetForNetworkAccessTransition();
+  }
+}
