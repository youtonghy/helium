+TEST_F(MediaDevicesManagerTest, DefaultPersonaMediaDevicesAreSynthetic) {
+  InitializeRenderFrameHost();
+  blink::HeliumPersonaSnapshot snapshot;
+  snapshot.enabled = true;
+  browser_client_.SetHeliumPersonaSnapshot(std::move(snapshot));
+
+  EXPECT_CALL(*audio_manager_, MockGetAudioInputDeviceNames(_)).Times(1);
+  EXPECT_CALL(*video_capture_device_factory_, MockGetDevicesInfo()).Times(1);
+  EXPECT_CALL(*audio_manager_, MockGetAudioOutputDeviceNames(_)).Times(1);
+  EXPECT_CALL(media_devices_manager_client_, InputDevicesChangedUI(_, _))
+      .Times(AtLeast(1));
+
+  MediaDevicesManager::BoolDeviceTypes requested_types;
+  requested_types.fill(true);
+  base::test::TestFuture<MediaDeviceEnumeration> future;
+  media_devices_manager_->EnumerateAndRankDevices(
+      render_frame_host_->GetGlobalId(), requested_types,
+      future.GetCallback<const MediaDeviceEnumeration&>());
+  const auto& devices = future.Get();
+  const auto& audio_inputs =
+      devices[static_cast<size_t>(MediaDeviceType::kMediaAudioInput)];
+  const auto& video_inputs =
+      devices[static_cast<size_t>(MediaDeviceType::kMediaVideoInput)];
+  const auto& audio_outputs =
+      devices[static_cast<size_t>(MediaDeviceType::kMediaAudioOutput)];
+
+  ASSERT_EQ(audio_inputs.size(), 1u);
+  EXPECT_EQ(audio_inputs[0].device_id, "persona_audio_input_0");
+  EXPECT_EQ(audio_inputs[0].label, "Default Audio Input");
+  EXPECT_EQ(audio_inputs[0].group_id, "persona_audio_input_group");
+  ASSERT_EQ(video_inputs.size(), 1u);
