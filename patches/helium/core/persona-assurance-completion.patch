+class AcceptingURLLoaderFactoryConnector
+    : public mojom::URLLoaderFactoryConnector {
+ public:
+  mojo::PendingRemote<mojom::URLLoaderFactoryConnector>
+  BindNewPipeAndPassRemote() {
+    return receiver_.BindNewPipeAndPassRemote();
+  }
+
+  void CreateURLLoaderFactory(
+      uint64_t network_access_generation,
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      CreateURLLoaderFactoryCallback callback) override {
+    last_network_access_generation_ = network_access_generation;
+    if (accept_) {
+      receivers_.push_back(std::move(receiver));
+    }
+    std::move(callback).Run(accept_);
+  }
+
+  void set_accept(bool accept) { accept_ = accept; }
+
+  uint64_t last_network_access_generation() const {
+    return last_network_access_generation_;
+  }
+
+ private:
+  bool accept_ = true;
+  uint64_t last_network_access_generation_ = 0;
+  std::vector<mojo::PendingReceiver<network::mojom::URLLoaderFactory>>
+      receivers_;
+  mojo::Receiver<mojom::URLLoaderFactoryConnector> receiver_{this};
+};
