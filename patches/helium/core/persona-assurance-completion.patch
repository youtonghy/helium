+void FakeTestCertVerifierParamsFactory::EnableNetworkAccess(
+    uint64_t network_access_generation,
+    bool network_access_blocked,
+    mojo::PendingRemote<mojom::URLLoaderFactory> url_loader_factory,
+    mojo::PendingRemote<cert_verifier::mojom::URLLoaderFactoryConnector>
+        reconnector) {
+  url_loader_factory_.Bind(std::move(url_loader_factory));
+  if (reconnector.is_valid()) {
+    reconnector_.Bind(std::move(reconnector));
+  }
+}
+
+void FakeTestCertVerifierParamsFactory::SetNetworkAccessState(
+    uint64_t network_access_generation,
+    bool network_access_blocked,
+    SetNetworkAccessStateCallback callback) {
+  if (network_access_blocked) {
+    url_loader_factory_.reset();
+    std::move(callback).Run(true);
+    return;
+  }
+  if (!reconnector_) {
+    std::move(callback).Run(false);
+    return;
+  }
+
+  url_loader_factory_.reset();
+  reconnector_->CreateURLLoaderFactory(
+      network_access_generation,
+      url_loader_factory_.BindNewPipeAndPassReceiver(),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(callback), false));
+}
