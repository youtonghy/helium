+void CertVerifierServiceImpl::SetNetworkAccessState(
+    uint64_t network_access_generation,
+    bool network_access_blocked,
+    SetNetworkAccessStateCallback callback) {
+  if (network_access_generation < network_access_generation_ ||
+      (network_access_generation > network_access_generation_ &&
+       !network_access_blocked)) {
+    std::move(callback).Run(false);
+    return;
+  }
+  const uint64_t operation_id = ++network_access_operation_id_;
+  CHECK_NE(0u, operation_id);
+  RejectQueuedVerifyRequestsForNetworkAccessTransition();
+  network_access_generation_ = network_access_generation;
+  network_access_blocked_ = true;
+
+  if (!cert_net_fetcher_) {
+    network_access_blocked_ = network_access_blocked;
+    std::move(callback).Run(true);
+    return;
+  }
+
+  if (!network_access_blocked && !url_loader_factory_reconnector_) {
+    std::move(callback).Run(false);
+    return;
+  }
+
+  if (!ReplaceCertNetFetcherForNetworkAccessTransition(
+          network_access_generation, network_access_blocked)) {
+    std::move(callback).Run(false);
+    return;
+  }
+
+  if (network_access_blocked) {
+    std::move(callback).Run(true);
+    return;
+  }
+
+  mojo::PendingRemote<network::mojom::URLLoaderFactory> url_loader_factory;
+  auto url_loader_factory_receiver =
+      url_loader_factory.InitWithNewPipeAndPassReceiver();
+  scoped_refptr<CertNetFetcherURLLoader> cert_net_fetcher = cert_net_fetcher_;
+  cert_net_fetcher->SetURLLoaderFactoryAndReconnector(
+      std::move(url_loader_factory),
+      base::BindRepeating(&CertVerifierServiceImpl::ReconnectURLLoaderFactory,
+                          weak_factory_.GetWeakPtr()));
+  url_loader_factory_reconnector_->CreateURLLoaderFactory(
+      network_access_generation, std::move(url_loader_factory_receiver),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              &CertVerifierServiceImpl::OnNetworkAccessFactoryReady,
+              weak_factory_.GetWeakPtr(), network_access_generation,
+              operation_id, std::move(cert_net_fetcher), std::move(callback)),
+          false));
+}
+
+bool CertVerifierServiceImpl::ReplaceCertNetFetcherForNetworkAccessTransition(
+    uint64_t network_access_generation,
+    bool network_access_blocked) {
+  cert_net_fetcher_->SetNetworkAccessState(network_access_generation,
+                                           /*blocked=*/true);
+  cert_net_fetcher_->Shutdown();
+  if (!service_factory_impl_) {
+    return false;
   }
+
+  cert_net_fetcher_ = base::MakeRefCounted<CertNetFetcherURLLoader>();
+  cert_net_fetcher_->SetNetworkAccessState(network_access_generation,
+                                           network_access_blocked);
+  verifier_->UpdateVerifyProcData(cert_net_fetcher_,
+                                  service_factory_impl_->get_impl_params(),
+                                  instance_params_);
+  return true;
+}
+
+void CertVerifierServiceImpl::OnNetworkAccessFactoryReady(
+    uint64_t network_access_generation,
+    uint64_t operation_id,
+    scoped_refptr<CertNetFetcherURLLoader> cert_net_fetcher,
+    SetNetworkAccessStateCallback callback,
+    bool accepted) {
+  if (!accepted || operation_id != network_access_operation_id_ ||
+      network_access_generation != network_access_generation_ ||
+      cert_net_fetcher != cert_net_fetcher_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  network_access_blocked_ = false;
+  std::move(callback).Run(true);
+}
+
+void CertVerifierServiceImpl::
+    RejectQueuedVerifyRequestsForNetworkAccessTransition() {
+  for (QueuedCertVerifyRequest& request : queued_requests_) {
+    mojo::Remote<mojom::CertVerifierRequest> remote(
+        std::move(request.cert_verifier_request));
+    remote->Complete(net::CertVerifyResult(),
+                     net::ERR_NETWORK_ACCESS_REVOKED);
+  }
+  queued_requests_.clear();
+}
+
+void CertVerifierServiceImpl::ReconnectURLLoaderFactory(
+    uint64_t network_access_generation,
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver) {
+  if (!url_loader_factory_reconnector_ || network_access_blocked_ ||
+      network_access_generation != network_access_generation_) {
+    return;
+  }
+  url_loader_factory_reconnector_->CreateURLLoaderFactory(
+      network_access_generation, std::move(receiver),
+      base::BindOnce([](bool) {}));
 }
 
