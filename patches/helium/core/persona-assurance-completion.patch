+
+void NetworkContext::OnCertNetworkAccessGenerationSynced(
+    uint64_t network_access_generation,
+    SetNetworkPersonaRequestsBlockedCallback callback,
+    bool accepted) {
+  if (!accepted ||
+      network_access_generation != cert_network_access_generation_) {
+    std::move(callback).Run(false);
+    return;
+  }
   std::move(callback).Run(true);
 }
 
+void NetworkContext::OnCertNetworkAccessPreparedForRelease(
+    uint64_t network_access_generation,
+    bool was_blocked,
+    SetNetworkPersonaRequestsBlockedCallback callback,
+    bool accepted) {
+  if (!accepted ||
+      network_access_generation != cert_network_access_generation_) {
+    std::move(callback).Run(false);
+    return;
+  }
+
+  cert_network_access_release_generation_ = network_access_generation;
+  mojo_cert_verifier_->SetNetworkAccessState(
+      network_access_generation, /*network_access_blocked=*/false,
+      base::BindOnce(&NetworkContext::OnCertNetworkAccessReleased,
+                     weak_factory_.GetWeakPtr(), network_access_generation,
+                     was_blocked, std::move(callback)));
+}
+
+void NetworkContext::OnCertNetworkAccessReleased(
+    uint64_t network_access_generation,
+    bool was_blocked,
+    SetNetworkPersonaRequestsBlockedCallback callback,
+    bool accepted) {
+  if (cert_network_access_release_generation_ == network_access_generation) {
+    cert_network_access_release_generation_.reset();
+  }
+  if (accepted &&
+      network_access_generation == cert_network_access_generation_) {
+    ReleaseNetworkPersonaRequestGateLocally(was_blocked);
+    std::move(callback).Run(true);
+    return;
+  }
+  std::move(callback).Run(false);
+}
+
+void NetworkContext::ReleaseNetworkPersonaRequestGateLocally(
+    bool was_blocked) {
+  network_persona_requests_blocked_ = false;
+  socket_factory_->SetNetworkPersonaRequestsBlocked(false);
+  if (internal_host_resolver_) {
+    internal_host_resolver_->SetNetworkRequestsBlocked(false);
+  }
+  for (const auto& resolver : host_resolvers_) {
+    resolver->SetNetworkRequestsBlocked(false);
+  }
+  if (was_blocked && doh_probes_activation_requested_) {
+    ActivateDohProbes();
+  }
+  if (was_blocked && prefetch_enabled_) {
+    InitializePrefetchURLLoaderFactory();
+  }
+}
