+  EXPECT_EQ(video_inputs[0].label, "Default Video Camera");
+  ASSERT_EQ(audio_outputs.size(), 1u);
+  EXPECT_EQ(audio_outputs[0].device_id, "persona_audio_output_0");
+  EXPECT_EQ(audio_outputs[0].label, "Default Audio Output");
+  EXPECT_EQ(audio_outputs[0].group_id, "persona_audio_output_group");
+}
