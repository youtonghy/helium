+// Build a fake device list of |count| entries. When |labels| is non-empty the
+// labels are assigned in order (cycling), otherwise platform-neutral generic
+// labels are generated. Labels keep the "hidden until permission granted"
+// behaviour: TranslateMediaDeviceInfo blanks them when the site lacks
+// permission, matching real browsers.
+blink::WebMediaDeviceInfoArray BuildPersonaAudioDevices(
+    int count,
+    const std::vector<std::string>& labels) {
+  blink::WebMediaDeviceInfoArray devices;
+  for (int i = 0; i < count; ++i) {
+    std::string label =
+        labels.empty()
+            ? (i == 0 ? "Default Audio Input"
+                      : "Microphone " + base::NumberToString(i + 1))
+            : labels[i % labels.size()];
+    devices.emplace_back("persona_audio_input_" + base::NumberToString(i),
+                         label, "persona_audio_group");
+  }
+  return devices;
+}
+
+blink::WebMediaDeviceInfoArray BuildPersonaVideoDevices(
+    int count,
+    const std::vector<std::string>& labels) {
+  blink::WebMediaDeviceInfoArray devices;
+  for (int i = 0; i < count; ++i) {
+    std::string label =
+        labels.empty()
+            ? (i == 0 ? "Default Video Camera"
+                      : "Camera " + base::NumberToString(i + 1))
+            : labels[i % labels.size()];
+    devices.emplace_back("persona_video_input_" + base::NumberToString(i),
+                         label, "persona_video_group");
+  }
+  return devices;
+}
