+// Binds GeolocationService while applying the persona geolocation override.
+// When the active persona enables geolocation override, the per-WebContents
+// GeolocationContext is given fixed coordinates so every frame of that
+// WebContents reports the persona position instead of the real device fix.
+void BindPersonaGeolocationService(
+    RenderFrameHost* host,
+    mojo::PendingReceiver<blink::mojom::GeolocationService> receiver) {
+  if (host) {
+    blink::HeliumPersonaSnapshot snapshot =
+        GetHeliumPersonaSnapshot(host->GetBrowserContext());
+    if (snapshot.IsEnabled() && snapshot.geolocation_enabled) {
+      WebContentsImpl* web_contents = static_cast<WebContentsImpl*>(
+          WebContents::FromRenderFrameHost(host));
+      if (web_contents) {
+        auto position = device::mojom::Geoposition::New();
+        position->latitude = snapshot.geolocation_latitude;
+        position->longitude = snapshot.geolocation_longitude;
+        position->accuracy = snapshot.geolocation_accuracy;
+        position->timestamp = base::Time::Now();
+        if (device::ValidateGeoposition(*position)) {
+          web_contents->GetGeolocationContext()->SetOverride(
+              device::mojom::GeopositionResult::NewPosition(
+                  std::move(position)));
+        }
+      }
+    }
+  }
+  BindRenderFrameHostImpl<&RenderFrameHostImpl::GetGeolocationService>(
+      host, std::move(receiver));
+}
