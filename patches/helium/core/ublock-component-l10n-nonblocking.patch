+TEST_F(ComponentLoaderTest, AddUBlockUsesComponentResourcesForLocalization) {
+  base::ScopedDisallowBlocking disallow_blocking;
+
+  component_loader_->AddUBlock();
+
+  ASSERT_FALSE(component_loader_->component_extensions_.empty());
+  const ComponentLoader::ComponentExtensionInfo& info =
+      component_loader_->component_extensions_.back();
+  const std::string* localized_description =
+      info.manifest.FindString("description");
+  ASSERT_TRUE(localized_description);
+  EXPECT_FALSE(localized_description->starts_with("__MSG_"));
