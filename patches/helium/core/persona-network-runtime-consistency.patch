+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "net/socket/client_socket_pool_manager_impl.h"
+
+#include "base/test/task_environment.h"
+#include "net/base/network_persona_config.h"
+#include "net/base/proxy_chain.h"
+#include "net/socket/client_socket_pool.h"
+#include "net/socket/websocket_endpoint_lock_manager.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace net {
+namespace {
+
+CommonConnectJobParams MakeCommonParams(
+    WebSocketEndpointLockManager* websocket_endpoint_lock_manager,
+    const NetworkPersonaConfig& config) {
+  static const bool kDisabled = false;
+  CommonConnectJobParams params(
+      /*client_socket_factory=*/nullptr, /*host_resolver=*/nullptr,
+      /*http_auth_cache=*/nullptr, /*http_auth_handler_factory=*/nullptr,
+      /*spdy_session_pool=*/nullptr, /*quic_supported_versions=*/nullptr,
+      /*quic_session_pool=*/nullptr, /*proxy_delegate=*/nullptr,
+      /*http_user_agent_settings=*/nullptr, /*ssl_client_context=*/nullptr,
+      /*socket_performance_watcher_factory=*/nullptr,
+      /*network_quality_estimator=*/nullptr, /*net_log=*/nullptr,
+      websocket_endpoint_lock_manager, /*http_server_properties=*/nullptr,
+      /*alpn_protos=*/nullptr, /*application_settings=*/nullptr, &kDisabled,
+      &kDisabled);
+  params.network_persona_config = config;
+  return params;
+}
+
+TEST(ClientSocketPoolManagerImplTest,
+     RuntimePersonaUpdateReachesNormalAndWebSocketPools) {
+  base::test::TaskEnvironment task_environment;
+  NetworkPersonaConfig initial_config;
+  initial_config.generation = 7;
+  WebSocketEndpointLockManager endpoint_lock_manager;
+  CommonConnectJobParams normal_params =
+      MakeCommonParams(nullptr, initial_config);
+  CommonConnectJobParams websocket_params =
+      MakeCommonParams(&endpoint_lock_manager, initial_config);
+  ClientSocketPoolManagerImpl normal_manager(
+      normal_params, websocket_params,
+      HttpNetworkSession::SocketPoolType::kNormal);
+  ClientSocketPoolManagerImpl websocket_manager(
+      normal_params, websocket_params,
+      HttpNetworkSession::SocketPoolType::kWebSocket);
+  ClientSocketPool* normal_pool =
+      normal_manager.GetSocketPool(ProxyChain::Direct());
+  ClientSocketPool* websocket_pool =
+      websocket_manager.GetSocketPool(ProxyChain::Direct());
+
+  NetworkPersonaConfig updated_config = initial_config;
+  updated_config.generation = 8;
+  normal_manager.UpdateNetworkPersonaConfig(updated_config);
+  websocket_manager.UpdateNetworkPersonaConfig(updated_config);
+
+  ASSERT_TRUE(normal_pool->NetworkPersonaConfigForTest());
+  EXPECT_EQ(8u,
+            normal_pool->NetworkPersonaConfigForTest()->generation);
+  ASSERT_TRUE(websocket_pool->NetworkPersonaConfigForTest());
+  EXPECT_EQ(8u,
+            websocket_pool->NetworkPersonaConfigForTest()->generation);
+
+  normal_manager.UpdateNetworkPersonaConfig(std::nullopt);
+  websocket_manager.UpdateNetworkPersonaConfig(std::nullopt);
+  EXPECT_FALSE(normal_pool->NetworkPersonaConfigForTest());
+  EXPECT_FALSE(websocket_pool->NetworkPersonaConfigForTest());
+}
+
