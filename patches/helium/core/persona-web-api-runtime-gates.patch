+const HeliumPersonaSnapshot* GetPersonaSnapshot(LocalDOMWindow* window) {
+  if (!window || !window->GetFrame() || !window->GetFrame()->Client() ||
+      !window->GetFrame()->Client()->GetWebFrame() ||
+      !window->GetFrame()->Client()->GetWebFrame()->Client()) {
+    return nullptr;
+  }
+  const HeliumPersonaSnapshot& snapshot =
+      window->GetFrame()->Client()->GetWebFrame()->Client()
+          ->GetHeliumPersonaSnapshot();
+  return snapshot.IsEnabled() ? &snapshot : nullptr;
+}
+
+bool HeliumPersonaAllowsRealBatteryStatus(LocalDOMWindow* window) {
+  const HeliumPersonaSnapshot* snapshot = GetPersonaSnapshot(window);
+  return !snapshot || snapshot->allow_real_battery_status;
+}
