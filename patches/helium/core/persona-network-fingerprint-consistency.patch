+TEST_F(PersonaServiceTest, LegacyNetworkMigrationCommitsWithActivationOnlyOnce) {
+  constexpr char kSeed[] =
+      "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
+  ASSERT_TRUE(service_->SetFixedFingerprintSeed(kSeed)
+                  .FindBool("ok").value_or(false));
+  auto legacy = InstallLegacyNetworkPreset("de-linux");
+  const std::string id = *legacy.FindString("id");
+  const auto old_state = prefs_.GetDict(kPersonaStatePref).Clone();
+  const auto old_seed = prefs_.GetString(kPersonaFingerprintProfileSaltPref);
+  service_->GetPersonaState();
+  service_->ResolvePersonaById(id);
+  EXPECT_EQ(old_state, prefs_.GetDict(kPersonaStatePref));
+
+  auto delegate = std::make_unique<FakeIdentityRotationDelegate>();
+  auto* network = delegate.get();
+  service_->SetIdentityRotationDelegateForTesting(std::move(delegate));
+  base::test::TestFuture<base::DictValue> result;
+  service_->SetActivePersona(id, result.GetCallback());
+  ASSERT_EQ(1u, network->apply_calls.size());
+  EXPECT_EQ(kChromium149LinuxX64IdentityTemplateId,
+            network->apply_calls.front().identity_template_id.value_or(0));
+  EXPECT_EQ(old_state, prefs_.GetDict(kPersonaStatePref));
+  EXPECT_EQ(old_seed, prefs_.GetString(kPersonaFingerprintProfileSaltPref));
+  network->CompleteNextApply(true);
+  ASSERT_TRUE(result.Take().FindBool("ok").value_or(false));
+  auto resolved = service_->ResolvePersonaById(id);
+  const auto* migrated = resolved.FindDict("requested");
+  ASSERT_TRUE(migrated);
+  EXPECT_EQ(2, migrated->FindInt("presetRevision"));
+  EXPECT_EQ(legacy, *migrated->FindDict("legacyNetworkSettings"));
+  EXPECT_EQ(*legacy.FindDict("region"), *migrated->FindDict("region"));
+  EXPECT_EQ(*legacy.FindDict("network"), *migrated->FindDict("network"));
+  EXPECT_EQ(*legacy.FindString("displayName"),
+            *migrated->FindString("displayName"));
+  EXPECT_TRUE(service_->GetActiveSnapshot().ua_ch_platform_version.empty());
+  EXPECT_EQ(kSeed, prefs_.GetString(kPersonaFingerprintProfileSaltPref));
+  EXPECT_FALSE(resolved.FindDict("upgradeCandidate"));
+
+  base::test::TestFuture<base::DictValue> again;
+  service_->SetActivePersona(id, again.GetCallback());
+  network->CompleteNextApply(true);
+  ASSERT_TRUE(again.Take().FindBool("ok").value_or(false));
+  EXPECT_EQ(legacy, *service_->ResolvePersonaById(id)
+                         .FindDict("requested")
+                         ->FindDict("legacyNetworkSettings"));
+}
