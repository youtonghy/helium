+      (async () => {
+        const read = () => navigator.userAgentData.getHighEntropyValues(
+            ['platformVersion', 'architecture', 'bitness', 'fullVersionList']);
+        const dedicated = await new Promise((resolve, reject) => {
+          const worker = new Worker('/persona-metadata-worker.js');
+          worker.onerror = reject;
+          worker.onmessage = event => { worker.terminate(); resolve(event.data); };
+          worker.postMessage('read');
+        });
+        const shared = await new Promise((resolve, reject) => {
+          const worker = new SharedWorker('/persona-metadata-shared-worker.js');
+          worker.onerror = reject;
+          worker.port.onmessage = event => {
+            worker.port.close(); resolve(event.data);
+          };
+          worker.port.start();
+          worker.port.postMessage('read');
+        });
+        await navigator.serviceWorker.register('/persona-metadata-service-worker.js');
+        const registration = await navigator.serviceWorker.ready;
+        const service = await new Promise(resolve => {
+          const channel = new MessageChannel();
+          channel.port1.onmessage = event => {
+            channel.port1.close(); resolve(event.data);
+          };
+          registration.active.postMessage('read', [channel.port2]);
+        });
+        await registration.unregister();
+        const headers = await (await fetch('/persona-metadata-headers')).json();
+        return {page: await read(), dedicated, shared, service, headers};
+      })()
