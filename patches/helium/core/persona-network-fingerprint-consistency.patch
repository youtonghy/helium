+IN_PROC_BROWSER_TEST_F(ProfileNetworkContextServiceBrowsertest,
+                       HistoricalCrossOsIdentityStaysBlockedUntilReactivation) {
+  auto* persona_service = helium_persona::PersonaServiceFactory::GetForProfile(
+      browser()->profile());
+  ASSERT_TRUE(persona_service);
+  auto created = persona_service->CreatePersonaProfile("Identity repair");
+  const std::string id = *created.FindString("personaId");
+  auto persona = persona_service->ResolvePersonaById(id).FindDict("requested")->Clone();
+  persona.SetByDottedPath("network.routeMode", "direct");
+  ASSERT_TRUE(persona_service->SavePersona(persona).FindBool("ok").value_or(false));
+  base::test::TestFuture<base::DictValue> activated;
+  persona_service->SetActivePersona(id, activated.GetCallback());
+  ASSERT_TRUE(activated.Take().FindBool("ok").value_or(false));
+
+  auto* service = ProfileNetworkContextServiceFactory::GetForContext(
+      browser()->profile());
+  auto* prefs = browser()->profile()->GetPrefs();
+  service->SuppressNetworkPersonaPrefUpdates();
+  auto rotation = prefs->GetDict(helium_persona::prefs::kFingerprintRotationEpoch).Clone();
+  rotation.Set("identityTemplateId",
+               static_cast<int>(helium_persona::kChromium149WindowsX64IdentityTemplateId));
+  prefs->SetDict(helium_persona::prefs::kFingerprintRotationEpoch, std::move(rotation));
+  network::mojom::NetworkContextParams blocked_params;
+  cert_verifier::mojom::CertVerifierCreationParams blocked_cert_params;
+  service->ConfigureNetworkContextParams(false, base::FilePath(),
+                                         &blocked_params, &blocked_cert_params);
+  EXPECT_TRUE(blocked_params.block_network_persona_requests);
+  base::test::TestFuture<bool> resumed;
+  service->ResumeNetworkPersonaPrefUpdates(resumed.GetCallback());
+  EXPECT_FALSE(resumed.Get());
+  base::test::TestFuture<bool> released;
+  service->ReleaseNetworkPersonaRequestGate(released.GetCallback());
+  EXPECT_FALSE(released.Get());
+  EXPECT_EQ(helium_persona::PersonaResolutionStatus::kPersonaUnavailable,
+            persona_service->ResolveActivePersona().status);
+
+  base::test::TestFuture<base::DictValue> repaired;
+  persona_service->SetActivePersona(id, repaired.GetCallback());
+  ASSERT_TRUE(repaired.Take().FindBool("ok").value_or(false));
+  network::mojom::NetworkContextParams repaired_params;
+  cert_verifier::mojom::CertVerifierCreationParams repaired_cert_params;
+  service->ConfigureNetworkContextParams(false, base::FilePath(),
+                                         &repaired_params, &repaired_cert_params);
+  EXPECT_FALSE(repaired_params.block_network_persona_requests);
+  EXPECT_TRUE(repaired_params.network_persona_config);
+}
