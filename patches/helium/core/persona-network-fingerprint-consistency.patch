+base::DictValue MakeNetworkPresetUpgrade(const base::DictValue& original,
+                                          bool reviewed) {
+  base::DictValue candidate = original.Clone();
+  if (!NeedsNetworkPresetUpgrade(original) ||
+      (original.FindString("id") &&
+       *original.FindString("id") == kDefaultPersonaId)) {
+    return candidate;
+  }
+  bool untouched = false;
+  const auto* source_id = original.FindString("sourcePresetId");
+  if (source_id && !source_id->empty()) {
+    for (const auto& value : MakePresetList()) {
+      auto legacy = value.GetDict().Clone();
+      if (*legacy.FindString("id") != *source_id) {
+        continue;
+      }
+      legacy.SetByDottedPath(
+          "uaCh.brands", base::ListValue()
+              .Append(base::DictValue().Set("brand", "Chromium")
+                                      .Set("version", "149"))
+              .Append(base::DictValue().Set("brand", "Not/A)Brand")
+                                      .Set("version", "24")));
+      if (*legacy.FindString("platform") == "Linux") {
+        legacy.SetByDottedPath("uaCh.platformVersion", "6.8.0");
+      }
+      untouched = true;
+      for (auto path : {"platform", "userAgent", "uaCh"}) {
