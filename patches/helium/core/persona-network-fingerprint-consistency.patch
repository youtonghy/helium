+bool ArePersonaIdentityTemplatesCompatible(
+    const PersonaIdentityTemplate& current,
+    const PersonaIdentityTemplate& candidate) {
+  // The catalog does not model alternate GPU/font/device packs. A rotation
+  // must retain the device's OS and CPU cohort; only browser identity may vary.
+  return current.os == candidate.os &&
+         current.architecture == candidate.architecture &&
+         current.bitness == candidate.bitness &&
+         current.navigator_platform == candidate.navigator_platform &&
+         current.ua_ch_platform == candidate.ua_ch_platform &&
+         current.ua_ch_mobile == candidate.ua_ch_mobile &&
+         current.ua_ch_wow64 == candidate.ua_ch_wow64 &&
+         current.chrome_major == candidate.chrome_major &&
+         PersonaIdentityHasNetworkVariants(candidate);
+}
+
+std::vector<uint32_t> GetCompatiblePersonaIdentityTemplateIds(
+    const PersonaIdentityTemplate& current) {
+  std::vector<uint32_t> ids;
+  for (const auto& candidate : GetIdentityTemplates()) {
+    if (ArePersonaIdentityTemplatesCompatible(current, candidate)) {
+      ids.push_back(candidate.id);
+    }
+  }
+  return ids;
+}
 
