+TEST(NetworkPersonaTemplateTest, TlsExtensionSeedIsGenerationScoped) {
+  NetworkPersonaConfig config;
+  config.template_id = kChromium149DefaultTemplateId;
+  config.generation = 7;
+  config.deterministic_seed.fill(0x42);
+
+  const auto first = DeriveNetworkPersonaTlsExtensionSeed(config);
+  EXPECT_EQ(first, DeriveNetworkPersonaTlsExtensionSeed(config));
+  ++config.generation;
+  EXPECT_NE(first, DeriveNetworkPersonaTlsExtensionSeed(config));
+}
