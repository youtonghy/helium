+std::span<const uint16_t> GetNetworkPersonaTlsVerifyAlgorithmPrefs(
+    TlsSignatureProfile profile) {
+  if (profile == TlsSignatureProfile::kChromium149Mldsa) {
+    return kChromium149MldsaVerifyPrefs;
+  }
+  return kChromium149DefaultVerifyPrefs;
+}
+
+std::array<uint8_t, 32> DeriveNetworkPersonaTlsExtensionSeed(
+    const NetworkPersonaConfig& config) {
+  constexpr std::string_view kDomain = "nitrous-tls-extension-order";
+  std::vector<uint8_t> input(config.deterministic_seed.begin(),
+                             config.deterministic_seed.end());
+  input.insert(input.end(), kDomain.begin(), kDomain.end());
+  for (int shift = 56; shift >= 0; shift -= 8) {
+    input.push_back(static_cast<uint8_t>(config.generation >> shift));
+  }
+  return crypto::hash::Sha256(input);
+}
