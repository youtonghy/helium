+TEST_F(NetworkContextTest, UpdateNetworkPersonaInstallsNetOwnedConfig) {
+  std::unique_ptr<NetworkContext> network_context =
+      CreateContextWithParams(CreateNetworkContextParamsForTesting());
+
+  auto config = mojom::NetworkPersonaConfig::New();
+  config->generation = 7;
+  config->template_id = 0;
+  config->deterministic_seed.assign(32, 0x5a);
+  base::test::TestFuture<bool> accepted;
+  network_context->UpdateNetworkPersona(std::move(config),
+                                        accepted.GetCallback());
+  ASSERT_TRUE(accepted.Get());
+
+  net::HttpNetworkSession* session = network_context->url_request_context()
+                                         ->http_transaction_factory()
+                                         ->GetSession();
+  ASSERT_TRUE(session->params().network_persona_config);
+  EXPECT_EQ(7u, session->params().network_persona_config->generation);
+  EXPECT_EQ(0u, session->params().network_persona_config->template_id);
+  EXPECT_EQ(0x5a,
+            session->params().network_persona_config->deterministic_seed[0]);
+
+  auto unknown_template = mojom::NetworkPersonaConfig::New();
+  unknown_template->generation = 8;
+  unknown_template->template_id = 14901;
+  unknown_template->deterministic_seed.assign(32, 0xff);
+  base::test::TestFuture<bool> unknown_template_rejected;
+  network_context->UpdateNetworkPersona(
+      std::move(unknown_template), unknown_template_rejected.GetCallback());
+  EXPECT_FALSE(unknown_template_rejected.Get());
+  EXPECT_EQ(7u, session->params().network_persona_config->generation);
+
+  auto invalid_seed = mojom::NetworkPersonaConfig::New();
+  invalid_seed->generation = 9;
+  invalid_seed->template_id = 0;
+  invalid_seed->deterministic_seed.assign(31, 0xff);
+  base::test::TestFuture<bool> invalid_seed_rejected;
+  network_context->UpdateNetworkPersona(std::move(invalid_seed),
+                                        invalid_seed_rejected.GetCallback());
+  EXPECT_FALSE(invalid_seed_rejected.Get());
+  EXPECT_EQ(7u, session->params().network_persona_config->generation);
+}
