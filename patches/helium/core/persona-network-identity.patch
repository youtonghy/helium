+void HttpNetworkSession::ApplyNetworkPersonaConfig(
+    std::optional<NetworkPersonaConfig> config) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (params_.network_persona_config == config) {
+    return;
+  }
+
+  quic_session_pool_.AbortAllSessionAttempts();
+  CloseAllConnections(ERR_ABORTED, "Network persona generation changed");
+  ClearSSLSessionCache();
+  quic_session_pool_.ClearCachedStatesInCryptoConfig(
+      base::RepeatingCallback<bool(const GURL&)>());
+  params_.network_persona_config = std::move(config);
+}
