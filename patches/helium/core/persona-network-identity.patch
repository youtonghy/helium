+void NetworkContext::UpdateNetworkPersona(
+    mojom::NetworkPersonaConfigPtr config,
+    UpdateNetworkPersonaCallback callback) {
+  if (!config) {
+    std::move(callback).Run(false);
+    return;
+  }
+
+  std::optional<net::NetworkPersonaConfig> net_config =
+      ToNetNetworkPersonaConfig(*config);
+  if (!net_config) {
+    std::move(callback).Run(false);
+    return;
+  }
+
+  net::HttpNetworkSession* http_session =
+      url_request_context_->http_transaction_factory()->GetSession();
+  DCHECK(http_session);
+  if (http_session->params().network_persona_config == net_config) {
+    std::move(callback).Run(true);
+    return;
+  }
+
+  http_session->ApplyNetworkPersonaConfig(std::move(net_config));
+  std::move(callback).Run(true);
+}
