+  PersonaSpeechClient client;
+  client.persona.enabled = true;
+  // An old flag cannot claim an implementation of a portable voice backend.
+  client.persona.allow_speech_synthesis = true;
+  frame_test_helpers::WebViewHelper helper;
+  helper.Initialize(&client);
+  auto* window = helper.LocalMainFrame()->GetFrame()->DomWindow();
+  int binding_requests = 0;
+  window->GetBrowserInterfaceBroker().SetBinderForTesting(
+      mojom::blink::SpeechSynthesis::Name_,
+      BindRepeating([](int* count, mojo::ScopedMessagePipeHandle) { ++*count; },
+                    Unretained(&binding_requests)));
