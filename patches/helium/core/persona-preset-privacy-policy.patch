+class PortableFontCache {
+ public:
+  sk_sp<SkTypeface> Get(size_t index) {
+    base::AutoLock lock(lock_);
+    if (!faces_[index]) {
+      const auto& face = kPortableFaces[index];
+      auto& data = resources_[face.resource_id];
+      if (!data) {
+        base::RefCountedMemory* resource =
+            Platform::Current()->GetDataResourceBytes(face.resource_id);
+        // A broken installation must never silently reveal system fonts.
+        CHECK(resource && resource->size()) << "Missing Persona font resource";
+        data = SkData::MakeWithCopy(resource->data(), resource->size());
