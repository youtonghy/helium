+  EXPECT_TRUE(synthesis->getVoices().empty());
+  synthesis->OnSetVoiceList(HostVoices());
+  EXPECT_TRUE(synthesis->getVoices().empty());
+  synthesis->pause();
+  synthesis->resume();
+  synthesis->cancel();
+  test::RunPendingTasks();
+  EXPECT_EQ(0, binding_requests);
+  EXPECT_FALSE(synthesis->pending());
+  EXPECT_FALSE(synthesis->speaking());
+  EXPECT_FALSE(synthesis->paused());
+  helper.Reset();
