+TEST_F(PersonaServiceTest,
+       UpgradeCandidateIsReadOnlyAndBacksUpCustomSettingsOnce) {
+  const auto created = CreateConfiguredProfile("Renamed custom profile");
+  const std::string id = *created.FindString("personaId");
+  auto state = prefs_.GetDict(kPersonaStatePref).Clone();
+  auto* records = state.FindList("personas");
+  base::DictValue legacy;
+  for (auto& value : *records) {
+    auto& profile = value.GetDict();
+    if (*profile.FindString("id") != id) {
+      continue;
+    }
+    profile.Remove("protectionVersion");
+    profile.Remove("presetRevision");
+    profile.Remove("sourcePresetId");
+    profile.Set("customValue", "preserved");
+    profile.SetByDottedPath("screen.width", 12345);
+    profile.SetByDottedPath("advanced.allowSpeechSynthesis", true);
+    profile.SetByDottedPath("fonts.id", "legacy-fonts");
+    profile.SetByDottedPath("fonts.families",
+                            base::ListValue().Append("Arial"));
+    profile.SetByDottedPath("fonts.aliases",
+                            base::ListValue().Append("sans-serif=Arial"));
+    profile.SetByDottedPath(
+        "advanced.speechVoices",
+        base::ListValue().Append(base::DictValue()
+                                     .Set("name", "Legacy Voice")
+                                     .Set("lang", "en-US")));
+    legacy = profile.Clone();
+  }
+  prefs_.SetDict(kPersonaStatePref, state.Clone());
+  auto resolved = service_->ResolvePersonaById(id);
+  service_->GetPersonaState();
+  service_->ResolvePersonaById(id);
+  EXPECT_EQ(state, prefs_.GetDict(kPersonaStatePref));
+  ASSERT_TRUE(resolved.FindDict("upgradeCandidate"));
+  auto candidate = resolved.FindDict("upgradeCandidate")->Clone();
+  EXPECT_TRUE(candidate.FindString("sourcePresetId")->empty());
+  EXPECT_EQ("preserved", *candidate.FindString("customValue"));
+  EXPECT_EQ(12345, candidate.FindDict("screen")->FindInt("width"));
+  EXPECT_EQ("unset", *candidate.FindDict("network")->FindString("routeMode"));
+  EXPECT_FALSE(
+      candidate.FindDict("advanced")->FindBool("allowSpeechSynthesis").value());
+  EXPECT_EQ(*legacy.FindDict("advanced")->FindList("speechVoices"),
+            *candidate.FindDict("advanced")->FindList("speechVoices"));
+  ASSERT_TRUE(service_->SavePersona(candidate).FindBool("ok").value());
+  auto saved = service_->ResolvePersonaById(id);
+  EXPECT_FALSE(saved.FindDict("upgradeCandidate"));
+  EXPECT_EQ(legacy,
+            *saved.FindDict("requested")->FindDict("legacyProtectionSettings"));
+  ASSERT_TRUE(service_->SavePersona(saved.FindDict("requested")->Clone())
+                  .FindBool("ok")
+                  .value());
+  EXPECT_EQ(legacy, *service_->ResolvePersonaById(id)
+                         .FindDict("requested")
+                         ->FindDict("legacyProtectionSettings"));
+}
