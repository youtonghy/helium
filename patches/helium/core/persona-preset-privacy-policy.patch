+base::DictValue PersonaService::GetActivationErrors(
+    const base::DictValue& persona) const {
+  base::DictValue errors = GetPersonaFieldErrors(persona);
+  const std::string* id = persona.FindString("id");
+  if (id && *id == kDefaultPersonaId) {
+    AddNetworkRouteFieldError(persona, &errors);
+    return errors;
+  }
+  if (persona.FindInt("protectionVersion") != kPersonaProtectionVersion) {
+    errors.Set("protectionVersion", "upgrade_required");
+  }
+  const std::string* mode = FindNestedString(persona, "network", "routeMode");
+  if (!mode || (*mode != "proxy" && *mode != "direct")) {
+    errors.Set("network.routeMode", "selection_required");
+  }
+  AddNetworkRouteFieldError(persona, &errors);
+  return errors;
+}
