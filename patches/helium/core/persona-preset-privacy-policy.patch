+      SkFontArguments args;
+      args.setCollectionIndex(face.collection_index);
+      faces_[index] = SkTypeface_Make_Fontations(data, args);
+      CHECK(faces_[index]) << "Invalid Persona font resource";
+    }
+    return faces_[index];
+  }
