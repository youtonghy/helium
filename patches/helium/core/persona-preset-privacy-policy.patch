+void PersonaService::InheritNetworkRoute(base::DictValue* persona) const {
+  std::string route_id;
+  if (identity_rotation_delegate_) {
+    route_id = identity_rotation_delegate_->GetActiveNetworkRouteId();
+    if (!identity_rotation_delegate_->ValidateNetworkRoute(route_id).empty()) {
+      route_id.clear();
+    }
+  }
+  persona->SetByDottedPath("network.routeId", route_id);
+  persona->SetByDottedPath("network.routeMode",
+                           route_id.empty() ? "unset" : "proxy");
+}
