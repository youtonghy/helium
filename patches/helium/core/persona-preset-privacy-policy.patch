+TEST_F(PersonaServiceTest, LegacyPresetIsRecognizedByIdentityAfterRename) {
+  auto created = CreateConfiguredProfile("Different name");
+  const std::string id = *created.FindString("personaId");
+  auto state = prefs_.GetDict(kPersonaStatePref).Clone();
+  for (auto& value : *state.FindList("personas")) {
+    if (*value.GetDict().FindString("id") == id) {
+      value.GetDict().Remove("protectionVersion");
+      value.GetDict().Remove("sourcePresetId");
+    }
+  }
+  state.Set("activePersonaId", id);
+  prefs_.SetDict(kPersonaStatePref, state.Clone());
+  EXPECT_EQ(PersonaResolutionStatus::kPersonaUnavailable,
+            service_->ResolveActivePersona().status);
+  const auto response = service_->ResolvePersonaById(id);
+  ASSERT_TRUE(response.FindDict("upgradeCandidate"));
+  EXPECT_EQ(
+      "us-west-macos",
+      *response.FindDict("upgradeCandidate")->FindString("sourcePresetId"));
+  EXPECT_EQ(state, prefs_.GetDict(kPersonaStatePref));
+  EXPECT_FALSE(ActivatePersona(service_.get(), id).FindBool("ok").value());
+}
