+TEST_F(MediaValuesTest, PersonaMediaPreferencesIgnoreHostAndCacheConsistently) {
+  class PersonaClient : public frame_test_helpers::TestWebFrameClient {
+   public:
+    const HeliumPersonaSnapshot& GetHeliumPersonaSnapshot() const override {
+      return persona;
+    }
+    HeliumPersonaSnapshot persona;
+  } client;
+  client.persona.enabled = true;
+  client.persona.color_gamut = "p3";
+  client.persona.dynamic_range = "high";
+  client.persona.prefers_reduced_motion = true;
+  frame_test_helpers::WebViewHelper helper;
+  helper.Initialize(&client);
+  auto* frame = helper.LocalMainFrame()->GetFrame();
+  auto* dynamic = MakeGarbageCollected<MediaValuesDynamic>(frame);
+  for (bool host_preference : {false, true}) {
+    frame->GetSettings()->SetPrefersReducedMotion(host_preference);
+    auto* cached =
+        MakeGarbageCollected<MediaValuesCached>(*frame->GetDocument());
+    for (MediaValues* values : {static_cast<MediaValues*>(dynamic),
+                                static_cast<MediaValues*>(cached)}) {
+      EXPECT_EQ(ColorSpaceGamut::P3, values->ColorGamut());
+      EXPECT_TRUE(values->DeviceSupportsHDR());
+      EXPECT_TRUE(values->PrefersReducedMotion());
+    }
+  }
+  client.persona.color_gamut = "srgb";
+  client.persona.dynamic_range = "standard";
+  client.persona.prefers_reduced_motion = false;
+  auto* updated =
+      MakeGarbageCollected<MediaValuesCached>(*frame->GetDocument());
+  EXPECT_EQ(ColorSpaceGamut::SRGB, dynamic->ColorGamut());
+  EXPECT_EQ(ColorSpaceGamut::SRGB, updated->ColorGamut());
+  EXPECT_FALSE(updated->DeviceSupportsHDR());
+  EXPECT_FALSE(dynamic->PrefersReducedMotion());
+  helper.Reset();
+}
