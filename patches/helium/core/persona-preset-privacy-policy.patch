+// Preserve custom identity fields. Only the protection policy changes here;
+// saving the reviewed candidate is the transaction that records its backup.
+base::DictValue MakeProtectionUpgrade(const base::DictValue& original) {
+  base::DictValue candidate = original.Clone();
+  std::string source_id;
+  for (const auto& preset : MakePresetList()) {
+    bool matches = true;
+    for (auto path :
+         {"platform", "userAgent", "region.locale", "region.timezone",
+          "region.acceptLanguage", "hardware.hardwareConcurrency",
+          "hardware.deviceMemory", "screen.width", "screen.height",
+          "screen.deviceScaleFactor", "gpu.vendor", "gpu.renderer"}) {
+      const base::Value* saved = FindPersonaPath(original, path);
+      const base::Value* expected = FindPersonaPath(preset.GetDict(), path);
+      if (!saved || !expected || *saved != *expected) {
+        matches = false;
+        break;
+      }
+    }
+    if (matches) {
+      source_id = *preset.GetDict().FindString("id");
+      break;
+    }
+  }
+  candidate.Set("sourcePresetId", source_id);
+  candidate.Set("presetRevision", source_id.empty() ? 0 : 1);
+  candidate.Set("protectionVersion", kPersonaProtectionVersion);
+  const base::DictValue* region = candidate.FindDict("region");
+  const std::string* locale = region ? region->FindString("locale") : nullptr;
+  candidate.Set("fonts", MakePortableFonts(locale ? *locale : "en-US"));
+  candidate.SetByDottedPath("advanced.allowSpeechSynthesis", false);
+  candidate.SetByDottedPath("advanced.fontMetricNoise", true);
+  candidate.SetByDottedPath("advanced.clientRectNoise", true);
+  candidate.SetByDottedPath("screen.colorGamut", "srgb");
+  candidate.SetByDottedPath("screen.dynamicRange", "standard");
+  candidate.SetByDottedPath("screen.reducedMotion", true);
+  // Legacy empty route IDs did not record consent to direct connections.
+  const base::DictValue* network = candidate.FindDict("network");
+  const std::string* route_id =
+      network ? network->FindString("routeId") : nullptr;
+  candidate.SetByDottedPath("network.routeMode",
+                            route_id && !route_id->empty() ? "proxy" : "unset");
+  return candidate;
+}
