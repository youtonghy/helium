+IN_PROC_BROWSER_TEST_F(PersonaFingerprintConsistencyBrowserTest,
+                       PersonaMediaPreferencesAndSpeechAreExplicit) {
+  auto profile = CreateProfile();
+  auto* screen = profile.EnsureDict("screen");
+  screen->Set("colorGamut", "p3");
+  screen->Set("dynamicRange", "high");
+  screen->Set("reducedMotion", false);
+  ASSERT_TRUE(service()->SavePersona(profile).FindBool("ok").value());
+  Activate(*profile.FindString("id"));
+  ASSERT_EQ(true,
+            content::EvalJs(contents(),
+                            content::JsReplace(R"JS(
+    new Promise(resolve => {
+      const frame = document.createElement('iframe');
+      frame.onload = () => resolve(true);
+      frame.src = $1;
+      document.body.append(frame);
+    })
+  )JS",
+                                               embedded_test_server()->GetURL(
+                                                   "b.test", "/title1.html"))));
+  for (auto* frame :
+       {contents()->GetPrimaryMainFrame(),
+        content::ChildFrameAt(contents()->GetPrimaryMainFrame(), 0)}) {
+    ASSERT_TRUE(frame);
+    EXPECT_EQ(true, content::EvalJs(frame, R"JS(
+      (async () => {
+        const media = query => matchMedia(query).matches;
+        if (!media('(color-gamut: p3)') || media('(color-gamut: rec2020)') ||
+            !media('(dynamic-range: high)') || !media('(video-dynamic-range: high)') ||
+            media('(prefers-reduced-motion: reduce)')) return false;
+        if (speechSynthesis.getVoices().length) return false;
+        const errors = await Promise.race([
+          Promise.all([1, 2].map(() => new Promise(resolve => {
+            const utterance = new SpeechSynthesisUtterance('Persona test');
+            utterance.onerror = event => resolve(event.error);
+            utterance.onend = () => resolve('unexpected-end');
+            speechSynthesis.speak(utterance);
+          }))),
+          new Promise(resolve => setTimeout(() => resolve([]), 3000)),
+        ]);
+        return errors.length === 2 && errors.every(error => error === 'not-allowed') &&
+            !speechSynthesis.pending && !speechSynthesis.speaking &&
+            !speechSynthesis.paused && !speechSynthesis.getVoices().length;
+      })()
+    )JS"));
+  }
+}
+
 }  // namespace helium_persona
