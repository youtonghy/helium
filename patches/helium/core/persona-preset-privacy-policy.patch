+inline constexpr std::string_view kPersonaPortableFontPackId = "portable-v1";
+inline constexpr auto kPersonaPortableFontFamilies =
+    std::to_array<std::string_view>(
+        {"Noto Sans", "Noto Serif", "Noto Sans Mono", "Noto Sans Devanagari",
+         "Noto Sans Symbols 2", "Noto Emoji", "Noto Sans CJK JP",
+         "Noto Sans CJK KR", "Noto Sans CJK SC", "Noto Sans CJK TC",
+         "Noto Sans CJK HK"});
+
+inline bool IsPersonaPortableFontFamily(std::string_view family) {
+  return std::ranges::any_of(kPersonaPortableFontFamilies, [family](auto item) {
+    return base::EqualsCaseInsensitiveASCII(item, family);
+  });
+}
+
+inline std::string PersonaCjkFontFamily(std::string_view locale) {
+  const std::string tag = base::ToLowerASCII(locale);
+  if (tag.starts_with("ja")) {
+    return "Noto Sans CJK JP";
+  }
+  if (tag.starts_with("ko")) {
+    return "Noto Sans CJK KR";
+  }
+  if (tag.starts_with("zh")) {
+    if (tag.find("hans") != std::string::npos) {
+      return "Noto Sans CJK SC";
+    }
+    if (tag.find("hk") != std::string::npos) {
+      return "Noto Sans CJK HK";
+    }
+    if (tag.find("hant") != std::string::npos ||
+        tag.find("tw") != std::string::npos ||
+        tag.find("mo") != std::string::npos) {
+      return "Noto Sans CJK TC";
+    }
+  }
+  return "Noto Sans CJK SC";
+}
+
+inline std::vector<std::string> PersonaPortableFontFamiliesForLocale(
+    std::string_view locale) {
+  std::vector<std::string> families;
+  for (size_t i = 0; i < 6; ++i) {
+    families.emplace_back(kPersonaPortableFontFamilies[i]);
+  }
+  families.push_back(PersonaCjkFontFamily(locale));
+  return families;
+}
