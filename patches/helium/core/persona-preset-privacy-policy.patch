+  service_->ClonePresetAndActivate("us-west-macos", result.GetCallback());
+  ASSERT_EQ(1u, route->apply_calls.size());
+  EXPECT_EQ("route-current", route->apply_calls.front().route_id);
+  route->CompleteNextApply(true);
+  EXPECT_TRUE(result.Take().FindBool("ok").value());
+  EXPECT_EQ("route-current", route->active_route_id);
+}
