+TEST_F(PersonaServiceTest, NewProfilesAndClonesInheritValidProxy) {
+  auto delegate = std::make_unique<FakeIdentityRotationDelegate>();
+  auto* route = delegate.get();
+  route->active_route_id = "route-current";
+  service_->SetIdentityRotationDelegateForTesting(std::move(delegate));
+  for (const auto& response :
+       {service_->CreatePersonaProfile("Inherited"),
+        service_->ClonePresetIntoProfile("hk-windows")}) {
+    const auto* profile =
+        FindPersona(response.FindDict("state")->FindList("personas"),
+                    *response.FindString("personaId"));
+    ASSERT_TRUE(profile);
