+IN_PROC_BROWSER_TEST_F(PersonaWebGpuAuditBrowserTest,
+                       AuditObservesWebGpuIdentityLimitsAndDevice) {
+  PersonaService* service =
+      PersonaServiceFactory::GetForProfile(browser()->profile());
+  ASSERT_TRUE(service);
+  base::DictValue response = service->CreatePersonaProfile("WebGPU audit");
+  const std::string* persona_id = response.FindString("personaId");
+  ASSERT_TRUE(persona_id);
+  base::test::TestFuture<base::DictValue> activation;
+  service->SetActivePersona(*persona_id, activation.GetCallback());
+  ASSERT_TRUE(activation.Take().FindBool("ok").value_or(false));
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  content::WebContents* web_contents =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  const content::EvalJsResult result = content::EvalJs(web_contents, R"JS(
+    (async () => {
+      if (!navigator.gpu) return {supported: false};
+      const adapter = await navigator.gpu.requestAdapter();
+      if (!adapter) return {supported: false};
+      const device = await adapter.requestDevice();
+      window.personaWebGpuDevice = device;
+      return {
+        supported: true,
+        vendor: adapter.info.vendor,
+        architecture: adapter.info.architecture,
+        device: adapter.info.device,
+        description: adapter.info.description,
+      };
+    })()
+  )JS");
+  ASSERT_TRUE(result.is_ok()) << result.ExtractError();
+  const base::DictValue& observed = result.ExtractDict();
+  if (!observed.FindBool("supported").value_or(false)) {
+    GTEST_SKIP() << "WebGPU is unavailable on this test host";
+  }
+  const blink::HeliumPersonaSnapshot expected = service->GetActiveSnapshot();
+  EXPECT_EQ(expected.gpu_vendor, *observed.FindString("vendor"));
+  EXPECT_EQ(expected.webgpu_architecture,
+            *observed.FindString("architecture"));
+  EXPECT_EQ(expected.webgpu_device, *observed.FindString("device"));
+  EXPECT_EQ(expected.webgpu_description,
+            *observed.FindString("description"));
+
+  base::test::TestFuture<base::DictValue> audit_future;
+  service->GetPersonaAudit(audit_future.GetCallback());
+  const base::DictValue audit = audit_future.Take();
+  EXPECT_TRUE(audit.FindBool("ok").value_or(false));
+  EXPECT_EQ("runtime_identity_verified",
+            *audit.FindDict("surfaces")->FindString("webGpu"));
+  const base::DictValue* evidence =
+      audit.FindDict("runtimeEvidence")->FindDict("webGpu");
+  ASSERT_TRUE(evidence);
+  const int observed_contexts =
+      evidence->FindInt("observedContexts").value_or(0);
+  EXPECT_GE(observed_contexts, 1);
+  EXPECT_EQ(observed_contexts,
+            evidence->FindInt("identityMatched").value_or(0));
+  EXPECT_EQ(0, evidence->FindInt("identityMismatched").value_or(-1));
+  EXPECT_EQ(observed_contexts,
+            evidence->FindInt("featureSetsObserved").value_or(0));
+  EXPECT_EQ(observed_contexts,
+            evidence->FindInt("limitSetsObserved").value_or(0));
+  EXPECT_EQ(observed_contexts * 36,
+            evidence->FindInt("limitValuesObserved").value_or(0));
+  EXPECT_EQ(0, evidence->FindInt("limitSetsIncomplete").value_or(-1));
+  EXPECT_GE(evidence->FindInt("devicesObserved").value_or(0), 1);
+}
