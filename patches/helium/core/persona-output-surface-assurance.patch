+base::DictValue EvaluateWebGLReadbackPolicy(
+    content::WebContents* web_contents) {
+  const content::EvalJsResult result = content::EvalJs(web_contents, R"JS(
+    (() => {
+      const canvas = document.createElement('canvas');
+      canvas.width = 2;
+      canvas.height = 2;
+      const gl = canvas.getContext('webgl2');
+      if (!gl) return {supported: false};
+
+      gl.clearColor(0.2, 0.4, 0.6, 1.0);
+      gl.clear(gl.COLOR_BUFFER_BIT);
+      const rgba8 = new Uint8Array(4);
+      gl.readPixels(0, 0, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, rgba8);
+      const rgba8Allowed = gl.getError() === gl.NO_ERROR;
+
+      gl.pixelStorei(gl.PACK_ROW_LENGTH, 2);
+      gl.readPixels(0, 0, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE,
+                    new Uint8Array(8));
+      const customPackRejected = gl.getError() === gl.INVALID_OPERATION;
+      gl.pixelStorei(gl.PACK_ROW_LENGTH, 0);
+
+      const packBuffer = gl.createBuffer();
+      gl.bindBuffer(gl.PIXEL_PACK_BUFFER, packBuffer);
+      gl.bufferData(gl.PIXEL_PACK_BUFFER, 4, gl.STREAM_READ);
+      gl.readPixels(0, 0, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, 0);
+      const packBufferRejected = gl.getError() === gl.INVALID_OPERATION;
+      gl.bindBuffer(gl.PIXEL_PACK_BUFFER, null);
+      gl.deleteBuffer(packBuffer);
+      return {
+        supported: true,
+        rgba8Allowed,
+        customPackRejected,
+        packBufferRejected,
+      };
+    })()
+  )JS");
+  CHECK(result.is_ok()) << result.ExtractError();
+  return result.ExtractDict().Clone();
+}
