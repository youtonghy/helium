+void PersonaIndicatorMenuModel::RefreshActiveSiteAndReload() {
+  auto* service = GetPersonaService();
+  const std::optional<std::string> site_origin = GetActiveSiteOrigin();
+  if (!service || !site_origin ||
+      service->ResolveActivePersona().status !=
+          helium_persona::PersonaResolutionStatus::kPersonaReady) {
+    return;
+  }
+
+  content::WebContents* web_contents =
+      browser_->tab_strip_model()->GetActiveWebContents();
+  if (!web_contents) {
+    return;
+  }
+  service->RefreshFingerprint(
+      helium_persona::FingerprintRefreshScope::kSite, *site_origin);
+  web_contents->GetController().Reload(content::ReloadType::NORMAL, true);
+}
