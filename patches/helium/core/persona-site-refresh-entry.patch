+class PersonaSiteRefreshBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+ protected:
+  PersonaService* CreateAndActivatePersona() {
+    auto* service =
+        PersonaServiceFactory::GetForProfile(browser()->profile());
+    CHECK(service);
+    base::DictValue response = service->CreatePersonaProfile("Site refresh");
+    const std::string* persona_id = response.FindString("personaId");
+    CHECK(persona_id);
+    CHECK(service->SetActivePersona(*persona_id)
+              .FindBool("ok")
+              .value_or(false));
+    return service;
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(PersonaSiteRefreshBrowserTest,
+                       RefreshesOnlyTheActiveSiteAndReloadsItsTab) {
+  PersonaService* service = CreateAndActivatePersona();
+  const GURL test_url = embedded_test_server()->GetURL("/title1.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), test_url));
+
+  const blink::HeliumPersonaSnapshot before = service->GetActiveSnapshot();
+  ASSERT_TRUE(before.fingerprint_rotation_site_epochs.empty());
+
+  PersonaIndicatorMenuModel model(browser());
+  const auto command_index =
+      model.GetIndexOfCommandId(kCommandRefreshSiteFingerprints);
+  ASSERT_TRUE(command_index);
+  EXPECT_TRUE(model.IsEnabledAt(*command_index));
+
+  content::WebContents* web_contents =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  content::TestNavigationObserver reload_observer(web_contents, 1);
+  model.ActivatedAt(*command_index);
+  reload_observer.Wait();
+
+  const blink::HeliumPersonaSnapshot after = service->GetActiveSnapshot();
+  EXPECT_EQ(before.fingerprint_generation, after.fingerprint_generation);
+  ASSERT_EQ(1u, after.fingerprint_rotation_site_epochs.size());
+  EXPECT_EQ(url::Origin::Create(test_url).Serialize(),
+            after.fingerprint_rotation_site_epochs.front().scope_key);
+  EXPECT_EQ(1u,
+            after.fingerprint_rotation_site_epochs.front().generation);
+}
+
+IN_PROC_BROWSER_TEST_F(PersonaSiteRefreshBrowserTest,
+                       DisablesSiteRefreshForNonHttpPages) {
+  CreateAndActivatePersona();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+
+  PersonaIndicatorMenuModel model(browser());
+  const auto command_index =
+      model.GetIndexOfCommandId(kCommandRefreshSiteFingerprints);
+  ASSERT_TRUE(command_index);
+  EXPECT_FALSE(model.IsEnabledAt(*command_index));
+}
+
