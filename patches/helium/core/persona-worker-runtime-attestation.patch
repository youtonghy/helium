+class PersonaWorkerAuditBrowserTest : public InProcessBrowserTest {
+ public:
+  void SetUpOnMainThread() override {
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&HandleWorkerAuditRequest));
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(PersonaWorkerAuditBrowserTest,
+                       AuditVerifiesAllWorkerTypes) {
+  PersonaService* service =
+      PersonaServiceFactory::GetForProfile(browser()->profile());
+  ASSERT_TRUE(service);
+  base::DictValue response = service->CreatePersonaProfile("Worker audit");
+  const std::string* persona_id = response.FindString("personaId");
+  ASSERT_TRUE(persona_id);
+  base::test::TestFuture<base::DictValue> activation;
+  service->SetActivePersona(*persona_id, activation.GetCallback());
+  ASSERT_TRUE(activation.Take().FindBool("ok").value_or(false));
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  content::WebContents* web_contents =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_EQ(true, content::EvalJs(web_contents, R"JS(
+    (async () => {
+      window.personaDedicatedWorker =
+          new Worker('/persona-audit-dedicated-worker.js');
+      await new Promise((resolve, reject) => {
+        personaDedicatedWorker.onmessage = () => resolve();
+        personaDedicatedWorker.onerror = reject;
+        personaDedicatedWorker.postMessage('start');
+      });
+
+      window.personaSharedWorker =
+          new SharedWorker('/persona-audit-shared-worker.js');
+      await new Promise((resolve, reject) => {
+        personaSharedWorker.port.onmessage = () => resolve();
+        personaSharedWorker.onerror = reject;
+        personaSharedWorker.port.start();
+        personaSharedWorker.port.postMessage('start');
+      });
+
+      await navigator.serviceWorker.register(
+          '/persona-audit-service-worker.js');
+      const registration = await navigator.serviceWorker.ready;
+      const channel = new MessageChannel();
+      await new Promise((resolve, reject) => {
+        channel.port1.onmessage = () => resolve();
+        channel.port1.onmessageerror = reject;
+        registration.active.postMessage('hold', [channel.port2]);
+      });
+      return true;
+    })()
+  )JS"));
+
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    const auto probes = browser()
+                            ->profile()
+                            ->GetDefaultStoragePartition()
+                            ->GetHeliumPersonaWorkerSurfaceProbes();
+    std::array<bool, 3> reported_types = {};
+    for (const auto& worker_probe : probes) {
+      if (!worker_probe || !worker_probe->probe) {
+        continue;
+      }
+      switch (worker_probe->type) {
+        case blink::mojom::HeliumPersonaWorkerType::kDedicated:
+          reported_types[0] = true;
+          break;
+        case blink::mojom::HeliumPersonaWorkerType::kShared:
+          reported_types[1] = true;
+          break;
+        case blink::mojom::HeliumPersonaWorkerType::kService:
+          reported_types[2] = true;
+          break;
+      }
+    }
+    return reported_types[0] && reported_types[1] && reported_types[2];
+  }));
+
+  base::test::TestFuture<base::DictValue> audit_future;
+  service->GetPersonaAudit(audit_future.GetCallback());
+  const base::DictValue audit = audit_future.Take();
+  EXPECT_TRUE(audit.FindBool("ok").value_or(false));
+  EXPECT_EQ("runtime_snapshot_verified",
+            *audit.FindDict("surfaces")->FindString("workers"));
+
+  const base::DictValue* workers =
+      audit.FindDict("runtimeEvidence")->FindDict("workers");
+  ASSERT_TRUE(workers);
+  const int total = workers->FindInt("total").value_or(0);
+  EXPECT_GE(total, 3);
+  EXPECT_EQ(total, workers->FindInt("matched").value_or(0));
+  EXPECT_EQ(0, workers->FindInt("mismatched").value_or(-1));
+  EXPECT_EQ(0, workers->FindInt("unreported").value_or(-1));
+  const base::DictValue* by_type = workers->FindDict("byType");
+  ASSERT_TRUE(by_type);
+  EXPECT_GE(by_type->FindInt("dedicated").value_or(0), 1);
+  EXPECT_GE(by_type->FindInt("shared").value_or(0), 1);
+  EXPECT_GE(by_type->FindInt("service").value_or(0), 1);
+}
