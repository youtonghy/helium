+void WorkerGlobalScope::ReportHeliumPersonaSurfaceProbe() {
+  if (!GetBrowserInterfaceBroker().is_bound())
+    return;
+
+  mojo::Remote<mojom::blink::HeliumPersonaWorkerSurfaceProbeHost> host;
+  GetBrowserInterfaceBroker().GetInterface(
+      host.BindNewPipeAndPassReceiver());
+  auto probe = mojom::blink::HeliumPersonaSurfaceProbe::New();
+  probe->snapshot = helium_persona_snapshot_;
+  probe->canvas_noise_token_present = CanvasNoiseToken().has_value();
+  probe->audio_noise_token_present = AudioNoiseToken().has_value();
+  probe->hardware_noise_token_present = HardwareNoiseToken().has_value();
+  probe->font_metric_noise_token_present =
+      FontMetricNoiseToken().has_value();
+  probe->client_rect_noise_token_present = false;
+  host->SetSurfaceProbe(std::move(probe));
+}
