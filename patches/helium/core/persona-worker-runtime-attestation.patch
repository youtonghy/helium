+  if (!context)
+    return probes;
+  for (const auto& entry : context->GetLiveVersions()) {
+    ServiceWorkerVersion* version = entry.second;
+    if (version->running_status() == blink::EmbeddedWorkerStatus::kStopped)
+      continue;
+    probes.push_back(
+        version->worker_host()->GetHeliumPersonaWorkerSurfaceProbe());
+  }
+  return probes;
+}
