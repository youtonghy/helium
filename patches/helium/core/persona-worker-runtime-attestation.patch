+std::unique_ptr<net::test_server::HttpResponse> HandleWorkerAuditRequest(
+    const net::test_server::HttpRequest& request) {
+  std::string script;
+  if (request.relative_url == "/persona-audit-dedicated-worker.js") {
+    script = "self.onmessage = () => self.postMessage('ready');";
+  } else if (request.relative_url ==
+             "/persona-audit-shared-worker.js") {
+    script = R"JS(
+      self.onconnect = event => {
+        const port = event.ports[0];
+        port.onmessage = () => port.postMessage('ready');
+        port.start();
+      };
+    )JS";
+  } else if (request.relative_url ==
+             "/persona-audit-service-worker.js") {
+    script = R"JS(
+      self.addEventListener('install', event => {
+        event.waitUntil(self.skipWaiting());
+      });
+      self.addEventListener('activate', event => {
+        event.waitUntil(self.clients.claim());
+      });
+      self.addEventListener('message', event => {
+        if (event.ports[0]) {
+          event.ports[0].postMessage('ready');
+        }
+        event.waitUntil(new Promise(resolve => setTimeout(resolve, 30000)));
+      });
+    )JS";
+  } else {
+    return nullptr;
+  }
+
+  auto response =
+      std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_code(net::HTTP_OK);
+  response->set_content_type("application/javascript");
+  response->set_content(std::move(script));
+  return response;
+}
