+Status ActivateNitrousPersona(Chrome* chrome,
+                              const std::string& persona_id,
+                              const std::string& browser_context_id) {
+  base::DictValue params;
+  params.Set("personaId", persona_id);
+  if (!browser_context_id.empty()) {
+    params.Set("browserContextId", browser_context_id);
+  }
+  base::DictValue command_result;
+  Status status = chrome->Client()->SendCommandAndGetResult(
+      "NitrousPersona.activate", params, &command_result);
+  if (status.IsError()) {
+    return Status(kSessionNotCreated,
+                  "failed to invoke Nitrous Persona activation", status);
+  }
+
+  const base::DictValue* activation = command_result.FindDict("result");
+  if (!activation) {
+    return Status(kSessionNotCreated,
+                  "Nitrous Persona activation returned an invalid response");
+  }
+  const std::string commit_state = activation->FindString("commitState")
+                                       ? *activation->FindString("commitState")
+                                       : "unknown";
+  const std::string restart_result =
+      activation->FindString("restartResult")
+          ? *activation->FindString("restartResult")
+          : "unknown";
+  if (activation->FindBool("ok").value_or(false) &&
+      (commit_state != "committed" || restart_result != "restarted")) {
+    return Status(kSessionNotCreated,
+                  "Nitrous Persona activation returned an inconsistent "
+                  "success outcome");
+  }
+  if (!activation->FindBool("ok").value_or(false)) {
+    std::string error = commit_state == "committed"
+                            ? "Nitrous Persona activation committed but did "
+                              "not become ready"
+                            : "Nitrous Persona activation did not complete";
+    const base::DictValue* field_errors = activation->FindDict("fieldErrors");
+    if (field_errors) {
+      if (const std::string* detail =
+              field_errors->FindString("personaActivation")) {
+        error += ": " + *detail;
+      } else if (const std::string* detail =
+                     field_errors->FindString("personaId")) {
+        error += ": " + *detail;
+      }
+    }
+    error += " (commitState=" + commit_state +
+             ", restartResult=" + restart_result + ")";
+    return Status(kSessionNotCreated, error);
+  }
+  return Status(kOk);
+}
+
