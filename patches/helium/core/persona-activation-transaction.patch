+struct FingerprintSeedState {
+  FingerprintSeedState Clone() const {
+    return {.seed_mode = seed_mode,
+            .fixed_seed = fixed_seed,
+            .rotate_daily = rotate_daily,
+            .profile_salt = profile_salt,
+            .last_changed = last_changed,
+            .last_rotation_day = last_rotation_day,
+            .rotation = rotation.Clone()};
+  }
+
+  std::string seed_mode;
+  std::string fixed_seed;
+  bool rotate_daily = false;
+  std::string profile_salt;
+  std::string last_changed;
+  std::string last_rotation_day;
+  base::DictValue rotation;
+};
+
+FingerprintSeedState ReadFingerprintSeedState(const PrefService& pref_service) {
+  return {
+      .seed_mode = pref_service.GetString(prefs::kFingerprintSeedMode),
+      .fixed_seed = pref_service.GetString(prefs::kFingerprintFixedSeed),
+      .rotate_daily = pref_service.GetBoolean(prefs::kFingerprintRotateDaily),
+      .profile_salt =
+          pref_service.GetString(kPersonaFingerprintProfileSaltPref),
+      .last_changed = pref_service.GetString(prefs::kFingerprintLastChanged),
+      .last_rotation_day =
+          pref_service.GetString(prefs::kFingerprintLastRotationDay),
+      .rotation =
+          pref_service.GetDict(kPersonaFingerprintRotationEpochPref).Clone(),
+  };
+}
+
+FingerprintSeedState PrepareFingerprintSeedState(
+    const PrefService& pref_service) {
+  FingerprintSeedState state = ReadFingerprintSeedState(pref_service);
+  const std::string current_day = GetCurrentLocalDay();
+  const bool replace_fixed_seed =
+      state.seed_mode == kFingerprintSeedModeFixed &&
+      IsValidFingerprintSeed(state.fixed_seed) &&
+      state.profile_salt != state.fixed_seed;
+  const bool replace_random_seed =
+      state.seed_mode != kFingerprintSeedModeFixed &&
+      (state.profile_salt.empty() ||
+       (state.rotate_daily && state.last_rotation_day != current_day));
+  if (replace_fixed_seed || replace_random_seed) {
+    state.profile_salt =
+        replace_fixed_seed ? state.fixed_seed : MakeFingerprintSalt();
+    state.last_changed = MakeIsoTimestamp();
+    state.rotation.Set("global", MakeIsoTimestamp());
+    state.rotation.Set("globalGeneration",
+                       base::NumberToString(NextGeneration(ReadGeneration(
+                           state.rotation.Find("globalGeneration")))));
+  }
+  if (state.seed_mode != kFingerprintSeedModeFixed && state.rotate_daily) {
+    state.last_rotation_day = current_day;
+  }
+  return state;
+}
+
+bool FingerprintSeedStateMatches(const PrefService& pref_service,
+                                 const FingerprintSeedState& expected) {
+  const FingerprintSeedState actual = ReadFingerprintSeedState(pref_service);
+  return actual.seed_mode == expected.seed_mode &&
+         actual.fixed_seed == expected.fixed_seed &&
+         actual.rotate_daily == expected.rotate_daily &&
+         actual.profile_salt == expected.profile_salt &&
+         actual.last_changed == expected.last_changed &&
+         actual.last_rotation_day == expected.last_rotation_day &&
+         actual.rotation == expected.rotation;
+}
+
+void WriteFingerprintSeedState(PrefService& pref_service,
+                               const FingerprintSeedState& state) {
+  if (pref_service.GetString(kPersonaFingerprintProfileSaltPref) !=
+      state.profile_salt) {
+    pref_service.SetString(kPersonaFingerprintProfileSaltPref,
+                           state.profile_salt);
+  }
+  if (pref_service.GetString(prefs::kFingerprintLastChanged) !=
+      state.last_changed) {
+    pref_service.SetString(prefs::kFingerprintLastChanged, state.last_changed);
+  }
+  if (pref_service.GetString(prefs::kFingerprintLastRotationDay) !=
+      state.last_rotation_day) {
+    pref_service.SetString(prefs::kFingerprintLastRotationDay,
+                           state.last_rotation_day);
+  }
+  if (pref_service.GetDict(kPersonaFingerprintRotationEpochPref) !=
+      state.rotation) {
+    pref_service.SetDict(kPersonaFingerprintRotationEpochPref,
+                         state.rotation.Clone());
+  }
+}
