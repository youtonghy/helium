+std::optional<NamedProxyRoute> NitrousProxyService::ReadRoute(
+    const std::string& route_id) const {
+  if (!IsValidRouteId(route_id)) {
+    return std::nullopt;
+  }
+  const base::DictValue* stored =
+      prefs_->GetDict(prefs::kRoutes).FindDict(route_id);
+  if (!stored) {
+    return std::nullopt;
+  }
+  const std::string* name = stored->FindString(kRouteNameKey);
+  const std::string* mode_value = stored->FindString(kRouteModeKey);
+  const std::string* host = stored->FindString(kRouteHostKey);
+  const std::optional<int> port = stored->FindInt(kRoutePortKey);
+  const std::string* username = stored->FindString(kRouteUsernameKey);
+  const std::optional<bool> enforce = stored->FindBool(kRouteEnforceKey);
+  const std::optional<ProxyMode> mode =
+      mode_value ? ParseProxyMode(*mode_value) : std::nullopt;
+  if (!name || !IsValidRouteName(*name) || !mode || !host || !port ||
+      !username || !enforce) {
+    return std::nullopt;
+  }
+
+  NamedProxyRoute route;
+  route.id = route_id;
+  route.name = *name;
+  route.config.mode = *mode;
+  route.config.host = *host;
+  route.config.port = *port;
+  route.config.username = *username;
+  route.config.enforce = *enforce;
+  const auto pending = pending_passwords_.find(route_id);
+  if (pending != pending_passwords_.end()) {
+    route.config.password = pending->second;
+  } else if (const std::string* encrypted =
+                 stored->FindString(kRoutePasswordEncryptedKey)) {
+    route.config.password = DecryptPassword(*encrypted);
+  }
+  if (!route.config.IsValid()) {
+    return std::nullopt;
+  }
+  return route;
+}
