+void ProxyConfigMonitor::Flush(base::OnceCallback<void(bool)> callback) {
+  if (proxy_config_client_set_.empty()) {
+    std::move(callback).Run(true);
+    return;
+  }
+
+  auto barrier = base::BarrierCallback<bool>(
+      proxy_config_client_set_.size(),
+      base::BindOnce(
+          [](base::OnceCallback<void(bool)> callback,
+             const std::vector<bool>& results) {
+            std::move(callback).Run(std::ranges::all_of(
+                results, [](bool result) { return result; }));
+          },
+          std::move(callback)));
+  for (const auto& proxy_config_client : proxy_config_client_set_) {
+    proxy_config_client->FlushProxyConfig(mojo::WrapCallbackWithDropHandler(
+        base::BindOnce(
+            [](base::RepeatingCallback<void(bool)> barrier) {
+              barrier.Run(true);
+            },
+            barrier),
+        base::BindOnce(
+            [](base::RepeatingCallback<void(bool)> barrier) {
+              barrier.Run(false);
+            },
+            barrier)));
+  }
+}
+
+void ProxyConfigMonitor::ApplyConfigOverrideAndFlush(
+    const net::ProxyConfigWithAnnotation& config,
+    base::OnceCallback<void(bool)> callback) {
+  proxy_config_override_ = config;
+  for (const auto& proxy_config_client : proxy_config_client_set_) {
+    proxy_config_client->OnProxyConfigUpdated(config);
+  }
+  Flush(base::BindOnce(
+      [](base::WeakPtr<ProxyConfigMonitor> monitor,
+         base::OnceCallback<void(bool)> callback,
+         bool flushed) { std::move(callback).Run(flushed && monitor); },
+      weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void ProxyConfigMonitor::ClearConfigOverrideAndFlush(
+    const net::ProxyConfigWithAnnotation& expected_config,
+    base::OnceCallback<void(bool)> callback) {
+  // Keep the expected config pinned until the preceding pref update has had a
+  // full Mojo round trip. Sampling before the flush can observe the old pref;
+  // clearing the override before it completes can publish a newer conflicting
+  // update while the transaction still reports success.
+  proxy_config_override_ = expected_config;
+  for (const auto& proxy_config_client : proxy_config_client_set_) {
+    proxy_config_client->OnProxyConfigUpdated(expected_config);
+  }
+  Flush(base::BindOnce(
+      [](base::WeakPtr<ProxyConfigMonitor> monitor,
+         net::ProxyConfigWithAnnotation expected_config,
+         base::OnceCallback<void(bool)> callback, bool flushed) {
+        if (!flushed || !monitor) {
+          std::move(callback).Run(false);
+          return;
+        }
+        net::ProxyConfigWithAnnotation effective_config;
+        const net::ProxyConfigService::ConfigAvailability availability =
+            monitor->proxy_config_service_->GetLatestProxyConfig(
+                &effective_config);
+        if (availability == net::ProxyConfigService::CONFIG_UNSET) {
+          effective_config = net::ProxyConfigWithAnnotation::CreateDirect();
+        }
+        const bool matches =
+            availability != net::ProxyConfigService::CONFIG_PENDING &&
+            effective_config.value().Equals(expected_config.value());
+        if (matches) {
+          monitor->proxy_config_override_.reset();
+        }
+        // A mismatch leaves `expected_config` pinned. The Persona service will
+        // remain degraded instead of publishing an unverified route.
+        std::move(callback).Run(matches);
+      },
+      weak_ptr_factory_.GetWeakPtr(), expected_config, std::move(callback)));
+}
