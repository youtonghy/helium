+  proxy_config_monitor_->ClearConfigOverrideAndFlush(
+      MakeProxyConfigWithAnnotation(config), base::BindOnce(barrier));
+  ApplySocksCredentialsForConfig(config, base::BindOnce(barrier));
+  FlushExpectedSystemProxyConfig(service, /*apply_candidate_override=*/false,
