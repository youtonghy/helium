+void PersonaService::AddNetworkRouteFieldError(const base::DictValue& persona,
+                                               base::DictValue* errors) const {
+  const std::string route_id = GetPersonaNetworkRouteId(persona);
+  if (errors->contains("network.routeId")) {
+    return;
+  }
+  if (!identity_rotation_delegate_) {
+    if (!route_id.empty()) {
+      errors->Set("network.routeId", "unavailable");
+    }
+    return;
+  }
+  const std::string error =
+      identity_rotation_delegate_->ValidateNetworkRoute(route_id);
+  if (!error.empty()) {
+    errors->Set("network.routeId", error);
+  }
+}
