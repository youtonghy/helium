+      prefs_->GetString(kPersonaLastUsedIdPref) ==
+          pending_persona_activation_->persona_id &&
+      FingerprintSeedStateMatches(
+          *prefs_, pending_persona_activation_->candidate_fingerprint_seed) &&
+      (!identity_rotation_delegate_ ||
+       identity_rotation_delegate_->GetActiveNetworkRouteId() ==
+           pending_persona_activation_->candidate_route_id);
+  const bool old_matches =
+      prefs_ &&
+      prefs_->GetDict(kPersonaStatePref) ==
+          pending_persona_activation_->old_state &&
+      prefs_->GetString(kPersonaLastUsedIdPref) ==
+          pending_persona_activation_->old_last_used_persona_id &&
+      FingerprintSeedStateMatches(
+          *prefs_, pending_persona_activation_->old_fingerprint_seed) &&
+      (!identity_rotation_delegate_ ||
