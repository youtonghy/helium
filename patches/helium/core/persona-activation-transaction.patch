+void PersonaService::OnPersonaActivationExecutionContextsRestarted(
+    PersonaExecutionContextRestartResult result) {
+  if (!pending_persona_activation_) {
+    return;
+  }
+  if (result == PersonaExecutionContextRestartResult::kIsolationFailed) {
+    network_identity_degraded_ = true;
+    base::DictValue response =
+        MakeResponse(false, ReadState(),
+                     base::DictValue().Set("personaActivation",
+                                           "executionContextIsolationFailed"));
+    response.Set("restartResult", "isolation_failed");
+    FinishPersonaActivation(std::move(response));
+    return;
+  }
+  if (result ==
+      PersonaExecutionContextRestartResult::kQuiescedAfterDispatchFailure) {
+    network_identity_transition_in_progress_ = true;
+    network_identity_degraded_ = true;
+    identity_rotation_delegate_->SuppressNetworkIdentityPrefUpdates();
+    bool restored = false;
+    if (prefs_->GetDict(kPersonaStatePref) ==
+            pending_persona_activation_->candidate_state &&
+        prefs_->GetString(kPersonaLastUsedIdPref) ==
+            pending_persona_activation_->persona_id &&
+        FingerprintSeedStateMatches(
+            *prefs_, pending_persona_activation_->candidate_fingerprint_seed) &&
+        identity_rotation_delegate_->GetActiveNetworkRouteId() ==
+            pending_persona_activation_->candidate_route_id &&
+        identity_rotation_delegate_->CompareAndSetActiveNetworkRoute(
+            pending_persona_activation_->candidate_route_id,
+            pending_persona_activation_->old_route_id)) {
+      WriteFingerprintSeedState(
+          *prefs_, pending_persona_activation_->old_fingerprint_seed);
+      prefs_->SetString(kPersonaLastUsedIdPref,
+                        pending_persona_activation_->old_last_used_persona_id);
+      WriteState(pending_persona_activation_->old_state.Clone());
+      restored = true;
+    }
+    ResumeNetworkIdentityPrefUpdates(base::BindOnce(
+        &PersonaService::OnPersonaActivationRestartRollbackPrefUpdatesResumed,
+        weak_ptr_factory_.GetWeakPtr(), restored));
+    return;
+  }
+  network_identity_degraded_ = false;
+  base::DictValue response = MakeResponse(true, ReadState());
+  response.Set("restartResult", "restarted");
+  FinishPersonaActivation(std::move(response));
+}
+
+void PersonaService::OnPersonaActivationRestartRollbackPrefUpdatesResumed(
+    bool restored,
+    bool accepted) {
+  if (!pending_persona_activation_) {
+    return;
+  }
+  network_identity_degraded_ = true;
+  const char* error = !accepted   ? "networkRollbackFailed"
+                      : !restored ? "stateChanged"
+                                  : "executionContextRestartFailed";
+  base::DictValue response = MakeResponse(
+      false, ReadState(), base::DictValue().Set("personaActivation", error));
+  response.Set("restartResult", "dispatch_failed");
+  FinishPersonaActivation(std::move(response));
+}
+
+void PersonaService::OnPersonaActivationFailureExecutionContextsRestarted(
+    base::DictValue response,
+    PersonaExecutionContextRestartResult result) {
+  if (result != PersonaExecutionContextRestartResult::kRestarted) {
+    network_identity_degraded_ = true;
+    response.EnsureDict("fieldErrors")
+        ->Set("personaActivation",
+              result == PersonaExecutionContextRestartResult::kIsolationFailed
+                  ? "executionContextIsolationFailed"
+                  : "executionContextRestartFailed");
+  }
+  const char* restart_result = "recovery_dispatch_failed";
+  if (result == PersonaExecutionContextRestartResult::kRestarted) {
+    restart_result = "recovered";
+  } else if (result == PersonaExecutionContextRestartResult::kIsolationFailed) {
+    restart_result = "recovery_isolation_failed";
+  }
+  response.Set("restartResult", restart_result);
+  FinishPersonaActivation(std::move(response));
+}
 
+void PersonaService::FinishPersonaActivation(base::DictValue response) {
