+    identity_rotation_delegate_->ReleaseExecutionContextQuiescence();
   }
-  return MakeResponse(true, std::move(state));
+  pending_persona_activation_.reset();
+  UnblockNetworkIdentityTransition();
+  std::move(callback).Run(std::move(response));
+}
