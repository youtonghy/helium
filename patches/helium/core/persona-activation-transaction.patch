+  void StopWorkers() {
+    if (!profile_) {
+      Complete(false);
+      return;
+    }
+
+    std::vector<content::StoragePartition*> partitions;
+    profile_->ForEachLoadedStoragePartition(
+        [&](content::StoragePartition* partition) {
+          partitions.push_back(partition);
+        });
+    if (partitions.empty()) {
+      ScanProcesses();
+      MaybeScheduleVerification();
+      return;
+    }
+
+    workers_stopping_ = true;
+    base::RepeatingClosure stopped = base::BarrierClosure(
+        partitions.size(), base::BindOnce(&Impl::OnWorkersStopped,
+                                          weak_ptr_factory_.GetWeakPtr()));
