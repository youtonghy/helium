+class PersonaExecutionContextQuiescence::Impl
+    : public content::RenderProcessHostCreationObserver,
+      public content::RenderProcessHostObserver,
+      public content::SpareRenderProcessHostManager::Observer {
+ public:
+  explicit Impl(Profile* profile) : profile_(profile->GetWeakPtr()) {
+    spare_observation_.Observe(&content::SpareRenderProcessHostManager::Get());
+  }
+
+  ~Impl() override { Deactivate(); }
+
+  void Quiesce(base::OnceCallback<void(bool)> callback) {
+    if (!active_ || callback_ || workers_stopping_) {
+      std::move(callback).Run(false);
+      return;
+    }
+    callback_ = std::move(callback);
+    shutdown_failures_.clear();
+    if (!profile_) {
+      Complete(false);
+      return;
+    }
+
+    timeout_.Start(
+        FROM_HERE, kExecutionContextQuiescenceTimeout,
+        base::BindOnce(&Impl::OnTimeout, weak_ptr_factory_.GetWeakPtr()));
+    StopWorkers();
+  }
+
+  void Deactivate() {
+    if (!active_) {
+      return;
+    }
+    active_ = false;
+    timeout_.Stop();
+    callback_.Reset();
+    process_observations_.RemoveAllObservations();
+    spare_observation_.Reset();
+    weak_ptr_factory_.InvalidateWeakPtrs();
+  }
+
+  void OnRenderProcessHostCreated(
+      content::RenderProcessHost* process_host) override {
+    shutdown_failures_.erase(process_host);
+    TrackProcess(process_host, true);
+  }
+
+  void OnSpareRenderProcessHostReady(
+      content::RenderProcessHost* process_host) override {
+    if (process_host->IsSpare()) {
+      if (process_observations_.IsObservingSource(process_host)) {
+        process_observations_.RemoveObservation(process_host);
+      }
+      MaybeScheduleVerification();
+      return;
+    }
+    TrackProcess(process_host, true);
+  }
+
+  void OnSpareRenderProcessHostRemoved(
+      content::RenderProcessHost* process_host) override {
+    if (IsProfileProcess(process_host) && !process_host->IsDeletingSoon() &&
+        process_host->IsInitializedAndNotDead()) {
+      TrackProcess(process_host, false);
+    }
+    MaybeScheduleVerification();
+  }
+
+  void OnRenderProcessHostCreationFailed(
+      content::RenderProcessHost* host,
+      const content::ChildProcessTerminationInfo&) override {
+    OnRenderProcessGenerationStopped(host);
+  }
+
+  void RenderProcessReady(content::RenderProcessHost* host) override {
+    RequestShutdown(host);
+  }
+
+  void RenderProcessExited(
+      content::RenderProcessHost* host,
+      const content::ChildProcessTerminationInfo&) override {
+    OnRenderProcessGenerationStopped(host);
+  }
+
+  void InProcessRendererExiting(content::RenderProcessHost* host) override {
+    OnRenderProcessDestroyed(host);
+  }
+
+  void RenderProcessHostDestroyed(content::RenderProcessHost* host) override {
