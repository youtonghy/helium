+bool NitrousProxyService::StoreRoute(
+    const std::string& route_id,
+    const std::string& name,
+    const ProxyConfig& config,
+    const std::optional<std::string>& password_update,
+    bool allow_active_route) {
+  if (!IsValidRouteId(route_id) || !IsValidRouteName(name) ||
+      !config.IsValid() ||
+      (!allow_active_route &&
+       (GetActiveRouteId() == route_id ||
+        (candidate_route_id_ && *candidate_route_id_ == route_id)))) {
+    return false;
   }
-  if (std::optional<std::string> encrypted =
-          EncryptPassword(*pending_password_)) {
-    prefs_->SetString(prefs::kPasswordEncrypted, *encrypted);
-    pending_password_.reset();
+
+  base::DictValue routes = prefs_->GetDict(prefs::kRoutes).Clone();
+  const base::DictValue* old_route = routes.FindDict(route_id);
+  const std::string* old_encrypted =
+      old_route ? old_route->FindString(kRoutePasswordEncryptedKey) : nullptr;
+  const bool preserves_password =
+      !password_update &&
+      (pending_passwords_.contains(route_id) ||
+       (old_encrypted && !old_encrypted->empty()) ||
+       (old_route &&
+        old_route->FindBool(kRoutePasswordRequiredKey).value_or(false)));
+  if (preserves_password && config.username.empty()) {
+    return false;
+  }
+  base::DictValue route = SerializeRoute(name, config);
+  if (!password_update && old_route) {
+    if (old_encrypted) {
+      route.Set(kRoutePasswordEncryptedKey, *old_encrypted);
+    }
+    if (old_route->FindBool(kRoutePasswordRequiredKey).value_or(false)) {
+      route.Set(kRoutePasswordRequiredKey, true);
+    }
+  } else if (password_update && password_update->empty()) {
+    pending_passwords_.erase(route_id);
+  } else if (password_update) {
+    route.Set(kRoutePasswordRequiredKey, true);
+    if (std::optional<std::string> encrypted =
+            EncryptPassword(*password_update)) {
+      route.Set(kRoutePasswordEncryptedKey, *encrypted);
+      pending_passwords_.erase(route_id);
+    } else {
+      pending_passwords_[route_id] = *password_update;
+    }
   }
+  routes.Set(route_id, std::move(route));
+  prefs_->SetDict(prefs::kRoutes, std::move(routes));
+  return true;
+}
+
+bool NitrousProxyService::IsNativeProxyExternallyControlled() const {
+  return IsProxyConfigurationExternallyControlled(prefs_);
+}
+
+base::DictValue NitrousProxyService::RouteForUi(
+    const NamedProxyRoute& route) const {
+  const base::DictValue* stored =
+      prefs_->GetDict(prefs::kRoutes).FindDict(route.id);
+  const std::string* encrypted =
+      stored ? stored->FindString(kRoutePasswordEncryptedKey) : nullptr;
+  const bool password_required =
+      stored && stored->FindBool(kRoutePasswordRequiredKey).value_or(false);
+  const bool has_password =
+      !route.config.password.empty() || pending_passwords_.contains(route.id) ||
+      password_required || (encrypted && !encrypted->empty());
+  return base::DictValue()
+      .Set("id", route.id)
+      .Set("name", route.name)
+      .Set("mode", ProxyModeToString(route.config.mode))
+      .Set("host", route.config.host)
+      .Set("port", route.config.port)
+      .Set("username", route.config.username)
+      .Set("hasPassword", has_password)
+      .Set("enforce", route.config.enforce)
+      .Set("active", GetActiveRouteId() == route.id)
+      .Set("inUse",
+           GetActiveRouteId() == route.id ||
+               (candidate_route_id_ && *candidate_route_id_ == route.id));
 }
 
