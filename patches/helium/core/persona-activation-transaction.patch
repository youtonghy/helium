+  if (!response.FindString("restartResult")) {
+    response.Set("restartResult", "not_started");
+  }
+  if (response.FindBool("ok").value_or(false) &&
+      pending_persona_activation_->created_persona_id) {
+    response.Set("personaId", *pending_persona_activation_->created_persona_id);
+  }
+  OperationCallback callback = std::move(pending_persona_activation_->callback);
   if (identity_rotation_delegate_) {
