+# Copyright 2026 The Helium Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+# Controls the profile-scoped Nitrous Persona contract. This domain is wired
+# only for trusted browser-target clients.
+experimental domain NitrousPersona
+  # Returns the versioned Persona contract and supported capabilities.
+  command getContract
+    parameters
+      # Profile context to address. Only "default" is currently supported and
+      # selects the last-used original profile.
+      optional string browserContextId
+    returns
+      object result
+
+  # Validates and normalizes a Persona without persisting it.
+  command validate
+    parameters
+      object persona
+      optional string browserContextId
+    returns
+      object result
+
+  # Resolves a saved Persona and reports its effective state when active.
+  command resolve
+    parameters
+      string personaId
+      optional string browserContextId
+    returns
+      object result
+
+  # Returns the requested and effective active Persona plus their differences.
+  command getEffective
+    parameters
+      optional string browserContextId
+    returns
+      object result
+
+  # Returns the current surface-level Persona assurance report.
+  command getAudit
+    parameters
+      optional string browserContextId
+    returns
+      object result
+
+  # Transactionally activates a saved Persona before returning. Inspect
+  # result.commitState and result.restartResult when result.ok is false.
+  command activate
+    parameters
+      string personaId
+      optional string browserContextId
+    returns
+      object result
