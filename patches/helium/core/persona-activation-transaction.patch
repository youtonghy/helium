+ public:
+  NitrousPersonaHandler(protocol::UberDispatcher* dispatcher,
+                        std::string target_id);
+  ~NitrousPersonaHandler() override;
+
+  NitrousPersonaHandler(const NitrousPersonaHandler&) = delete;
+  NitrousPersonaHandler& operator=(const NitrousPersonaHandler&) = delete;
+
+ private:
+  void GetContract(std::optional<protocol::String> browser_context_id,
+                   std::unique_ptr<GetContractCallback> callback) override;
+  void Validate(std::unique_ptr<protocol::DictionaryValue> persona,
+                std::optional<protocol::String> browser_context_id,
+                std::unique_ptr<ValidateCallback> callback) override;
+  void Resolve(const protocol::String& persona_id,
+               std::optional<protocol::String> browser_context_id,
+               std::unique_ptr<ResolveCallback> callback) override;
+  void GetEffective(std::optional<protocol::String> browser_context_id,
+                    std::unique_ptr<GetEffectiveCallback> callback) override;
+  void GetAudit(std::optional<protocol::String> browser_context_id,
+                std::unique_ptr<GetAuditCallback> callback) override;
+  void Activate(const protocol::String& persona_id,
+                std::optional<protocol::String> browser_context_id,
+                std::unique_ptr<ActivateCallback> callback) override;
+
+  Profile* GetProfile(
+      const std::optional<protocol::String>& browser_context_id) const;
+  void OnActivated(std::unique_ptr<ActivateCallback> callback,
+                   base::DictValue result);
+
+  const std::string target_id_;
+  base::WeakPtrFactory<NitrousPersonaHandler> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_NITROUS_PERSONA_HANDLER_H_
