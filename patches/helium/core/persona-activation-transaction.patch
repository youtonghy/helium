+const base::Value* FindPersonaPath(const base::DictValue& value,
+                                   std::string_view path) {
+  const base::DictValue* current = &value;
+  size_t start = 0;
+  while (start < path.size()) {
+    const size_t separator = path.find('.', start);
+    const size_t length = separator == std::string_view::npos
+                              ? path.size() - start
+                              : separator - start;
+    const base::Value* field =
+        current->Find(std::string(path.substr(start, length)));
+    if (!field) {
+      return nullptr;
+    }
+    if (separator == std::string_view::npos) {
+      return field;
+    }
+    if (!field->is_dict()) {
+      return nullptr;
+    }
+    current = &field->GetDict();
+    start = separator + 1;
+  }
+  return nullptr;
+}
+
+void AppendPersonaDiff(const base::DictValue& requested,
+                       const base::DictValue& effective,
+                       std::string_view path,
+                       base::ListValue* diff) {
+  const base::Value* expected = FindPersonaPath(requested, path);
+  const base::Value* actual = FindPersonaPath(effective, path);
+  if ((expected == nullptr) != (actual == nullptr) ||
+      (expected && actual && *expected != *actual)) {
+    diff->Append(std::string(path));
+  }
+}
+
+base::DictValue MakeAssurance(PersonaResolutionStatus status,
+                              bool transition_in_progress,
+                              bool degraded) {
+  base::ListValue reasons;
+  if (status == PersonaResolutionStatus::kPersonaReady) {
+    reasons.Append("network_identity_applied");
+    reasons.Append("persona_snapshot_built");
+    reasons.Append("renderer_probe_partial");
+  } else if (status == PersonaResolutionStatus::kSystemReal) {
+    reasons.Append("system_identity");
+  } else {
+    if (transition_in_progress) {
+      reasons.Append("identity_transition_in_progress");
+    }
+    if (degraded) {
+      reasons.Append("network_identity_degraded");
+    }
+    if (reasons.empty()) {
+      reasons.Append("persona_not_resolved");
+    }
+  }
+  const char* level =
+      status == PersonaResolutionStatus::kPersonaReady ? "partial"
+      : status == PersonaResolutionStatus::kSystemReal ? "system"
+                                                       : "fail_closed";
+  return base::DictValue()
+      .Set("level", level)
+      .Set("reasons", std::move(reasons));
+}
