+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/devtools/protocol/nitrous_persona_handler.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/devtools/devtools_browser_context_manager.h"
+#include "chrome/browser/helium_persona/persona_service.h"
+#include "chrome/browser/helium_persona/persona_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/startup/startup_browser_creator.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/devtools_agent_host.h"
+
+namespace {
+
+template <typename Callback>
+void SendUnavailable(std::unique_ptr<Callback> callback,
+                     bool explicit_context) {
+  std::move(callback)->sendFailure(
+      explicit_context
+          ? protocol::Response::InvalidParams("Browser context not found.")
+          : protocol::Response::ServerError("Persona service unavailable."));
+}
+
+}  // namespace
+
+NitrousPersonaHandler::NitrousPersonaHandler(
+    protocol::UberDispatcher* dispatcher,
+    std::string target_id)
+    : target_id_(std::move(target_id)) {
+  protocol::NitrousPersona::Dispatcher::wire(dispatcher, this);
+}
+
+NitrousPersonaHandler::~NitrousPersonaHandler() = default;
+
+void NitrousPersonaHandler::GetContract(
+    std::optional<protocol::String> browser_context_id,
+    std::unique_ptr<GetContractCallback> callback) {
+  Profile* profile = GetProfile(browser_context_id);
+  helium_persona::PersonaService* service =
+      profile ? helium_persona::PersonaServiceFactory::GetForProfile(profile)
+              : nullptr;
+  if (!service) {
+    SendUnavailable(std::move(callback), browser_context_id.has_value());
+    return;
+  }
+  std::move(callback)->sendSuccess(
+      std::make_unique<base::DictValue>(service->GetPersonaContract()));
+}
+
+void NitrousPersonaHandler::Validate(
+    std::unique_ptr<protocol::DictionaryValue> persona,
+    std::optional<protocol::String> browser_context_id,
+    std::unique_ptr<ValidateCallback> callback) {
+  Profile* profile = GetProfile(browser_context_id);
+  helium_persona::PersonaService* service =
+      profile ? helium_persona::PersonaServiceFactory::GetForProfile(profile)
+              : nullptr;
+  if (!service) {
+    SendUnavailable(std::move(callback), browser_context_id.has_value());
+    return;
+  }
+  std::move(callback)->sendSuccess(std::make_unique<base::DictValue>(
+      service->ValidatePersonaConfig(*persona)));
+}
+
+void NitrousPersonaHandler::Resolve(
+    const protocol::String& persona_id,
+    std::optional<protocol::String> browser_context_id,
+    std::unique_ptr<ResolveCallback> callback) {
+  Profile* profile = GetProfile(browser_context_id);
+  helium_persona::PersonaService* service =
+      profile ? helium_persona::PersonaServiceFactory::GetForProfile(profile)
+              : nullptr;
+  if (!service) {
+    SendUnavailable(std::move(callback), browser_context_id.has_value());
+    return;
+  }
+  std::move(callback)->sendSuccess(std::make_unique<base::DictValue>(
+      service->ResolvePersonaById(persona_id)));
+}
+
+void NitrousPersonaHandler::GetEffective(
+    std::optional<protocol::String> browser_context_id,
+    std::unique_ptr<GetEffectiveCallback> callback) {
+  Profile* profile = GetProfile(browser_context_id);
+  helium_persona::PersonaService* service =
+      profile ? helium_persona::PersonaServiceFactory::GetForProfile(profile)
+              : nullptr;
+  if (!service) {
+    SendUnavailable(std::move(callback), browser_context_id.has_value());
+    return;
+  }
+  std::move(callback)->sendSuccess(
+      std::make_unique<base::DictValue>(service->GetEffectivePersona()));
+}
+
+void NitrousPersonaHandler::GetAudit(
+    std::optional<protocol::String> browser_context_id,
+    std::unique_ptr<GetAuditCallback> callback) {
+  Profile* profile = GetProfile(browser_context_id);
+  helium_persona::PersonaService* service =
+      profile ? helium_persona::PersonaServiceFactory::GetForProfile(profile)
+              : nullptr;
+  if (!service) {
+    SendUnavailable(std::move(callback), browser_context_id.has_value());
+    return;
+  }
+  std::move(callback)->sendSuccess(
+      std::make_unique<base::DictValue>(service->GetPersonaAudit()));
+}
+
+void NitrousPersonaHandler::Activate(
+    const protocol::String& persona_id,
+    std::optional<protocol::String> browser_context_id,
+    std::unique_ptr<ActivateCallback> callback) {
+  Profile* profile = GetProfile(browser_context_id);
+  helium_persona::PersonaService* service =
+      profile ? helium_persona::PersonaServiceFactory::GetForProfile(profile)
+              : nullptr;
+  if (!service) {
+    SendUnavailable(std::move(callback), browser_context_id.has_value());
+    return;
+  }
+  StartupBrowserCreator::ActivatePersonaForAutomation(
+      profile, persona_id,
+      base::BindOnce(&NitrousPersonaHandler::OnActivated,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+Profile* NitrousPersonaHandler::GetProfile(
+    const std::optional<protocol::String>& browser_context_id) const {
+  DevToolsBrowserContextManager& manager =
+      DevToolsBrowserContextManager::GetInstance();
+  if (browser_context_id.has_value()) {
+    if (*browser_context_id != "default") {
+      return nullptr;
+    }
+    content::BrowserContext* context = manager.GetDefaultBrowserContext();
+    return context ? Profile::FromBrowserContext(context) : nullptr;
+  }
+
+  scoped_refptr<content::DevToolsAgentHost> host =
+      content::DevToolsAgentHost::GetForId(target_id_);
+  content::BrowserContext* context = host ? host->GetBrowserContext() : nullptr;
+  if (!context) {
+    context = manager.GetDefaultBrowserContext();
+  }
+  return context ? Profile::FromBrowserContext(context) : nullptr;
+}
+
+void NitrousPersonaHandler::OnActivated(
+    std::unique_ptr<ActivateCallback> callback,
+    base::DictValue result) {
+  std::move(callback)->sendSuccess(
+      std::make_unique<base::DictValue>(std::move(result)));
+}
