+base::DictValue PersonaService::GetEffectivePersona() const {
+  const base::DictValue state = ReadState();
+  const std::string active_id = GetActivePersonaId(state);
+  base::DictValue response = ResolvePersonaById(active_id);
+  const base::DictValue* requested = response.FindDict("requested");
+  const base::DictValue* effective = response.FindDict("effective");
+  base::ListValue diff;
+  if (requested && effective) {
+    constexpr std::array<std::string_view, 25> kComparableFields = {
+        "enabled",
+        "id",
+        "name",
+        "platform",
+        "userAgent",
+        "region.timezone",
+        "region.locale",
+        "region.acceptLanguage",
+        "uaCh.platform",
+        "uaCh.platformVersion",
+        "uaCh.architecture",
+        "uaCh.bitness",
+        "gpu.vendor",
+        "gpu.renderer",
+        "hardware.hardwareConcurrency",
+        "hardware.deviceMemory",
+        "screen.width",
+        "screen.height",
+        "screen.deviceScaleFactor",
+        "advanced.allowWebRtc",
+        "advanced.webrtcMode",
+        "network.type",
+        "network.effectiveType",
+        "network.rtt",
+        "network.routeId",
+    };
+    for (std::string_view path : kComparableFields) {
+      AppendPersonaDiff(*requested, *effective, path, &diff);
+    }
+  }
+  response.Set("schema", kPersonaExportSchema);
+  response.Set("diff", std::move(diff));
+  response.Set("transition", base::DictValue()
+                                 .Set("busy", IsIdentityTransitionBusy())
+                                 .Set("networkInProgress",
+                                      network_identity_transition_in_progress_)
+                                 .Set("degraded", network_identity_degraded_));
+  const std::string* status_value = response.FindString("status");
+  const std::string status =
+      status_value ? *status_value : "persona_unavailable";
+  const PersonaResolutionStatus resolution_status =
+      status == "system_real" ? PersonaResolutionStatus::kSystemReal
+      : status == "persona_ready"
+          ? PersonaResolutionStatus::kPersonaReady
+          : PersonaResolutionStatus::kPersonaUnavailable;
+  response.Set(
+      "assurance",
+      MakeAssurance(resolution_status, network_identity_transition_in_progress_,
+                    network_identity_degraded_));
+  return response;
+}
