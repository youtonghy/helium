+void PersonaService::OnPersonaActivationRollbackPrefUpdatesResumed(
+    std::string error,
+    bool rollback_accepted,
+    bool resume_accepted) {
+  if (!pending_persona_activation_) {
+    return;
+  }
+  base::DictValue field_errors;
+  const bool old_state_restored =
+      prefs_->GetDict(kPersonaStatePref) ==
+          pending_persona_activation_->old_state &&
+      prefs_->GetString(kPersonaLastUsedIdPref) ==
+          pending_persona_activation_->old_last_used_persona_id &&
+      FingerprintSeedStateMatches(
+          *prefs_, pending_persona_activation_->old_fingerprint_seed) &&
+      (!identity_rotation_delegate_ ||
+       identity_rotation_delegate_->GetActiveNetworkRouteId() ==
+           pending_persona_activation_->old_route_id);
+  const bool network_recovered =
+      rollback_accepted && resume_accepted && old_state_restored;
+  network_identity_degraded_ = !network_recovered;
+  field_errors.Set("personaActivation", network_recovered
+                                            ? std::move(error)
+                                            : "networkRollbackFailed");
+  base::DictValue response =
+      MakeResponse(false, ReadState(), std::move(field_errors));
+  if (!network_recovered || !identity_rotation_delegate_) {
+    response.Set("restartResult",
+                 network_recovered ? "not_started" : "recovery_failed");
+    FinishPersonaActivation(std::move(response));
+    return;
   }
+  identity_rotation_delegate_->RestartExecutionContexts(
+      base::BindOnce(&PersonaService::PrepareExecutionContextsForRestart,
+                     weak_ptr_factory_.GetWeakPtr()),
+      base::BindOnce(
+          &PersonaService::OnPersonaActivationFailureExecutionContextsRestarted,
+          weak_ptr_factory_.GetWeakPtr(), std::move(response)));
+}
 
