+base::DictValue PersonaService::ResolvePersonaById(
+    const std::string& persona_id) const {
+  base::DictValue state = ReadState();
+  const base::DictValue* persona =
+      FindPersonaInList(state.FindList("personas"), persona_id);
+  base::DictValue response = base::DictValue()
+                                 .Set("schema", kPersonaExportSchema)
+                                 .Set("personaId", persona_id)
+                                 .Set("active", false);
+  if (!persona) {
+    response.Set("ok", false);
+    response.Set("status", "persona_unavailable");
+    response.Set("reason", "not_found");
+    response.Set("requested", base::Value());
+    response.Set("effective", base::Value());
+    return response;
+  }
+
+  const bool active = GetActivePersonaId(state) == persona_id;
+  response.Set("active", active);
+  response.Set("requested", persona->Clone());
+  if (!active) {
+    response.Set("ok", true);
+    response.Set("status", "not_active");
+    response.Set("effective", base::Value());
+    return response;
+  }
+
+  const PersonaResolution resolution = ResolveActivePersona();
+  response.Set(
+      "ok", resolution.status != PersonaResolutionStatus::kPersonaUnavailable);
+  response.Set("status", PersonaResolutionStatusName(resolution.status));
+  response.Set("expectedPersonaId", resolution.expected_persona_id);
+  response.Set(
+      "assurance",
+      MakeAssurance(resolution.status, network_identity_transition_in_progress_,
+                    network_identity_degraded_));
+  if (resolution.status == PersonaResolutionStatus::kPersonaReady) {
+    base::DictValue effective = SnapshotToDict(resolution.snapshot);
+    effective.EnsureDict("network")->Set("routeId",
+                                         GetPersonaNetworkRouteId(*persona));
+    response.Set("effective", std::move(effective));
+  } else if (resolution.status == PersonaResolutionStatus::kSystemReal) {
+    response.Set("effective", base::Value());
+    response.Set("source", "system_unprobed");
+  } else {
+    response.Set("effective", base::Value());
+    response.Set("reason", network_identity_transition_in_progress_
+                               ? "identity_transition_in_progress"
+                           : network_identity_degraded_
+                               ? "network_identity_degraded"
+                               : "persona_not_resolved");
+  }
+  return response;
+}
