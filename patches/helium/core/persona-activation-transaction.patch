+void NitrousProxyService::MigrateLegacyConfigIfNeeded() {
+  if (!prefs_->GetDict(prefs::kRoutes).empty()) {
+    return;
+  }
+
+  const std::optional<ProxyMode> mode =
+      ParseProxyMode(prefs_->GetString(prefs::kMode));
+  if (!mode || *mode == ProxyMode::kOff) {
+    return;
+  }
+  ProxyConfig config;
+  config.mode = *mode;
+  config.host = prefs_->GetString(prefs::kHost);
+  config.port = prefs_->GetInteger(prefs::kPort);
+  config.username = prefs_->GetString(prefs::kUsername);
+  config.enforce = prefs_->GetBoolean(prefs::kEnforce);
+  if (!config.IsValid()) {
+    return;
+  }
+
+  base::DictValue route = SerializeRoute(kMigratedRouteName, config);
+  const std::string encrypted = prefs_->GetString(prefs::kPasswordEncrypted);
+  if (!encrypted.empty()) {
+    route.Set(kRoutePasswordEncryptedKey, encrypted);
+    route.Set(kRoutePasswordRequiredKey, true);
+  }
+  base::DictValue routes;
+  routes.Set(kLegacyRouteId, std::move(route));
+  prefs_->SetDict(prefs::kRoutes, std::move(routes));
+  prefs_->SetString(prefs::kActiveRouteId, kLegacyRouteId);
+
+  prefs_->SetString(prefs::kMode, kModeOff);
+  prefs_->SetString(prefs::kHost, std::string());
+  prefs_->SetInteger(prefs::kPort, 0);
+  prefs_->SetString(prefs::kUsername, std::string());
+  prefs_->SetString(prefs::kPasswordEncrypted, std::string());
+  prefs_->SetBoolean(prefs::kEnforce, true);
 }
 
