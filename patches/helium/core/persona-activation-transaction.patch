+base::DictValue PersonaService::GetPersonaAudit() const {
+  base::DictValue effective = GetEffectivePersona();
+  const std::string* status_value = effective.FindString("status");
+  const std::string status =
+      status_value ? *status_value : "persona_unavailable";
+  const base::DictValue* snapshot = effective.FindDict("effective");
+  const bool fail_closed = status == "persona_unavailable";
+  const char* network_status = status == "system_real"     ? "system"
+                               : status == "persona_ready" ? "applied"
+                                                           : "blocked";
+  base::DictValue surfaces =
+      base::DictValue()
+          .Set("prefs", "present")
+          .Set("network", network_status)
+          .Set("renderer", "unknown")
+          .Set("workers", "unknown")
+          .Set("probe", "partial")
+          .Set("fingerprint", status == "persona_ready" ? "configured"
+                              : status == "system_real" ? "system"
+                                                        : "unavailable");
+  if (snapshot) {
+    const base::DictValue* advanced = snapshot->FindDict("advanced");
+    surfaces.Set("webrtc", advanced && advanced->FindString("webrtcMode")
+                               ? *advanced->FindString("webrtcMode")
+                               : "unknown");
+  } else {
+    surfaces.Set("webrtc", "unknown");
+  }
+  const base::DictValue* requested = effective.FindDict("requested");
+  const std::string requested_route_id =
+      requested ? GetPersonaNetworkRouteId(*requested) : std::string();
+  const std::string active_route_id =
+      identity_rotation_delegate_
+          ? identity_rotation_delegate_->GetActiveNetworkRouteId()
+          : std::string();
+  base::DictValue route_binding =
+      base::DictValue()
+          .Set("requestedRouteId", requested_route_id)
+          .Set("activeRouteId", active_route_id)
+          .Set("status", network_status);
+  return base::DictValue()
+      .Set("ok", !fail_closed)
+      .Set("schema", kPersonaExportSchema)
+      .Set("checkedAt", MakeIsoTimestamp())
+      .Set("status", status)
+      .Set("expectedPersonaId", effective.FindString("expectedPersonaId")
+                                    ? *effective.FindString("expectedPersonaId")
+                                    : std::string())
+      .Set("failClosed", fail_closed)
+      .Set("surfaces", std::move(surfaces))
+      .Set("networkRoute", std::move(route_binding))
+      .Set("assurance", effective.FindDict("assurance")
+                            ? effective.FindDict("assurance")->Clone()
+                            : base::DictValue())
+      .Set("transition", effective.FindDict("transition")
+                             ? effective.FindDict("transition")->Clone()
+                             : base::DictValue());
+}
