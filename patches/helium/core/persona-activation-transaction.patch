+
+  void RequestShutdown(content::RenderProcessHost* host) {
+    if (!active_ || !process_observations_.IsObservingSource(host)) {
+      return;
+    }
+    if (!BelongsToProfile(host)) {
+      process_observations_.RemoveObservation(host);
+      return;
+    }
+    if (host->ShutdownRequested()) {
+      return;
+    }
+    if (host->Shutdown(content::RESULT_CODE_KILLED)) {
+      return;
+    }
+    failed_ = true;
+    shutdown_failures_.insert(host);
+    process_observations_.RemoveObservation(host);
+    MaybeScheduleVerification();
+  }
+
+  void OnRenderProcessGenerationStopped(content::RenderProcessHost* host) {
+    if (process_observations_.IsObservingSource(host)) {
+      process_observations_.RemoveObservation(host);
+    }
+    shutdown_failures_.erase(host);
+    // A prior death observer may synchronously reinitialize this host. Recheck
+    // by stable host ID after the current observer notification completes;
+    // re-adding during iteration would receive the same event again.
+    const content::ChildProcessId host_id = host->GetID();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&Impl::RecheckProcess,
+                                  weak_ptr_factory_.GetWeakPtr(), host_id));
+    MaybeScheduleVerification();
+  }
+
+  void RecheckProcess(content::ChildProcessId host_id) {
+    content::RenderProcessHost* host =
+        content::RenderProcessHost::FromID(host_id);
+    if (host) {
+      TrackProcess(host, false);
+    }
+  }
+
+  void OnRenderProcessDestroyed(content::RenderProcessHost* host) {
+    shutdown_failures_.erase(host);
+    if (process_observations_.IsObservingSource(host)) {
+      process_observations_.RemoveObservation(host);
+    }
+    MaybeScheduleVerification();
+  }
+
+  void MaybeScheduleVerification() {
+    if (!callback_ || workers_stopping_ ||
+        process_observations_.IsObservingAnySource() || verification_posted_) {
+      return;
+    }
+    verification_posted_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&Impl::VerifyQuiescence,
+                                  weak_ptr_factory_.GetWeakPtr()));
+  }
+
+  void VerifyQuiescence() {
+    verification_posted_ = false;
+    if (!callback_) {
+      return;
+    }
+    ScanProcesses();
+    if (process_observations_.IsObservingAnySource()) {
+      return;
+    }
+    Complete(!failed_);
+  }
+
+  void OnTimeout() {
+    failed_ = true;
+    Complete(false);
+  }
+
+  void Complete(bool accepted) {
+    if (!callback_) {
+      return;
+    }
+    timeout_.Stop();
+    base::OnceCallback<void(bool)> callback = std::move(callback_);
+    std::move(callback).Run(accepted);
+  }
+
+  base::WeakPtr<Profile> profile_;
+  base::OnceCallback<void(bool)> callback_;
+  base::ScopedMultiSourceObservation<content::RenderProcessHost,
+                                     content::RenderProcessHostObserver>
+      process_observations_{this};
+  base::ScopedObservation<content::SpareRenderProcessHostManager,
+                          content::SpareRenderProcessHostManager::Observer>
+      spare_observation_{this};
+  base::flat_set<content::RenderProcessHost*> shutdown_failures_;
+  base::OneShotTimer timeout_;
+  bool active_ = true;
+  bool failed_ = false;
+  bool workers_stopping_ = false;
+  bool verification_posted_ = false;
+  base::WeakPtrFactory<Impl> weak_ptr_factory_{this};
+};
