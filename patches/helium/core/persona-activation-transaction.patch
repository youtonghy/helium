+           pending_persona_activation_->old_route_id);
+  const char* commit_state = "unknown";
+  if (candidate_matches) {
+    commit_state = "committed";
+  } else if (old_matches) {
+    commit_state = pending_persona_activation_->candidate_persisted
+                       ? "rolled_back"
+                       : "not_committed";
+  }
+  response.Set("commitState", commit_state);
