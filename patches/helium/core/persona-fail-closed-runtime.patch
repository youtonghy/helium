+
+void AIManager::CompleteTrackedCanCreate(
+    uint64_t request_id,
+    blink::mojom::ModelAvailabilityCheckResult result) {
+  auto it = pending_can_create_callbacks_.find(request_id);
+  if (it == pending_can_create_callbacks_.end()) {
+    return;
+  }
+  CanCreateLanguageModelCallback callback = std::move(it->second);
+  pending_can_create_callbacks_.erase(it);
+  std::move(callback).Run(result);
+}
