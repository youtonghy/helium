+TEST_F(AILanguageModelTest, PersonaDenialRevokesExistingSession) {
+  mojo::Remote<blink::mojom::AIManager> manager = GetAIManagerRemote();
+  mojo::Remote<blink::mojom::AILanguageModel> session = CreateSession();
+  ASSERT_EQ(1u, GetAIManagerContextBoundObjectSetSize());
+
+  ActivateDisabledPersona(profile());
+
+  EXPECT_EQ(0u, GetAIManagerContextBoundObjectSetSize());
+  session.FlushForTesting();
+  EXPECT_FALSE(session.is_connected());
+  manager.FlushForTesting();
+  EXPECT_TRUE(manager.is_connected());
+}
