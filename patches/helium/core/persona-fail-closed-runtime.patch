+helium_persona::PersonaService* ActivateDisabledPersona(Profile* profile) {
+  auto* service =
+      helium_persona::PersonaServiceFactory::GetForProfile(profile);
+  CHECK(service);
+  base::DictValue response = service->CreatePersonaProfile("No AI");
+  const std::string* persona_id = response.FindString("personaId");
+  CHECK(persona_id);
+  CHECK(service->SetActivePersona(*persona_id).FindBool("ok").value_or(false));
+  return service;
+}
