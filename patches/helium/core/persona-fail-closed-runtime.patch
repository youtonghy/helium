+PersonaRuntimeState PersonaRuntimeOverride::ResolveForBrowserContext(
+    content::BrowserContext* browser_context) {
+  PersonaResolution resolution;
+  if (browser_context) {
+    Profile* profile = Profile::FromBrowserContext(browser_context);
+    if (auto* service = PersonaServiceFactory::GetForProfile(profile)) {
+      resolution = service->ResolveActivePersona();
+    }
+  }
+  return ApplyForContext(browser_context, resolution);
+}
+
+PersonaRuntimeState PersonaRuntimeOverride::ApplyForContext(
+    const void* context_key,
+    const PersonaResolution& resolution) {
+  base::AutoLock lock(GetPersonaRuntimeOverrideLock());
+  CacheEntry& entry = GetPersonaRuntimeOverrideEntries()[context_key];
+  entry.status = resolution.status;
+  entry.expected_persona_id = resolution.expected_persona_id;
+
+  if (resolution.status == PersonaResolutionStatus::kSystemReal) {
+    entry.last_valid_snapshot = resolution.snapshot;
+  } else if (resolution.status == PersonaResolutionStatus::kPersonaReady) {
+    entry.last_valid_snapshot = resolution.snapshot;
+  } else if (entry.last_valid_snapshot &&
+             !resolution.expected_persona_id.empty() &&
+             entry.last_valid_snapshot->id != resolution.expected_persona_id) {
+    entry.last_valid_snapshot.reset();
+  }
+  return MakeRuntimeState(entry);
+}
+
+void PersonaRuntimeOverride::ClearForContext(const void* context_key) {
+  base::AutoLock lock(GetPersonaRuntimeOverrideLock());
+  GetPersonaRuntimeOverrideEntries().erase(context_key);
+}
