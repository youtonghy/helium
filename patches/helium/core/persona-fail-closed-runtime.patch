+AIManager::CanCreateLanguageModelCallback AIManager::TrackCanCreateCallback(
+    CanCreateLanguageModelCallback callback) {
+  const uint64_t request_id = ++next_can_create_request_id_;
+  pending_can_create_callbacks_.emplace(request_id, std::move(callback));
+  return base::BindOnce(&AIManager::CompleteTrackedCanCreate,
