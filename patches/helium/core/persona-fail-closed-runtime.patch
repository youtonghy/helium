+PersonaResolution PersonaService::ResolveActivePersona() const {
+  PersonaResolution resolution;
+  if (!prefs_) {
+    return resolution;
+  }
+
+  const base::DictValue& raw_state = prefs_->GetDict(kPersonaStatePref);
+  const std::string* active_id = raw_state.FindString("activePersonaId");
+  if (!active_id || active_id->empty()) {
+    return resolution;
+  }
+  resolution.expected_persona_id = *active_id;
+
+  if (*active_id == kDefaultPersonaId) {
+    resolution.status = PersonaResolutionStatus::kSystemReal;
+    resolution.snapshot.id = kDefaultPersonaId;
+    return resolution;
+  }
+
+  const base::DictValue* persona =
+      FindPersonaInList(raw_state.FindList("personas"), *active_id);
+  const std::string* persona_id = persona ? persona->FindString("id") : nullptr;
+  if (!persona_id || *persona_id != *active_id ||
+      !persona->FindBool("enabled").value_or(false)) {
+    return resolution;
+  }
+
+  blink::HeliumPersonaSnapshot snapshot = GetActiveSnapshot();
+  if (!snapshot.enabled || snapshot.id != *active_id || snapshot.locale.empty() ||
+      snapshot.timezone.empty()) {
+    return resolution;
+  }
+
+  resolution.status = PersonaResolutionStatus::kPersonaReady;
+  resolution.snapshot = std::move(snapshot);
+  return resolution;
+}
