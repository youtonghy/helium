+class TestDisconnectAwareCreateLanguageModelClient
+    : public blink::mojom::AIManagerCreateLanguageModelClient {
+ public:
+  mojo::PendingRemote<blink::mojom::AIManagerCreateLanguageModelClient>
+  BindNewPipeAndPassRemote() {
+    mojo::PendingRemote<blink::mojom::AIManagerCreateLanguageModelClient>
+        remote = receiver_.BindNewPipeAndPassRemote();
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &TestDisconnectAwareCreateLanguageModelClient::OnDisconnect,
+        base::Unretained(this)));
+    return remote;
+  }
+
+  void OnResult(
+      mojo::PendingRemote<blink::mojom::AILanguageModel> language_model,
+      blink::mojom::AILanguageModelInstanceInfoPtr info) override {
+    ADD_FAILURE() << "Revoked create unexpectedly returned a session";
+    SetError(blink::mojom::AIManagerCreateClientError::kUnableToCreateSession);
+  }
+
+  void OnError(blink::mojom::AIManagerCreateClientError error,
+               blink::mojom::QuotaErrorInfoPtr quota_error_info) override {
+    EXPECT_FALSE(quota_error_info);
+    SetError(error);
+  }
+
+  blink::mojom::AIManagerCreateClientError WaitForError() {
+    return error_.Take();
+  }
+
+ private:
+  void OnDisconnect() {
+    SetError(blink::mojom::AIManagerCreateClientError::kUnableToCreateSession);
+  }
+
+  void SetError(blink::mojom::AIManagerCreateClientError error) {
+    receiver_.reset();
+    error_.SetValue(error);
+  }
+
+  TestFuture<blink::mojom::AIManagerCreateClientError> error_;
+  mojo::Receiver<blink::mojom::AIManagerCreateLanguageModelClient> receiver_{
+      this};
+};
