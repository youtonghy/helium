+TEST_F(PersonaServiceTest, AttachesDevicePackToMacPresetClone) {
+  base::DictValue state = service_->GetPersonaState();
+  const base::ListValue* presets = state.FindList("presets");
+  ASSERT_TRUE(presets);
+  const base::DictValue* mac_preset = nullptr;
+  for (const base::Value& value : *presets) {
+    const base::DictValue* preset = value.GetIfDict();
+    if (!preset) {
+      continue;
+    }
+    if (preset->FindBool("networkReady").value_or(false) &&
+        preset->FindInt("devicePackId").value_or(0) ==
+            static_cast<int>(kChromium149MacArmIdentityTemplateId)) {
+      mac_preset = preset;
+      break;
+    }
+  }
