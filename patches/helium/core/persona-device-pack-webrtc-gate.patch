+  const std::string* preset_id = mac_preset->FindString("id");
+  ASSERT_TRUE(preset_id);
+  base::DictValue response = service_->ClonePresetIntoProfile(*preset_id);
+  ASSERT_TRUE(response.FindBool("ok").value_or(false));
+  const std::string* persona_id = response.FindString("personaId");
+  ASSERT_TRUE(persona_id);
+  ASSERT_TRUE(service_->SetActivePersona(*persona_id)
+                  .FindBool("ok")
+                  .value_or(false));
+  EXPECT_TRUE(service_->GetActiveSnapshot().enabled);
+  EXPECT_FALSE(service_->GetActiveSnapshot().allow_web_rtc);
+  EXPECT_EQ(kChromium149MacArmIdentityTemplateId,
+            service_->GetActiveIdentityTemplateId());
