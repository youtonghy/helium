+const PersonaIdentityTemplate* ResolveCompleteIdentity(
+    const base::DictValue& persona) {
+  if (std::optional<int> pack_id = persona.FindInt("devicePackId");
+      pack_id && *pack_id > 0) {
+    if (const PersonaIdentityTemplate* by_pack =
+            FindPersonaIdentityTemplate(static_cast<uint32_t>(*pack_id));
+        by_pack && PersonaIdentityHasNetworkVariants(*by_pack)) {
+      return by_pack;
+    }
+  }
+
+  const base::DictValue* ua_ch = persona.FindDict("uaCh");
+  if (!ua_ch) {
+    return nullptr;
+  }
+  const auto find_string = [](const base::DictValue& dict,
+                              std::string_view key) -> std::string_view {
+    const std::string* value = dict.FindString(key);
+    return value ? *value : std::string_view();
+  };
+  const std::string_view user_agent = find_string(persona, "userAgent");
+  const std::string_view os = find_string(persona, "platform");
+  const std::string_view ua_ch_platform = find_string(*ua_ch, "platform");
+  const std::string_view ua_ch_platform_version =
+      find_string(*ua_ch, "platformVersion");
+  const std::string_view ua_ch_full_version = find_string(*ua_ch, "fullVersion");
+  const std::string_view architecture = find_string(*ua_ch, "architecture");
+  const std::string_view bitness = find_string(*ua_ch, "bitness");
+  const bool mobile = ua_ch->FindBool("mobile").value_or(false);
+  const bool wow64 = ua_ch->FindBool("wow64").value_or(false);
+
+  if (const PersonaIdentityTemplate* exact = MatchPersonaIdentityTemplate(
+          user_agent, os, ua_ch_platform, ua_ch_platform_version,
+          ua_ch_full_version, architecture, bitness, mobile, wow64);
+      exact && PersonaIdentityHasNetworkVariants(*exact)) {
+    return exact;
+  }
+
+  return MatchCompatiblePersonaIdentityTemplate(
+      os, architecture, bitness, ua_ch_full_version, mobile);
+}
+
+bool PersonaHasCompleteNetworkIdentity(const base::DictValue& persona) {
+  const PersonaIdentityTemplate* identity = ResolveCompleteIdentity(persona);
+  return identity && PersonaIdentityHasNetworkVariants(*identity);
+}
+
+void AttachDevicePackMetadata(base::DictValue& persona) {
+  const PersonaIdentityTemplate* identity = ResolveCompleteIdentity(persona);
+  if (!identity) {
+    persona.Set("networkReady", false);
+    if (!persona.FindInt("devicePackId").has_value()) {
+      persona.Set("devicePackId", 0);
+    }
+    return;
+  }
+  persona.Set("devicePackId", static_cast<int>(identity->id));
+  persona.Set("networkReady", true);
+}
