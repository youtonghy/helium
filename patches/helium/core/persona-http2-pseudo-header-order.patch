+std::vector<std::string> HeaderNames(
+    const quiche::HttpHeaderBlock& headers) {
+  std::vector<std::string> names;
+  names.reserve(headers.size());
+  for (const auto& header : headers) {
+    names.emplace_back(header.first);
+  }
+  return names;
+}
