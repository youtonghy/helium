+bool ReorderSpdyRequestPseudoHeaders(
+    std::string_view pseudo_header_order,
+    quiche::HttpHeaderBlock* headers) {
+  if (pseudo_header_order.empty()) {
+    return true;
+  }
+  if (pseudo_header_order.size() != 4u) {
+    return false;
+  }
+
+  std::string seen;
+  for (char key : pseudo_header_order) {
+    if (std::string_view("masp").find(key) == std::string_view::npos ||
+        seen.find(key) != std::string::npos) {
+      return false;
+    }
+    seen.push_back(key);
+  }
+
+  for (const auto& header : *headers) {
+    if (!header.first.starts_with(':')) {
+      continue;
+    }
+    if (header.first != spdy::kHttp2MethodHeader &&
+        header.first != spdy::kHttp2AuthorityHeader &&
+        header.first != spdy::kHttp2SchemeHeader &&
+        header.first != spdy::kHttp2PathHeader) {
+      return false;
+    }
+  }
+
+  quiche::HttpHeaderBlock reordered;
+  for (char key : pseudo_header_order) {
+    std::string_view name;
+    switch (key) {
+      case 'm':
+        name = spdy::kHttp2MethodHeader;
+        break;
+      case 'a':
+        name = spdy::kHttp2AuthorityHeader;
+        break;
+      case 's':
+        name = spdy::kHttp2SchemeHeader;
+        break;
+      case 'p':
+        name = spdy::kHttp2PathHeader;
+        break;
+      default:
+        return false;
+    }
+    const auto existing = headers->find(name);
+    if (existing != headers->end()) {
+      reordered.insert(*existing);
+    }
+  }
+  for (const auto& header : *headers) {
+    if (!header.first.starts_with(':')) {
+      reordered.insert(header);
+    }
+  }
+  *headers = std::move(reordered);
+  return true;
+}
