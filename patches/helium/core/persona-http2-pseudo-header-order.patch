+    headers[":authority"] = "www.example.test";
+    headers[":scheme"] = "https";
+    headers[":path"] = "/";
+    const std::vector<std::string> original = HeaderNames(headers);
+
+    EXPECT_FALSE(ReorderSpdyRequestPseudoHeaders(order, &headers));
+    EXPECT_EQ(original, HeaderNames(headers));
+  }
+}
