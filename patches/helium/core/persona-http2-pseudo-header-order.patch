+TEST(SpdyHttpUtilsTest, ReordersPersonaPseudoHeaders) {
+  quiche::HttpHeaderBlock headers;
+  headers[":path"] = "/index.html";
+  headers[":scheme"] = "https";
+  headers[":authority"] = "www.example.test";
+  headers[":method"] = "GET";
+  headers["accept"] = "text/html";
+  headers["user-agent"] = "Nitrous";
+
+  EXPECT_TRUE(ReorderSpdyRequestPseudoHeaders("masp", &headers));
+  EXPECT_EQ((std::vector<std::string>{":method", ":authority", ":scheme",
+                                      ":path", "accept", "user-agent"}),
+            HeaderNames(headers));
+}
+
+TEST(SpdyHttpUtilsTest, ReordersOnlyPresentConnectPseudoHeaders) {
+  quiche::HttpHeaderBlock headers;
+  headers[":authority"] = "www.example.test:443";
+  headers[":method"] = "CONNECT";
+  headers["user-agent"] = "Nitrous";
+
+  EXPECT_TRUE(ReorderSpdyRequestPseudoHeaders("masp", &headers));
+  EXPECT_EQ((std::vector<std::string>{":method", ":authority", "user-agent"}),
+            HeaderNames(headers));
+  EXPECT_FALSE(headers.contains(":scheme"));
+  EXPECT_FALSE(headers.contains(":path"));
+}
+
+TEST(SpdyHttpUtilsTest, LeavesUnmodelledPseudoHeadersUnchanged) {
+  quiche::HttpHeaderBlock headers;
+  headers[":scheme"] = "https";
+  headers[":path"] = "/socket";
+  headers[":protocol"] = "websocket";
+  headers[":method"] = "CONNECT";
+  headers[":authority"] = "www.example.test";
+  headers["user-agent"] = "Nitrous";
+  const std::vector<std::string> original = HeaderNames(headers);
+
+  EXPECT_FALSE(ReorderSpdyRequestPseudoHeaders("masp", &headers));
+  EXPECT_EQ(original, HeaderNames(headers));
+}
+
+TEST(SpdyHttpUtilsTest, RejectsInvalidPersonaPseudoHeaderOrders) {
+  for (std::string_view order : {"mas", "maap", "masx"}) {
+    quiche::HttpHeaderBlock headers;
