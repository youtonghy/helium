+base::DictValue PersonaService::GetFingerprintSettings() const {
+  if (!prefs_) {
+    return base::DictValue().Set("ok", false).Set("error", "unavailable");
+  }
+  EnsureFingerprintSeedForCurrentDay();
+  return MakeFingerprintSettingsResponse(prefs_, true);
+}
+
+base::DictValue PersonaService::SetFixedFingerprintSeed(
+    const std::string& seed) {
+  if (!prefs_ || !IsValidFingerprintSeed(seed)) {
+    return prefs_ ? MakeFingerprintSettingsResponse(prefs_, false, "invalid")
+                  : base::DictValue().Set("ok", false).Set("error", "invalid");
+  }
+
+  const std::string normalized_seed = base::ToLowerASCII(seed);
+  prefs_->SetString(prefs::kFingerprintSeedMode, kFingerprintSeedModeFixed);
+  prefs_->SetString(prefs::kFingerprintFixedSeed, normalized_seed);
+  prefs_->SetBoolean(prefs::kFingerprintClearOnExit, false);
+  prefs_->SetBoolean(prefs::kFingerprintRotateDaily, false);
+  ReplaceFingerprintSeed(normalized_seed);
+  return MakeFingerprintSettingsResponse(prefs_, true);
+}
+
+base::DictValue PersonaService::GenerateRandomFingerprintSeed() {
+  if (!prefs_) {
+    return base::DictValue().Set("ok", false).Set("error", "unavailable");
+  }
+
+  prefs_->SetString(prefs::kFingerprintSeedMode, kFingerprintSeedModeRandom);
+  prefs_->ClearPref(prefs::kFingerprintFixedSeed);
+  ReplaceFingerprintSeed(MakeFingerprintSalt());
+  if (prefs_->GetBoolean(prefs::kFingerprintRotateDaily)) {
+    prefs_->SetString(prefs::kFingerprintLastRotationDay, GetCurrentLocalDay());
+  }
+  return MakeFingerprintSettingsResponse(prefs_, true);
+}
+
+base::DictValue PersonaService::SetFingerprintAutomation(bool clear_on_exit,
+                                                         bool rotate_daily) {
+  if (!prefs_) {
+    return base::DictValue().Set("ok", false).Set("error", "unavailable");
+  }
+  if (prefs_->GetString(prefs::kFingerprintSeedMode) ==
+      kFingerprintSeedModeFixed) {
+    prefs_->SetBoolean(prefs::kFingerprintClearOnExit, false);
+    prefs_->SetBoolean(prefs::kFingerprintRotateDaily, false);
+    return GetFingerprintSettings();
+  }
+
+  prefs_->SetBoolean(prefs::kFingerprintClearOnExit, clear_on_exit);
+  prefs_->SetBoolean(prefs::kFingerprintRotateDaily, rotate_daily);
+  if (rotate_daily) {
+    prefs_->SetString(prefs::kFingerprintLastRotationDay, GetCurrentLocalDay());
+  } else {
+    prefs_->ClearPref(prefs::kFingerprintLastRotationDay);
+  }
+  return GetFingerprintSettings();
+}
