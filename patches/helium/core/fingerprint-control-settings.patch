+void PersonaService::ReplaceFingerprintSeed(const std::string& seed) const {
+  DCHECK(prefs_);
+  prefs_->SetString(kPersonaFingerprintProfileSaltPref, seed);
+  prefs_->SetString(prefs::kFingerprintLastChanged, MakeIsoTimestamp());
+
+  base::DictValue rotation_epoch =
+      prefs_->GetDict(kPersonaFingerprintRotationEpochPref).Clone();
+  rotation_epoch.Set("global", MakeIsoTimestamp());
+  rotation_epoch.Set(
+      "globalGeneration",
+      base::NumberToString(NextGeneration(
+          ReadGeneration(rotation_epoch.Find("globalGeneration")))));
+  prefs_->SetDict(kPersonaFingerprintRotationEpochPref,
+                  std::move(rotation_epoch));
 }
 
