+void PersonaService::EnsureFingerprintSeedForCurrentDay() const {
+  if (!prefs_) {
+    return;
   }
-  return salt;
+
+  const std::string mode = prefs_->GetString(prefs::kFingerprintSeedMode);
+  if (mode == kFingerprintSeedModeFixed) {
+    const std::string fixed_seed = prefs_->GetString(prefs::kFingerprintFixedSeed);
+    if (IsValidFingerprintSeed(fixed_seed) &&
+        prefs_->GetString(kPersonaFingerprintProfileSaltPref) != fixed_seed) {
+      ReplaceFingerprintSeed(fixed_seed);
+    }
+    return;
+  }
+
+  const bool rotate_daily =
+      prefs_->GetBoolean(prefs::kFingerprintRotateDaily);
+  const std::string current_day = GetCurrentLocalDay();
+  const bool seed_missing =
+      prefs_->GetString(kPersonaFingerprintProfileSaltPref).empty();
+  const bool day_changed =
+      rotate_daily &&
+      prefs_->GetString(prefs::kFingerprintLastRotationDay) != current_day;
+  if (seed_missing || day_changed) {
+    ReplaceFingerprintSeed(MakeFingerprintSalt());
+  }
+  if (rotate_daily) {
+    prefs_->SetString(prefs::kFingerprintLastRotationDay, current_day);
+  }
+}
