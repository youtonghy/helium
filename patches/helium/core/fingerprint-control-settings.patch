+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+export interface FingerprintSettings {
+  ok: boolean;
+  seed: string;
+  mode: 'fixed'|'random';
+  clearOnExit: boolean;
+  rotateDaily: boolean;
+  lastChanged: string;
+  generation: string;
+  error?: string;
+}
+
+export interface FingerprintBrowserProxy {
+  getFingerprintSettings(): Promise<FingerprintSettings>;
+  setFixedFingerprintSeed(seed: string): Promise<FingerprintSettings>;
+  generateRandomFingerprintSeed(): Promise<FingerprintSettings>;
+  setFingerprintAutomation(
+      clearOnExit: boolean, rotateDaily: boolean): Promise<FingerprintSettings>;
+}
+
+let instance: FingerprintBrowserProxy|null = null;
+
+export class FingerprintBrowserProxyImpl implements FingerprintBrowserProxy {
+  getFingerprintSettings() {
+    return sendWithPromise<FingerprintSettings>('getFingerprintSettings');
+  }
+
+  setFixedFingerprintSeed(seed: string) {
+    return sendWithPromise<FingerprintSettings>('setFixedFingerprintSeed', seed);
+  }
+
+  generateRandomFingerprintSeed() {
