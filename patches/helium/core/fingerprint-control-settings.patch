+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+import '../settings_page/settings_subpage.js';
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+
+import {I18nMixin} from 'chrome://resources/cr_elements/i18n_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import type {
+  FingerprintBrowserProxy,
+  FingerprintSettings,
+} from './fingerprint_browser_proxy.js';
+import {FingerprintBrowserProxyImpl} from './fingerprint_browser_proxy.js';
+import {getTemplate} from './fingerprint_page.html.js';
+
+const EMPTY_SETTINGS: FingerprintSettings = {
+  ok: false,
+  seed: '',
+  mode: 'random',
+  clearOnExit: false,
+  rotateDaily: false,
+  lastChanged: '',
+  generation: '0',
+};
+
+export class SettingsFingerprintPageElement extends I18nMixin(PolymerElement) {
+  static get is() {
+    return 'settings-fingerprint-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      routePath: String,
+      settings_: {type: Object, value: () => ({...EMPTY_SETTINGS})},
+      fixedSeed_: {type: String, value: ''},
+    };
+  }
+
+  declare routePath: string;
+  private declare settings_: FingerprintSettings;
+  private declare fixedSeed_: string;
+  private proxy_: FingerprintBrowserProxy =
+      FingerprintBrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    void this.loadSettings_();
+  }
+
+  private async loadSettings_() {
+    this.applySettings_(await this.proxy_.getFingerprintSettings());
+  }
+
+  private async onApplyFixedSeedClick_() {
+    this.applySettings_(
+        await this.proxy_.setFixedFingerprintSeed(this.fixedSeed_.trim()));
+  }
+
+  private async onGenerateRandomSeedClick_() {
+    this.applySettings_(await this.proxy_.generateRandomFingerprintSeed());
+  }
+
+  private async onClearOnExitChange_(event: Event) {
+    const clearOnExit = (event.target as HTMLInputElement).checked;
+    this.applySettings_(await this.proxy_.setFingerprintAutomation(
+        clearOnExit, this.settings_.rotateDaily));
+  }
+
+  private async onRotateDailyChange_(event: Event) {
+    const rotateDaily = (event.target as HTMLInputElement).checked;
+    this.applySettings_(await this.proxy_.setFingerprintAutomation(
+        this.settings_.clearOnExit, rotateDaily));
+  }
+
+  private applySettings_(settings: FingerprintSettings) {
+    this.settings_ = settings;
+    if (settings.mode === 'fixed') {
+      this.fixedSeed_ = settings.seed;
+    }
+  }
+
+  private isFixedMode_(mode: string) {
+    return mode === 'fixed';
+  }
+
+  private hasError_(error?: string) {
+    return error === 'invalid';
+  }
+
+  private isUnavailable_(error?: string) {
+    return error === 'unavailable';
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-fingerprint-page': SettingsFingerprintPageElement;
+  }
+}
+
+customElements.define(
+    SettingsFingerprintPageElement.is, SettingsFingerprintPageElement);
