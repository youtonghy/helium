+TEST(PersonaSnapshotMojomTraitsTest, RoundTripsWebGPUIdentity) {
+  HeliumPersonaSnapshot input;
+  input.enabled = true;
+  input.gpu_vendor = "persona-vendor";
+  input.webgpu_adapter = "legacy-description";
+  input.webgpu_architecture = "persona-architecture";
+  input.webgpu_device = "0xabcd";
+  input.webgpu_description = "persona-description";
+  input.gpu_driver = "persona-driver";
+
+  HeliumPersonaSnapshot output;
+  ASSERT_TRUE(mojo::test::SerializeAndDeserialize<
+              mojom::HeliumPersonaSnapshot>(input, output));
+
+  EXPECT_TRUE(output.enabled);
+  EXPECT_EQ(input.gpu_vendor, output.gpu_vendor);
+  EXPECT_EQ(input.webgpu_adapter, output.webgpu_adapter);
+  EXPECT_EQ(input.webgpu_architecture, output.webgpu_architecture);
+  EXPECT_EQ(input.webgpu_device, output.webgpu_device);
+  EXPECT_EQ(input.webgpu_description, output.webgpu_description);
+  EXPECT_EQ(input.gpu_driver, output.gpu_driver);
+}
+
