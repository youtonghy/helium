+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "third_party/blink/renderer/modules/webgpu/gpu_adapter_info_persona.h"
+
+#include "third_party/blink/public/common/helium_persona/persona_snapshot.h"
+
+namespace blink {
+
+GPUAdapterInfoPersonaData ApplyHeliumPersonaToGPUAdapterInfo(
+    const HeliumPersonaSnapshot* snapshot,
+    GPUAdapterInfoPersonaData data) {
+  if (!snapshot || !snapshot->IsEnabled()) {
+    return data;
+  }
+
+  data.vendor = String::FromUtf8(snapshot->gpu_vendor);
+  data.architecture = String::FromUtf8(snapshot->webgpu_architecture);
+  data.device = String::FromUtf8(snapshot->webgpu_device);
+  data.description = String::FromUtf8(snapshot->webgpu_description);
+  data.driver = String::FromUtf8(snapshot->gpu_driver);
+
+  // Developer diagnostics can reveal the real platform even after the public
+  // identity strings have been replaced. System Real mode retains them.
+  data.backend = String();
+  data.type = String();
+  data.d3d_shader_model = std::nullopt;
+  data.vk_driver_version = std::nullopt;
+  data.power_preference = String();
+  data.expose_memory_heaps = false;
+  return data;
+}
+
+}  // namespace blink
