+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "third_party/blink/renderer/modules/webgpu/gpu_adapter_info_persona.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/helium_persona/persona_snapshot.h"
+
+namespace blink {
+namespace {
+
+GPUAdapterInfoPersonaData MakeRealAdapterInfo() {
+  return {
+      .vendor = "real-vendor",
+      .architecture = "real-architecture",
+      .device = "0x1234",
+      .description = "real-description",
+      .driver = "real-driver",
+      .backend = "Metal",
+      .type = "integrated GPU",
+      .d3d_shader_model = 60,
+      .vk_driver_version = 123,
+      .power_preference = "high-performance",
+  };
+}
+
+TEST(GPUAdapterInfoPersonaTest, LeavesSystemRealDataUnchanged) {
+  GPUAdapterInfoPersonaData data =
+      ApplyHeliumPersonaToGPUAdapterInfo(nullptr, MakeRealAdapterInfo());
+
+  EXPECT_EQ(String("real-vendor"), data.vendor);
+  EXPECT_EQ(String("real-architecture"), data.architecture);
+  EXPECT_EQ(String("0x1234"), data.device);
+  EXPECT_EQ(String("real-driver"), data.driver);
+  EXPECT_EQ(String("Metal"), data.backend);
+  EXPECT_TRUE(data.d3d_shader_model.has_value());
+  EXPECT_TRUE(data.vk_driver_version.has_value());
+  EXPECT_TRUE(data.expose_memory_heaps);
+}
+
+TEST(GPUAdapterInfoPersonaTest, UsesPersonaValuesAndRedactsDiagnostics) {
+  HeliumPersonaSnapshot snapshot;
+  snapshot.enabled = true;
+  snapshot.gpu_vendor = "persona-vendor";
+  snapshot.webgpu_architecture = "persona-architecture";
+  snapshot.webgpu_device = "0xabcd";
+  snapshot.webgpu_description = "persona-description";
+  snapshot.gpu_driver = "persona-driver";
+
+  GPUAdapterInfoPersonaData data =
+      ApplyHeliumPersonaToGPUAdapterInfo(&snapshot, MakeRealAdapterInfo());
+
+  EXPECT_EQ(String("persona-vendor"), data.vendor);
+  EXPECT_EQ(String("persona-architecture"), data.architecture);
+  EXPECT_EQ(String("0xabcd"), data.device);
+  EXPECT_EQ(String("persona-description"), data.description);
+  EXPECT_EQ(String("persona-driver"), data.driver);
+  EXPECT_TRUE(data.backend.empty());
+  EXPECT_TRUE(data.type.empty());
+  EXPECT_FALSE(data.d3d_shader_model.has_value());
+  EXPECT_FALSE(data.vk_driver_version.has_value());
+  EXPECT_TRUE(data.power_preference.empty());
+  EXPECT_FALSE(data.expose_memory_heaps);
+}
+
+TEST(GPUAdapterInfoPersonaTest, EmptyPersonaValuesDoNotRevealRealData) {
+  HeliumPersonaSnapshot snapshot;
+  snapshot.enabled = true;
+
+  GPUAdapterInfoPersonaData data =
+      ApplyHeliumPersonaToGPUAdapterInfo(&snapshot, MakeRealAdapterInfo());
+
+  EXPECT_TRUE(data.vendor.empty());
+  EXPECT_TRUE(data.architecture.empty());
+  EXPECT_TRUE(data.device.empty());
+  EXPECT_TRUE(data.description.empty());
+  EXPECT_TRUE(data.driver.empty());
+}
+
+}  // namespace
