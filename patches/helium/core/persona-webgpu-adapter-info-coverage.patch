+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGPU_GPU_ADAPTER_INFO_PERSONA_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGPU_GPU_ADAPTER_INFO_PERSONA_H_
+
+#include <cstdint>
+#include <optional>
+
+#include "third_party/blink/renderer/modules/modules_export.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+struct HeliumPersonaSnapshot;
+
+struct MODULES_EXPORT GPUAdapterInfoPersonaData {
+  String vendor;
+  String architecture;
+  String device;
+  String description;
+  String driver;
+  String backend;
+  String type;
+  std::optional<uint32_t> d3d_shader_model;
+  std::optional<uint32_t> vk_driver_version;
+  String power_preference;
+  bool expose_memory_heaps = true;
+};
+
+MODULES_EXPORT GPUAdapterInfoPersonaData ApplyHeliumPersonaToGPUAdapterInfo(
+    const HeliumPersonaSnapshot* snapshot,
+    GPUAdapterInfoPersonaData data);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGPU_GPU_ADAPTER_INFO_PERSONA_H_
