+TEST_F(PersonaServiceTest, ImportMigratesLegacyWebGPUAdapterIdentity) {
+  base::DictValue state = service_->GetPersonaState();
+  const base::ListValue* presets = state.FindList("presets");
+  ASSERT_TRUE(presets);
+  ASSERT_FALSE(presets->empty());
+  base::DictValue payload = presets->front().GetDict().Clone();
+  const std::string* payload_id = payload.FindString("id");
+  ASSERT_TRUE(payload_id);
+  const std::string persona_id = *payload_id;
+  base::DictValue* gpu = payload.EnsureDict("gpu");
+  gpu->Set("webgpuAdapter", "Legacy Adapter Name");
+  gpu->Remove("webgpuArchitecture");
+  gpu->Remove("webgpuDevice");
+  gpu->Remove("webgpuDescription");
+  gpu->Remove("driver");
+
+  base::ListValue personas;
+  personas.Append(std::move(payload));
+  base::DictValue bundle;
+  bundle.Set("schema", "helium.persona/v1");
+  bundle.Set("personas", std::move(personas));
+
+  base::DictValue response = service_->ImportPersonas(bundle);
+
+  ASSERT_TRUE(response.FindBool("ok").value_or(false));
+  const base::DictValue* response_state = response.FindDict("state");
+  ASSERT_TRUE(response_state);
+  const base::DictValue* imported =
+      FindPersona(response_state->FindList("personas"), persona_id);
+  ASSERT_TRUE(imported);
+  const base::DictValue* imported_gpu = imported->FindDict("gpu");
+  ASSERT_TRUE(imported_gpu);
+  const std::string* webgpu_description =
+      imported_gpu->FindString("webgpuDescription");
+  const std::string* webgpu_adapter = imported_gpu->FindString("webgpuAdapter");
+  const std::string* webgpu_architecture =
+      imported_gpu->FindString("webgpuArchitecture");
+  const std::string* webgpu_device = imported_gpu->FindString("webgpuDevice");
+  const std::string* driver = imported_gpu->FindString("driver");
+  ASSERT_TRUE(webgpu_description);
+  ASSERT_TRUE(webgpu_adapter);
+  ASSERT_TRUE(webgpu_architecture);
+  ASSERT_TRUE(webgpu_device);
+  ASSERT_TRUE(driver);
+  EXPECT_EQ("Legacy Adapter Name", *webgpu_description);
+  EXPECT_EQ("Legacy Adapter Name", *webgpu_adapter);
+  EXPECT_TRUE(webgpu_architecture->empty());
+  EXPECT_TRUE(webgpu_device->empty());
+  EXPECT_TRUE(driver->empty());
+
+  ASSERT_TRUE(service_->SetActivePersona(persona_id)
+                  .FindBool("ok")
+                  .value_or(false));
+  const blink::HeliumPersonaSnapshot snapshot = service_->GetActiveSnapshot();
+  EXPECT_EQ("Legacy Adapter Name", snapshot.webgpu_description);
+  EXPECT_TRUE(snapshot.webgpu_architecture.empty());
+  EXPECT_TRUE(snapshot.webgpu_device.empty());
+  EXPECT_TRUE(snapshot.gpu_driver.empty());
+}
