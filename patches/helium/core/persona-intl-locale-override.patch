+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/inspector/persona_locale_coordinator.h"
+
+#include <algorithm>
+
+#include "third_party/blink/public/web/web_persona_locale.h"
+#include "third_party/blink/renderer/core/inspector/locale_controller.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+PersonaLocaleCoordinator& PersonaLocaleCoordinator::GetInstance() {
+  static base::NoDestructor<PersonaLocaleCoordinator> instance;
+  return *instance;
+}
+
+void PersonaLocaleCoordinator::Update(const void* client,
+                                      bool is_main_frame,
+                                      const std::string& locale) {
+  CHECK(client);
+  base::AutoLock lock(lock_);
+  auto it = std::find_if(requests_.begin(), requests_.end(),
+                         [client](const Request& request) {
+                           return request.client == client;
+                         });
+  if (locale.empty()) {
+    if (it != requests_.end()) {
+      requests_.erase(it);
+    }
+  } else if (it != requests_.end()) {
+    it->is_main_frame = is_main_frame;
+    it->locale = locale;
+  } else {
+    requests_.push_back({client, is_main_frame, locale});
+  }
+  RecomputeLocked();
+}
+
+void PersonaLocaleCoordinator::Clear(const void* client) {
+  base::AutoLock lock(lock_);
+  std::erase_if(requests_, [client](const Request& request) {
+    return request.client == client;
+  });
+  RecomputeLocked();
+}
+
+std::string PersonaLocaleCoordinator::PickEffectiveLocked() const {
+  std::string latest;
+  for (const Request& request : requests_) {
+    if (request.is_main_frame) {
+      return request.locale;
+    }
+    latest = request.locale;
+  }
+  return latest;
+}
+
+void PersonaLocaleCoordinator::RecomputeLocked() {
+  const std::string effective = PickEffectiveLocked();
+  if (effective.empty()) {
+    if (owns_override_) {
+      LocaleController::instance().SetLocaleOverride(String(), false);
+      owns_override_ = false;
+      active_locale_.clear();
+    }
+    return;
+  }
+  if (owns_override_ && effective == active_locale_) {
+    return;
+  }
+
+  const String error = LocaleController::instance().SetLocaleOverride(
+      String::FromUtf8(base::as_byte_span(effective)), !owns_override_);
+  if (error.empty()) {
+    owns_override_ = true;
+    active_locale_ = effective;
+  }
+}
+
+void UpdatePersonaLocale(const void* client,
+                         bool is_main_frame,
+                         const std::string& locale) {
+  PersonaLocaleCoordinator::GetInstance().Update(client, is_main_frame, locale);
+}
+
+void ClearPersonaLocale(const void* client) {
+  PersonaLocaleCoordinator::GetInstance().Clear(client);
+}
+
+}  // namespace blink
