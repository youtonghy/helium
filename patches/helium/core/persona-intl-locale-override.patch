+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_INSPECTOR_PERSONA_LOCALE_COORDINATOR_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_INSPECTOR_PERSONA_LOCALE_COORDINATOR_H_
+
+#include <string>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+
+namespace blink {
+
+class PersonaLocaleCoordinator {
+ public:
+  PersonaLocaleCoordinator(const PersonaLocaleCoordinator&) = delete;
+  PersonaLocaleCoordinator& operator=(const PersonaLocaleCoordinator&) = delete;
+
+  static PersonaLocaleCoordinator& GetInstance();
+  void Update(const void* client,
+              bool is_main_frame,
+              const std::string& locale);
+  void Clear(const void* client);
+
+ private:
+  friend class base::NoDestructor<PersonaLocaleCoordinator>;
+
+  struct Request {
+    const void* client;
+    bool is_main_frame;
+    std::string locale;
+  };
+
+  PersonaLocaleCoordinator() = default;
+  ~PersonaLocaleCoordinator() = default;
+
+  std::string PickEffectiveLocked() const EXCLUSIVE_LOCKS_REQUIRED(lock_);
+  void RecomputeLocked() EXCLUSIVE_LOCKS_REQUIRED(lock_);
+
+  base::Lock lock_;
+  std::vector<Request> requests_ GUARDED_BY(lock_);
+  bool owns_override_ GUARDED_BY(lock_) = false;
+  std::string active_locale_ GUARDED_BY(lock_);
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_INSPECTOR_PERSONA_LOCALE_COORDINATOR_H_
