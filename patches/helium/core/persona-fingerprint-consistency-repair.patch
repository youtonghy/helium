+class PersonaFingerprintConsistencyBrowserTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&HandleFingerprintPage));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    ASSERT_TRUE(content::NavigateToURL(contents(), PageURL()));
+  }
+
+  content::WebContents* contents() {
+    return browser()->tab_strip_model()->GetActiveWebContents();
+  }
+  PersonaService* service() {
+    return PersonaServiceFactory::GetForProfile(browser()->profile());
+  }
+  GURL PageURL() {
+    return embedded_test_server()->GetURL("/fingerprint-consistency.html");
+  }
+
+  base::DictValue CreateProfile() {
+    auto created = service()->CreatePersonaProfile("Consistency");
+    const auto* id = created.FindString("personaId");
+    CHECK(id);
+    for (const auto& value : *created.FindDict("state")->FindList("personas")) {
+      if (*value.GetDict().FindString("id") == *id) {
+        auto profile = value.GetDict().Clone();
+        auto* advanced = profile.EnsureDict("advanced");
+        advanced->Set("fontMetricNoise", true);
+        advanced->Set("clientRectNoise", true);
+        advanced->Set("canvasNoise", true);
+        profile.EnsureDict("region")->Set("locale", "en-US");
+        profile.EnsureDict("region")->Set("acceptLanguage", "en-US,en;q=0.9");
+        CHECK(service()->SavePersona(profile).FindBool("ok").value_or(false));
+        return profile;
+      }
+    }
+    NOTREACHED();
+  }
+
+  void Activate(const std::string& id) {
+    base::test::TestFuture<base::DictValue> result;
+    service()->SetActivePersona(id, result.GetCallback());
+    ASSERT_TRUE(result.Take().FindBool("ok").value_or(false));
+    ASSERT_TRUE(content::NavigateToURL(contents(), PageURL()));
+  }
+};
