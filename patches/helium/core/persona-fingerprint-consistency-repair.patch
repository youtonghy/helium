+base::DictValue PersonaFieldDiagnostics(const base::DictValue& persona) {
+  base::DictValue diagnostics;
+  for (auto path : kUnsupportedPersonaFields) {
+    if (FindPersonaPath(persona, path)) {
+      diagnostics.Set(path, "unsupported");
+    }
+  }
+  return diagnostics;
