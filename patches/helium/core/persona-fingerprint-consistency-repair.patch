+void RejectUnsupportedPersonaChanges(const base::DictValue& candidate,
+                                     const base::DictValue& existing,
+                                     base::DictValue* errors) {
+  for (auto path : kUnsupportedPersonaFields) {
+    const base::Value* requested = FindPersonaPath(candidate, path);
+    const base::Value* saved = FindPersonaPath(existing, path);
+    if (requested && (!saved || *requested != *saved)) {
+      errors->Set(path, "unsupported");
+    }
+  }
+}
