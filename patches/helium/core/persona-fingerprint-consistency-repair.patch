+      snapshot && snapshot->device_scale_factor > 0) {
+    // Layout zoom includes the host scale and page zoom. Replace only the
+    // host scale, leaving page/CSS zoom and actual layout geometry intact.
+    const float host_scale = GetChromeClient().WindowToViewportScalar(
+        const_cast<LocalFrame*>(this), 1.0f);
+    if (host_scale > 0) {
+      ratio *= snapshot->device_scale_factor / host_scale;
+    }
+  }
   return ratio;
 }
 
