+export interface PersonaEffectiveDifference {
+  field: string;
+  requested: string;
+  effective: string;
+}
+
+export function personaEffectiveDifferences(
+    requested: Record<string, unknown>, effective: Record<string, unknown>,
+    fields: string[]): PersonaEffectiveDifference[] {
+  const atPath = (record: Record<string, unknown>, path: string): unknown => {
+    let value: unknown = record;
+    for (const key of path.split('.')) {
+      value = asObject(value)[key];
+    }
+    return value;
+  };
+  const display = (value: unknown): string =>
+      typeof value === 'string' ? value : JSON.stringify(value) ?? '';
+  return fields.map(field => ({
+    field,
+    requested: display(atPath(requested, field)),
+    effective: display(atPath(effective, field)),
+  }));
+}
