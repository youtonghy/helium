+double PersonaMeasurementNoise(const NoiseToken& token,
+                               std::string_view measurement) {
+  const auto key = base::U64ToBigEndian(token.Value());
+  const auto digest =
+      crypto::hmac::SignSha256(key, base::as_byte_span(measurement));
+  const uint32_t sample = base::U32FromBigEndian(base::span(digest).first<4>());
+  return (static_cast<double>(sample) / 4294967295.0) * 2.0 - 1.0;
+}
+
+namespace {
+
+double PersonaCoordinate(double value, const NoiseToken& token, char axis) {
+  if (!std::isfinite(value) || value == 0 || std::abs(value) > 1e7) {
+    return value;
+  }
+  const double lower = std::floor(value);
+  auto offset = [&](double knot) {
+    if (knot == 0) {
+      return 0.0;
+    }
+    return 0.01 *
+           PersonaMeasurementNoise(token, std::string("rect-v2/") + axis + "/" +
+                                              base::NumberToString(knot));
+  };
+  // Adjacent knots differ by at most .02, so the slope is always positive.
+  return value + std::lerp(offset(lower), offset(lower + 1), value - lower);
+}
+
+}  // namespace
+
+gfx::RectF ApplyPersonaClientRectNoise(const gfx::RectF& rect,
+                                       const NoiseToken& token) {
+  if (!std::isfinite(rect.x()) || !std::isfinite(rect.y()) ||
+      !std::isfinite(rect.right()) || !std::isfinite(rect.bottom())) {
+    return rect;
+  }
+  const float left = PersonaCoordinate(rect.x(), token, 'x');
+  const float top = PersonaCoordinate(rect.y(), token, 'y');
+  const float right = PersonaCoordinate(rect.right(), token, 'x');
+  const float bottom = PersonaCoordinate(rect.bottom(), token, 'y');
+  return gfx::RectF(left, top, std::max(0.0f, right - left),
+                    std::max(0.0f, bottom - top));
+}
+
+gfx::RectF ApplyPersonaClientRectNoise(const gfx::RectF& rect,
+                                       ExecutionContext* context) {
+  return context && context->ClientRectNoiseToken()
+             ? ApplyPersonaClientRectNoise(rect,
+                                           *context->ClientRectNoiseToken())
+             : rect;
+}
