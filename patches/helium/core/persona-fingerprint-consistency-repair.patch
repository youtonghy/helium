+std::unique_ptr<net::test_server::HttpResponse> HandleFingerprintPage(
+    const net::test_server::HttpRequest& request) {
+  if (request.relative_url != "/fingerprint-consistency.html" &&
+      request.relative_url != "/fingerprint-worker.js") {
+    return nullptr;
+  }
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  if (request.relative_url == "/fingerprint-worker.js") {
+    response->set_content_type("application/javascript");
+    response->set_content(R"JS(
+      const canvas = new OffscreenCanvas(200, 40);
+      const ctx = canvas.getContext('2d');
+      ctx.font = '16px sans-serif';
+      self.onmessage = () => self.postMessage({
+        language: navigator.language,
+        width: ctx.measureText('worker measurement').width,
+      });
+    )JS");
+  } else {
+    response->set_content_type("text/html");
+    response->set_content(R"HTML(
+      <!doctype html><title>Fingerprint consistency</title>
+      <script>
+        window.worker = new Worker('/fingerprint-worker.js');
+        window.workerReady = new Promise(resolve => {
+          worker.onmessage = event => resolve(event.data);
+          worker.postMessage('measure');
+        });
+      </script>
+    )HTML");
+  }
+  return response;
+}
+
+constexpr char kScreenConsistency[] = R"JS(
+  (async () => {
+    await new Promise(resolve => requestAnimationFrame(resolve));
+    return {
+      width: screen.width, height: screen.height, dpr: devicePixelRatio,
+      consistent: matchMedia(`(device-width: ${screen.width}px)`).matches &&
+          matchMedia(`(device-height: ${screen.height}px)`).matches &&
+          matchMedia(`(resolution: ${devicePixelRatio}dppx)`).matches &&
+          matchMedia(`(color: ${screen.colorDepth / 3})`).matches,
+      viewportIsActual: matchMedia(`(width: ${innerWidth}px)`).matches,
+    };
+  })()
+)JS";
+
+constexpr char kGeometryConsistency[] = R"JS(
+  (() => {
+    document.body.innerHTML = `
+      <div id="box" style="position:absolute;left:12.25px;top:19.5px;
+          width:123.25px;height:36.5px"></div>
+      <div id="lines" style="position:absolute;left:21px;top:67px;
+          width:80px;font:16px sans-serif">one two three four five six seven</div>`;
+    const vector = rect => [rect.x, rect.y, rect.width, rect.height];
+    const equal = (a, b) => a.every((v, i) => Math.abs(v - b[i]) < 0.00002);
+    const box = document.getElementById('box');
+    const selected = document.createRange();
+    selected.selectNode(box);
+    const elementRect = vector(box.getBoundingClientRect());
+    const rangeRect = vector(selected.getBoundingClientRect());
+    const fragments = document.createRange();
+    fragments.selectNodeContents(document.getElementById('lines'));
+    const rects = Array.from(fragments.getClientRects()).filter(r => r.width && r.height);
+    const bounds = fragments.getBoundingClientRect();
+    const finite = rects.every(r => vector(r).every(Number.isFinite) && r.width >= 0 && r.height >= 0);
+    const union = rects.length > 1 &&
+        Math.abs(bounds.left - Math.min(...rects.map(r => r.left))) < 0.00002 &&
+        Math.abs(bounds.top - Math.min(...rects.map(r => r.top))) < 0.00002 &&
+        Math.abs(bounds.right - Math.max(...rects.map(r => r.right))) < 0.00002 &&
+        Math.abs(bounds.bottom - Math.max(...rects.map(r => r.bottom))) < 0.00002;
+    return {
+      elementRect,
+      consistent: equal(elementRect, rangeRect) &&
+          equal(elementRect, vector(box.getClientRects()[0])) &&
+          equal(rangeRect, vector(selected.getClientRects()[0])),
+      stable: equal(elementRect, vector(box.getBoundingClientRect())),
+      finite, union,
+    };
+  })()
+)JS";
+
+constexpr char kWebGLReadback[] = R"JS(
+  (() => {
+    const gl = document.createElement('canvas').getContext('webgl');
+    if (!gl) return {supported: false};
+    const line = Array.from(gl.getParameter(gl.ALIASED_LINE_WIDTH_RANGE));
+    const point = Array.from(gl.getParameter(gl.ALIASED_POINT_SIZE_RANGE));
+    const caps = [line, point];
+    for (const shader of [gl.VERTEX_SHADER, gl.FRAGMENT_SHADER]) {
+      for (const type of [gl.LOW_FLOAT, gl.MEDIUM_FLOAT, gl.HIGH_FLOAT,
+                          gl.LOW_INT, gl.MEDIUM_INT, gl.HIGH_INT]) {
+        const precision = gl.getShaderPrecisionFormat(shader, type);
+        caps.push([precision.rangeMin, precision.rangeMax, precision.precision]);
+      }
+    }
+    gl.clearColor(.3, .4, .5, 1);
+    gl.clear(gl.COLOR_BUFFER_BIT);
+    const pixels = new Uint8Array(32 * 16 * 4);
+    const again = new Uint8Array(pixels.length);
+    gl.readPixels(0, 0, 32, 16, gl.RGBA, gl.UNSIGNED_BYTE, pixels);
+    gl.readPixels(0, 0, 32, 16, gl.RGBA, gl.UNSIGNED_BYTE, again);
+    return {supported: true, caps: JSON.stringify(caps),
+      ordered: line[0] <= line[1] && point[0] <= point[1] && caps.flat().every(Number.isFinite),
+      pixels: Array.from(pixels).join(','),
+      stable: pixels.every((value, index) => value === again[index]),
+      error: gl.getError()};
+  })()
+)JS";
