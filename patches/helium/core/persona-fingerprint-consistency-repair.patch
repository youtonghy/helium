+IN_PROC_BROWSER_TEST_F(PersonaFingerprintConsistencyBrowserTest,
+                       ScreenMediaAndDprAgreeInMainAndCrossOriginFrames) {
+  auto profile = CreateProfile();
+  const auto* id = profile.FindString("id");
+  profile.EnsureDict("screen")->Set("width", 2400);
+  profile.EnsureDict("screen")->Set("height", 1600);
+  profile.EnsureDict("screen")->Set("deviceScaleFactor", 1.25);
+  ASSERT_TRUE(service()->SavePersona(profile).FindBool("ok").value_or(false));
+  Activate(*id);
+  const auto child_url =
+      embedded_test_server()->GetURL("b.test", "/title1.html");
+  ASSERT_EQ(true, content::EvalJs(contents(), content::JsReplace(R"JS(
+    new Promise(resolve => {
+      const frame = document.createElement('iframe');
+      frame.onload = () => resolve(true);
+      frame.src = $1;
+      document.body.append(frame);
+    })
+  )JS",
+                                                                 child_url)));
+  for (double zoom : {1.0, 1.5, 2.0}) {
+    content::HostZoomMap::SetZoomLevel(contents(),
+                                       blink::ZoomFactorToZoomLevel(zoom));
+    for (auto* frame :
+         {contents()->GetPrimaryMainFrame(),
+          content::ChildFrameAt(contents()->GetPrimaryMainFrame(), 0)}) {
+      ASSERT_TRUE(frame);
+      const auto values =
+          content::EvalJs(frame, kScreenConsistency).ExtractDict().Clone();
+      EXPECT_EQ(2400, values.FindInt("width").value_or(0));
+      EXPECT_EQ(1600, values.FindInt("height").value_or(0));
+      EXPECT_NEAR(1.25 * zoom, values.FindDouble("dpr").value_or(0), 0.00001);
+      EXPECT_TRUE(values.FindBool("consistent").value_or(false));
+      EXPECT_TRUE(values.FindBool("viewportIsActual").value_or(false));
+    }
+  }
+}
