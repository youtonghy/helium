+TEST_F(TextMetricsTest, FontMetricNoisePreservesRelatedExtendedMeasurements) {
+  auto* painter =
+      MakeGarbageCollected<PlainTextPainter>(PlainTextPainter::kCanvas);
+  const String text = "test text";
+  auto* metrics = MakeGarbageCollected<TextMetrics>(
+      GetFont(kLatinFont), TextDirection::kLtr,
+      V8CanvasTextBaseline::Enum::kAlphabetic, V8CanvasTextAlign::Enum::kLeft,
+      text, *painter);
+  const double raw_width = metrics->width();
+  DummyExceptionStateForTesting exception_state;
+  const auto raw_selection =
+      metrics->getSelectionRects(0, text.length(), exception_state);
+  const auto* raw_box =
+      metrics->getActualBoundingBox(0, text.length(), exception_state);
+  metrics->ApplyFontMetricNoise(NoiseToken(1234567));
+  const double scale = metrics->width() / raw_width;
+  const auto selection =
+      metrics->getSelectionRects(0, text.length(), exception_state);
+  ASSERT_EQ(raw_selection.size(), selection.size());
+  for (wtf_size_t i = 0; i < selection.size(); ++i) {
+    EXPECT_DOUBLE_EQ(raw_selection[i]->width() * scale, selection[i]->width());
+    EXPECT_DOUBLE_EQ(-metrics->fontBoundingBoxAscent(), selection[i]->y());
+    EXPECT_DOUBLE_EQ(
+        metrics->fontBoundingBoxAscent() + metrics->fontBoundingBoxDescent(),
+        selection[i]->height());
+  }
+  const auto* box =
+      metrics->getActualBoundingBox(0, text.length(), exception_state);
+  EXPECT_DOUBLE_EQ(raw_box->width() * scale, box->width());
+  EXPECT_EQ(text.length(), metrics->getIndexFromOffset(metrics->width()));
+  const double once = metrics->width();
+  metrics->ApplyFontMetricNoise(NoiseToken(1234567));
+  EXPECT_EQ(once, metrics->width());
+  metrics->ApplyFontMetricNoise(NoiseToken(7654321));
+  EXPECT_NE(once, metrics->width());
+}
+
+TEST_F(TextMetricsTest, FontMetricNoiseSeparatesFontSizeAndKeepsEmptyWidth) {
+  auto* painter =
+      MakeGarbageCollected<PlainTextPainter>(PlainTextPainter::kCanvas);
+  FontDescription::VariantLigatures ligatures;
+  const auto* large_font = blink::test::CreateTestFont(
+      AtomicString("Roboto"),
+      blink::test::PlatformTestDataPath(
+          "third_party/Roboto/roboto-regular.woff2"),
+      24.0, &ligatures);
+  auto measure = [&](const Font* font, const String& text) {
+    return MakeGarbageCollected<TextMetrics>(
+        font, TextDirection::kLtr, V8CanvasTextBaseline::Enum::kAlphabetic,
+        V8CanvasTextAlign::Enum::kLeft, text, *painter);
+  };
+  auto* small = measure(GetFont(kLatinFont), "size check");
+  auto* large = measure(large_font, "size check");
+  const double small_raw = small->width();
+  const double large_raw = large->width();
+  small->ApplyFontMetricNoise(NoiseToken(1234567));
+  large->ApplyFontMetricNoise(NoiseToken(1234567));
+  EXPECT_NE(small->width() - small_raw, large->width() - large_raw);
+  EXPECT_NEAR(small_raw, small->width(), 0.01001);
+  EXPECT_NEAR(large_raw, large->width(), 0.01001);
+  auto* empty = measure(GetFont(kLatinFont), "");
+  empty->ApplyFontMetricNoise(NoiseToken(1234567));
+  EXPECT_EQ(0, empty->width());
+  EXPECT_EQ(0, empty->actualBoundingBoxLeft());
+  EXPECT_EQ(0, empty->actualBoundingBoxRight());
+}
