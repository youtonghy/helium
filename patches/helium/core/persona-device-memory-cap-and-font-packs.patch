+base::ListValue MakeFontFamiliesForPersona(std::string_view platform,
+                                           std::string_view locale) {
+  base::span<const char* const> base_fonts = kMacBaseFonts;
+  if (platform == "Windows") {
+    base_fonts = kWindowsBaseFonts;
+  } else if (platform == "Linux") {
+    base_fonts = kLinuxBaseFonts;
+  }
+
+  const std::string_view script = ResolveFontScript(locale);
+  base::span<const char* const> script_fonts;
+  if (platform == "Windows") {
+    if (script == "hans") {
+      script_fonts = kWindowsHansFonts;
+    } else if (script == "hant") {
+      script_fonts = kWindowsHantFonts;
+    } else if (script == "ja") {
+      script_fonts = kWindowsJapaneseFonts;
+    } else if (script == "ko") {
+      script_fonts = kWindowsKoreanFonts;
+    }
+  } else if (platform == "Linux") {
+    if (script == "hans") {
+      script_fonts = kLinuxHansFonts;
+    } else if (script == "hant") {
+      script_fonts = kLinuxHantFonts;
+    } else if (script == "ja") {
+      script_fonts = kLinuxJapaneseFonts;
+    } else if (script == "ko") {
+      script_fonts = kLinuxKoreanFonts;
+    }
+  } else {
+    if (script == "hans") {
+      script_fonts = kMacHansFonts;
+    } else if (script == "hant") {
+      script_fonts = kMacHantFonts;
+    } else if (script == "ja") {
+      script_fonts = kMacJapaneseFonts;
+    } else if (script == "ko") {
+      script_fonts = kMacKoreanFonts;
+    }
+  }
+
+  base::ListValue families;
+  for (const char* family : base_fonts) {
+    families.Append(family);
+  }
+  for (const char* family : script_fonts) {
+    families.Append(family);
+  }
+  return families;
+}
