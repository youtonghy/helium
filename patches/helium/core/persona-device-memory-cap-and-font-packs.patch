+TEST_F(PersonaServiceTest, PresetFontPacksMatchPlatformAndLanguage) {
+  const base::DictValue state = service_->GetPersonaState();
+  const base::ListValue* presets = state.FindList("presets");
+  ASSERT_TRUE(presets);
+
+  // Families that only ship on one OS, and CJK families that must never appear
+  // on a persona whose language does not call for them.
+  static constexpr auto kWindowsOnly = std::to_array<const char*>(
+      {"Segoe UI", "Calibri", "Consolas", "Tahoma"});
+  static constexpr auto kMacOnly = std::to_array<const char*>(
+      {"Helvetica Neue", "Menlo", "Lucida Grande"});
+  static constexpr auto kCjkFonts = std::to_array<const char*>(
+      {"Microsoft YaHei", "SimSun", "MingLiU", "MS Gothic", "Meiryo",
+       "Malgun Gothic", "PingFang SC", "PingFang TC", "Hiragino Sans",
+       "Apple SD Gothic Neo", "Noto Sans CJK SC", "Noto Sans CJK JP"});
+
+  for (const auto& value : *presets) {
+    ASSERT_TRUE(value.is_dict());
+    const base::DictValue& preset = value.GetDict();
+    const std::string* id = preset.FindString("id");
+    const std::string* platform = preset.FindString("platform");
+    ASSERT_TRUE(id);
+    ASSERT_TRUE(platform);
+    SCOPED_TRACE(*id);
+
+    const base::DictValue* region = preset.FindDict("region");
+    ASSERT_TRUE(region);
+    const std::string* locale = region->FindString("locale");
+    ASSERT_TRUE(locale);
+
+    const base::ListValue* families =
+        preset.FindDict("fonts")
+            ? preset.FindDict("fonts")->FindList("families")
+            : nullptr;
+    ASSERT_TRUE(families);
+
+    std::vector<std::string> names;
+    for (const auto& family : *families) {
+      ASSERT_TRUE(family.is_string());
+      names.push_back(family.GetString());
+    }
+    const auto has = [&names](std::string_view needle) {
+      return std::ranges::find(names, needle) != names.end();
+    };
+
+    // A four-family list is more identifying than a full system set.
+    EXPECT_GE(names.size(), 15u);
+
+    if (*platform == "Windows") {
+      EXPECT_TRUE(has("Segoe UI"));
+      for (const char* mac_only : kMacOnly) {
+        EXPECT_FALSE(has(mac_only)) << mac_only;
+      }
+    } else if (*platform == "macOS") {
+      EXPECT_TRUE(has("Helvetica Neue"));
+      for (const char* windows_only : kWindowsOnly) {
+        EXPECT_FALSE(has(windows_only)) << windows_only;
+      }
+    }
+
+    const bool is_cjk_locale = locale->starts_with("zh") ||
+                               locale->starts_with("ja") ||
+                               locale->starts_with("ko");
+    if (!is_cjk_locale) {
+      for (const char* cjk : kCjkFonts) {
+        EXPECT_FALSE(has(cjk)) << *locale << " must not claim " << cjk;
+      }
+    }
+  }
+}
 
