+// Which CJK supplement, if any, a BCP 47 locale calls for. Empty means the
+// Western base set alone is correct for this persona.
+std::string_view ResolveFontScript(std::string_view locale) {
+  const std::string lower = base::ToLowerASCII(locale);
+  const std::vector<std::string> parts = base::SplitString(
+      lower, "-_", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (parts.empty()) {
+    return "";
+  }
+  const std::string& language = parts.front();
+  if (language == "ja") {
+    return "ja";
+  }
+  if (language == "ko") {
+    return "ko";
+  }
+  if (language != "zh") {
+    return "";
+  }
+  // An explicit script subtag wins over the region; otherwise the region
+  // decides, since zh-TW/HK/MO ship Traditional and zh-CN/SG ship Simplified.
+  for (const std::string& part : parts) {
+    if (part == "hans") {
+      return "hans";
+    }
+    if (part == "hant") {
+      return "hant";
+    }
+    if (part == "tw" || part == "hk" || part == "mo") {
+      return "hant";
+    }
+  }
+  return "hans";
+}
