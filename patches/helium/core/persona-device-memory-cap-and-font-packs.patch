+/**
+ * Returns the CJK script a locale calls for, or '' when the Western base set
+ * alone is correct. An en-US persona must not advertise CJK faces.
+ */
+export function resolveFontScript(locale: string): string {
+  const parts = String(locale || '').toLowerCase().split(/[-_]/).filter(
+      part => part.length > 0);
+  if (parts.length === 0) {
+    return '';
+  }
+  const language = parts[0];
+  if (language === 'ja' || language === 'ko') {
+    return language;
+  }
+  if (language !== 'zh') {
+    return '';
+  }
+  for (const part of parts) {
+    if (part === 'hans' || part === 'hant') {
+      return part;
+    }
+    if (part === 'tw' || part === 'hk' || part === 'mo') {
+      return 'hant';
+    }
+  }
+  return 'hans';
