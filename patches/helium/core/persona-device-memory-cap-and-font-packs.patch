+  if (platform === 'Windows') {
+    base = WINDOWS_BASE_FONTS;
+  } else if (platform === 'Linux') {
+    base = LINUX_BASE_FONTS;
+  }
+  const script = resolveFontScript(locale);
+  const perPlatform = SCRIPT_FONTS[platform] || SCRIPT_FONTS['macOS'];
+  const scriptFonts = script ? (perPlatform[script] || []) : [];
+  return [...base, ...scriptFonts];
+}
