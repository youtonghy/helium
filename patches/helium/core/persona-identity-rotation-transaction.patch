+void RestartPersonaExecutionContexts(Profile* profile,
+                                     base::OnceClosure callback) {
+  std::vector<content::StoragePartition*> partitions;
+  profile->ForEachLoadedStoragePartition(
+      [&](content::StoragePartition* partition) {
+        partitions.push_back(partition);
+      });
+
+  base::OnceClosure reload_and_complete = base::BindOnce(
+      [](base::WeakPtr<Profile> profile, base::OnceClosure callback) {
+        if (profile) {
+          ReloadPersonaTabs(profile.get());
+        }
+        std::move(callback).Run();
+      },
+      profile->GetWeakPtr(), std::move(callback));
+  if (partitions.empty()) {
+    std::move(reload_and_complete).Run();
+    return;
+  }
+
+  base::RepeatingClosure stopped =
+      base::BarrierClosure(partitions.size(), std::move(reload_and_complete));
+  for (content::StoragePartition* partition : partitions) {
+    partition->GetSharedWorkerService()->TerminateAllWorkers();
+    partition->GetServiceWorkerContext()->StopAllServiceWorkers(stopped);
+  }
+}
+
