+namespace content {
+namespace {
+
+const char kTestUrl[] = "https://example.com/";
+
+class PersonaDenyBrowserClient : public ContentBrowserClient {
+ public:
+  blink::HeliumPersonaSnapshot GetHeliumPersonaSnapshot(
+      BrowserContext*) override {
+    blink::HeliumPersonaSnapshot snapshot;
+    snapshot.enabled = true;
+    snapshot.allow_contacts = false;
+    snapshot.allow_background_sync = false;
+    snapshot.allow_gamepads = false;
+    snapshot.allow_shape_detection = false;
+    snapshot.allow_web_nn = false;
+    return snapshot;
+  }
+};
+
+class PersonaInterfaceBinderFailClosedTest : public RenderViewHostTestHarness {
+ protected:
+  void SetUp() override {
+    RenderViewHostTestHarness::SetUp();
+    previous_client_ = SetBrowserClientForTesting(&browser_client_);
+    NavigateAndCommit(GURL(kTestUrl));
+  }
+
+  void TearDown() override {
+    SetBrowserClientForTesting(previous_client_);
+    RenderViewHostTestHarness::TearDown();
+  }
+
+  mojo::Remote<blink::mojom::BrowserInterfaceBroker> BindBroker() {
+    auto* rfh = static_cast<RenderFrameHostImpl*>(main_rfh());
+    // The harness may already have bound the broker to a stub renderer end.
+    // Reset so tests can drive GetInterface() from this process.
+    rfh->ResetBrowserInterfaceBrokerReceiverForTesting();
+    mojo::Remote<blink::mojom::BrowserInterfaceBroker> broker;
+    rfh->BindBrowserInterfaceBrokerReceiver(
+        broker.BindNewPipeAndPassReceiver());
+    return broker;
+  }
+
+  PersonaDenyBrowserClient browser_client_;
+  raw_ptr<ContentBrowserClient> previous_client_ = nullptr;
+};
+
+TEST_F(PersonaInterfaceBinderFailClosedTest,
+       DisabledContactsSelectSettlesWithNullopt) {
+  auto broker = BindBroker();
+  mojo::Remote<blink::mojom::ContactsManager> contacts;
+  broker->GetInterface(contacts.BindNewPipeAndPassReceiver());
+
+  base::RunLoop loop;
+  std::optional<std::vector<blink::mojom::ContactInfoPtr>> result =
+      std::vector<blink::mojom::ContactInfoPtr>();
+  contacts->Select(
+      /*multiple=*/false, /*include_names=*/true, /*include_emails=*/false,
+      /*include_tel=*/false, /*include_addresses=*/false,
+      /*include_icons=*/false,
+      base::BindLambdaForTesting(
+          [&](std::optional<std::vector<blink::mojom::ContactInfoPtr>>
+                  contacts_out) {
+            result = std::move(contacts_out);
+            loop.Quit();
+          }));
+  loop.Run();
+
+  EXPECT_EQ(std::nullopt, result);
+  EXPECT_TRUE(contacts.is_connected());
+}
+
+TEST_F(PersonaInterfaceBinderFailClosedTest,
+       DisabledBackgroundFetchSettlesWithPermissionDenied) {
+  auto broker = BindBroker();
+  mojo::Remote<blink::mojom::BackgroundFetchService> service;
+  broker->GetInterface(service.BindNewPipeAndPassReceiver());
+
+  base::RunLoop loop;
+  blink::mojom::BackgroundFetchError error =
+      blink::mojom::BackgroundFetchError::NONE;
+  service->Fetch(
+      /*service_worker_registration_id=*/1, /*developer_id=*/"persona-deny",
+      /*requests=*/{}, blink::mojom::BackgroundFetchOptions::New(), SkBitmap(),
+      blink::mojom::BackgroundFetchUkmData::New(),
+      base::BindLambdaForTesting(
+          [&](blink::mojom::BackgroundFetchError fetch_error,
+              blink::mojom::BackgroundFetchRegistrationPtr) {
+            error = fetch_error;
+            loop.Quit();
+          }));
+  loop.Run();
+
+  EXPECT_EQ(blink::mojom::BackgroundFetchError::PERMISSION_DENIED, error);
+  EXPECT_TRUE(service.is_connected());
+}
+
+TEST_F(PersonaInterfaceBinderFailClosedTest,
+       DisabledGamepadHapticsSettlesWithNotSupported) {
+  auto broker = BindBroker();
+  mojo::Remote<device::mojom::GamepadHapticsManager> haptics;
+  broker->GetInterface(haptics.BindNewPipeAndPassReceiver());
+
+  base::RunLoop loop;
+  device::mojom::GamepadHapticsResult result =
+      device::mojom::GamepadHapticsResult::GamepadHapticsResultComplete;
+  haptics->ResetVibrationActuator(
+      /*pad_index=*/0,
+      base::BindLambdaForTesting([&](device::mojom::GamepadHapticsResult r) {
+        result = r;
+        loop.Quit();
+      }));
+  loop.Run();
+
+  EXPECT_EQ(
+      device::mojom::GamepadHapticsResult::GamepadHapticsResultNotSupported,
+      result);
+  EXPECT_TRUE(haptics.is_connected());
+}
+
