+void NoiseF32PixelsImpl(const NoiseHash& token_hash,
+                        base::span<uint8_t> pixels,
+                        const int width,
+                        const int height,
+                        SkAlphaType alpha_type) {
+  CHECK_EQ(pixels.size(),
+           static_cast<size_t>(width * height) * kF32BytesPerPixel);
+  const size_t row_size = width * kF32BytesPerPixel;
+  std::vector<uint8_t> row1(row_size);
+  std::vector<uint8_t> row2(row_size);
+  base::span<uint8_t> unnoised_previous_row(row1);
+  base::span<uint8_t> unnoised_current_row(row2);
+
+  for (int y = 0; y < height; ++y) {
+    unnoised_current_row.copy_from(pixels.subspan(y * row_size, row_size));
+    for (int x = 0; x < width; ++x) {
+      auto pixel = GetF32PixelAt(x, y, width, pixels);
+      if (base::U64FromLittleEndian(pixel.first<8u>()) == 0u &&
+          base::U64FromLittleEndian(pixel.last<8u>()) == 0u) {
+        continue;
+      }
+      const auto previous_pixel = [&](int previous_x, int previous_y) {
+        return GetF32PixelAt(previous_x, previous_y, width, pixels);
+      };
+      if (y > 0 && x > 0 &&
+          GetF32PixelAt(x - 1, 0, width, unnoised_previous_row) == pixel) {
