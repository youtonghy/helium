+scoped_refptr<StaticBitmapImage> ApplyCanvasNoiseForExport(
+    scoped_refptr<StaticBitmapImage> image_bitmap,
+    ExecutionContext* execution_context) {
+  if (!image_bitmap || !execution_context ||
+      !execution_context->CanvasNoiseToken()) {
+    return image_bitmap;
+  }
+
+  const gfx::Size size = image_bitmap->Size();
+  const SkImageInfo source_info =
+      image_bitmap->PaintImageForCurrentFrame().GetSkImageInfo();
+  const SkAlphaType alpha_type =
+      source_info.alphaType() == kUnknown_SkAlphaType
+          ? kPremul_SkAlphaType
+          : source_info.alphaType();
+  const bool is_f16 = source_info.colorType() == kRGBA_F16_SkColorType;
+  const bool is_f16_normalized =
+      source_info.colorType() == kRGBA_F16Norm_SkColorType;
+  const bool is_f32 = source_info.colorType() == kRGBA_F32_SkColorType;
+  const bool is_floating_point = is_f16 || is_f16_normalized || is_f32;
+  const SkImageInfo info =
+      is_floating_point
+          ? SkImageInfo::Make(size.width(), size.height(),
+                              kRGBA_F16_SkColorType, alpha_type,
+                              source_info.refColorSpace())
+          : SkImageInfo::MakeN32(size.width(), size.height(), alpha_type,
+                                 source_info.refColorSpace());
+  Vector<uint8_t> pixels =
+      image_bitmap->CopyImageData(info, /*apply_orientation=*/false);
+  if (pixels.empty()) {
+    return nullptr;
+  }
+
+  if (is_floating_point) {
+    NoiseF16Pixels(NoiseHash(*execution_context->CanvasNoiseToken()),
+                   base::span(pixels), size.width(), size.height(), alpha_type,
+                   is_f16_normalized);
+  } else {
+    NoisePixels(NoiseHash(*execution_context->CanvasNoiseToken()),
+                base::span(pixels), size.width(), size.height());
+  }
+  scoped_refptr<StaticBitmapImage> noisy_bitmap = StaticBitmapImage::Create(
+      SkData::MakeWithCopy(pixels.data(), pixels.size()), info,
+      image_bitmap->Orientation());
+  if (!noisy_bitmap) {
+    return nullptr;
+  }
+  noisy_bitmap->SetOriginClean(image_bitmap->OriginClean());
+  return noisy_bitmap;
+}
