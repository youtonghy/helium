+TEST_F(NoiseHelperTest, ApplyCanvasNoiseForExportUsesExecutionContextToken) {
+  test::TaskEnvironment task_environment;
+  auto page = std::make_unique<DummyPageHolder>(gfx::Size(32, 32));
+  Document& document = page->GetDocument();
+  const SkImageInfo info = SkImageInfo::MakeN32Premul(32, 32);
+  sk_sp<SkSurface> surface = SkSurfaces::Raster(info);
+  ASSERT_TRUE(surface);
+  surface->getCanvas()->clear(SkColorSetRGB(37, 89, 143));
+  scoped_refptr<StaticBitmapImage> image =
+      UnacceleratedStaticBitmapImage::Create(surface->makeImageSnapshot());
+  ASSERT_TRUE(image);
+  const Vector<uint8_t> original =
+      image->CopyImageData(info, /*apply_orientation=*/false);
+
+  EXPECT_EQ(image, ApplyCanvasNoiseForExport(image, &document));
+  document.SetCanvasNoiseToken(NoiseToken(0x01234678901234567));
+  scoped_refptr<StaticBitmapImage> first =
+      ApplyCanvasNoiseForExport(image, &document);
+  scoped_refptr<StaticBitmapImage> second =
+      ApplyCanvasNoiseForExport(image, &document);
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  EXPECT_NE(original,
+            first->CopyImageData(info, /*apply_orientation=*/false));
+  EXPECT_EQ(first->CopyImageData(info, /*apply_orientation=*/false),
+            second->CopyImageData(info, /*apply_orientation=*/false));
