+
+void NoiseF16Pixel(base::span<uint8_t, kF16BytesPerPixel> pixel,
+                   NoiseHash& token_hash,
+                   SkAlphaType alpha_type,
+                   bool normalized) {
+  const uint16_t alpha = base::U16FromLittleEndian(
+      pixel.subspan(3u * kF16BytesPerChannel)
+          .first<kF16BytesPerChannel>());
+  for (size_t channel_index = 0; channel_index < 3u; ++channel_index) {
+    base::span<uint8_t, kF16BytesPerChannel> channel =
+        pixel.subspan(channel_index * kF16BytesPerChannel)
+            .first<kF16BytesPerChannel>();
+    const uint16_t value = base::U16FromLittleEndian(channel);
+    if (value == kF16SignMask ||
+        (value & kF16ExponentMask) == kF16ExponentMask) {
+      continue;
+    }
+
+    uint16_t minimum;
+    uint16_t maximum;
+    if (value & kF16SignMask) {
+      if (normalized) {
+        continue;
+      }
+      minimum = std::max<uint16_t>(kF16SignMask + 1u, value - 3u);
+      maximum = std::min<uint16_t>(kF16SignMask | kF16MaxFinite, value + 3u);
+    } else {
+      minimum = value > 3u ? value - 3u : 0u;
+      maximum = std::min<uint16_t>(kF16MaxFinite, value + 3u);
+      if (normalized) {
+        if (value > kF16NormalizedOne) {
+          continue;
+        }
+        maximum = std::min(maximum, kF16NormalizedOne);
+      }
+      if (alpha_type == kPremul_SkAlphaType &&
+          !(alpha & kF16SignMask) &&
+          (alpha & kF16ExponentMask) != kF16ExponentMask && value <= alpha) {
+        maximum = std::min(maximum, alpha);
+      }
+    }
+    if (minimum > maximum) {
+      continue;
+    }
+    const uint16_t noised_value = base::checked_cast<uint16_t>(
+        minimum + token_hash.GetValueBelow(maximum - minimum + 1));
+    base::SpanWriter writer(channel);
+    writer.WriteU16LittleEndian(noised_value);
+  }
+}
+
+void NoiseF16PixelsImpl(const NoiseHash& token_hash,
+                        base::span<uint8_t> pixels,
+                        const int width,
+                        const int height,
+                        SkAlphaType alpha_type,
+                        bool normalized) {
+  CHECK_EQ(pixels.size(),
+           static_cast<size_t>(width * height) * kF16BytesPerPixel);
+  const size_t row_size = width * kF16BytesPerPixel;
+  std::vector<uint8_t> row1(row_size);
+  std::vector<uint8_t> row2(row_size);
+  base::span<uint8_t> unnoised_previous_row(row1);
+  base::span<uint8_t> unnoised_current_row(row2);
+
+  for (int y = 0; y < height; ++y) {
+    unnoised_current_row.copy_from(pixels.subspan(y * row_size, row_size));
+    for (int x = 0; x < width; ++x) {
+      auto pixel = GetF16PixelAt(x, y, width, pixels);
+      if (base::U64FromLittleEndian(pixel) == 0u) {
+        continue;
+      }
+      if (y > 0 && x > 0 &&
+          GetF16PixelAt(x - 1, 0, width, unnoised_previous_row) == pixel) {
+        CopyF16PixelValue(GetF16PixelAt(x - 1, y - 1, width, pixels), pixel);
+      } else if (y > 0 &&
+                 GetF16PixelAt(x, 0, width, unnoised_previous_row) == pixel) {
+        CopyF16PixelValue(GetF16PixelAt(x, y - 1, width, pixels), pixel);
+      } else if (y > 0 && x < width - 1 &&
+                 GetF16PixelAt(x + 1, 0, width, unnoised_previous_row) ==
+                     pixel) {
+        CopyF16PixelValue(GetF16PixelAt(x + 1, y - 1, width, pixels), pixel);
+      } else if (x > 0 &&
+                 GetF16PixelAt(x - 1, 0, width, unnoised_current_row) ==
+                     pixel) {
+        CopyF16PixelValue(GetF16PixelAt(x - 1, y, width, pixels), pixel);
+      } else {
+        NoiseHash hash_copy = token_hash;
+        hash_copy.Update(base::U64FromLittleEndian(pixel));
+        const std::pair<PixelLocation, PixelLocation> other_pixels =
+            GetRandomPixelLocations(hash_copy, {x, y}, width, height);
+        hash_copy.Update(base::U64FromLittleEndian(GetF16PixelAt(
+            other_pixels.first.x, other_pixels.first.y, width, pixels)));
+        hash_copy.Update(base::U64FromLittleEndian(GetF16PixelAt(
+            other_pixels.second.x, other_pixels.second.y, width, pixels)));
+        NoiseF16Pixel(pixel, hash_copy, alpha_type, normalized);
+      }
+    }
+    std::swap(unnoised_previous_row, unnoised_current_row);
+  }
+}
