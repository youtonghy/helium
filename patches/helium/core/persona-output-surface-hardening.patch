+std::string CaptureWorkerOffscreenCanvas(
+    content::WebContents* web_contents) {
+  const content::EvalJsResult result = content::EvalJs(web_contents, R"JS(
+    (async () => {
+      const workerSource = `
+        self.onmessage = async () => {
+          const canvas = new OffscreenCanvas(32, 32);
+          const context = canvas.getContext('2d');
+          context.fillStyle = 'rgb(37, 89, 143)';
+          context.fillRect(0, 0, 32, 32);
+          context.fillStyle = 'rgb(211, 47, 91)';
+          context.fillRect(4, 6, 20, 17);
+          const blob = await canvas.convertToBlob({type: 'image/png'});
+          const bytes = new Uint8Array(await blob.arrayBuffer());
+          let binary = '';
+          for (const byte of bytes) binary += String.fromCharCode(byte);
+          self.postMessage(btoa(binary));
+        };
+      `;
+      const url = URL.createObjectURL(
+          new Blob([workerSource], {type: 'application/javascript'}));
+      try {
+        const worker = new Worker(url);
+        const output = await new Promise((resolve, reject) => {
+          worker.onmessage = event => resolve(event.data);
+          worker.onerror = reject;
+          worker.postMessage('capture');
+        });
+        worker.terminate();
+        return output;
+      } finally {
+        URL.revokeObjectURL(url);
+      }
+    })()
+  )JS");
+  CHECK(result.is_ok()) << result.ExtractError();
+  return result.ExtractString();
+}
+
+std::string CaptureCanvasStreamFrame(content::WebContents* web_contents) {
+  const content::EvalJsResult result = content::EvalJs(web_contents, R"JS(
+    (async () => {
+      const canvas = document.createElement('canvas');
+      canvas.width = 32;
+      canvas.height = 32;
+      const context = canvas.getContext('2d');
+      context.fillStyle = 'rgb(37, 89, 143)';
+      context.fillRect(0, 0, 32, 32);
+      context.fillStyle = 'rgb(211, 47, 91)';
+      context.fillRect(4, 6, 20, 17);
+
+      const stream = canvas.captureStream(0);
+      const track = stream.getVideoTracks()[0];
+      const processor = new MediaStreamTrackProcessor({track});
+      const reader = processor.readable.getReader();
+      track.requestFrame();
+      const {value: frame} = await reader.read();
+      const bytes = new Uint8Array(
+          frame.allocationSize({format: 'RGBA'}));
+      await frame.copyTo(bytes, {format: 'RGBA'});
+      frame.close();
+      track.stop();
+      await reader.cancel();
+      const digest = await crypto.subtle.digest('SHA-256', bytes);
+      return Array.from(new Uint8Array(digest), byte =>
+        byte.toString(16).padStart(2, '0')).join('');
+    })()
+  )JS");
+  CHECK(result.is_ok()) << result.ExtractError();
+  return result.ExtractString();
+}
+
+std::string CaptureCanvasFloatingPointReadback(
+    content::WebContents* web_contents) {
+  const content::EvalJsResult result = content::EvalJs(web_contents, R"JS(
+    (async () => {
+      const canvas = document.createElement('canvas');
+      canvas.width = 32;
+      canvas.height = 32;
+      const context = canvas.getContext('2d');
+      context.fillStyle = 'rgb(37, 89, 143)';
+      context.fillRect(0, 0, 32, 32);
+      context.fillStyle = 'rgb(211, 47, 91)';
+      context.fillRect(4, 6, 20, 17);
+      const outputs = [];
+      for (const pixelFormat of ['rgba-float16', 'rgba-float32']) {
+        const imageData = context.getImageData(
+            0, 0, 32, 32, {pixelFormat});
+        const bytes = new Uint8Array(imageData.data.buffer);
+        const digest = await crypto.subtle.digest('SHA-256', bytes);
+        outputs.push(Array.from(new Uint8Array(digest), byte =>
+          byte.toString(16).padStart(2, '0')).join(''));
+      }
+      return outputs.join(':');
+    })()
+  )JS");
+  CHECK(result.is_ok()) << result.ExtractError();
+  return result.ExtractString();
+}
+
+std::string CaptureCanvasAndCopyReadback(
+    content::WebContents* web_contents) {
+  const content::EvalJsResult result = content::EvalJs(web_contents, R"JS(
+    (async () => {
+      const source = document.createElement('canvas');
+      source.width = 32;
+      source.height = 32;
+      const sourceContext = source.getContext('2d');
+      sourceContext.fillStyle = 'rgb(37, 89, 143)';
+      sourceContext.fillRect(0, 0, 32, 32);
+      sourceContext.fillStyle = 'rgb(211, 47, 91)';
+      sourceContext.fillRect(4, 6, 20, 17);
+
+      const destination = document.createElement('canvas');
+      destination.width = 32;
+      destination.height = 32;
+      const destinationContext = destination.getContext('2d');
+      destinationContext.drawImage(source, 0, 0);
+
+      const hash = async context => {
+        const bytes = context.getImageData(0, 0, 32, 32).data;
+        const digest = await crypto.subtle.digest('SHA-256', bytes);
+        return Array.from(new Uint8Array(digest), byte =>
+          byte.toString(16).padStart(2, '0')).join('');
+      };
+      return `${await hash(sourceContext)}:${await hash(destinationContext)}`;
+    })()
+  )JS");
+  CHECK(result.is_ok()) << result.ExtractError();
+  return result.ExtractString();
+}
