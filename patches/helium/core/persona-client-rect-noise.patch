+// Client rect noise (Persona). Deterministic sub-pixel jitter applied to
+// Element.getClientRects() / getBoundingClientRect() so the reported geometry
+// varies slightly between personas while staying stable for a given persona
+// and element (same token + same layout => same result).
+constexpr uint64_t kClientRectFnvPrime = 0x00000100000001b3;
+constexpr double kHeliumClientRectNoiseDelta = 0.001;
+
+uint64_t MixHeliumClientRectNoise(uint64_t hash, uint64_t value) {
+  hash ^= value;
+  hash *= kClientRectFnvPrime;
+  return hash;
+}
+
+double ApplyHeliumClientRectNoise(double value,
+                                  uint64_t token_hash,
+                                  uint64_t field_index) {
+  if (!std::isfinite(value) || value == 0.0) {
+    return value;
+  }
+  const uint64_t field_hash =
+      MixHeliumClientRectNoise(token_hash, field_index);
+  const double direction = (field_hash & 1) ? 1.0 : -1.0;
+  const double magnitude =
+      1.0 + static_cast<double>((field_hash >> 1) % 31);
+  return value + direction * magnitude * kHeliumClientRectNoiseDelta;
+}
