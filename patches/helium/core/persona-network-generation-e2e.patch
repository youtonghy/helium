+TEST_P(HttpNetworkTransactionTest,
+       NetworkPersonaGenerationEvictsIdleSocket) {
+  const auto request = DefaultRequestInfo();
+  MockRead reads1[] = {
+      MockRead("HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\none"),
+  };
+  MockRead reads2[] = {
+      MockRead("HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\ntwo"),
+  };
+  StaticSocketDataProvider data1(reads1, base::span<MockWrite>());
+  StaticSocketDataProvider data2(reads2, base::span<MockWrite>());
+  session_deps_.socket_factory->AddSocketDataProvider(&data1);
+  session_deps_.socket_factory->AddSocketDataProvider(&data2);
+
+  std::unique_ptr<HttpNetworkSession> session = CreateSession(&session_deps_);
+  {
+    HttpNetworkTransaction transaction(DEFAULT_PRIORITY, session.get());
+    TestCompletionCallback callback;
+    EXPECT_THAT(
+        callback.GetResult(transaction.Start(
+            &request, callback.callback(), NetLogWithSource())),
+        IsOk());
+    std::string body;
+    EXPECT_THAT(ReadTransaction(&transaction, &body), IsOk());
+    EXPECT_EQ("one", body);
+  }
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(1, GetIdleSocketCountInTransportSocketPool(session.get()));
+
+  NetworkPersonaConfig config;
+  config.generation = 1;
+  config.deterministic_seed.fill(0x42);
+  session->ApplyNetworkPersonaConfig(config);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(0, GetIdleSocketCountInTransportSocketPool(session.get()));
+
+  {
+    HttpNetworkTransaction transaction(DEFAULT_PRIORITY, session.get());
+    TestCompletionCallback callback;
+    EXPECT_THAT(
+        callback.GetResult(transaction.Start(
+            &request, callback.callback(), NetLogWithSource())),
+        IsOk());
+    std::string body;
+    EXPECT_THAT(ReadTransaction(&transaction, &body), IsOk());
+    EXPECT_EQ("two", body);
+  }
+  EXPECT_TRUE(data2.socket());
+}
