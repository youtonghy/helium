+TEST_F(QuicEndToEndTest,
+       NetworkPersonaGenerationReplacesActiveQuicSession) {
+  AddToCache(request_.url.PathForRequest(), 200, "OK", kResponseBody);
+
+  std::string first_status;
+  std::string first_body;
+  {
+    TestTransactionConsumer consumer(DEFAULT_PRIORITY,
+                                     transaction_factory_.get());
+    consumer.Start(&request_, NetLogWithSource());
+    ASSERT_TRUE(consumer.is_done());
+    ASSERT_THAT(consumer.error(), IsOk());
+    ASSERT_TRUE(consumer.response_info()->headers);
+    first_status = consumer.response_info()->headers->GetStatusLine();
+    first_body = consumer.content();
+  }
+  HttpNetworkSession* session = transaction_factory_->GetSession();
+  ASSERT_EQ(1u, session->quic_session_pool()
+                    ->QuicSessionPoolInfoToValue()
+                    .GetList()
+                    .size());
+
+  NetworkPersonaConfig config;
+  config.template_id = kChromium149DefaultTemplateId;
+  config.generation = 1;
+  config.deterministic_seed.fill(0x42);
+  session->ApplyNetworkPersonaConfig(config);
+  EXPECT_TRUE(session->quic_session_pool()
+                  ->QuicSessionPoolInfoToValue()
+                  .GetList()
+                  .empty());
+
+  {
+    TestTransactionConsumer consumer(DEFAULT_PRIORITY,
+                                     transaction_factory_.get());
+    consumer.Start(&request_, NetLogWithSource());
+    ASSERT_TRUE(consumer.is_done());
+    ASSERT_THAT(consumer.error(), IsOk());
+    ASSERT_TRUE(consumer.response_info()->headers);
+    EXPECT_EQ(first_status, consumer.response_info()->headers->GetStatusLine());
+    EXPECT_EQ(first_body, consumer.content());
+  }
+  EXPECT_EQ(1u, session->quic_session_pool()
+                    ->QuicSessionPoolInfoToValue()
+                    .GetList()
+                    .size());
+}
