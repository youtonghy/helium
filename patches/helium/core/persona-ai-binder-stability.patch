+      error_.SetValue(                                                              \
+          blink::mojom::AIManagerCreateClientError::kUnableToCreateSession);        \
+    }                                                                               \
+                                                                                    \
+    void OnError(blink::mojom::AIManagerCreateClientError error,                   \
+                 blink::mojom::QuotaErrorInfoPtr quota_error_info) override {       \
+      EXPECT_FALSE(quota_error_info);                                                \
+      error_.SetValue(error);                                                        \
+    }                                                                               \
+                                                                                    \
+    blink::mojom::AIManagerCreateClientError WaitForError() {                       \
+      return error_.Take();                                                         \
+    }                                                                               \
+                                                                                    \
+   private:                                                                         \
+    base::test::TestFuture<blink::mojom::AIManagerCreateClientError> error_;        \
+    mojo::Receiver<blink::mojom::client_interface> receiver_{this};                 \
