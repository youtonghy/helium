+#define DEFINE_DENIED_CREATE_CLIENT(class_name, client_interface, result_interface) \
+  class class_name final : public blink::mojom::client_interface {               \
+   public:                                                                         \
+    mojo::PendingRemote<blink::mojom::client_interface>                            \
+    BindNewPipeAndPassRemote() {                                                    \
