+TEST_F(AIManagerTest, PersonaDenialRejectsAllCreateRequestsDynamically) {
+  mojo::Remote<blink::mojom::AIManager> remote = GetAIManagerRemote();
+  ActivateDisabledPersona();
+
+  TestDeniedLanguageModelClient language_model_client;
+  remote->CreateLanguageModel(language_model_client.BindNewPipeAndPassRemote(),
+                              blink::mojom::AILanguageModelCreateOptions::New());
+  TestDeniedWriterClient writer_client;
+  remote->CreateWriter(writer_client.BindNewPipeAndPassRemote(),
+                       blink::mojom::AIWriterCreateOptions::New());
+  TestDeniedSummarizerClient summarizer_client;
+  remote->CreateSummarizer(summarizer_client.BindNewPipeAndPassRemote(),
+                           blink::mojom::AISummarizerCreateOptions::New());
+  TestDeniedRewriterClient rewriter_client;
+  remote->CreateRewriter(rewriter_client.BindNewPipeAndPassRemote(),
+                         blink::mojom::AIRewriterCreateOptions::New());
+  TestDeniedProofreaderClient proofreader_client;
+  remote->CreateProofreader(proofreader_client.BindNewPipeAndPassRemote(),
+                            blink::mojom::AIProofreaderCreateOptions::New());
+  TestDeniedClassifierClient classifier_client;
+  remote->CreateClassifier(classifier_client.BindNewPipeAndPassRemote(),
+                           blink::mojom::AIClassifierCreateOptions::New());
+
+  constexpr auto kExpectedError =
+      blink::mojom::AIManagerCreateClientError::kUnableToCreateSession;
+  EXPECT_EQ(language_model_client.WaitForError(), kExpectedError);
+  EXPECT_EQ(writer_client.WaitForError(), kExpectedError);
+  EXPECT_EQ(summarizer_client.WaitForError(), kExpectedError);
+  EXPECT_EQ(rewriter_client.WaitForError(), kExpectedError);
+  EXPECT_EQ(proofreader_client.WaitForError(), kExpectedError);
+  EXPECT_EQ(classifier_client.WaitForError(), kExpectedError);
+  EXPECT_TRUE(remote.is_connected());
+}
