+bool AIManager::IsBlockedByPersona() const {
+  auto* persona_service =
+      helium_persona::PersonaServiceFactory::GetForProfile(
+          Profile::FromBrowserContext(browser_context_));
+  if (!persona_service) {
+    return false;
+  }
+  const blink::HeliumPersonaSnapshot snapshot =
+      persona_service->GetActiveSnapshot();
+  return snapshot.IsEnabled() && !snapshot.allow_ai_apis;
+}
