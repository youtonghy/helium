+IN_PROC_BROWSER_TEST_F(PersonaDisabledAIOnDeviceBrowserTest,
+                       SettlesLanguageModelPromisesInWindow) {
+  auto* tab = browser()->tab_strip_model()->GetActiveWebContents();
+  EXPECT_EQ("string", content::EvalJs(tab, R"JS(
+              LanguageModel.availability().then(value => typeof value)
+            )JS"));
+  ActivateDisabledPersona();
+
+  EXPECT_EQ("unavailable:NotSupportedError",
+            content::EvalJs(tab, R"JS(
+              (async () => {
+                const withTimeout = promise => Promise.race([
+                  promise,
+                  new Promise(resolve =>
+                    setTimeout(() => resolve('timeout'), 5000)),
+                ]);
+                const availability = await withTimeout(
+                  LanguageModel.availability().catch(error => error.name));
+                const creation = await withTimeout(
+                  LanguageModel.create().then(
+                    () => 'created', error => error.name));
+                return `${availability}:${creation}`;
+              })()
+            )JS"));
+}
+
+IN_PROC_BROWSER_TEST_F(PersonaDisabledAIOnDeviceBrowserTest,
+                       SettlesLanguageModelPromisesInDedicatedWorker) {
+  auto* tab = browser()->tab_strip_model()->GetActiveWebContents();
+  EXPECT_EQ("string", content::EvalJs(tab, R"JS(
+              (() => {
+                const workerScript = `
+                  self.onmessage = async event => {
+                    if (event.data === 'prime') {
+                      const availability = await LanguageModel.availability();
+                      self.postMessage(typeof availability);
+                      return;
+                    }
+                    const availability = await LanguageModel.availability()
+                      .catch(error => error.name);
+                    const creation = await LanguageModel.create().then(
+                      () => 'created', error => error.name);
+                    self.postMessage(availability + ':' + creation);
+                  };`;
+                self.aiPersonaWorker = new Worker(URL.createObjectURL(
+                  new Blob([workerScript], {type: 'text/javascript'})));
+                self.aiPersonaWorker.postMessage('prime');
+                return Promise.race([
+                  new Promise(resolve => {
+                    self.aiPersonaWorker.onmessage = event =>
+                      resolve(event.data);
+                    self.aiPersonaWorker.onerror = event =>
+                      resolve(event.message);
+                  }),
+                  new Promise(resolve =>
+                    setTimeout(() => resolve('timeout'), 5000)),
+                ]);
+              })()
+            )JS"));
+  ActivateDisabledPersona();
+
+  EXPECT_EQ("unavailable:NotSupportedError",
+            content::EvalJs(tab, R"JS(
+              (() => {
+                return Promise.race([
+                  new Promise(resolve => {
+                    self.aiPersonaWorker.onmessage = event =>
+                      resolve(event.data);
+                    self.aiPersonaWorker.onerror = event =>
+                      resolve(event.message);
+                    self.aiPersonaWorker.postMessage('check');
+                  }),
+                  new Promise(resolve =>
+                    setTimeout(() => resolve('timeout'), 5000)),
+                ]);
+              })()
+            )JS"));
+}
