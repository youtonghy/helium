+TEST_F(ChromeContentBrowserClientTest,
+       DisabledPersonaClosesAIManagerReceiver) {
+  auto* persona_service =
+      helium_persona::PersonaServiceFactory::GetForProfile(&profile_);
+  ASSERT_TRUE(persona_service);
+  base::DictValue create_response =
+      persona_service->CreatePersonaProfile("No AI");
+  const std::string* persona_id = create_response.FindString("personaId");
+  ASSERT_TRUE(persona_id);
+  ASSERT_TRUE(persona_service->SetActivePersona(*persona_id)
+                  .FindBool("ok")
+                  .value_or(false));
+  ASSERT_FALSE(persona_service->GetActiveSnapshot().allow_ai_apis);
+
+  ChromeContentBrowserClient browser_client;
+  mojo::Remote<blink::mojom::AIManager> remote;
+  browser_client.BindAIManager(&profile_, &profile_, /*rfh=*/nullptr,
+                               remote.BindNewPipeAndPassReceiver());
+  remote.FlushForTesting();
+
+  EXPECT_FALSE(remote.is_connected());
+}
