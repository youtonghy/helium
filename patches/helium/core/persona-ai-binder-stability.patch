+  remote->CanCreateSummarizer(/*options=*/nullptr,
+                              availability_callback.Get());
+  remote->CanCreateRewriter(blink::mojom::AIRewriterCreateOptions::New(),
+                            availability_callback.Get());
+  remote->CanCreateProofreader(blink::mojom::AIProofreaderCreateOptions::New(),
+                               availability_callback.Get());
+  remote->CanCreateClassifier(blink::mojom::AIClassifierCreateOptions::New(),
+                              availability_callback.Get());
+
+  base::test::TestFuture<blink::mojom::AILanguageModelParamsPtr> params_future;
+  remote->GetLanguageModelParams(params_future.GetCallback());
+  mojo::PendingRemote<on_device_model::mojom::DownloadObserver> observer;
+  auto observer_receiver = observer.InitWithNewPipeAndPassReceiver();
+  remote->AddModelDownloadProgressObserver(std::move(observer));
+
+  EXPECT_FALSE(params_future.Get());
+  remote.FlushForTesting();
+  observer_receiver.reset();
+  EXPECT_TRUE(remote.is_connected());
+
+  ASSERT_TRUE(persona_service->SetActivePersona("default")
+                  .FindBool("ok")
+                  .value_or(false));
+  base::test::TestFuture<blink::mojom::ModelAvailabilityCheckResult>
+      reenabled_future;
+  remote->CanCreateLanguageModel(/*options=*/nullptr,
+                                 reenabled_future.GetCallback());
+  EXPECT_EQ(reenabled_future.Get(),
+            blink::mojom::ModelAvailabilityCheckResult::kDownloadable);
+}
