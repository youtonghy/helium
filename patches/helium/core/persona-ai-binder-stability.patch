+            )JS"));
+
+  EXPECT_EQ("alive", content::EvalJs(tab, R"JS(
+              (() => {
+                const workerScript = `
+                  LanguageModel.availability();
+                  LanguageModel.create().catch(() => {});
+                  setTimeout(() => {
+                    gc();
+                    gc();
+                    self.postMessage('alive');
