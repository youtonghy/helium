+      browser()->tab_strip_model()->GetActiveWebContents();
+  const content::EvalJsResult result = content::EvalJs(web_contents, R"JS(
+    (async () => {
+      if (!navigator.gpu) return {supported: false};
+      const adapter = await navigator.gpu.requestAdapter({
+        featureLevel: 'compatibility',
+      });
+      if (!adapter) return {supported: false};
+      const device = await adapter.requestDevice();
+      window.personaCompatibilityDevice = device;
+      return {
+        supported: true,
+        featureCount: [...adapter.features].length,
+        maxTextureDimension2D: adapter.limits.maxTextureDimension2D,
+        maxComputeInvocationsPerWorkgroup:
+            adapter.limits.maxComputeInvocationsPerWorkgroup,
+        maxColorAttachments: adapter.limits.maxColorAttachments,
+        maxStorageBuffersInVertexStage:
+            adapter.limits.maxStorageBuffersInVertexStage,
+      };
+    })()
+  )JS");
+  ASSERT_TRUE(result.is_ok()) << result.ExtractError();
