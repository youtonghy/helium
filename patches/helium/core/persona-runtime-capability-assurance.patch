+const HeliumPersonaSnapshot* GetPersonaSnapshot(GPU* gpu) {
+  if (!gpu) {
+    return nullptr;
+  }
+  ExecutionContext* context = gpu->GetExecutionContext();
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    if (window->GetFrame() && window->GetFrame()->Client() &&
+        window->GetFrame()->Client()->GetWebFrame() &&
+        window->GetFrame()->Client()->GetWebFrame()->Client()) {
+      return &window->GetFrame()->Client()->GetWebFrame()->Client()
+                  ->GetHeliumPersonaSnapshot();
+    }
+  } else if (auto* worker = DynamicTo<WorkerGlobalScope>(context)) {
+    return &worker->GetHeliumPersonaSnapshot();
+  }
+  return nullptr;
+}
