+uint64_t ReadGeneration(const base::Value* value) {
+  if (!value) {
+    return 0;
+  }
+  if (value->is_int()) {
+    const int generation = value->GetInt();
+    return generation < 0 ? 0 : static_cast<uint64_t>(generation);
+  }
+  uint64_t generation = 0;
+  return value->is_string() &&
+                 base::StringToUint64(value->GetString(), &generation)
+             ? generation
+             : 0;
+}
+
+uint64_t NextGeneration(uint64_t generation) {
+  return generation == std::numeric_limits<uint64_t>::max() ? 0
+                                                             : generation + 1;
+}
