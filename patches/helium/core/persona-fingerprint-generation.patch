+TEST_F(PersonaServiceTest,
+       ProfileRefreshIncrementsGenerationWithoutReplacingProfileSalt) {
+  base::DictValue create_response = service_->CreatePersonaProfile("Work");
+  const std::string* persona_id = create_response.FindString("personaId");
+  ASSERT_TRUE(persona_id);
+  ASSERT_TRUE(
+      service_->SetActivePersona(*persona_id).FindBool("ok").value_or(false));
+
+  const blink::HeliumPersonaSnapshot before = service_->GetActiveSnapshot();
+  const std::string salt_before =
+      prefs_.GetString(kPersonaFingerprintProfileSaltPref);
+  service_->RefreshFingerprint(FingerprintRefreshScope::kProfile,
+                               std::string());
+  const blink::HeliumPersonaSnapshot after = service_->GetActiveSnapshot();
+
+  EXPECT_EQ(before.fingerprint_generation + 1,
+            after.fingerprint_generation);
+  EXPECT_EQ(salt_before,
+            prefs_.GetString(kPersonaFingerprintProfileSaltPref));
+}
+
+TEST_F(PersonaServiceTest, SiteRefreshIncrementsOnlyMatchingSiteGeneration) {
+  base::DictValue create_response = service_->CreatePersonaProfile("Work");
+  const std::string* persona_id = create_response.FindString("personaId");
+  ASSERT_TRUE(persona_id);
+  ASSERT_TRUE(
+      service_->SetActivePersona(*persona_id).FindBool("ok").value_or(false));
+
+  service_->RefreshFingerprint(FingerprintRefreshScope::kSite,
+                               "https://fingerprint.example");
+  const blink::HeliumPersonaSnapshot first = service_->GetActiveSnapshot();
+  ASSERT_EQ(1u, first.fingerprint_rotation_site_epochs.size());
+  EXPECT_EQ(1u, first.fingerprint_rotation_site_epochs.front().generation);
+
+  service_->RefreshFingerprint(FingerprintRefreshScope::kSite,
+                               "https://fingerprint.example");
+  const blink::HeliumPersonaSnapshot second = service_->GetActiveSnapshot();
+  ASSERT_EQ(1u, second.fingerprint_rotation_site_epochs.size());
+  EXPECT_EQ(2u, second.fingerprint_rotation_site_epochs.front().generation);
+  EXPECT_EQ(first.fingerprint_generation, second.fingerprint_generation);
+}
