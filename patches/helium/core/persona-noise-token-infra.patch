+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "content/browser/helium_noise/noise_token_data.h"
+
+#include <array>
+#include <span>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "base/numerics/byte_conversions.h"
+#include "content/public/browser/browser_context.h"
+#include "crypto/hash.h"
+#include "url/origin.h"
+
+namespace content {
+
+namespace {
+
+constexpr char kFingerprintRotationScopeSiteProfile[] = "site_profile";
+constexpr char kFingerprintRotationScopeProfile[] = "profile";
+constexpr char kFingerprintRotationScopeGlobal[] = "global";
+constexpr int kDefaultFingerprintRotationIntervalDays = 14;
+
+std::string_view FeatureTag(blink::HeliumNoiseFeature feature) {
+  switch (feature) {
+    case blink::HeliumNoiseFeature::kCanvas:
+      return "canvas";
+    case blink::HeliumNoiseFeature::kAudio:
+      return "audio";
+    case blink::HeliumNoiseFeature::kHardware:
+      return "hardware";
+    case blink::HeliumNoiseFeature::kFontMetric:
+      return "font_metric";
+  }
+}
+
+std::string FindSiteEpoch(const blink::HeliumPersonaSnapshot& persona,
+                          const url::Origin& origin) {
+  const std::string serialized_origin = origin.Serialize();
+  for (const auto& site_epoch : persona.fingerprint_rotation_site_epochs) {
+    if (site_epoch.scope_key == serialized_origin)
+      return site_epoch.epoch;
+  }
+  return persona.fingerprint_rotation_global_epoch;
+}
+
+int64_t RotationBucket(const blink::HeliumPersonaSnapshot& persona,
+                       const url::Origin& origin) {
+  const int interval_days = persona.fingerprint_rotation_interval_days > 0
+                                ? persona.fingerprint_rotation_interval_days
+                                : kDefaultFingerprintRotationIntervalDays;
+  const std::string epoch_string =
+      persona.fingerprint_rotation_scope == kFingerprintRotationScopeGlobal ||
+              persona.fingerprint_rotation_scope == kFingerprintRotationScopeProfile
+          ? persona.fingerprint_rotation_global_epoch
+          : FindSiteEpoch(persona, origin);
+
+  base::Time epoch;
+  if (!base::Time::FromUTCString(epoch_string.c_str(), &epoch)) {
+    epoch = base::Time::Now();
+  }
+
+  const base::TimeDelta elapsed = base::Time::Now() - epoch;
+  if (elapsed.is_negative()) {
+    return 0;
+  }
+  return elapsed.InDays() / interval_days;
+}
+
+std::string BuildSeed(const url::Origin& origin,
+                      const blink::HeliumPersonaSnapshot& persona) {
+  std::string seed =
+      persona.fingerprint_profile_salt.empty()
+          ? persona.noise_seed
+          : persona.fingerprint_profile_salt + "\n" + persona.id;
+  seed.push_back('\n');
+  seed.append(persona.fingerprint_rotation_scope);
+  if (persona.fingerprint_rotation_scope ==
+      kFingerprintRotationScopeSiteProfile) {
+    seed.push_back('\n');
+    seed.append(origin.Serialize());
+  }
+  seed.push_back('\n');
+  seed.append(base::NumberToString(RotationBucket(persona, origin)));
+  return seed;
+}
+
+uint64_t DeriveToken(std::string_view seed,
+                     const url::Origin& origin,
+                     const blink::HeliumPersonaSnapshot& persona,
+                     blink::HeliumNoiseFeature feature) {
+  std::string input;
+  input.reserve(seed.size() + origin.Serialize().size() + persona.id.size() +
+                persona.locale.size() + persona.timezone.size() + 64);
+  input.append(seed);
+  input.push_back('\n');
+  input.append(origin.Serialize());
+  input.push_back('\n');
+  input.append(persona.id);
+  input.push_back('\n');
+  input.append(persona.locale);
+  input.push_back('\n');
+  input.append(persona.timezone);
+  input.push_back('\n');
+  input.append(FeatureTag(feature));
+
+  const std::array<uint8_t, crypto::hash::kSha256Size> digest =
+      crypto::hash::Sha256(input);
+  return base::U64FromBigEndian(
+      std::span<const uint8_t, 8u>(digest.data(), 8u));
+}
+
+void AddToken(blink::HeliumNoiseTokenMap& tokens,
+              std::string_view seed,
+              const url::Origin& origin,
+              const blink::HeliumPersonaSnapshot& persona,
+              blink::HeliumNoiseFeature feature) {
+  tokens.emplace(feature,
+                 blink::NoiseToken(DeriveToken(seed, origin, persona,
+                                               feature)));
+}
+
+}  // namespace
+
+blink::HeliumNoiseTokenMap HeliumNoiseTokenData::GetTokens(
+    BrowserContext* browser_context,
+    const url::Origin& origin,
+    const blink::HeliumPersonaSnapshot& persona) {
+  const std::string seed = BuildSeed(origin, persona);
+
+  blink::HeliumNoiseTokenMap tokens;
+  AddToken(tokens, seed, origin, persona, blink::HeliumNoiseFeature::kCanvas);
+  AddToken(tokens, seed, origin, persona, blink::HeliumNoiseFeature::kAudio);
+  AddToken(tokens, seed, origin, persona, blink::HeliumNoiseFeature::kHardware);
+  AddToken(tokens, seed, origin, persona,
+           blink::HeliumNoiseFeature::kFontMetric);
+  return tokens;
+}
+
+}  // namespace content
