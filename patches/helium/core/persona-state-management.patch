+      .Set("platform", "macOS")
+      .Set("platformVersion", "")
+      .Set("architecture", "arm")
+      .Set("model", "")
+      .Set("bitness", "64")
+      .Set("fullVersion", "")
+      .Set("mobile", false)
+      .Set("wow64", false)
+      .Set("brands", std::move(brands))
+      .Set("formFactors", std::move(form_factors));
