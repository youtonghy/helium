+  const base::ListValue* presets = state.FindList("presets");
+  ASSERT_TRUE(presets);
+  ASSERT_FALSE(presets->empty());
+
+  base::DictValue invalid_group = presets->front().GetDict().Clone();
+  invalid_group.Set("gpu", "not-a-dictionary");
+  base::DictValue invalid_list = presets->front().GetDict().Clone();
+  base::ListValue invalid_families;
+  invalid_families.Append(42);
+  invalid_list.EnsureDict("fonts")->Set("families",
+                                        std::move(invalid_families));
+  base::DictValue invalid_timezone = presets->front().GetDict().Clone();
+  invalid_timezone.EnsureDict("region")->Set("timezone", "Not/A_Timezone");
+  base::DictValue invalid_memory = presets->front().GetDict().Clone();
+  invalid_memory.EnsureDict("hardware")->Set("deviceMemory", 24);
+  base::DictValue invalid_integer = presets->front().GetDict().Clone();
+  invalid_integer.EnsureDict("screen")->Set("width", 1920.0);
+
+  base::ListValue personas;
+  personas.Append(std::move(invalid_group));
+  personas.Append(std::move(invalid_list));
+  personas.Append(std::move(invalid_timezone));
+  personas.Append(std::move(invalid_memory));
+  personas.Append(std::move(invalid_integer));
+  base::DictValue bundle;
+  bundle.Set("schema", "helium.persona/v1");
+  bundle.Set("personas", std::move(personas));
+
+  base::DictValue response = service_->ImportPersonas(bundle);
+
+  EXPECT_FALSE(response.FindBool("ok").value_or(true));
+  EXPECT_EQ(0, response.FindInt("importedCount").value_or(-1));
+  EXPECT_EQ(5, response.FindInt("skippedCount").value_or(-1));
+  const base::DictValue* errors = response.FindDict("fieldErrors");
+  ASSERT_TRUE(errors);
+  EXPECT_TRUE(errors->FindDict("0"));
+  EXPECT_TRUE(errors->FindDict("1"));
+  EXPECT_TRUE(errors->FindDict("2"));
+  EXPECT_TRUE(errors->FindDict("3"));
+  EXPECT_TRUE(errors->FindDict("4"));
+}
