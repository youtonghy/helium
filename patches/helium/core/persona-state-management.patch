+  snapshot.outer_height =
+      FindNestedInt(*persona, "screen", "outerHeight").value_or(0);
+  snapshot.avail_width =
+      FindNestedInt(*persona, "screen", "availWidth")
+          .value_or(snapshot.screen_width);
+  snapshot.avail_height =
+      FindNestedInt(*persona, "screen", "availHeight")
+          .value_or(snapshot.screen_height);
+  snapshot.color_depth = 24;
+  snapshot.pixel_depth = 24;
+  snapshot.device_scale_factor =
+      FindNestedDouble(*persona, "screen", "deviceScaleFactor").value_or(0.0);
+  snapshot.refresh_rate =
+      FindNestedInt(*persona, "screen", "refreshRate").value_or(0);
+  snapshot.audio_base_latency =
+      FindNestedDouble(*persona, "mediaDevices", "audioBaseLatency")
+          .value_or(0.0);
+  snapshot.audio_output_latency =
+      FindNestedDouble(*persona, "mediaDevices", "audioOutputLatency")
+          .value_or(0.0);
+  if (const std::string* value = FindNestedString(*persona, "network", "type")) {
+    snapshot.network_type = *value;
+  }
+  snapshot.network_downlink_max =
+      FindNestedDouble(*persona, "network", "downlinkMax").value_or(0.0);
+
+  const base::DictValue* ua_ch = persona->FindDict("uaCh");
+  const base::ListValue* form_factors =
+      ua_ch ? ua_ch->FindList("formFactors") : nullptr;
+  if (form_factors) {
+    for (const auto& value : *form_factors) {
+      if (value.is_string()) {
+        snapshot.ua_ch_form_factors.push_back(value.GetString());
+      }
+    }
+  }
+
+  const base::ListValue* brands = ua_ch ? ua_ch->FindList("brands") : nullptr;
+  if (brands) {
+    for (const auto& value : *brands) {
+      if (!value.is_dict()) {
+        continue;
+      }
+      const base::DictValue& brand_dict = value.GetDict();
+      const std::string* brand = brand_dict.FindString("brand");
+      const std::string* version = brand_dict.FindString("version");
+      if (brand && version) {
+        snapshot.ua_ch_brands.push_back({*brand, *version});
+      }
+    }
+  }
+
+  return snapshot;
