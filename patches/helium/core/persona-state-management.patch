+TEST_F(PersonaServiceTest, SnapshotUsesRealisticNavigatorPlatformValues) {
+  base::DictValue create_response = service_->CreatePersonaProfile("Platform");
+  const base::DictValue* created_state = create_response.FindDict("state");
+  ASSERT_TRUE(created_state);
+  const base::DictValue* created_persona =
+      FindFirstCustomPersona(created_state->FindList("personas"));
+  ASSERT_TRUE(created_persona);
+
+  struct PlatformExpectation {
+    const char* os;
+    const char* navigator_platform;
+  };
+  constexpr std::array<PlatformExpectation, 5> kExpectations = {{
+      {"macOS", "MacIntel"},
+      {"Windows", "Win32"},
+      {"Linux", "Linux x86_64"},
+      {"Chrome OS", "Linux x86_64"},
+      {"Android", "Linux armv81"},
+  }};
+
+  for (const auto& expectation : kExpectations) {
+    base::DictValue payload = created_persona->Clone();
+    payload.Set("platform", expectation.os);
+    payload.EnsureDict("uaCh")->Set("platform", expectation.os);
+    base::DictValue save_response = service_->SavePersona(payload);
+    ASSERT_TRUE(save_response.FindBool("ok").value_or(false));
+    const std::string* id = payload.FindString("id");
+    ASSERT_TRUE(id);
+    ASSERT_TRUE(
+        service_->SetActivePersona(*id).FindBool("ok").value_or(false));
+
+    const blink::HeliumPersonaSnapshot snapshot = service_->GetActiveSnapshot();
+    EXPECT_EQ(expectation.os, snapshot.os);
+    EXPECT_EQ(expectation.navigator_platform, snapshot.platform);
+    EXPECT_EQ(expectation.os, snapshot.ua_ch_platform);
+  }
+}
