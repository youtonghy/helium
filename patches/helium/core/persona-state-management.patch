+                           int outer_height,
+                           double device_scale_factor,
+                           std::string_view fonts_id,
+                           double audio_base_latency,
+                           std::string_view network_type,
+                           double network_downlink_max) {
+  const std::string created_at = MakeIsoTimestamp();
+  base::DictValue region = MakeRegionDefaults();
+  region.Set("timezone", timezone);
+  region.Set("locale", locale);
+  region.Set("acceptLanguage", accept_language);
+
+  base::DictValue ua_ch = MakeUaChDefaults();
+  ua_ch.Set("platform", platform);
+  ua_ch.Set("platformVersion", platform_version);
+  ua_ch.Set("architecture", architecture);
+  ua_ch.Set("bitness", bitness);
+  ua_ch.Set("fullVersion", full_version);
+  ua_ch.Set("mobile", false);
+  ua_ch.Set("wow64", platform == "Windows");
+
+  base::DictValue gpu;
+  gpu.Set("vendor", gpu_vendor);
+  gpu.Set("renderer", gpu_renderer);
+  gpu.Set("webgpuAdapter", webgpu_adapter);
+  gpu.Set("webglProfile",
+          base::DictValue().Set("maxCombinedTextureImageUnits", 192));
+  gpu.Set("webgl2Profile",
+          base::DictValue().Set("uniformBufferOffsetAlignment", 256));
+  gpu.Set("webgpuProfile",
+          base::DictValue().Set("maxComputeInvocationsPerWorkgroup", 256));
+
+  base::DictValue hardware;
+  hardware.Set("hardwareConcurrency", hardware_concurrency);
+  hardware.Set("deviceMemory", device_memory);
+  hardware.Set("maxTouchPoints", max_touch_points);
+  hardware.Set("touchEnabled", max_touch_points > 0);
+
+  base::DictValue screen;
+  screen.Set("width", screen_width);
+  screen.Set("height", screen_height);
+  screen.Set("availLeft", 0);
+  screen.Set("availTop", 0);
+  screen.Set("outerWidth", outer_width);
+  screen.Set("outerHeight", outer_height);
+  screen.Set("windowScreenY", 0);
+  screen.Set("deviceScaleFactor", device_scale_factor);
+  screen.Set("orientationType", "landscape-primary");
+  screen.Set("reducedMotion", false);
+  screen.Set("colorGamut", "srgb");
+  screen.Set("dynamicRange", "standard");
+  screen.Set("monochromeDepth", 0);
+
+  base::DictValue fonts;
+  fonts.Set("id", fonts_id);
+
+  base::DictValue font_rendering;
+  font_rendering.Set("engine", platform == "Windows" ? "directwrite"
+                                                      : "coretext");
+  font_rendering.Set("useAutohinter", platform == "Linux");
+
+  base::DictValue media_devices;
+  media_devices.Set("videoFrameRate", 30);
+  media_devices.Set("audioBaseLatency", audio_base_latency);
+  media_devices.Set("audioOutputLatency", audio_base_latency * 2);
+  media_devices.Set("voiceIsolation", platform == "macOS");
+
+  base::DictValue network;
+  network.Set("type", network_type);
+  network.Set("downlinkMax", network_downlink_max);
+  network.Set("saveData", false);
+  network.Set("online", true);
+
+  return base::DictValue()
+      .Set("id", id)
+      .Set("name", name)
+      .Set("displayName", name)
+      .Set("icon", GetPersonaIconForPlatform(platform))
+      .Set("createdAt", created_at)
+      .Set("modifiedAt", created_at)
+      .Set("lastUsedAt", "")
+      .Set("enabled", true)
+      .Set("userAgent", user_agent)
+      .Set("platform", platform)
+      .Set("navigatorVendor", "Google Inc.")
+      .Set("navigatorProductSub", "20030107")
+      .Set("region", std::move(region))
+      .Set("uaCh", std::move(ua_ch))
+      .Set("gpu", std::move(gpu))
+      .Set("hardware", std::move(hardware))
+      .Set("screen", std::move(screen))
+      .Set("fonts", std::move(fonts))
+      .Set("fontRendering", std::move(font_rendering))
+      .Set("mediaDevices", std::move(media_devices))
+      .Set("network", std::move(network))
+      .Set("advanced", MakeAdvancedDefaults());
+}
