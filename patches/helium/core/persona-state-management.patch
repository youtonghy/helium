+base::DictValue PersonaService::SavePersona(const base::DictValue& payload) {
+  base::DictValue state = ReadState();
+  base::DictValue persona =
+      NormalizePersona(ValidatePersona(payload), GetActivePersonaId(state));
+  if (!PersonaHasRequiredFields(persona)) {
+    base::DictValue errors;
+    errors.Set("persona", "Persona is missing required fields");
+    return MakeResponse(false, std::move(state), std::move(errors));
+  }
+  const std::string* persona_id = persona.FindString("id");
+  if (persona_id && !persona_id->empty()) {
+    persona.Set("lastUsedAt", MakeIsoTimestamp());
+  }
+  state.Set("personas", UpsertPersona(state.FindList("personas"), persona));
+  const std::string active_persona_id =
+      persona_id ? *persona_id : kDefaultPersonaId;
+  state.Set("activePersonaId", active_persona_id);
+  state.Set("lastUsedPersonaId", active_persona_id);
+  SetLastUsedPersonaId(active_persona_id);
+  WriteState(state.Clone());
+  return MakeResponse(true, std::move(state));
+}
+
+base::DictValue PersonaService::ImportPersonas(const base::ListValue& payload) {
+  base::DictValue state = ReadState();
+  base::ListValue personas = state.FindList("personas")
+                                ? state.FindList("personas")->Clone()
+                                : base::ListValue();
+  int imported_count = 0;
+  int skipped_count = 0;
+  const std::string name_suffix = MakeImportNameSuffix();
+
+  for (const auto& value : payload) {
+    if (!value.is_dict()) {
+      ++skipped_count;
+      continue;
+    }
+
+    base::DictValue persona =
+        NormalizePersona(ValidatePersona(value.GetDict()), MakePersonaId());
+    const std::string* id = persona.FindString("id");
+    if (id && *id == kDefaultPersonaId) {
+      ++skipped_count;
+      continue;
+    }
+    persona.Set("id", MakePersonaId());
+
+    std::string display_name = GetPersonaDisplayName(persona);
+    if (PersonaNameExists(&personas, display_name)) {
+      display_name += " " + name_suffix;
+      persona.Set("name", display_name);
+      persona.Set("displayName", display_name);
+    }
+
+    if (!PersonaHasRequiredFields(persona)) {
+      ++skipped_count;
+      continue;
+    }
+    personas.Append(std::move(persona));
+    ++imported_count;
+  }
+
+  state.Set("personas", std::move(personas));
+  WriteState(state.Clone());
+  base::DictValue response = MakeResponse(imported_count > 0, std::move(state));
+  response.Set("importedCount", imported_count);
+  response.Set("skippedCount", skipped_count);
+  return response;
+}
