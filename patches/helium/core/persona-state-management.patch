+blink::HeliumPersonaSnapshot PersonaService::GetActiveSnapshot() const {
+  base::DictValue state = ReadState();
+  const base::DictValue* persona =
+      FindPersonaInList(state.FindList("personas"), GetActivePersonaId(state));
+  if (!persona) {
+    return blink::HeliumPersonaSnapshot();
+  }
+
+  blink::HeliumPersonaSnapshot snapshot;
+  snapshot.enabled = persona->FindBool("enabled").value_or(false);
+  if (!snapshot.enabled) {
+    return snapshot;
+  }
+
+  if (const std::string* value = persona->FindString("id")) {
+    snapshot.id = *value;
+    snapshot.fingerprint_profile_salt =
+        GetOrCreateFingerprintProfileSalt();
+    snapshot.fingerprint_rotation_global_epoch =
+        GetOrCreateFingerprintGlobalEpoch();
+    snapshot.noise_seed = snapshot.fingerprint_profile_salt + "\n" + *value;
+  }
+  const base::DictValue* fingerprint_rotation =
+      persona->FindDict("advanced")
+          ? persona->FindDict("advanced")->FindDict("fingerprintRotation")
+          : nullptr;
+  if (fingerprint_rotation) {
+    if (const std::string* scope = fingerprint_rotation->FindString("scope");
+        scope && !scope->empty()) {
+      snapshot.fingerprint_rotation_scope = *scope;
+    }
+    snapshot.fingerprint_rotation_interval_days =
+        fingerprint_rotation->FindInt("rotationIntervalDays")
+            .value_or(kDefaultFingerprintRotationIntervalDays);
+  }
+  if (snapshot.fingerprint_rotation_scope.empty()) {
+    snapshot.fingerprint_rotation_scope = kFingerprintRotationScopeSiteProfile;
+  }
+  if (snapshot.fingerprint_rotation_interval_days <= 0) {
+    snapshot.fingerprint_rotation_interval_days =
+        kDefaultFingerprintRotationIntervalDays;
+  }
+  if (prefs_) {
+    const base::DictValue rotation_epoch =
+        prefs_->GetDict(kPersonaFingerprintRotationEpochPref).Clone();
+    const base::DictValue* site_epochs = rotation_epoch.FindDict("sites");
+    if (site_epochs) {
+      for (auto [scope_key, epoch] : *site_epochs) {
+        if (epoch.is_string()) {
+          snapshot.fingerprint_rotation_site_epochs.push_back(
+              {scope_key, epoch.GetString()});
+        }
+      }
+    }
+  }
+  if (const std::string* value = persona->FindString("name")) {
+    snapshot.name = *value;
+  }
+  if (const std::string* value = persona->FindString("platform")) {
+    snapshot.os = *value;
+    snapshot.platform = GetNavigatorPlatformForOs(*value);
+  }
+  snapshot.device = "Desktop";
+  snapshot.passthrough = false;
+  snapshot.client_hints_enabled =
+      FindNestedBool(*persona, "advanced", "clientHintsEnabled").value_or(true);
+  snapshot.allow_background_sync =
+      FindNestedBool(*persona, "advanced", "allowBackgroundSync").value_or(false);
