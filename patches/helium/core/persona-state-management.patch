+blink::HeliumPersonaSnapshot PersonaService::GetActiveSnapshot() const {
+  base::DictValue state = ReadState();
+  const base::DictValue* persona =
+      FindPersonaInList(state.FindList("personas"), GetActivePersonaId(state));
+  if (!persona) {
+    return blink::HeliumPersonaSnapshot();
+  }
+
+  blink::HeliumPersonaSnapshot snapshot;
+  snapshot.enabled = persona->FindBool("enabled").value_or(false);
+  if (!snapshot.enabled) {
+    return snapshot;
+  }
+
+  if (const std::string* value = persona->FindString("id")) {
+    snapshot.id = *value;
+    snapshot.fingerprint_profile_salt =
+        GetOrCreateFingerprintProfileSalt();
+    snapshot.fingerprint_rotation_global_epoch =
+        GetOrCreateFingerprintGlobalEpoch();
+    snapshot.noise_seed = snapshot.fingerprint_profile_salt + "\n" + *value;
+  }
+  const base::DictValue* fingerprint_rotation =
+      persona->FindDict("advanced")
+          ? persona->FindDict("advanced")->FindDict("fingerprintRotation")
+          : nullptr;
+  if (fingerprint_rotation) {
+    if (const std::string* scope = fingerprint_rotation->FindString("scope");
+        scope && !scope->empty()) {
+      snapshot.fingerprint_rotation_scope = *scope;
+    }
+    snapshot.fingerprint_rotation_interval_days =
+        fingerprint_rotation->FindInt("rotationIntervalDays")
+            .value_or(kDefaultFingerprintRotationIntervalDays);
+  }
+  if (snapshot.fingerprint_rotation_scope.empty()) {
+    snapshot.fingerprint_rotation_scope = kFingerprintRotationScopeSiteProfile;
+  }
+  if (snapshot.fingerprint_rotation_interval_days <= 0) {
+    snapshot.fingerprint_rotation_interval_days =
+        kDefaultFingerprintRotationIntervalDays;
+  }
+  if (prefs_) {
+    const base::DictValue rotation_epoch =
+        prefs_->GetDict(kPersonaFingerprintRotationEpochPref).Clone();
+    const base::DictValue* site_epochs = rotation_epoch.FindDict("sites");
+    if (site_epochs) {
+      for (auto [scope_key, epoch] : *site_epochs) {
+        if (epoch.is_string()) {
+          snapshot.fingerprint_rotation_site_epochs.push_back(
+              {scope_key, epoch.GetString()});
+        }
+      }
+    }
+  }
+  if (const std::string* value = persona->FindString("name")) {
+    snapshot.name = *value;
+  }
+  if (const std::string* value = persona->FindString("platform")) {
+    snapshot.os = *value;
+    snapshot.platform = *value;
+  }
+  snapshot.device = "Desktop";
+  snapshot.passthrough = false;
+  snapshot.client_hints_enabled =
+      FindNestedBool(*persona, "advanced", "clientHintsEnabled").value_or(true);
+  snapshot.allow_background_sync =
+      FindNestedBool(*persona, "advanced", "allowBackgroundSync").value_or(false);
+  snapshot.allow_contacts =
+      FindNestedBool(*persona, "advanced", "allowContacts").value_or(false);
+  snapshot.allow_local_fonts =
+      FindNestedBool(*persona, "advanced", "allowLocalFonts").value_or(false);
+  snapshot.allow_privacy_sandbox_apis =
+      FindNestedBool(*persona, "advanced", "allowPrivacySandboxApis")
+          .value_or(true);
+  snapshot.allow_gamepads =
+      FindNestedBool(*persona, "advanced", "allowGamepads").value_or(true);
+  snapshot.allow_clipboard =
+      FindNestedBool(*persona, "advanced", "allowClipboard").value_or(true);
+  snapshot.allow_geolocation =
+      FindNestedBool(*persona, "advanced", "allowGeolocation").value_or(false);
+  snapshot.allow_notifications =
+      FindNestedBool(*persona, "advanced", "allowNotifications")
+          .value_or(false);
+  snapshot.allow_midi =
+      FindNestedBool(*persona, "advanced", "allowMidi").value_or(false);
+  snapshot.allow_idle_detection =
+      FindNestedBool(*persona, "advanced", "allowIdleDetection")
+          .value_or(false);
+  snapshot.allow_window_management =
+      FindNestedBool(*persona, "advanced", "allowWindowManagement")
+          .value_or(false);
+  snapshot.allow_web_nfc =
+      FindNestedBool(*persona, "advanced", "allowWebNfc").value_or(false);
+  snapshot.allow_web_xr =
+      FindNestedBool(*persona, "advanced", "allowWebXr").value_or(false);
+  snapshot.allow_sensor_apis =
+      FindNestedBool(*persona, "advanced", "allowSensorApis").value_or(false);
+  snapshot.allow_real_battery_status =
+      FindNestedBool(*persona, "advanced", "allowRealBatteryStatus")
+          .value_or(false);
+  snapshot.allow_platform_credentials =
+      FindNestedBool(*persona, "advanced", "allowPlatformCredentials")
+          .value_or(true);
+  snapshot.allow_payment_handler =
+      FindNestedBool(*persona, "advanced", "allowPaymentHandler")
+          .value_or(false);
+  snapshot.allow_speech_synthesis =
+      FindNestedBool(*persona, "advanced", "allowSpeechSynthesis")
+          .value_or(true);
+  snapshot.allow_web_printing =
+      FindNestedBool(*persona, "advanced", "allowWebPrinting").value_or(true);
+  snapshot.allow_shape_detection =
+      FindNestedBool(*persona, "advanced", "allowShapeDetection")
+          .value_or(false);
+  snapshot.allow_web_otp =
+      FindNestedBool(*persona, "advanced", "allowWebOtp").value_or(false);
+  snapshot.allow_ai_apis =
+      FindNestedBool(*persona, "advanced", "allowAiApis").value_or(false);
+  snapshot.allow_handwriting_recognition =
+      FindNestedBool(*persona, "advanced", "allowHandwritingRecognition")
+          .value_or(false);
+  snapshot.allow_web_nn =
+      FindNestedBool(*persona, "advanced", "allowWebNn").value_or(false);
+  snapshot.allow_private_state_tokens =
+      FindNestedBool(*persona, "advanced", "allowPrivateStateTokens")
+          .value_or(false);
+  snapshot.canvas_noise =
+      FindNestedBool(*persona, "advanced", "canvasNoise").value_or(true);
+  snapshot.audio_noise =
+      FindNestedBool(*persona, "advanced", "audioNoise").value_or(true);
+  snapshot.hardware_noise =
+      FindNestedBool(*persona, "advanced", "hardwareNoise").value_or(true);
+  snapshot.font_metric_noise =
+      FindNestedBool(*persona, "advanced", "fontMetricNoise").value_or(false);
+  snapshot.ua_ch_mobile =
+      FindNestedBool(*persona, "uaCh", "mobile").value_or(false);
+  snapshot.ua_ch_wow64 =
+      FindNestedBool(*persona, "uaCh", "wow64").value_or(false);
+
+  if (const std::string* user_agent = persona->FindString("userAgent")) {
+    snapshot.user_agent = *user_agent;
+  }
+  if (const std::string* value = persona->FindString("navigatorVendor")) {
+    snapshot.navigator_vendor = *value;
+  }
+  if (const std::string* value = persona->FindString("navigatorProductSub")) {
+    snapshot.navigator_product_sub = *value;
+  }
+  if (const std::string* value = FindNestedString(*persona, "region", "timezone")) {
+    snapshot.timezone = *value;
+  }
+  if (const std::string* value = FindNestedString(*persona, "region", "locale")) {
+    snapshot.locale = *value;
+    snapshot.navigator_languages = DeriveNavigatorLanguages(*value);
+  }
+  if (const std::string* accept_language =
+          FindNestedString(*persona, "region", "acceptLanguage")) {
+    snapshot.accept_language = *accept_language;
+  }
+  if (const std::string* value = FindNestedString(*persona, "uaCh", "platform")) {
+    snapshot.ua_ch_platform = *value;
+  }
+  if (const std::string* value =
+          FindNestedString(*persona, "uaCh", "platformVersion")) {
+    snapshot.ua_ch_platform_version = *value;
+  }
+  if (const std::string* value =
+          FindNestedString(*persona, "uaCh", "architecture")) {
+    snapshot.ua_ch_architecture = *value;
+  }
+  if (const std::string* value = FindNestedString(*persona, "uaCh", "model")) {
+    snapshot.ua_ch_model = *value;
+  }
+  if (const std::string* value = FindNestedString(*persona, "uaCh", "bitness")) {
+    snapshot.ua_ch_bitness = *value;
+  }
+  if (const std::string* value =
+          FindNestedString(*persona, "uaCh", "fullVersion")) {
+    snapshot.ua_ch_full_version = *value;
+  }
+  if (const std::string* value = FindNestedString(*persona, "gpu", "vendor")) {
+    snapshot.gpu_vendor = *value;
+  }
+  if (const std::string* value = FindNestedString(*persona, "gpu", "renderer")) {
+    snapshot.gpu_renderer = *value;
+  }
+  if (const std::string* value =
+          FindNestedString(*persona, "gpu", "webgpuAdapter")) {
+    snapshot.webgpu_adapter = *value;
+  }
+  if (const std::string* value =
+          FindNestedString(*persona, "gpu", "driver")) {
+    snapshot.gpu_driver = *value;
+  }
+  if (const std::string* value = FindNestedString(*persona, "fonts", "id")) {
+    snapshot.font_pack_id = *value;
+  }
+  if (const std::string* value =
+          FindNestedString(*persona, "fonts", "name")) {
+    snapshot.font_pack_name = *value;
+  }
+  const base::DictValue* fonts_dict = persona->FindDict("fonts");
+  const base::ListValue* font_families_list =
+      fonts_dict ? fonts_dict->FindList("families") : nullptr;
+  if (font_families_list) {
+    for (const auto& value : *font_families_list) {
+      if (value.is_string()) {
+        snapshot.font_families.push_back(value.GetString());
+      }
+    }
+  }
+  const base::ListValue* font_aliases_list =
+      fonts_dict ? fonts_dict->FindList("aliases") : nullptr;
+  if (font_aliases_list) {
+    for (const auto& value : *font_aliases_list) {
+      if (value.is_string()) {
+        snapshot.font_aliases.push_back(value.GetString());
+      }
+    }
+  }
+  if (const std::string* value =
+          FindNestedString(*persona, "fontRendering", "engine")) {
+    snapshot.font_rendering_engine = *value;
+  }
+  if (const std::string* value =
+          FindNestedString(*persona, "fontRendering", "id")) {
+    snapshot.font_rendering_id = *value;
+  }
+  snapshot.font_antialiasing =
+      FindNestedBool(*persona, "fontRendering", "antialiasing")
+          .value_or(false);
+  snapshot.font_subpixel_rendering =
+      FindNestedBool(*persona, "fontRendering", "subpixelRendering")
+          .value_or(false);
+  snapshot.font_lcd_text =
+      FindNestedBool(*persona, "fontRendering", "lcdText").value_or(false);
+  snapshot.hardware_concurrency =
+      FindNestedInt(*persona, "hardware", "hardwareConcurrency").value_or(0);
+  snapshot.device_memory =
+      FindNestedInt(*persona, "hardware", "deviceMemory").value_or(0);
+  snapshot.max_touch_points =
+      FindNestedInt(*persona, "hardware", "maxTouchPoints").value_or(0);
+  snapshot.screen_width =
+      FindNestedInt(*persona, "screen", "width").value_or(0);
+  snapshot.screen_height =
+      FindNestedInt(*persona, "screen", "height").value_or(0);
+  snapshot.avail_left =
+      FindNestedInt(*persona, "screen", "availLeft").value_or(0);
+  snapshot.avail_top =
+      FindNestedInt(*persona, "screen", "availTop").value_or(0);
+  snapshot.outer_width =
+      FindNestedInt(*persona, "screen", "outerWidth").value_or(0);
+  snapshot.outer_height =
+      FindNestedInt(*persona, "screen", "outerHeight").value_or(0);
+  snapshot.avail_width =
+      FindNestedInt(*persona, "screen", "availWidth")
+          .value_or(snapshot.screen_width);
+  snapshot.avail_height =
+      FindNestedInt(*persona, "screen", "availHeight")
+          .value_or(snapshot.screen_height);
+  snapshot.color_depth = 24;
+  snapshot.pixel_depth = 24;
+  snapshot.device_scale_factor =
+      FindNestedDouble(*persona, "screen", "deviceScaleFactor").value_or(0.0);
+  snapshot.refresh_rate =
+      FindNestedInt(*persona, "screen", "refreshRate").value_or(0);
+  snapshot.audio_base_latency =
+      FindNestedDouble(*persona, "mediaDevices", "audioBaseLatency")
+          .value_or(0.0);
+  snapshot.audio_output_latency =
+      FindNestedDouble(*persona, "mediaDevices", "audioOutputLatency")
+          .value_or(0.0);
+  if (const std::string* value = FindNestedString(*persona, "network", "type")) {
+    snapshot.network_type = *value;
+  }
+  snapshot.network_downlink_max =
+      FindNestedDouble(*persona, "network", "downlinkMax").value_or(0.0);
+
+  const base::DictValue* ua_ch = persona->FindDict("uaCh");
+  const base::ListValue* form_factors =
+      ua_ch ? ua_ch->FindList("formFactors") : nullptr;
+  if (form_factors) {
+    for (const auto& value : *form_factors) {
+      if (value.is_string()) {
+        snapshot.ua_ch_form_factors.push_back(value.GetString());
+      }
+    }
+  }
+
+  const base::ListValue* brands = ua_ch ? ua_ch->FindList("brands") : nullptr;
+  if (brands) {
+    for (const auto& value : *brands) {
+      if (!value.is_dict()) {
+        continue;
+      }
+      const base::DictValue& brand_dict = value.GetDict();
+      const std::string* brand = brand_dict.FindString("brand");
+      const std::string* version = brand_dict.FindString("version");
+      if (brand && version) {
+        snapshot.ua_ch_brands.push_back({*brand, *version});
+      }
+    }
+  }
+
+  return snapshot;
+}
+
+base::DictValue PersonaService::ReadState() const {
+  if (!prefs_) {
+    base::DictValue state = MakeDefaultState();
+    state.Set("lastUsedPersonaId", kDefaultPersonaId);
+    state.Set("launchSelectionMode", kLaunchSelectionModeAlwaysAsk);
+    return state;
+  }
+
+  base::DictValue state = prefs_->GetDict(kPersonaStatePref).Clone();
+  if (!state.FindList("personas")) {
+    state = MakeDefaultState();
+  } else {
+    state.Set("personas",
+              NormalizePersonaList(state.FindList("personas"), true));
+  }
+  if (!state.FindList("presets")) {
+    state.Set("presets", MakePresetList());
+  } else {
+    state.Set("presets", NormalizePersonaList(state.FindList("presets"), false));
+  }
+  if (!state.FindString("activePersonaId")) {
+    state.Set("activePersonaId", kDefaultPersonaId);
+  }
+  state.Set("lastUsedPersonaId", GetLastUsedPersonaId());
+  state.Set("launchSelectionMode", GetLaunchSelectionMode());
+  return state;
+}
+
+void PersonaService::WriteState(base::DictValue state) {
+  if (prefs_) {
+    prefs_->SetDict(kPersonaStatePref, std::move(state));
+  }
+}
+
+std::string PersonaService::GetOrCreateFingerprintProfileSalt() const {
+  if (!prefs_) {
+    return "transient-profile";
+  }
+
+  std::string salt = prefs_->GetString(kPersonaFingerprintProfileSaltPref);
+  if (salt.empty()) {
+    salt = MakeFingerprintSalt();
+    prefs_->SetString(kPersonaFingerprintProfileSaltPref, salt);
+  }
+  return salt;
+}
+
+std::string PersonaService::GetOrCreateFingerprintGlobalEpoch() const {
+  if (!prefs_) {
+    return MakeIsoTimestamp(base::Time::UnixEpoch());
+  }
+
+  base::DictValue rotation_epoch =
+      prefs_->GetDict(kPersonaFingerprintRotationEpochPref).Clone();
+  const std::string* global_epoch = rotation_epoch.FindString("global");
+  if (global_epoch && !global_epoch->empty()) {
+    return *global_epoch;
+  }
+
+  const std::string epoch = MakeIsoTimestamp();
+  rotation_epoch.Set("global", epoch);
+  prefs_->SetDict(kPersonaFingerprintRotationEpochPref,
+                  std::move(rotation_epoch));
+  return epoch;
+}
