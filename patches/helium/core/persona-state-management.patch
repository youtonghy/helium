+void PersonaService::RefreshFingerprint(
+    FingerprintRefreshScope scope,
+    const std::string& site_origin_or_empty) {
+  if (!prefs_) {
+    return;
+  }
+
+  base::DictValue rotation_epoch =
+      prefs_->GetDict(kPersonaFingerprintRotationEpochPref).Clone();
+  if (scope == FingerprintRefreshScope::kSite &&
+      !site_origin_or_empty.empty()) {
+    rotation_epoch.EnsureDict("sites")
+        ->Set(site_origin_or_empty, MakeIsoTimestamp());
+  } else {
+    prefs_->SetString(kPersonaFingerprintProfileSaltPref,
+                      MakeFingerprintSalt());
+    rotation_epoch.Set("global", MakeIsoTimestamp());
+  }
+  prefs_->SetDict(kPersonaFingerprintRotationEpochPref,
+                  std::move(rotation_epoch));
+}
