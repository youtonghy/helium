+std::optional<blink::HeliumPersonaSnapshot> PersonaRuntimeOverride::GetGlobal() {
+  base::AutoLock lock(GetPersonaRuntimeOverrideLock());
+  return GetPersonaRuntimeOverrideSnapshot();
