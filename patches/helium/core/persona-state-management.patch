+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+#include "components/helium_persona/persona_snapshot.h"
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <tuple>
+
+#include "third_party/icu/source/common/unicode/unistr.h"
+#include "third_party/icu/source/i18n/unicode/timezone.h"
+
+namespace helium_persona {
+
+namespace {
+
+bool HasNonEmptyString(const base::DictValue& value, std::string_view key) {
+  const std::string* string_value = value.FindString(key);
+  return string_value && !string_value->empty();
+}
+
+bool IsValidTimeZoneId(std::string_view timezone_id) {
+  std::unique_ptr<icu::TimeZone> timezone(icu::TimeZone::createTimeZone(
+      icu::UnicodeString::fromUTF8(timezone_id)));
+  return timezone && *timezone != icu::TimeZone::getUnknown();
+}
+
+bool IsSupportedDeviceMemory(int device_memory) {
+  switch (device_memory) {
+    case 1:
+    case 2:
+    case 4:
+    case 8:
+    case 16:
+    case 32:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool HasRequiredRegionFields(const base::DictValue& value) {
+  const base::DictValue* region = value.FindDict("region");
+  return region && HasNonEmptyString(*region, "timezone") &&
+         HasNonEmptyString(*region, "locale") &&
+         HasNonEmptyString(*region, "acceptLanguage");
+}
+
+bool HasRequiredUaChFields(const base::DictValue& value) {
+  const base::DictValue* ua_ch = value.FindDict("uaCh");
+  return ua_ch && HasNonEmptyString(*ua_ch, "platform") &&
+         HasNonEmptyString(*ua_ch, "architecture") &&
+         HasNonEmptyString(*ua_ch, "bitness");
+}
+
+void RequireNonEmptyString(const base::DictValue& value,
+                           std::string_view key,
+                           std::string_view path,
+                           base::DictValue* errors) {
+  if (!HasNonEmptyString(value, key)) {
+    errors->Set(path, "required");
+  }
+}
+
+void ValidateBooleanFields(const base::DictValue& value,
+                           std::span<const std::string_view> keys,
+                           std::string_view prefix,
+                           base::DictValue* errors) {
+  for (std::string_view key : keys) {
+    if (const base::Value* field = value.Find(key);
+        field && !field->is_bool()) {
+      errors->Set(std::string(prefix) + std::string(key), "invalid_type");
+    }
+  }
+}
+
+void ValidateStringFields(const base::DictValue& value,
+                          std::span<const std::string_view> keys,
+                          std::string_view prefix,
+                          base::DictValue* errors) {
+  for (std::string_view key : keys) {
+    if (const base::Value* field = value.Find(key);
+        field && !field->is_string()) {
+      errors->Set(std::string(prefix) + std::string(key), "invalid_type");
+    }
+  }
+}
+
+const base::DictValue* ValidateDictField(const base::DictValue& value,
+                                        std::string_view key,
+                                        std::string_view path,
+                                        bool required,
+                                        base::DictValue* errors) {
+  const base::Value* field = value.Find(key);
+  if (!field) {
+    if (required) {
+      errors->Set(path, "required");
+    }
+    return nullptr;
+  }
+  if (!field->is_dict()) {
+    errors->Set(path, "invalid_type");
+    return nullptr;
+  }
+  return &field->GetDict();
+}
+
+void ValidateStringList(const base::DictValue& value,
+                        std::string_view key,
+                        std::string_view path,
+                        bool require_non_empty,
+                        base::DictValue* errors) {
+  const base::Value* field = value.Find(key);
+  if (!field) {
+    return;
+  }
+  if (!field->is_list()) {
+    errors->Set(path, "invalid_type");
+    return;
+  }
+  const base::ListValue& list = field->GetList();
+  if (require_non_empty && list.empty()) {
+    errors->Set(path, "required");
+    return;
+  }
+  for (const auto& item : list) {
+    if (!item.is_string() || item.GetString().empty()) {
+      errors->Set(path, "invalid_element");
+      return;
+    }
+  }
+}
+
+void ValidateUaChBrands(const base::DictValue& ua_ch,
+                        base::DictValue* errors) {
+  const base::Value* field = ua_ch.Find("brands");
+  if (!field) {
+    return;
+  }
+  if (!field->is_list()) {
+    errors->Set("uaCh.brands", "invalid_type");
+    return;
+  }
+  const base::ListValue& brands = field->GetList();
+  if (brands.empty()) {
+    errors->Set("uaCh.brands", "required");
+    return;
+  }
+  for (const auto& item : brands) {
+    if (!item.is_dict() || !HasNonEmptyString(item.GetDict(), "brand") ||
+        !HasNonEmptyString(item.GetDict(), "version")) {
+      errors->Set("uaCh.brands", "invalid_element");
+      return;
+    }
+  }
+}
+
+std::optional<double> GetNumber(const base::Value* value) {
+  if (!value) {
+    return std::nullopt;
+  }
+  if (value->is_int()) {
+    return value->GetInt();
+  }
+  if (value->is_double()) {
+    return value->GetDouble();
+  }
+  return std::nullopt;
+}
+
+void ValidateNumber(const base::DictValue& parent,
+                    std::string_view key,
+                    std::string_view path,
+                    double minimum,
+                    double maximum,
+                    bool require_integer,
+                    base::DictValue* errors) {
+  const base::Value* field = parent.Find(key);
+  if (!field) {
+    return;
+  }
+  if (require_integer && !field->is_int()) {
+    errors->Set(path, "invalid_type");
+    return;
+  }
+  const std::optional<double> number = GetNumber(field);
+  if (!number) {
+    errors->Set(path, "invalid_type");
+    return;
+  }
+  if (*number < minimum || *number > maximum) {
+    errors->Set(path, "out_of_range");
+  }
+}
+
+void ValidateNumericGroup(const base::DictValue& value,
+                          std::string_view group,
+                          std::span<const std::tuple<std::string_view,
+                                                     double,
+                                                     double,
+                                                     bool>> fields,
+                          base::DictValue* errors) {
+  const base::DictValue* dict = value.FindDict(group);
+  if (!dict) {
+    return;
+  }
+  for (const auto& [key, minimum, maximum, require_integer] : fields) {
+    ValidateNumber(*dict, key, std::string(group) + "." + std::string(key),
+                   minimum, maximum, require_integer, errors);
+  }
+}
+
+}  // namespace
+
+bool PersonaHasRequiredFields(const base::DictValue& value) {
+  return HasNonEmptyString(value, "id") && HasNonEmptyString(value, "name") &&
+         value.FindBool("enabled").has_value() &&
+         HasRequiredRegionFields(value) && HasRequiredUaChFields(value) &&
+         value.FindDict("advanced");
+}
+
+base::DictValue ValidatePersona(const base::DictValue& value) {
+  return value.Clone();
+}
+
+base::DictValue GetPersonaFieldErrors(const base::DictValue& value) {
+  base::DictValue errors;
+  RequireNonEmptyString(value, "id", "id", &errors);
+  RequireNonEmptyString(value, "name", "name", &errors);
+  RequireNonEmptyString(value, "displayName", "displayName", &errors);
+  if (!value.FindBool("enabled").has_value()) {
+    errors.Set("enabled", "invalid_type");
+  }
+  constexpr std::array<std::string_view, 11> kTopLevelStringFields = {
+      "id",          "name",              "displayName", "icon",
+      "userAgent",   "platform",          "navigatorVendor",
+      "navigatorProductSub", "createdAt", "modifiedAt",  "lastUsedAt",
+  };
+  ValidateStringFields(value, kTopLevelStringFields, "", &errors);
+
+  const base::DictValue* region =
+      ValidateDictField(value, "region", "region", true, &errors);
+  if (region) {
+    RequireNonEmptyString(*region, "timezone", "region.timezone", &errors);
+    RequireNonEmptyString(*region, "locale", "region.locale", &errors);
+    RequireNonEmptyString(*region, "acceptLanguage", "region.acceptLanguage",
+                          &errors);
+    constexpr std::array<std::string_view, 3> kRegionStringFields = {
+        "timezone", "locale", "acceptLanguage"};
+    ValidateStringFields(*region, kRegionStringFields, "region.", &errors);
+    if (const std::string* timezone = region->FindString("timezone");
+        timezone && !timezone->empty() && !IsValidTimeZoneId(*timezone)) {
+      errors.Set("region.timezone", "invalid_value");
+    }
+  }
+  const base::DictValue* ua_ch =
+      ValidateDictField(value, "uaCh", "uaCh", true, &errors);
+  if (ua_ch) {
+    RequireNonEmptyString(*ua_ch, "platform", "uaCh.platform", &errors);
+    RequireNonEmptyString(*ua_ch, "architecture", "uaCh.architecture",
+                          &errors);
+    RequireNonEmptyString(*ua_ch, "bitness", "uaCh.bitness", &errors);
+    constexpr std::array<std::string_view, 2> kUaChBooleanFields = {
+        "mobile", "wow64"};
+    ValidateBooleanFields(*ua_ch, kUaChBooleanFields, "uaCh.", &errors);
+    constexpr std::array<std::string_view, 6> kUaChStringFields = {
+        "platform", "platformVersion", "architecture",
+        "model",    "bitness",         "fullVersion"};
+    ValidateStringFields(*ua_ch, kUaChStringFields, "uaCh.", &errors);
+    ValidateUaChBrands(*ua_ch, &errors);
+    ValidateStringList(*ua_ch, "formFactors", "uaCh.formFactors", true,
+                       &errors);
+  }
+
+  const base::DictValue* advanced =
+      ValidateDictField(value, "advanced", "advanced", true, &errors);
+  if (advanced) {
+    constexpr std::array<std::string_view, 30> kAdvancedBooleanFields = {
+        "clientHintsEnabled",
+        "canvasNoise",
+        "audioNoise",
+        "hardwareNoise",
+        "fontMetricNoise",
+        "allowBackgroundSync",
+        "allowContacts",
+        "allowLocalFonts",
+        "allowPrivacySandboxApis",
+        "allowGamepads",
+        "allowClipboard",
+        "allowGeolocation",
+        "allowNotifications",
+        "allowMidi",
+        "allowIdleDetection",
+        "allowWindowManagement",
+        "allowWebNfc",
+        "allowWebXr",
+        "allowSensorApis",
+        "allowRealBatteryStatus",
+        "allowPlatformCredentials",
+        "allowPaymentHandler",
+        "allowSpeechSynthesis",
+        "allowWebPrinting",
+        "allowShapeDetection",
+        "allowWebOtp",
+        "allowAiApis",
+        "allowHandwritingRecognition",
+        "allowWebNn",
+        "allowPrivateStateTokens",
+    };
+    ValidateBooleanFields(*advanced, kAdvancedBooleanFields, "advanced.",
+                          &errors);
+    const base::DictValue* rotation = ValidateDictField(
+        *advanced, "fingerprintRotation", "advanced.fingerprintRotation",
+        false, &errors);
+    if (rotation) {
+      constexpr std::array<std::string_view, 1> kRotationStringFields = {
+          "scope"};
+      constexpr std::array<std::string_view, 3> kRotationBooleanFields = {
+          "rotateOnManualRefresh", "rotateOnBrowserRestart",
+          "rotateOnProfileReset"};
+      ValidateStringFields(*rotation, kRotationStringFields,
+                           "advanced.fingerprintRotation.", &errors);
+      ValidateBooleanFields(*rotation, kRotationBooleanFields,
+                            "advanced.fingerprintRotation.", &errors);
+      ValidateNumber(*rotation, "rotationIntervalDays",
+                     "advanced.fingerprintRotation.rotationIntervalDays", 1,
+                     3650, true, &errors);
+    }
+  }
+
+  constexpr std::array<std::string_view, 7> kOptionalDictFields = {
+      "gpu", "hardware", "screen", "fonts", "fontRendering",
+      "mediaDevices", "network"};
+  for (std::string_view key : kOptionalDictFields) {
+    ValidateDictField(value, key, key, false, &errors);
+  }
+
+  if (const base::DictValue* gpu = value.FindDict("gpu")) {
+    constexpr std::array<std::string_view, 4> kGpuStringFields = {
+        "vendor", "renderer", "webgpuAdapter", "driver"};
+    ValidateStringFields(*gpu, kGpuStringFields, "gpu.", &errors);
+  }
+  if (const base::DictValue* hardware = value.FindDict("hardware")) {
+    constexpr std::array<std::string_view, 1> kHardwareBooleanFields = {
+        "touchEnabled"};
+    ValidateBooleanFields(*hardware, kHardwareBooleanFields, "hardware.",
+                          &errors);
+  }
+  if (const base::DictValue* screen = value.FindDict("screen")) {
+    constexpr std::array<std::string_view, 3> kScreenStringFields = {
+        "orientationType", "colorGamut", "dynamicRange"};
+    constexpr std::array<std::string_view, 1> kScreenBooleanFields = {
+        "reducedMotion"};
+    ValidateStringFields(*screen, kScreenStringFields, "screen.", &errors);
+    ValidateBooleanFields(*screen, kScreenBooleanFields, "screen.", &errors);
+  }
+  if (const base::DictValue* fonts = value.FindDict("fonts")) {
+    constexpr std::array<std::string_view, 2> kFontStringFields = {"id",
+                                                                   "name"};
+    ValidateStringFields(*fonts, kFontStringFields, "fonts.", &errors);
+    ValidateStringList(*fonts, "families", "fonts.families", false, &errors);
+    ValidateStringList(*fonts, "aliases", "fonts.aliases", false, &errors);
+  }
+  if (const base::DictValue* font_rendering =
+          value.FindDict("fontRendering")) {
+    constexpr std::array<std::string_view, 2> kFontRenderingStringFields = {
+        "engine", "id"};
+    constexpr std::array<std::string_view, 4> kFontRenderingBooleanFields = {
+        "useAutohinter", "antialiasing", "subpixelRendering", "lcdText"};
+    ValidateStringFields(*font_rendering, kFontRenderingStringFields,
+                         "fontRendering.", &errors);
+    ValidateBooleanFields(*font_rendering, kFontRenderingBooleanFields,
+                          "fontRendering.", &errors);
+  }
+  if (const base::DictValue* media_devices =
+          value.FindDict("mediaDevices")) {
+    constexpr std::array<std::string_view, 1> kMediaBooleanFields = {
+        "voiceIsolation"};
+    ValidateBooleanFields(*media_devices, kMediaBooleanFields, "mediaDevices.",
+                          &errors);
+  }
+  if (const base::DictValue* network = value.FindDict("network")) {
+    constexpr std::array<std::string_view, 1> kNetworkStringFields = {"type"};
+    constexpr std::array<std::string_view, 2> kNetworkBooleanFields = {
+        "saveData", "online"};
+    ValidateStringFields(*network, kNetworkStringFields, "network.", &errors);
+    ValidateBooleanFields(*network, kNetworkBooleanFields, "network.",
+                          &errors);
+  }
+
+  constexpr std::array<std::tuple<std::string_view, double, double, bool>, 3>
+      kHardwareFields = {
+      std::tuple{"hardwareConcurrency", 1.0, 256.0, true},
+      std::tuple{"deviceMemory", 1.0, 32.0, true},
+      std::tuple{"maxTouchPoints", 0.0, 32.0, true},
+  };
+  ValidateNumericGroup(value, "hardware", kHardwareFields, &errors);
+  if (const base::DictValue* hardware = value.FindDict("hardware")) {
+    if (std::optional<int> device_memory = hardware->FindInt("deviceMemory");
+        device_memory && !IsSupportedDeviceMemory(*device_memory)) {
+      errors.Set("hardware.deviceMemory", "unsupported_value");
+    }
+  }
+  constexpr std::array<std::tuple<std::string_view, double, double, bool>, 9>
+      kScreenFields = {
