+std::string MakePersonaId() {
+  return "persona-" + base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+std::string MakeFingerprintSalt() {
+  const std::array<uint8_t, 32> bytes = crypto::RandBytesAsArray<32>();
+  return base::HexEncodeLower(bytes);
+}
+
+std::string GetPersonaIconForPlatform(std::string_view platform) {
+  if (platform == "macOS") {
+    return "macos";
+  }
+  if (platform == "Windows") {
+    return "windows";
+  }
+  if (platform == "Linux") {
+    return "linux";
+  }
+  if (platform == "Chrome OS") {
+    return "chromeos";
+  }
+  if (platform == "Android") {
+    return "android";
+  }
+  return "default";
+}
