+
+namespace helium_persona {
+
+namespace {
+
+blink::HeliumPersonaSnapshot MakeSnapshot(std::string id, bool enabled) {
+  blink::HeliumPersonaSnapshot snapshot;
+  snapshot.id = std::move(id);
+  snapshot.name = "Test Persona";
+  snapshot.enabled = enabled;
+  snapshot.locale = "en-US";
+  snapshot.timezone = "UTC";
+  return snapshot;
+}
+
+}  // namespace
+
+class PersonaRuntimeOverrideTest : public testing::Test {
+ protected:
+  void SetUp() override { PersonaRuntimeOverride::ClearGlobal(); }
+  void TearDown() override { PersonaRuntimeOverride::ClearGlobal(); }
+};
+
+TEST_F(PersonaRuntimeOverrideTest, StartsEmpty) {
+  EXPECT_FALSE(PersonaRuntimeOverride::GetGlobal().has_value());
+}
+
+TEST_F(PersonaRuntimeOverrideTest, CachesLastResolvedPersonaSnapshot) {
+  PersonaRuntimeOverride::ApplyGlobal(MakeSnapshot("persona-a", true));
+
+  std::optional<blink::HeliumPersonaSnapshot> cached =
+      PersonaRuntimeOverride::GetGlobal();
+  ASSERT_TRUE(cached.has_value());
+  EXPECT_TRUE(cached->IsEnabled());
+  EXPECT_EQ("persona-a", cached->id);
+  EXPECT_EQ("en-US", cached->locale);
+  EXPECT_EQ("UTC", cached->timezone);
+}
+
+TEST_F(PersonaRuntimeOverrideTest, CachesExplicitSystemRealSnapshot) {
+  PersonaRuntimeOverride::ApplyGlobal(MakeSnapshot("default", false));
+
+  std::optional<blink::HeliumPersonaSnapshot> cached =
+      PersonaRuntimeOverride::GetGlobal();
+  ASSERT_TRUE(cached.has_value());
+  EXPECT_FALSE(cached->IsEnabled());
+  EXPECT_EQ("default", cached->id);
+}
+
+TEST_F(PersonaRuntimeOverrideTest, ClearRemovesCachedSnapshot) {
+  PersonaRuntimeOverride::ApplyGlobal(MakeSnapshot("persona-a", true));
+  ASSERT_TRUE(PersonaRuntimeOverride::GetGlobal().has_value());
+
+  PersonaRuntimeOverride::ClearGlobal();
+
+  EXPECT_FALSE(PersonaRuntimeOverride::GetGlobal().has_value());
+}
+
+}  // namespace helium_persona
