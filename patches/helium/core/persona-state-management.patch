+TEST_F(PersonaServiceTest, PresetsMatchRuntimeVersionAndPlatformInvariants) {
+  const base::DictValue state = service_->GetPersonaState();
+  const base::ListValue* presets = state.FindList("presets");
+  ASSERT_TRUE(presets);
+  ASSERT_EQ(19u, presets->size());
+
+  for (const auto& value : *presets) {
+    ASSERT_TRUE(value.is_dict());
+    const base::DictValue& preset = value.GetDict();
+    const std::string* id = preset.FindString("id");
+    ASSERT_TRUE(id);
+    SCOPED_TRACE(*id);
+    const std::string* platform = preset.FindString("platform");
+    const base::DictValue* ua_ch = preset.FindDict("uaCh");
+    ASSERT_TRUE(platform);
+    ASSERT_TRUE(ua_ch);
+    const base::DictValue* hardware = preset.FindDict("hardware");
+    const base::DictValue* screen = preset.FindDict("screen");
+    ASSERT_TRUE(hardware);
+    ASSERT_TRUE(screen);
+    const std::optional<int> device_memory =
+        hardware->FindInt("deviceMemory");
+    const std::optional<int> width = screen->FindInt("width");
+    const std::optional<int> height = screen->FindInt("height");
+    const std::optional<int> avail_width = screen->FindInt("availWidth");
+    const std::optional<int> avail_height = screen->FindInt("availHeight");
+    const std::optional<int> outer_width = screen->FindInt("outerWidth");
+    const std::optional<int> outer_height = screen->FindInt("outerHeight");
+    ASSERT_TRUE(device_memory);
+    ASSERT_TRUE(width);
+    ASSERT_TRUE(height);
+    ASSERT_TRUE(avail_width);
+    ASSERT_TRUE(avail_height);
+    ASSERT_TRUE(outer_width);
+    ASSERT_TRUE(outer_height);
+    EXPECT_TRUE(*device_memory == 1 || *device_memory == 2 ||
+                *device_memory == 4 || *device_memory == 8 ||
+                *device_memory == 16 || *device_memory == 32);
+    EXPECT_LE(*avail_width, *width);
+    EXPECT_LE(*avail_height, *height);
+    EXPECT_LE(*outer_width, *width);
+    EXPECT_LE(*outer_height, *height);
+    EXPECT_EQ(*outer_width, *avail_width);
+    EXPECT_EQ(*outer_height, *avail_height);
+    const std::string* full_version = ua_ch->FindString("fullVersion");
+    ASSERT_TRUE(full_version);
+    EXPECT_TRUE(full_version->starts_with("149."));
+    if (*platform == "Windows") {
+      EXPECT_FALSE(ua_ch->FindBool("wow64").value_or(true));
+    }
+    if (*platform == "Linux") {
+      const base::DictValue* font_rendering = preset.FindDict("fontRendering");
+      ASSERT_TRUE(font_rendering);
+      EXPECT_EQ("freetype", *font_rendering->FindString("engine"));
+    }
+  }
+}
