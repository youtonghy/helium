+const base::DictValue* FindPersona(const base::ListValue* personas,
+                                   const std::string& id) {
+  if (!personas) {
+    return nullptr;
+  }
+  for (const auto& value : *personas) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    const base::DictValue& persona = value.GetDict();
+    const std::string* candidate_id = persona.FindString("id");
+    if (candidate_id && *candidate_id == id) {
+      return &persona;
+    }
+  }
+  return nullptr;
+}
+
+const base::DictValue* FindFirstCustomPersona(
+    const base::ListValue* personas) {
+  if (!personas) {
+    return nullptr;
+  }
+  for (const auto& value : *personas) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    const base::DictValue& persona = value.GetDict();
+    const std::string* id = persona.FindString("id");
+    if (id && *id != kDefaultPersonaId) {
+      return &persona;
+    }
+  }
+  return nullptr;
+}
