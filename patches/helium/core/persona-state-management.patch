+  snapshot.font_subpixel_rendering =
+      FindNestedBool(*persona, "fontRendering", "subpixelRendering")
+          .value_or(false);
+  snapshot.font_lcd_text =
+      FindNestedBool(*persona, "fontRendering", "lcdText").value_or(false);
+  snapshot.hardware_concurrency =
+      FindNestedInt(*persona, "hardware", "hardwareConcurrency").value_or(0);
+  snapshot.device_memory =
+      FindNestedInt(*persona, "hardware", "deviceMemory").value_or(0);
+  snapshot.max_touch_points =
+      FindNestedInt(*persona, "hardware", "maxTouchPoints").value_or(0);
+  snapshot.screen_width =
+      FindNestedInt(*persona, "screen", "width").value_or(0);
+  snapshot.screen_height =
+      FindNestedInt(*persona, "screen", "height").value_or(0);
+  snapshot.avail_left =
+      FindNestedInt(*persona, "screen", "availLeft").value_or(0);
+  snapshot.avail_top =
