+base::Lock& GetPersonaRuntimeOverrideLock() {
+  static base::NoDestructor<base::Lock> lock;
+  return *lock;
+}
+
+std::optional<blink::HeliumPersonaSnapshot>& GetPersonaRuntimeOverrideSnapshot() {
+  static base::NoDestructor<std::optional<blink::HeliumPersonaSnapshot>>
+      snapshot;
+  return *snapshot;
+}
+
+}  // namespace
+
+void PersonaRuntimeOverride::ApplyGlobal(
+    const blink::HeliumPersonaSnapshot& snapshot) {
+  base::AutoLock lock(GetPersonaRuntimeOverrideLock());
+  GetPersonaRuntimeOverrideSnapshot() = snapshot;
+}
+
+void PersonaRuntimeOverride::ClearGlobal() {
+  base::AutoLock lock(GetPersonaRuntimeOverrideLock());
+  GetPersonaRuntimeOverrideSnapshot().reset();
+}
+
+std::optional<blink::HeliumPersonaSnapshot> PersonaRuntimeOverride::GetGlobal() {
+  base::AutoLock lock(GetPersonaRuntimeOverrideLock());
+  return GetPersonaRuntimeOverrideSnapshot();
+}
