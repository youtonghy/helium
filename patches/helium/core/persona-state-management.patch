+base::DictValue MakeNewProfile(std::string_view display_name) {
+  const std::string timestamp = MakeIsoTimestamp();
+  const std::string resolved_display_name =
+      display_name.empty() ? "New Persona" : std::string(display_name);
+  base::ListValue presets = MakePresetList();
+  base::DictValue persona = presets.front().GetDict().Clone();
+  persona.Set("id", MakePersonaId());
+  persona.Set("name", resolved_display_name);
+  persona.Set("displayName", resolved_display_name);
+  persona.Set("createdAt", timestamp);
+  persona.Set("modifiedAt", timestamp);
+  persona.Set("lastUsedAt", "");
+  return persona;
+}
