+base::DictValue PersonaService::SavePersona(const base::DictValue& payload) {
+  base::DictValue state = ReadState();
+  const std::string* payload_id = payload.FindString("id");
+  if (!payload_id || payload_id->empty()) {
+    base::DictValue errors;
+    errors.Set("id", "required");
+    return MakeResponse(false, std::move(state), std::move(errors));
+  }
+  if (*payload_id == kDefaultPersonaId) {
+    base::DictValue errors;
+    errors.Set("id", "reserved");
+    return MakeResponse(false, std::move(state), std::move(errors));
+  }
+  const base::DictValue* existing =
+      FindPersonaInList(state.FindList("personas"), *payload_id);
+  if (!existing) {
+    base::DictValue errors;
+    errors.Set("id", "unknown_persona");
+    return MakeResponse(false, std::move(state), std::move(errors));
+  }
+
+  base::DictValue validated = ValidatePersona(payload);
+  base::DictValue errors = GetPersonaFieldErrors(validated);
+  if (!PersonaHasRequiredFields(validated) || !errors.empty()) {
+    if (errors.empty()) {
+      errors.Set("persona", "missing_required_fields");
+    }
+    return MakeResponse(false, std::move(state), std::move(errors));
+  }
+
+  base::DictValue persona = NormalizePersona(validated, *payload_id);
+  const std::string* display_name = persona.FindString("displayName");
+  persona.Set("name", display_name ? *display_name : "Custom Persona");
+  if (const std::string* created_at = existing->FindString("createdAt")) {
+    persona.Set("createdAt", *created_at);
+  }
+  if (const std::string* last_used_at = existing->FindString("lastUsedAt")) {
+    persona.Set("lastUsedAt", *last_used_at);
+  }
+  persona.Set("modifiedAt", MakeIsoTimestamp());
+  persona.Set("enabled", true);
+  state.Set("personas", UpsertPersona(state.FindList("personas"), persona));
+  WriteState(state.Clone());
+  return MakeResponse(true, std::move(state));
+}
+
+base::DictValue PersonaService::ImportPersonas(const base::DictValue& bundle) {
+  base::DictValue state = ReadState();
+  const std::string* schema = bundle.FindString("schema");
+  const base::ListValue* payload = bundle.FindList("personas");
+  if (!schema || *schema != kPersonaImportSchema || !payload) {
+    base::DictValue errors;
+    errors.Set(!schema || *schema != kPersonaImportSchema ? "schema" : "personas",
+               !schema || *schema != kPersonaImportSchema ? "unsupported"
+                                                          : "invalid_type");
+    return MakeResponse(false, std::move(state), std::move(errors));
+  }
+  base::ListValue personas = state.FindList("personas")
+                                ? state.FindList("personas")->Clone()
+                                : base::ListValue();
+  int imported_count = 0;
+  int skipped_count = 0;
+  const std::string name_suffix = MakeImportNameSuffix();
+  base::DictValue field_errors;
+
+  for (size_t index = 0; index < payload->size(); ++index) {
+    const auto& value = (*payload)[index];
+    if (!value.is_dict()) {
+      field_errors.Set(base::NumberToString(index), "invalid_type");
+      ++skipped_count;
+      continue;
+    }
+
+    base::DictValue validated = ValidatePersona(value.GetDict());
+    validated.Set("id", MakePersonaId());
+    base::DictValue errors = GetPersonaFieldErrors(validated);
+    if (!PersonaHasRequiredFields(validated) || !errors.empty()) {
+      field_errors.Set(base::NumberToString(index), std::move(errors));
+      ++skipped_count;
+      continue;
+    }
+
+    base::DictValue persona =
+        NormalizePersona(validated, *validated.FindString("id"));
+    persona.Set("enabled", true);
+    persona.Set("modifiedAt", MakeIsoTimestamp());
+
+    std::string display_name = GetPersonaDisplayName(persona);
+    int duplicate_index = 2;
+    if (PersonaNameExists(&personas, display_name)) {
+      display_name += " " + name_suffix;
+      const std::string base_name = display_name;
+      while (PersonaNameExists(&personas, display_name)) {
+        display_name = base_name + " " + base::NumberToString(duplicate_index++);
+      }
+      persona.Set("name", display_name);
+      persona.Set("displayName", display_name);
+    }
+    personas.Append(std::move(persona));
+    ++imported_count;
+  }
+
+  if (imported_count > 0) {
+    state.Set("personas", std::move(personas));
+    WriteState(state.Clone());
+  }
+  base::DictValue response = MakeResponse(imported_count > 0, std::move(state),
+                                          std::move(field_errors));
+  response.Set("importedCount", imported_count);
+  response.Set("skippedCount", skipped_count);
+  return response;
+}
