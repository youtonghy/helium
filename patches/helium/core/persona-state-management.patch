+inline std::string ResolveHeliumPersonaBrandFullVersion(
+    std::string_view brand_version,
+    std::string_view browser_full_version) {
+  const std::string_view brand_major =
+      brand_version.substr(0, brand_version.find('.'));
+  const std::string_view browser_major =
+      browser_full_version.substr(0, browser_full_version.find('.'));
+  if (!browser_full_version.empty() && brand_major == browser_major) {
+    return std::string(browser_full_version);
+  }
+  if (brand_version.find('.') != std::string_view::npos) {
+    return std::string(brand_version);
+  }
+  return std::string(brand_version) + ".0.0.0";
+}
