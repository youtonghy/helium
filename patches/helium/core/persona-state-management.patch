+
+base::DictValue MakeDefaultPersona() {
+  const std::string created_at = MakeIsoTimestamp();
+  return base::DictValue()
+      .Set("id", kDefaultPersonaId)
+      .Set("name", "No Persona (System Real)")
+      .Set("displayName", "No Persona (System Real)")
+      .Set("icon", "default")
+      .Set("createdAt", created_at)
+      .Set("modifiedAt", created_at)
+      .Set("lastUsedAt", "")
+      .Set("enabled", false)
+      .Set("userAgent", "")
+      .Set("region", MakeRegionDefaults())
+      .Set("uaCh", MakeUaChDefaults())
+      .Set("advanced", MakeAdvancedDefaults());
+}
+
+base::DictValue MakeDefaultState() {
+  base::ListValue personas;
+  personas.Append(MakeDefaultPersona());
+
+  return base::DictValue()
+      .Set("activePersonaId", kDefaultPersonaId)
+      .Set("personas", std::move(personas))
+      .Set("presets", MakePresetList());
+}
+
+bool IsValidLaunchSelectionMode(std::string_view mode) {
+  return mode == kLaunchSelectionModeAlwaysAsk ||
+         mode == kLaunchSelectionModeUseLast;
+}
+
+std::string ResolvePersonaPlatform(const base::DictValue& persona);
+
+const base::DictValue* FindPersonaInList(const base::ListValue* personas,
+                                         const std::string& persona_id) {
+  if (!personas) {
+    return nullptr;
+  }
+
+  for (const auto& value : *personas) {
+    if (!value.is_dict()) {
+      continue;
+    }
+
+    const base::DictValue& persona = value.GetDict();
+    const std::string* id = persona.FindString("id");
+    if (id && *id == persona_id) {
+      return &persona;
+    }
+  }
+  return nullptr;
+}
+
+std::string GetActivePersonaId(const base::DictValue& state) {
+  const std::string* active_id = state.FindString("activePersonaId");
+  return active_id && !active_id->empty() ? *active_id : kDefaultPersonaId;
+}
+
+std::string GetPersonaDisplayName(const base::DictValue& persona) {
+  if (const std::string* display_name = persona.FindString("displayName");
+      display_name && !display_name->empty()) {
+    return *display_name;
+  }
+  if (const std::string* name = persona.FindString("name");
+      name && !name->empty()) {
+    return *name;
+  }
+  return "Custom Persona";
+}
+
+std::string MakeImportNameSuffix() {
+  std::string suffix;
+  base::ReplaceChars(MakeIsoTimestamp(), "-:TZ", "", &suffix);
+  if (suffix.size() > 8) {
+    suffix.insert(8, "-");
+  }
+  return suffix;
+}
+
+bool PersonaNameExists(const base::ListValue* personas,
+                       std::string_view display_name) {
+  if (!personas || display_name.empty()) {
+    return false;
+  }
+  return std::any_of(personas->begin(), personas->end(),
+                     [display_name](const base::Value& value) {
+    if (!value.is_dict()) {
+      return false;
+    }
+    return GetPersonaDisplayName(value.GetDict()) == display_name;
+  });
+}
+
+base::DictValue NormalizePersona(const base::DictValue& payload,
+                                 const std::string& fallback_id) {
+  base::DictValue persona = payload.Clone();
+  const std::string timestamp = MakeIsoTimestamp();
+
+  const std::string* id = persona.FindString("id");
+  if (!id || id->empty()) {
+    persona.Set("id", fallback_id.empty() ? kDefaultPersonaId : fallback_id);
+  }
+
+  const std::string* name = persona.FindString("name");
+  if (!name || name->empty()) {
+    persona.Set("name", "Custom Persona");
+  }
+  if (const std::string* display_name = persona.FindString("displayName");
+      !display_name || display_name->empty()) {
+    persona.Set("displayName", GetPersonaDisplayName(persona));
+  }
+
+  const std::string platform = ResolvePersonaPlatform(persona);
+  persona.Set("platform", platform);
+  if (const std::string* icon = persona.FindString("icon");
+      !icon || icon->empty()) {
+    persona.Set("icon", GetPersonaIconForPlatform(platform));
+  }
+
+  const std::string* created_at = persona.FindString("createdAt");
+  if (!created_at || created_at->empty()) {
+    persona.Set("createdAt", timestamp);
+  }
+  const std::string* modified_at = persona.FindString("modifiedAt");
+  if (!modified_at || modified_at->empty()) {
+    persona.Set("modifiedAt", timestamp);
+  }
+  if (!persona.FindString("lastUsedAt")) {
+    persona.Set("lastUsedAt", "");
+  }
+
+  if (!persona.FindBool("enabled").has_value()) {
+    persona.Set("enabled", true);
+  }
+
+  if (!persona.FindString("userAgent")) {
+    persona.Set("userAgent", "");
+  }
+  if (!persona.FindString("navigatorVendor")) {
+    persona.Set("navigatorVendor", "Google Inc.");
+  }
+  if (!persona.FindString("navigatorProductSub")) {
+    persona.Set("navigatorProductSub", "20030107");
+  }
+
+  base::DictValue* region = persona.EnsureDict("region");
+  if (!region->FindString("timezone")) {
+    region->Set("timezone", "UTC");
+  }
+  if (!region->FindString("locale")) {
+    region->Set("locale", "en-US");
+  }
+  if (!region->FindString("acceptLanguage")) {
+    region->Set("acceptLanguage", "en-US,en;q=0.9");
+  }
+
+  base::DictValue* ua_ch = persona.EnsureDict("uaCh");
+  if (!ua_ch->FindString("platform")) {
+    ua_ch->Set("platform", "macOS");
+  }
+  if (!ua_ch->FindString("platformVersion")) {
+    ua_ch->Set("platformVersion", "");
+  }
+  if (!ua_ch->FindString("architecture")) {
+    ua_ch->Set("architecture", "arm");
+  }
+  if (!ua_ch->FindString("model")) {
+    ua_ch->Set("model", "");
+  }
+  if (!ua_ch->FindString("bitness")) {
+    ua_ch->Set("bitness", "64");
+  }
+  if (!ua_ch->FindString("fullVersion")) {
+    ua_ch->Set("fullVersion", "");
+  }
+  if (!ua_ch->FindBool("mobile").has_value()) {
+    ua_ch->Set("mobile", false);
+  }
+  if (!ua_ch->FindBool("wow64").has_value()) {
+    ua_ch->Set("wow64", false);
+  }
+  if (!ua_ch->FindList("brands") || !ua_ch->FindList("formFactors")) {
+    const base::DictValue defaults = MakeUaChDefaults();
+    if (!ua_ch->FindList("brands")) {
+      ua_ch->Set("brands", defaults.FindList("brands")->Clone());
+    }
+    if (!ua_ch->FindList("formFactors")) {
+      ua_ch->Set("formFactors", defaults.FindList("formFactors")->Clone());
+    }
+  }
+
+  base::DictValue* gpu = persona.EnsureDict("gpu");
+  if (!gpu->FindString("vendor")) {
+    gpu->Set("vendor", platform == "macOS" ? "Apple Inc." : "Intel Inc.");
+  }
+  if (!gpu->FindString("renderer")) {
+    gpu->Set("renderer", platform == "macOS"
+                             ? "ANGLE (Apple, Apple M2, Metal)"
+                             : "ANGLE (Intel, Intel Iris Xe Graphics Direct3D11)");
+  }
+  if (!gpu->FindString("webgpuAdapter")) {
+    gpu->Set("webgpuAdapter",
+             platform == "macOS" ? "Apple M2" : "Intel Iris Xe Graphics");
+  }
+
+  base::DictValue* hardware = persona.EnsureDict("hardware");
+  if (!hardware->FindInt("hardwareConcurrency")) {
+    hardware->Set("hardwareConcurrency", 8);
+  }
+  if (!hardware->FindInt("deviceMemory")) {
+    hardware->Set("deviceMemory", 16);
+  }
+  if (!hardware->FindInt("maxTouchPoints")) {
+    hardware->Set("maxTouchPoints", 0);
+  }
+
+  base::DictValue* screen = persona.EnsureDict("screen");
+  if (!screen->FindInt("width")) {
+    screen->Set("width", platform == "macOS" ? 1512 : 1920);
+  }
+  if (!screen->FindInt("height")) {
+    screen->Set("height", platform == "macOS" ? 982 : 1080);
+  }
+  const int screen_width = screen->FindInt("width").value_or(1512);
+  const int screen_height = screen->FindInt("height").value_or(982);
+  if (!screen->FindInt("availLeft")) {
+    screen->Set("availLeft", 0);
+  }
+  if (!screen->FindInt("availTop")) {
+    screen->Set("availTop", 0);
+  }
+  if (!screen->FindInt("availWidth")) {
+    screen->Set("availWidth", screen_width);
+  }
+  if (!screen->FindInt("availHeight")) {
+    screen->Set("availHeight", screen_height);
+  }
+  if (!screen->FindInt("outerWidth")) {
+    screen->Set("outerWidth", screen_width);
+  }
+  if (!screen->FindInt("outerHeight")) {
+    screen->Set("outerHeight", screen_height);
+  }
+  if (!screen->FindDouble("deviceScaleFactor")) {
+    screen->Set("deviceScaleFactor", platform == "macOS" ? 2.0 : 1.0);
+  }
+
+  base::DictValue* fonts = persona.EnsureDict("fonts");
+  if (!fonts->FindString("id")) {
+    fonts->Set("id", platform == "Windows"   ? "segoe-default"
+                     : platform == "Linux" ? "noto-default"
+                                           : "sf-pro-default");
+  }
+  if (!fonts->FindList("families")) {
+    base::ListValue families;
+    if (platform == "Windows") {
+      families.Append("Arial");
+      families.Append("Segoe UI");
+      families.Append("Times New Roman");
+      families.Append("Courier New");
+    } else if (platform == "Linux") {
+      families.Append("Noto Sans");
+      families.Append("Liberation Sans");
+      families.Append("Liberation Serif");
+      families.Append("DejaVu Sans Mono");
+    } else {
+      families.Append("Arial");
+      families.Append("Helvetica");
+      families.Append("Times");
+      families.Append("Courier");
+    }
+    fonts->Set("families", std::move(families));
+  }
+  if (!fonts->FindList("aliases")) {
+    fonts->Set("aliases", base::ListValue());
+  }
+
+  base::DictValue* font_rendering = persona.EnsureDict("fontRendering");
+  if (!font_rendering->FindString("engine")) {
+    font_rendering->Set("engine", platform == "Windows"   ? "directwrite"
+                                  : platform == "Linux" ? "freetype"
+                                                        : "coretext");
+  }
+
+  base::DictValue* media_devices = persona.EnsureDict("mediaDevices");
+  if (!media_devices->FindDouble("audioBaseLatency")) {
+    media_devices->Set("audioBaseLatency", platform == "macOS" ? 0.01 : 0.02);
+  }
+  if (!media_devices->FindDouble("audioOutputLatency")) {
+    media_devices->Set("audioOutputLatency",
+                       platform == "macOS" ? 0.02 : 0.04);
+  }
+
+  base::DictValue* network = persona.EnsureDict("network");
+  if (!network->FindString("type")) {
+    network->Set("type", "wifi");
+  }
+  if (!network->FindDouble("downlinkMax")) {
+    network->Set("downlinkMax", 25.0);
+  }
+
+  base::DictValue* advanced = persona.EnsureDict("advanced");
+  if (!advanced->FindBool("clientHintsEnabled").has_value()) {
+    advanced->Set("clientHintsEnabled", true);
+  }
+  if (!advanced->FindBool("allowBackgroundSync").has_value()) {
+    advanced->Set("allowBackgroundSync", false);
+  }
+  if (!advanced->FindBool("allowContacts").has_value()) {
+    advanced->Set("allowContacts", false);
+  }
+  if (!advanced->FindBool("allowLocalFonts").has_value()) {
+    advanced->Set("allowLocalFonts", false);
+  }
+  if (!advanced->FindBool("allowPrivacySandboxApis").has_value()) {
+    advanced->Set("allowPrivacySandboxApis", true);
+  }
+  if (!advanced->FindBool("canvasNoise").has_value()) {
+    advanced->Set("canvasNoise", true);
+  }
+  if (!advanced->FindBool("audioNoise").has_value()) {
+    advanced->Set("audioNoise", true);
+  }
+  if (!advanced->FindBool("hardwareNoise").has_value()) {
+    advanced->Set("hardwareNoise", true);
