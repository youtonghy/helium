+
+base::DictValue PersonaService::ReadState() const {
+  if (!prefs_) {
+    base::DictValue state = MakeDefaultState();
+    state.Set("lastUsedPersonaId", kDefaultPersonaId);
+    state.Set("launchSelectionMode", kLaunchSelectionModeAlwaysAsk);
+    return state;
+  }
+
+  base::DictValue state = prefs_->GetDict(kPersonaStatePref).Clone();
+  if (!state.FindList("personas")) {
+    state = MakeDefaultState();
+  } else {
+    state.Set("personas",
+              NormalizePersonaList(state.FindList("personas"), true));
+  }
+  state.Set("presets", MakePresetList());
+  const base::ListValue* personas = state.FindList("personas");
+  const std::string active_id = GetActivePersonaId(state);
+  if (!FindPersonaInList(personas, active_id)) {
+    state.Set("activePersonaId", kDefaultPersonaId);
+  }
+  const std::string last_used_id = GetLastUsedPersonaId();
+  state.Set("lastUsedPersonaId",
+            FindPersonaInList(personas, last_used_id) ? last_used_id
+                                                     : kDefaultPersonaId);
+  state.Set("launchSelectionMode", GetLaunchSelectionMode());
+  return state;
+}
+
+void PersonaService::WriteState(base::DictValue state) {
+  if (prefs_) {
+    prefs_->SetDict(kPersonaStatePref, std::move(state));
+  }
+}
+
+std::string PersonaService::GetOrCreateFingerprintProfileSalt() const {
+  if (!prefs_) {
+    return "transient-profile";
+  }
+
+  std::string salt = prefs_->GetString(kPersonaFingerprintProfileSaltPref);
+  if (salt.empty()) {
+    salt = MakeFingerprintSalt();
+    prefs_->SetString(kPersonaFingerprintProfileSaltPref, salt);
+  }
+  return salt;
+}
+
+std::string PersonaService::GetOrCreateFingerprintGlobalEpoch() const {
+  if (!prefs_) {
+    return MakeIsoTimestamp(base::Time::UnixEpoch());
+  }
+
+  base::DictValue rotation_epoch =
+      prefs_->GetDict(kPersonaFingerprintRotationEpochPref).Clone();
+  const std::string* global_epoch = rotation_epoch.FindString("global");
+  if (global_epoch && !global_epoch->empty()) {
+    return *global_epoch;
+  }
+
+  const std::string epoch = MakeIsoTimestamp();
+  rotation_epoch.Set("global", epoch);
+  prefs_->SetDict(kPersonaFingerprintRotationEpochPref,
+                  std::move(rotation_epoch));
+  return epoch;
+}
