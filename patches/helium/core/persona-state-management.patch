+blink::HeliumPersonaSnapshot ChromeContentBrowserClient::GetHeliumPersonaSnapshot(
+    content::BrowserContext* browser_context) {
+  if (!browser_context) {
+    if (auto cached = helium_persona::PersonaRuntimeOverride::GetGlobal()) {
+      return *cached;
+    }
+    return blink::HeliumPersonaSnapshot();
+  }
+  Profile* profile = Profile::FromBrowserContext(browser_context);
+  auto* service = helium_persona::PersonaServiceFactory::GetForProfile(profile);
+  if (!service) {
+    if (auto cached = helium_persona::PersonaRuntimeOverride::GetGlobal()) {
+      return *cached;
+    }
+    return blink::HeliumPersonaSnapshot();
+  }
+  blink::HeliumPersonaSnapshot snapshot = service->GetActiveSnapshot();
+  helium_persona::PersonaRuntimeOverride::ApplyGlobal(snapshot);
+  return snapshot;
+}
