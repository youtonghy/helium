+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+#include "components/helium_persona/persona_snapshot.h"
+
+#include <string_view>
+
+namespace helium_persona {
+
+namespace {
+
+bool HasNonEmptyString(const base::DictValue& value, std::string_view key) {
+  const std::string* string_value = value.FindString(key);
+  return string_value && !string_value->empty();
+}
+
+bool HasRequiredRegionFields(const base::DictValue& value) {
+  const base::DictValue* region = value.FindDict("region");
+  return region && HasNonEmptyString(*region, "timezone") &&
+         HasNonEmptyString(*region, "locale") &&
+         HasNonEmptyString(*region, "acceptLanguage");
+}
+
+bool HasRequiredUaChFields(const base::DictValue& value) {
+  const base::DictValue* ua_ch = value.FindDict("uaCh");
+  return ua_ch && HasNonEmptyString(*ua_ch, "platform") &&
+         HasNonEmptyString(*ua_ch, "architecture") &&
+         HasNonEmptyString(*ua_ch, "bitness");
+}
+
+}  // namespace
+
+bool PersonaHasRequiredFields(const base::DictValue& value) {
+  return HasNonEmptyString(value, "id") && HasNonEmptyString(value, "name") &&
+         value.FindBool("enabled").has_value() &&
+         HasRequiredRegionFields(value) && HasRequiredUaChFields(value) &&
+         value.FindDict("advanced");
+}
+
+base::DictValue ValidatePersona(const base::DictValue& value) {
+  return value.Clone();
+}
+
+}  // namespace helium_persona
