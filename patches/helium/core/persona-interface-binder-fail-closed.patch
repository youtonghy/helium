+    mojo::MakeSelfOwnedReceiver(
+        std::make_unique<DeniedBackgroundFetchService>(), std::move(receiver));
+    return;
+  }
+  BackgroundFetchServiceImpl::CreateForFrame(host, std::move(receiver));
+}
