+class DeniedContactsManager : public blink::mojom::ContactsManager {
+ public:
+  void Select(bool,
+              bool,
+              bool,
+              bool,
+              bool,
+              bool,
+              SelectCallback callback) override {
+    std::move(callback).Run(std::nullopt);
+  }
+};
+
+void BindContactsManager(
+    RenderFrameHost* host,
+    mojo::PendingReceiver<blink::mojom::ContactsManager> receiver) {
+  if (!HeliumPersonaAllowsContacts(host)) {
+    mojo::MakeSelfOwnedReceiver(std::make_unique<DeniedContactsManager>(),
+                                std::move(receiver));
+    return;
+  }
+  ContactsManagerImpl::Create(host, std::move(receiver));
+}
+
+class DeniedBackgroundFetchService
+    : public blink::mojom::BackgroundFetchService {
+ public:
+  void Fetch(int64_t,
+             const std::string&,
+             std::vector<blink::mojom::FetchAPIRequestPtr>,
+             blink::mojom::BackgroundFetchOptionsPtr,
+             const SkBitmap&,
+             blink::mojom::BackgroundFetchUkmDataPtr,
+             FetchCallback callback) override {
+    std::move(callback).Run(
+        blink::mojom::BackgroundFetchError::PERMISSION_DENIED,
+        /*registration=*/nullptr);
+  }
+
+  void GetRegistration(int64_t,
+                       const std::string&,
+                       GetRegistrationCallback callback) override {
+    std::move(callback).Run(
+        blink::mojom::BackgroundFetchError::PERMISSION_DENIED,
+        /*registration=*/nullptr);
+  }
+
+  void GetDeveloperIds(int64_t, GetDeveloperIdsCallback callback) override {
+    std::move(callback).Run(
+        blink::mojom::BackgroundFetchError::PERMISSION_DENIED,
+        /*developer_ids=*/std::vector<std::string>());
+  }
+
+  void GetIconDisplaySize(GetIconDisplaySizeCallback callback) override {
+    std::move(callback).Run(gfx::Size());
+  }
+};
+
+void BindBackgroundFetchServiceForFrame(
+    RenderFrameHost* host,
