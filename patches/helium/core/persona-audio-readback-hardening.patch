+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/helium_persona/persona_service.h"
+#include "chrome/browser/helium_persona/persona_service_factory.h"
+
+#include <algorithm>
+#include <cmath>
+#include <string>
+#include <vector>
+
+#include "base/check.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test_utils.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace helium_persona {
+
+namespace {
+
+struct AudioCapture {
+  bool consistent = false;
+  std::string buffer_hash;
+  std::string analyser_hash;
+  double sum = 0.0;
+  std::vector<double> samples;
+};
+
+double MaxAbsoluteError(const AudioCapture& expected,
+                        const AudioCapture& actual) {
+  CHECK_EQ(expected.samples.size(), actual.samples.size());
+  double maximum = 0.0;
+  for (size_t i = 0; i < expected.samples.size(); ++i) {
+    maximum =
+        std::max(maximum, std::abs(expected.samples[i] - actual.samples[i]));
+  }
+  return maximum;
+}
+
+AudioCapture CaptureAudio(content::WebContents* web_contents) {
+  const content::EvalJsResult result = content::EvalJs(web_contents, R"JS(
+    (async () => {
+      const hashArrays = arrays => {
+        let hash = 2166136261;
+        for (const array of arrays) {
+          const bytes = new Uint8Array(
+              array.buffer, array.byteOffset, array.byteLength);
+          for (const byte of bytes) {
+            hash = Math.imul(hash ^ byte, 16777619) >>> 0;
+          }
+        }
+        return hash.toString(16).padStart(8, '0');
+      };
+      const sameBytes = (left, right) => {
+        if (left.byteLength !== right.byteLength) {
+          return false;
+        }
+        const leftBytes = new Uint8Array(
+            left.buffer, left.byteOffset, left.byteLength);
+        const rightBytes = new Uint8Array(
+            right.buffer, right.byteOffset, right.byteLength);
+        return leftBytes.every((value, index) => value === rightBytes[index]);
+      };
+      const readAnalyser = analyser => {
+        const floatFrequency = new Float32Array(analyser.frequencyBinCount);
+        const byteFrequency = new Uint8Array(analyser.frequencyBinCount);
+        const floatTime = new Float32Array(analyser.fftSize);
+        const byteTime = new Uint8Array(analyser.fftSize);
+        analyser.getFloatFrequencyData(floatFrequency);
+        analyser.getByteFrequencyData(byteFrequency);
+        analyser.getFloatTimeDomainData(floatTime);
+        analyser.getByteTimeDomainData(byteTime);
+        return [floatFrequency, byteFrequency, floatTime, byteTime];
+      };
+
+      const context = new OfflineAudioContext(1, 5000, 44100);
+      const oscillator = context.createOscillator();
+      oscillator.type = 'triangle';
+      oscillator.frequency.value = 10000;
+      const analyser = context.createAnalyser();
+      analyser.fftSize = 2048;
+      analyser.smoothingTimeConstant = 0;
+      const compressor = context.createDynamicsCompressor();
+      compressor.threshold.value = -50;
+      compressor.knee.value = 40;
+      compressor.ratio.value = 12;
+      compressor.attack.value = 0;
+      compressor.release.value = 0.25;
+      oscillator.connect(analyser);
+      analyser.connect(compressor);
+      compressor.connect(context.destination);
+      oscillator.start(0);
+
+      let eventBuffer = null;
+      context.oncomplete = event => {
+        eventBuffer = event.renderedBuffer;
+      };
+      const promiseBuffer = await context.startRendering();
+      const channel = promiseBuffer.getChannelData(0);
+      const repeatedChannel = promiseBuffer.getChannelData(0);
+      const copiedChannel = new Float32Array(channel.length);
+      promiseBuffer.copyFromChannel(copiedChannel, 0);
+      const firstAnalyser = readAnalyser(analyser);
+      const secondAnalyser = readAnalyser(analyser);
+
+      const consistent =
+          eventBuffer === promiseBuffer && channel === repeatedChannel &&
+          sameBytes(channel, copiedChannel) &&
+          firstAnalyser.every(
+              (array, index) => sameBytes(array, secondAnalyser[index]));
+      let sum = 0;
+      for (let i = 4500; i < 5000; ++i) {
+        sum += Math.abs(channel[i]);
+      }
+      return {
+        consistent,
+        bufferHash: hashArrays([channel]),
+        analyserHash: hashArrays(firstAnalyser),
+        sum,
+        samples: Array.from(channel),
+      };
+    })()
+  )JS");
+
+  CHECK(result.is_ok()) << result.ExtractError();
+  const base::DictValue& dict = result.ExtractDict();
+  const base::ListValue* samples = dict.FindList("samples");
+  const std::string* buffer_hash = dict.FindString("bufferHash");
+  const std::string* analyser_hash = dict.FindString("analyserHash");
+  CHECK(samples);
+  CHECK(buffer_hash);
+  CHECK(analyser_hash);
+
+  AudioCapture capture;
+  capture.consistent = dict.FindBool("consistent").value_or(false);
+  capture.buffer_hash = *buffer_hash;
+  capture.analyser_hash = *analyser_hash;
+  capture.sum = dict.FindDouble("sum").value_or(0.0);
+  capture.samples.reserve(samples->size());
+  for (const base::Value& sample : *samples) {
+    capture.samples.push_back(sample.GetDouble());
+  }
+  return capture;
+}
+
+}  // namespace
+
+class PersonaAudioReadbackBrowserTest : public InProcessBrowserTest {};
+
+IN_PROC_BROWSER_TEST_F(PersonaAudioReadbackBrowserTest,
+                       StableWithinGenerationAndChangesAfterRefresh) {
+  const GURL test_url("data:text/html,<body></body>");
+  content::WebContents* web_contents =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(content::NavigateToURL(web_contents, test_url));
+  const AudioCapture baseline = CaptureAudio(web_contents);
+  ASSERT_TRUE(baseline.consistent);
+
+  PersonaService* service =
+      PersonaServiceFactory::GetForProfile(browser()->profile());
+  ASSERT_TRUE(service);
+  base::DictValue response = service->CreatePersonaProfile("Audio test");
+  const std::string* persona_id = response.FindString("personaId");
+  ASSERT_TRUE(persona_id);
+  ASSERT_TRUE(service->SetActivePersona(*persona_id)
+                  .FindBool("ok")
+                  .value_or(false));
+
+  ASSERT_TRUE(content::NavigateToURL(web_contents, test_url));
+  const AudioCapture generation_zero = CaptureAudio(web_contents);
+  const AudioCapture generation_zero_repeat = CaptureAudio(web_contents);
+  ASSERT_TRUE(generation_zero.consistent);
+  ASSERT_TRUE(generation_zero_repeat.consistent);
+  EXPECT_EQ(generation_zero.buffer_hash,
+            generation_zero_repeat.buffer_hash);
+  EXPECT_EQ(generation_zero.analyser_hash,
+            generation_zero_repeat.analyser_hash);
+  EXPECT_EQ(generation_zero.sum, generation_zero_repeat.sum);
+  EXPECT_NE(baseline.buffer_hash, generation_zero.buffer_hash);
+  EXPECT_GT(MaxAbsoluteError(baseline, generation_zero), 0.0);
+  EXPECT_LE(MaxAbsoluteError(baseline, generation_zero), 1e-4);
+
+  service->RefreshFingerprint(FingerprintRefreshScope::kProfile,
+                              std::string());
+  ASSERT_TRUE(content::NavigateToURL(web_contents, test_url));
+  const AudioCapture generation_one = CaptureAudio(web_contents);
+  ASSERT_TRUE(generation_one.consistent);
+  EXPECT_NE(generation_zero.buffer_hash, generation_one.buffer_hash);
+  EXPECT_NE(generation_zero.analyser_hash, generation_one.analyser_hash);
+  EXPECT_NE(generation_zero.sum, generation_one.sum);
+  EXPECT_LE(MaxAbsoluteError(baseline, generation_one), 1e-4);
+}
+
+}  // namespace helium_persona
