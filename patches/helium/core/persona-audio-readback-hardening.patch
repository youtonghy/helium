+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "third_party/blink/renderer/modules/webaudio/audio_fingerprint_noise.h"
+
+#include <array>
+#include <cmath>
+#include <limits>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace blink {
+
+TEST(AudioFingerprintNoiseTest, FloatNoiseIsStableBoundedAndTokenSpecific) {
+  const std::array<float, 6> input = {
+      -1.0f, -0.25f, 0.0f, 0.25f, 0.75f, 1.0f};
+  auto first = input;
+  auto repeat = input;
+  auto rotated = input;
+
+  ApplyAudioFingerprintNoise(first, NoiseToken(11),
+                             AudioFingerprintDomain::kOfflineRender, 0, true);
+  ApplyAudioFingerprintNoise(repeat, NoiseToken(11),
+                             AudioFingerprintDomain::kOfflineRender, 0, true);
+  ApplyAudioFingerprintNoise(rotated, NoiseToken(12),
+                             AudioFingerprintDomain::kOfflineRender, 0, true);
+
+  EXPECT_EQ(first, repeat);
+  EXPECT_NE(first, rotated);
+  for (size_t i = 0; i < input.size(); ++i) {
+    EXPECT_LE(std::abs(first[i] - input[i]), 1e-4f);
+    EXPECT_GE(first[i], -1.0f);
+    EXPECT_LE(first[i], 1.0f);
+  }
+  EXPECT_EQ(first[2], 0.0f);
+}
+
+TEST(AudioFingerprintNoiseTest, FloatNoisePreservesNonFiniteValues) {
+  std::array<float, 3> values = {
+      std::numeric_limits<float>::infinity(),
+      -std::numeric_limits<float>::infinity(),
+      std::numeric_limits<float>::quiet_NaN()};
+
+  ApplyAudioFingerprintNoise(values, NoiseToken(21),
+                             AudioFingerprintDomain::kFloatFrequency, 0,
+                             false);
+
+  EXPECT_EQ(values[0], std::numeric_limits<float>::infinity());
+  EXPECT_EQ(values[1], -std::numeric_limits<float>::infinity());
+  EXPECT_TRUE(std::isnan(values[2]));
+}
+
+TEST(AudioFingerprintNoiseTest, FloatFrequencyNoiseHasBoundedAbsoluteError) {
+  const std::array<float, 4> input = {-120.0f, -60.0f, -1.0f, 0.0f};
+  auto values = input;
+
+  ApplyAudioFingerprintNoise(values, NoiseToken(22),
+                             AudioFingerprintDomain::kFloatFrequency, 0,
+                             false);
+
+  for (size_t i = 0; i < input.size(); ++i) {
+    EXPECT_LE(std::abs(values[i] - input[i]), 1e-4f);
+  }
+  EXPECT_EQ(values.back(), 0.0f);
+}
+
+TEST(AudioFingerprintNoiseTest, ByteNoiseIsStableAndPreservesBoundaries) {
+  const std::array<uint8_t, 5> input = {0, 1, 127, 254, 255};
+  auto first = input;
+  auto repeat = input;
+
+  ApplyAudioFingerprintNoise(first, NoiseToken(31),
+                             AudioFingerprintDomain::kByteTimeDomain, 0);
+  ApplyAudioFingerprintNoise(repeat, NoiseToken(31),
+                             AudioFingerprintDomain::kByteTimeDomain, 0);
+
+  EXPECT_EQ(first, repeat);
+  EXPECT_EQ(first.front(), 0);
+  EXPECT_EQ(first.back(), 255);
+  for (size_t i = 1; i + 1 < input.size(); ++i) {
+    EXPECT_EQ(std::abs(static_cast<int>(first[i]) - input[i]), 1);
+  }
+}
+
+}  // namespace blink
