+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "third_party/blink/renderer/modules/webaudio/audio_fingerprint_noise.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace blink {
+
+namespace {
+
+constexpr uint64_t kFnvPrime = 0x00000100000001b3;
+constexpr float kMinimumGain = 0x1p-15f;
+constexpr float kGainRange = 0x1p-15f;
+constexpr float kMaximumUnboundedDelta = 0x1p-15f;
+constexpr float kMaximumAbsoluteError = 1e-4f;
+
+uint64_t Mix(uint64_t hash, uint64_t value) {
+  hash ^= value;
+  hash *= kFnvPrime;
+  return hash;
+}
+
+uint64_t DomainSeed(NoiseToken token,
+                    AudioFingerprintDomain domain,
+                    uint64_t stream_id) {
+  return Mix(Mix(token.Value(), static_cast<uint64_t>(domain)), stream_id + 1);
+}
+
+float GainForSeed(uint64_t seed) {
+  constexpr float kFractionScale = 1.0f / 65535.0f;
+  const float magnitude =
+      kMinimumGain + static_cast<float>((seed >> 1) & 0xffff) *
+                         kFractionScale * kGainRange;
+  return (seed & 1) ? magnitude : -magnitude;
+}
+
+}  // namespace
+
+void ApplyAudioFingerprintNoise(base::span<float> values,
+                                NoiseToken token,
+                                AudioFingerprintDomain domain,
+                                uint64_t stream_id,
+                                bool clamp_unit_range) {
+  const uint64_t seed = DomainSeed(token, domain, stream_id);
+  const float gain = GainForSeed(seed);
+  for (size_t i = 0; i < values.size(); ++i) {
+    const float value = values[i];
+    if (!std::isfinite(value) || value == 0.0f) {
+      continue;
+    }
+
+    const uint64_t element_seed = Mix(seed, i + 1);
+    const float direction =
+        (element_seed & 1) ? std::numeric_limits<float>::infinity()
+                           : -std::numeric_limits<float>::infinity();
+    if (clamp_unit_range) {
+      const float perturbed = std::nextafter(value * (1.0f + gain), direction);
+      values[i] = std::clamp(perturbed, -1.0f, 1.0f);
+      continue;
+    }
+
+    const float delta = std::clamp(value * gain, -kMaximumUnboundedDelta,
+                                   kMaximumUnboundedDelta);
+    const float perturbed = std::nextafter(value + delta, direction);
+    if (std::abs(perturbed - value) <= kMaximumAbsoluteError) {
+      values[i] = perturbed;
+    }
+  }
+}
+
+void ApplyAudioFingerprintNoise(base::span<uint8_t> values,
+                                NoiseToken token,
+                                AudioFingerprintDomain domain,
+                                uint64_t stream_id) {
+  const uint64_t seed = DomainSeed(token, domain, stream_id);
+  for (size_t i = 0; i < values.size(); ++i) {
+    if (values[i] == 0 || values[i] == 255) {
+      continue;
+    }
+    values[i] = static_cast<uint8_t>(
+        values[i] + ((Mix(seed, i + 1) & 1) ? 1 : -1));
+  }
+}
+
+}  // namespace blink
