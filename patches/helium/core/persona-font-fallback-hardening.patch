+#include "third_party/blink/renderer/platform/fonts/persona_cjk_fallback_font.h"
+
+#include "base/memory/ref_counted_memory.h"
+#include "base/no_destructor.h"
+#include "third_party/blink/public/platform/platform.h"
+#include "third_party/blink/public/resources/grit/blink_resources.h"
+#include "third_party/blink/renderer/platform/fonts/font_description.h"
+#include "third_party/blink/renderer/platform/fonts/font_platform_data.h"
+#include "third_party/blink/renderer/platform/fonts/simple_font_data.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/ports/SkTypeface_fontations.h"
+#include "unicode/uscript.h"
+
+namespace blink {
+
+namespace {
+
+sk_sp<SkTypeface> LoadPrivateCjkTypeface() {
+  base::RefCountedMemory* resource =
+      Platform::Current()->GetDataResourceBytes(
+          IDR_NITROUS_NOTO_SANS_SC_REGULAR);
+  if (!resource || resource->size() == 0) {
+    return nullptr;
+  }
+  sk_sp<SkData> data = SkData::MakeWithCopy(resource->data(), resource->size());
+  return SkTypeface_Make_Fontations(std::move(data), SkFontArguments());
+}
+
+}  // namespace
+
+bool IsPersonaCjkCharacter(UChar32 character) {
+  return uscript_hasScript(character, USCRIPT_HAN) ||
+         uscript_hasScript(character, USCRIPT_HIRAGANA) ||
+         uscript_hasScript(character, USCRIPT_KATAKANA) ||
+         uscript_hasScript(character, USCRIPT_HANGUL) ||
+         uscript_hasScript(character, USCRIPT_BOPOMOFO);
+}
+
+const SimpleFontData* GetPersonaCjkFallbackFontData(
+    const FontDescription& description) {
+  static const base::NoDestructor<sk_sp<SkTypeface>> typeface(
+      LoadPrivateCjkTypeface());
+  if (!*typeface) {
+    return nullptr;
+  }
+
+  auto* platform_data = MakeGarbageCollected<FontPlatformData>(
+      *typeface, std::string(), description.EffectiveFontSize(),
+      description.IsSyntheticBold() && description.SyntheticBoldAllowed(),
+      description.IsSyntheticItalic() && description.SyntheticItalicAllowed(),
+      description.TextRendering(), ResolvedFontFeatures(),
+      description.Orientation());
+  return MakeGarbageCollected<SimpleFontData>(
+      platform_data, nullptr, description.SubpixelAscentDescent());
+}
+
+}  // namespace blink
