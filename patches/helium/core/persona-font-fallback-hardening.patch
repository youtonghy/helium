+IN_PROC_BROWSER_TEST_F(PersonaFontVirtualizationBrowserTest,
+                       RejectsCjkFamilyWidthProbesAcrossRenderingPaths) {
+  PersonaService* service =
+      PersonaServiceFactory::GetForProfile(browser()->profile());
+  ASSERT_TRUE(service);
+  base::DictValue response = service->CreatePersonaProfile("Font test");
+  const std::string* persona_id = response.FindString("personaId");
+  ASSERT_TRUE(persona_id);
+  ASSERT_TRUE(service->SetActivePersona(*persona_id)
+                  .FindBool("ok")
+                  .value_or(false));
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<body></body>")));
+
+  EXPECT_EQ(true, content::EvalJs(
+                      browser()->tab_strip_model()->GetActiveWebContents(),
+                      R"JS(
+    (async () => {
+      const text = '\u6d4b\u8bd5\u4e2d\u6587\u5b57\u4f53\u6307\u7eb9';
+      const candidates = [
+        'PingFang SC',
+        'Hiragino Sans GB',
+        'Microsoft YaHei',
+        '\u5fae\u8f6f\u96c5\u9ed1',
+        'MiSans',
+        'HarmonyOS Sans',
+        'OPPO Sans',
+        'Noto Sans SC',
+      ];
+      const generics = ['serif', 'sans-serif', 'monospace'];
+      const missing = '__nitrous_missing_cjk_font__';
+      const threshold = 0.5;
+
+      const canvas = document.createElement('canvas');
+      const context = canvas.getContext('2d');
+      const offscreen = new OffscreenCanvas(512, 128);
+      const offscreenContext = offscreen.getContext('2d');
+
+      const canvasWidth = (ctx, family, generic) => {
+        ctx.font = `72px "${family}", ${generic}`;
+        return ctx.measureText(text).width;
+      };
+      const domWidth = (family, generic) => {
+        const element = document.createElement('span');
+        element.textContent = text;
+        element.style.cssText =
+            `position:absolute;white-space:nowrap;font:72px "${family}", ${generic}`;
+        document.body.appendChild(element);
+        const width = element.getBoundingClientRect().width;
+        element.remove();
+        return width;
+      };
+
+      for (const generic of generics) {
+        const canvasBaseline = canvasWidth(context, missing, generic);
+        const offscreenBaseline =
+            canvasWidth(offscreenContext, missing, generic);
+        const domBaseline = domWidth(missing, generic);
+        for (const candidate of candidates) {
+          if (Math.abs(canvasWidth(context, candidate, generic) -
+                       canvasBaseline) > threshold ||
+              Math.abs(canvasWidth(offscreenContext, candidate, generic) -
+                       offscreenBaseline) > threshold ||
+              Math.abs(domWidth(candidate, generic) - domBaseline) >
+                  threshold) {
+            return false;
+          }
+        }
+      }
+
+      try {
+        await new FontFace('private-probe', 'local("Noto Sans SC")').load();
+        return false;
+      } catch {
+        return true;
+      }
+    })()
+  )JS"));
+}
