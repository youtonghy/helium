+TEST_F(FontTestBase, EmojiPriorityDoesNotUsePrivateCjkFallback) {
+  auto* selector = MakeGarbageCollected<PrivateFallbackFontSelector>();
+  Font* font = CreatePrivateFallbackTestFont(selector);
+  FontFallbackIterator iterator =
+      font->CreateFontFallbackIterator(FontFallbackPriority::kEmojiEmoji);
+  FontFallbackIterator::HintCharList hint = {0x1F642};
+
+  ASSERT_TRUE(iterator.Next(hint)->HasFontData());
+  iterator.Next(hint);
+  EXPECT_EQ(selector->private_fallback_requests(), 0u);
+}
