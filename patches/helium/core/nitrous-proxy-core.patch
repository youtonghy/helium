+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_pref_names.h"
+#include "chrome/browser/net/profile_network_context_service.h"
+#include "chrome/browser/net/profile_network_context_service_factory.h"
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_system_config.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/os_crypt/async/browser/os_crypt_async.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "components/proxy_config/proxy_config_dictionary.h"
+#include "components/proxy_config/proxy_config_pref_names.h"
+
+namespace nitrous_proxy {
+
+namespace {
+
+constexpr char kModeOff[] = "off";
+constexpr char kModeHttp[] = "http";
+constexpr char kModeHttps[] = "https";
+constexpr char kModeSocks5[] = "socks5";
+
+constexpr int kMinPort = 1;
+constexpr int kMaxPort = 65535;
+
+}  // namespace
+
+ProxyMode ProxyModeFromString(const std::string& value) {
+  if (value == kModeHttp) {
+    return ProxyMode::kHttp;
+  }
+  if (value == kModeHttps) {
+    return ProxyMode::kHttps;
+  }
+  if (value == kModeSocks5) {
+    return ProxyMode::kSocks5;
+  }
+  return ProxyMode::kOff;
+}
+
+const char* ProxyModeToString(ProxyMode mode) {
+  switch (mode) {
+    case ProxyMode::kHttp:
+      return kModeHttp;
+    case ProxyMode::kHttps:
+      return kModeHttps;
+    case ProxyMode::kSocks5:
+      return kModeSocks5;
+    case ProxyMode::kOff:
+      return kModeOff;
+  }
+}
+
+bool ProxyConfig::IsValid() const {
+  if (!is_enabled()) {
+    return true;
+  }
+  if (host.empty() || host != base::TrimWhitespaceASCII(host, base::TRIM_ALL)) {
+    return false;
+  }
+  // A host containing these would let a crafted value escape into the proxy
+  // rules string and add extra servers or scheme mappings.
+  if (host.find_first_of(":;=/ \t") != std::string::npos) {
+    return false;
+  }
+  return port >= kMinPort && port <= kMaxPort;
+}
+
+std::string ProxyConfig::ToProxyUri() const {
+  if (!IsValid() || !is_enabled()) {
+    return std::string();
+  }
+  return base::StringPrintf("%s://%s:%d", ProxyModeToString(mode), host.c_str(),
+                            port);
+}
+
+NitrousProxyService::NitrousProxyService(PrefService* prefs, Profile* profile)
+    : prefs_(prefs), profile_(profile) {
+  if (g_browser_process && g_browser_process->os_crypt_async()) {
+    g_browser_process->os_crypt_async()->GetInstance(
+        base::BindOnce(&NitrousProxyService::OnEncryptorReady,
+                       weak_ptr_factory_.GetWeakPtr()));
+  }
+  // Re-derive the native pref on startup so a route configured in a previous
+  // session is in force before any request is issued.
+  SyncNativeProxyPref();
+}
+
+NitrousProxyService::~NitrousProxyService() = default;
+
+void NitrousProxyService::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterStringPref(prefs::kMode, kModeOff);
+  registry->RegisterStringPref(prefs::kHost, std::string());
+  registry->RegisterIntegerPref(prefs::kPort, 0);
+  registry->RegisterStringPref(prefs::kUsername, std::string());
+  registry->RegisterStringPref(prefs::kPasswordEncrypted, std::string());
+  registry->RegisterBooleanPref(prefs::kEnforce, true);
+}
+
+ProxyConfig NitrousProxyService::GetConfig() const {
+  ProxyConfig config;
+  config.mode = ProxyModeFromString(prefs_->GetString(prefs::kMode));
+  config.host = prefs_->GetString(prefs::kHost);
+  config.port = prefs_->GetInteger(prefs::kPort);
+  config.username = prefs_->GetString(prefs::kUsername);
+  config.enforce = prefs_->GetBoolean(prefs::kEnforce);
+  if (pending_password_) {
+    config.password = *pending_password_;
+  } else {
+    config.password =
+        DecryptPassword(prefs_->GetString(prefs::kPasswordEncrypted));
+  }
+  return config;
+}
+
+bool NitrousProxyService::SetConfig(const ProxyConfig& config) {
+  if (!config.IsValid()) {
+    return false;
+  }
+
+  prefs_->SetString(prefs::kMode, ProxyModeToString(config.mode));
+  prefs_->SetString(prefs::kHost, config.host);
+  prefs_->SetInteger(prefs::kPort, config.port);
+  prefs_->SetString(prefs::kUsername, config.username);
+  prefs_->SetBoolean(prefs::kEnforce, config.enforce);
+
+  if (config.password.empty()) {
+    prefs_->SetString(prefs::kPasswordEncrypted, std::string());
+    pending_password_.reset();
+  } else if (std::optional<std::string> encrypted =
+                 EncryptPassword(config.password)) {
+    prefs_->SetString(prefs::kPasswordEncrypted, *encrypted);
+    pending_password_.reset();
+  } else {
+    // No encryptor yet. Keep the secret in memory for this session rather than
+    // persisting it in the clear; it is re-encrypted once the key arrives.
+    pending_password_ = config.password;
+  }
+
+  SyncNativeProxyPref();
+  SyncSystemRoute();
+  // The proxy pref reaches the network context on its own, but credentials are
+  // cached per session, so they have to be pushed explicitly. Without this a
+  // password change would appear to apply while authentication still used the
+  // old value.
+  if (profile_) {
+    if (ProfileNetworkContextService* network_service =
+            ProfileNetworkContextServiceFactory::GetForContext(profile_)) {
+      network_service->ApplySocksCredentials();
+    }
+  }
+  return true;
+}
+
+base::DictValue NitrousProxyService::GetConfigForUi() const {
+  const ProxyConfig config = GetConfig();
+  base::DictValue result;
+  result.Set("mode", ProxyModeToString(config.mode));
+  result.Set("host", config.host);
+  result.Set("port", config.port);
+  result.Set("username", config.username);
+  result.Set("hasPassword", !config.password.empty());
+  result.Set("enforce", config.enforce);
+  return result;
+}
+
+base::DictValue NitrousProxyService::SetConfigFromUi(
+    const base::DictValue& payload) {
+  ProxyConfig config = GetConfig();
+  if (const std::string* mode = payload.FindString("mode")) {
+    config.mode = ProxyModeFromString(*mode);
+  }
+  if (const std::string* host = payload.FindString("host")) {
+    config.host = *host;
+  }
+  if (std::optional<int> port = payload.FindInt("port")) {
+    config.port = *port;
+  }
+  if (const std::string* username = payload.FindString("username")) {
+    config.username = *username;
+  }
+  // Absent password means "keep the stored one"; explicit empty clears it.
+  if (const std::string* password = payload.FindString("password")) {
+    config.password = *password;
+  }
+  if (std::optional<bool> enforce = payload.FindBool("enforce")) {
+    config.enforce = *enforce;
+  }
+
+  base::DictValue result;
+  if (!SetConfig(config)) {
+    result.Set("success", false);
+    result.Set("error", "invalid_config");
+    return result;
+  }
+  result.Set("success", true);
+  result.Set("config", GetConfigForUi());
+  return result;
+}
+
+bool NitrousProxyService::IsRouteEnforced() const {
+  const ProxyConfig config = GetConfig();
+  return config.is_enabled() && config.enforce;
+}
+
+bool NitrousProxyService::IsRouteSubverted() const {
+  const ProxyConfig config = GetConfig();
+  if (!config.is_enabled() || !config.enforce) {
+    return false;
+  }
+  if (!config.IsValid()) {
+    // Enforced but unusable: nothing can be routed, so treat it as subverted
+    // rather than letting requests find another way out.
+    return true;
+  }
+
+  const ProxyConfigDictionary dict(
+      prefs_->GetDict(proxy_config::prefs::kProxy).Clone());
+  ProxyPrefs::ProxyMode mode = ProxyPrefs::MODE_DIRECT;
+  if (!dict.GetMode(&mode) || mode != ProxyPrefs::MODE_FIXED_SERVERS) {
+    return true;
+  }
+  std::string servers;
+  if (!dict.GetProxyServer(&servers)) {
+    return true;
+  }
+  // The pref must still name exactly the route we derived. Anything else, an
+  // added fallback or a different upstream, is a way out we did not authorize.
+  return servers != config.ToProxyUri();
+}
+
+void NitrousProxyService::Shutdown() {
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+void NitrousProxyService::OnEncryptorReady(
+    os_crypt_async::Encryptor encryptor) {
+  encryptor_ = std::move(encryptor);
+  if (!pending_password_) {
+    return;
+  }
+  if (std::optional<std::string> encrypted =
+          EncryptPassword(*pending_password_)) {
+    prefs_->SetString(prefs::kPasswordEncrypted, *encrypted);
+    pending_password_.reset();
+  }
+}
+
+void NitrousProxyService::SyncNativeProxyPref() {
+  const ProxyConfig config = GetConfig();
+  if (!config.is_enabled() || !config.IsValid()) {
+    prefs_->SetDict(proxy_config::prefs::kProxy,
+                    ProxyConfigDictionary::CreateDirect());
+    return;
+  }
+  // Empty bypass list: only net's implicit localhost/link-local rules apply.
+  prefs_->SetDict(proxy_config::prefs::kProxy,
+                  ProxyConfigDictionary::CreateFixedServers(
+                      config.ToProxyUri(), /*bypass_list=*/std::string()));
+}
+
+void NitrousProxyService::SyncSystemRoute() {
+  // Whether this profile now enforces a route decides what system traffic is
+  // allowed to do, so the local-state route is re-derived on every change.
+  if (g_browser_process) {
+    SyncSystemProxyPref(g_browser_process->local_state());
+  }
+}
+
+std::optional<std::string> NitrousProxyService::EncryptPassword(
+    const std::string& plaintext) const {
+  if (!encryptor_ || plaintext.empty()) {
+    return std::nullopt;
+  }
+  std::string ciphertext;
+  if (!encryptor_->EncryptString(plaintext, &ciphertext)) {
+    return std::nullopt;
+  }
+  return base::Base64Encode(ciphertext);
+}
+
+std::string NitrousProxyService::DecryptPassword(
+    const std::string& stored) const {
+  if (!encryptor_ || stored.empty()) {
+    return std::string();
+  }
+  std::string ciphertext;
+  if (!base::Base64Decode(stored, &ciphertext)) {
+    return std::string();
+  }
+  std::string plaintext;
+  if (!encryptor_->DecryptString(ciphertext, &plaintext)) {
+    return std::string();
+  }
+  return plaintext;
+}
+
