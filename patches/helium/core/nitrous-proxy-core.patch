+} from './nitrous_proxy_browser_proxy.js';
+import {NitrousProxyBrowserProxyImpl} from './nitrous_proxy_browser_proxy.js';
+import {getTemplate} from './nitrous_proxy_page.html.js';
+
+const EMPTY_STATE: NitrousProxyState = {
+  config: {
+    mode: 'off',
+    host: '',
+    port: 0,
+    username: '',
+    hasPassword: false,
+    enforce: true,
+  },
+  subverted: false,
+  systemRouteEnabled: false,
+  systemRouteSourceProfile: '',
+};
+
+export class SettingsNitrousProxyPageElement extends I18nMixin(PolymerElement) {
+  static get is() {
+    return 'settings-nitrous-proxy-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      routePath: String,
+      state_: {type: Object, value: () => structuredClone(EMPTY_STATE)},
+      editableMode_: {type: String, value: 'off'},
+      editableHost_: {type: String, value: ''},
+      editablePort_: {type: String, value: ''},
+      editableUsername_: {type: String, value: ''},
+      // Left empty on load, since the stored password is never sent to the UI.
+      // Staying empty means "keep the stored one".
+      editablePassword_: {type: String, value: ''},
+      errorMessage_: {type: String, value: ''},
+      testResultMessage_: {type: String, value: ''},
+    };
+  }
+
+  declare routePath: string;
+  private declare state_: NitrousProxyState;
+  private declare editableMode_: NitrousProxyMode;
+  private declare editableHost_: string;
+  private declare editablePort_: string;
+  private declare editableUsername_: string;
+  private declare editablePassword_: string;
+  private declare errorMessage_: string;
+  private declare testResultMessage_: string;
+  private proxy_: NitrousProxyBrowserProxy =
+      NitrousProxyBrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    void this.loadState_();
+  }
+
+  private async loadState_() {
+    this.applyState_(await this.proxy_.getProxyState());
+  }
+
+  private async onSaveClick_() {
+    this.errorMessage_ = '';
+    this.testResultMessage_ = '';
+
+    const port = Number.parseInt(this.editablePort_, 10);
+    const result = await this.proxy_.setProxyConfig({
+      mode: this.editableMode_,
+      host: this.editableHost_.trim(),
+      port: Number.isNaN(port) ? 0 : port,
+      username: this.editableUsername_.trim(),
+      // Only sent when the user typed something, so an untouched field keeps
+      // the stored password instead of clearing it.
+      ...(this.editablePassword_ ? {password: this.editablePassword_} : {}),
+      enforce: this.state_.config.enforce,
+    });
+
+    if (!result.success) {
+      this.errorMessage_ = this.i18n('nitrousProxyInvalidConfig');
+      return;
+    }
+    this.editablePassword_ = '';
+    await this.loadState_();
+  }
+
+  private async onSystemRouteChange_(event: Event) {
+    const enabled = (event.target as HTMLInputElement).checked;
+    this.applyState_(await this.proxy_.setSystemRouteEnabled(enabled));
+  }
+
+  private async onTestConnectionClick_() {
+    this.testResultMessage_ = this.i18n('nitrousProxyTestRunning');
+    const result = await this.proxy_.testProxyConnection();
+    this.testResultMessage_ = result.success ?
+        this.i18n('nitrousProxyTestSucceeded') :
+        this.i18n('nitrousProxyTestFailed');
+  }
+
+  private onModeChange_(event: Event) {
+    this.editableMode_ = (event.target as HTMLSelectElement).value as
+        NitrousProxyMode;
+  }
+
+  private applyState_(state: NitrousProxyState) {
+    this.state_ = state;
+    this.editableMode_ = state.config.mode;
+    this.editableHost_ = state.config.host;
+    this.editablePort_ = state.config.port ? String(state.config.port) : '';
+    this.editableUsername_ = state.config.username;
+  }
+
+  private isEnabled_(mode: string) {
+    return mode !== 'off';
+  }
+
+  private supportsAuth_(mode: string) {
+    return mode !== 'off';
+  }
+
+  private passwordPlaceholder_(hasPassword: boolean) {
+    return hasPassword ? this.i18n('nitrousProxyPasswordStored') : '';
+  }
+}
