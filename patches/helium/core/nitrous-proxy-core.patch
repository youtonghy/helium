+
+// A proxy demanding credentials we do not have must fail, not connect
+// unauthenticated.
+TEST_F(SOCKS5ClientSocketTest, AuthRequestedWithoutCredentialsFails) {
+  MockWrite data_writes[] = {MockWrite(ASYNC, kSOCKS5GreetRequest)};
