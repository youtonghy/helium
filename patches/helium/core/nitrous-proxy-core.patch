+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+#include "chrome/browser/ui/webui/settings/nitrous_proxy_handler.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_service.h"
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_service_factory.h"
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_system_config.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/base/host_port_pair.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/mojom/network_context.mojom.h"
+
+namespace settings {
+
+namespace {
+
+nitrous_proxy::NitrousProxyService* GetProxyService(Profile* profile) {
+  return nitrous_proxy::NitrousProxyServiceFactory::GetForProfile(profile);
+}
+
+constexpr net::NetworkTrafficAnnotationTag kProxyTestTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("nitrous_proxy_reachability_test", R"(
+        semantics {
+          sender: "Nitrous Proxy Settings"
+          description:
+            "Opens a TCP connection to the proxy server the user configured, "
+            "to report whether that server is reachable."
+          trigger: "User activates the proxy connection test in settings."
+          data: "None. The connection is opened and immediately closed."
+          destination: OTHER
+          destination_other:
+            "The proxy server entered by the user in settings."
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Only performed on explicit user request."
+          policy_exception_justification: "Not implemented."
+        })");
+
+}  // namespace
+
+NitrousProxyHandler::NitrousProxyHandler(Profile* profile)
+    : profile_(profile) {}
+
+NitrousProxyHandler::~NitrousProxyHandler() = default;
+
+void NitrousProxyHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getNitrousProxyState",
+      base::BindRepeating(&NitrousProxyHandler::HandleGetProxyState,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setNitrousProxyConfig",
+      base::BindRepeating(&NitrousProxyHandler::HandleSetProxyConfig,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setNitrousProxySystemRoute",
+      base::BindRepeating(&NitrousProxyHandler::HandleSetSystemRoute,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "testNitrousProxyConnection",
+      base::BindRepeating(&NitrousProxyHandler::HandleTestConnection,
+                          base::Unretained(this)));
+}
+
+void NitrousProxyHandler::OnJavascriptAllowed() {}
+
+void NitrousProxyHandler::OnJavascriptDisallowed() {
+  // Drop any in-flight reachability test; its callback must not outlive the
+  // page that asked for it.
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  host_resolver_.reset();
+  test_socket_.reset();
+}
+
+base::DictValue NitrousProxyHandler::BuildState() const {
+  nitrous_proxy::NitrousProxyService* service = GetProxyService(profile_);
+  CHECK(service);
+
+  base::DictValue state;
+  state.Set("config", service->GetConfigForUi());
+  state.Set("subverted", service->IsRouteSubverted());
+
+  PrefService* local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  state.Set("systemRouteEnabled",
+            local_state && local_state->GetBoolean(
+                               nitrous_proxy::system_prefs::kEnabled));
+  state.Set("systemRouteSourceProfile",
+            local_state ? local_state->GetString(
+                              nitrous_proxy::system_prefs::kSourceProfile)
+                        : std::string());
+  return state;
+}
+
+void NitrousProxyHandler::HandleGetProxyState(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1U, args.size());
+  ResolveJavascriptCallback(args[0], BuildState());
+}
+
+void NitrousProxyHandler::HandleSetProxyConfig(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(2U, args.size());
+  CHECK(args[1].is_dict());
+
+  nitrous_proxy::NitrousProxyService* service = GetProxyService(profile_);
+  CHECK(service);
+
+  base::DictValue result = service->SetConfigFromUi(args[1].GetDict());
+  // Keep the system route in step with the profile route it was copied from.
+  if (result.FindBool("success").value_or(false) && g_browser_process &&
+      g_browser_process->local_state() &&
+      g_browser_process->local_state()->GetBoolean(
+          nitrous_proxy::system_prefs::kEnabled)) {
+    nitrous_proxy::SetSystemProxyFromConfig(
+        g_browser_process->local_state(), service->GetConfig(),
+        profile_->GetProfileUserName());
+  }
+  ResolveJavascriptCallback(args[0], std::move(result));
+}
+
+void NitrousProxyHandler::HandleSetSystemRoute(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(2U, args.size());
+  CHECK(args[1].is_bool());
+
+  nitrous_proxy::NitrousProxyService* service = GetProxyService(profile_);
+  CHECK(service);
+
+  PrefService* local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  if (local_state) {
+    if (args[1].GetBool()) {
+      nitrous_proxy::SetSystemProxyFromConfig(local_state, service->GetConfig(),
+                                              profile_->GetProfileUserName());
+    } else {
+      nitrous_proxy::ClearSystemProxy(local_state);
+    }
+  }
+  ResolveJavascriptCallback(args[0], BuildState());
+}
+
+void NitrousProxyHandler::HandleTestConnection(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1U, args.size());
+  CHECK(args[0].is_string());
+  const std::string callback_id = args[0].GetString();
+
+  nitrous_proxy::NitrousProxyService* service = GetProxyService(profile_);
+  CHECK(service);
+  const nitrous_proxy::ProxyConfig config = service->GetConfig();
+  if (!config.is_enabled() || !config.IsValid()) {
+    ResolveTestResult(callback_id, false, "invalid_config");
+    return;
+  }
+
+  network::mojom::NetworkContext* network_context =
+      profile_->GetDefaultStoragePartition()->GetNetworkContext();
+  if (!network_context) {
+    ResolveTestResult(callback_id, false, "unavailable");
+    return;
+  }
+
+  host_resolver_ = network::SimpleHostResolver::Create(network_context);
+  auto parameters = network::mojom::ResolveHostParameters::New();
+  // The proxy endpoint itself must be resolved locally; it is the one host that
+  // cannot be resolved through the proxy.
+  parameters->dns_query_type = net::DnsQueryType::UNSPECIFIED;
+  host_resolver_->ResolveHost(
+      network::mojom::HostResolverHost::NewHostPortPair(
+          net::HostPortPair(config.host, config.port)),
+      net::NetworkAnonymizationKey(), std::move(parameters),
+      base::BindOnce(&NitrousProxyHandler::OnTestHostResolved,
+                     weak_ptr_factory_.GetWeakPtr(), callback_id));
+}
+
+void NitrousProxyHandler::OnTestHostResolved(
+    std::string callback_id,
+    int result,
+    const net::ResolveErrorInfo& resolve_error_info,
+    const net::AddressList& resolved_addresses,
+    const net::HostResolverEndpointResults& alternative_endpoints) {
+  if (result != net::OK || resolved_addresses.empty()) {
+    ResolveTestResult(callback_id, false, "resolve_failed");
+    return;
+  }
+
+  network::mojom::NetworkContext* network_context =
+      profile_->GetDefaultStoragePartition()->GetNetworkContext();
+  if (!network_context) {
+    ResolveTestResult(callback_id, false, "unavailable");
+    return;
+  }
+
+  test_socket_.reset();
+  network_context->CreateTCPConnectedSocket(
+      /*local_addr=*/std::nullopt, resolved_addresses,
+      /*tcp_connected_socket_options=*/nullptr,
+      net::MutableNetworkTrafficAnnotationTag(kProxyTestTrafficAnnotation),
+      test_socket_.BindNewPipeAndPassReceiver(),
+      /*observer=*/mojo::NullRemote(),
+      base::BindOnce(&NitrousProxyHandler::OnTestSocketConnected,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback_id)));
+}
+
+void NitrousProxyHandler::OnTestSocketConnected(
+    std::string callback_id,
+    int result,
+    const std::optional<net::IPEndPoint>& local_addr,
+    const std::optional<net::IPEndPoint>& peer_addr,
+    mojo::ScopedDataPipeConsumerHandle receive_stream,
+    mojo::ScopedDataPipeProducerHandle send_stream) {
+  // The connection is only used to prove reachability, so it is dropped here.
+  test_socket_.reset();
+  ResolveTestResult(callback_id, result == net::OK,
+                    result == net::OK ? std::string() : "connect_failed");
+}
+
+void NitrousProxyHandler::ResolveTestResult(const std::string& callback_id,
+                                           bool success,
+                                           const std::string& error) {
+  base::DictValue result;
+  result.Set("success", success);
+  if (!error.empty()) {
+    result.Set("error", error);
+  }
+  ResolveJavascriptCallback(base::Value(callback_id), result);
+}
+
+}  // namespace settings
