+#ifndef CHROME_BROWSER_NITROUS_PROXY_NITROUS_PROXY_SERVICE_H_
+#define CHROME_BROWSER_NITROUS_PROXY_NITROUS_PROXY_SERVICE_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/os_crypt/async/common/encryptor.h"
+
+class PrefService;
+class Profile;
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace nitrous_proxy {
+
+enum class ProxyMode {
+  kOff,
+  kHttp,
+  kHttps,
+  kSocks5,
+};
+
+// Parses/serializes the wire name used by prefs and the settings UI.
+ProxyMode ProxyModeFromString(const std::string& value);
+const char* ProxyModeToString(ProxyMode mode);
+
+struct ProxyConfig {
+  ProxyMode mode = ProxyMode::kOff;
+  std::string host;
+  int port = 0;
+  std::string username;
+  std::string password;
+  bool enforce = true;
+
+  bool is_enabled() const { return mode != ProxyMode::kOff; }
+  // True when the route is enabled and every field needed to reach the
+  // upstream is present and in range.
+  bool IsValid() const;
+  // "socks5://host:port" style URI with no url-scheme prefix, so that
+  // net::ProxyConfig::ProxyRules parses it as a single PROXY_LIST that applies
+  // to every URL scheme. A per-scheme spec would silently fall back to DIRECT
+  // for unlisted schemes.
+  std::string ToProxyUri() const;
+};
+
+// Owns the profile's Nitrous proxy configuration and keeps the native
+// `proxy` pref in sync with it.
+class NitrousProxyService : public KeyedService {
+ public:
+  NitrousProxyService(PrefService* prefs, Profile* profile);
+  ~NitrousProxyService() override;
+
+  NitrousProxyService(const NitrousProxyService&) = delete;
+  NitrousProxyService& operator=(const NitrousProxyService&) = delete;
+
+  static void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+  // Reads the stored config. `password` is only populated once the encryptor
+  // is available; callers that need it must handle the empty case.
+  ProxyConfig GetConfig() const;
+
+  // Validates and persists `config`, then re-derives the native proxy pref.
+  // Returns false without writing anything when the config is invalid, so a
+  // malformed edit can never downgrade an enforced route to DIRECT.
+  bool SetConfig(const ProxyConfig& config);
+
+  // Settings-UI facing wrappers. The password is never sent back to the UI;
+  // `hasPassword` reports whether one is stored.
+  base::DictValue GetConfigForUi() const;
+  base::DictValue SetConfigFromUi(const base::DictValue& payload);
+
+  // True when traffic must not fall back to a direct connection. Used by the
+  // leak-sealing and kill-switch layers.
+  bool IsRouteEnforced() const;
+
+  // True when an enforced route is configured but the effective native proxy
+  // pref no longer describes it, which happens when an extension or a policy
+  // takes over `proxy`. Traffic in that state would leave outside the route,
+  // so the kill switch must block it.
+  bool IsRouteSubverted() const;
+
+  void Shutdown() override;
+
+ private:
+  void OnEncryptorReady(os_crypt_async::Encryptor encryptor);
+  // Mirrors the current config into `proxy_config::prefs::kProxy`.
+  void SyncNativeProxyPref();
+  // Re-derives the local-state route, whose sentinel depends on whether any
+  // profile enforces a route.
+  void SyncSystemRoute();
+  std::optional<std::string> EncryptPassword(const std::string& plaintext) const;
+  std::string DecryptPassword(const std::string& stored) const;
+
+  raw_ptr<PrefService> prefs_;
+  raw_ptr<Profile> profile_;
+  std::optional<os_crypt_async::Encryptor> encryptor_;
+  // Held until the encryptor arrives, so a password set during startup is not
+  // lost and is not written out in the clear.
+  std::optional<std::string> pending_password_;
+  base::WeakPtrFactory<NitrousProxyService> weak_ptr_factory_{this};
+};
+
+}  // namespace nitrous_proxy
+
+#endif  // CHROME_BROWSER_NITROUS_PROXY_NITROUS_PROXY_SERVICE_H_
