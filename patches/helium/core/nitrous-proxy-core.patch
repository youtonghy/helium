+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_enforcement.h"
+
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_service.h"
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "content/public/browser/browser_context.h"
+
+namespace nitrous_proxy {
+
+bool IsRouteEnforcedForProfile(Profile* profile) {
+  if (!profile) {
+    return false;
+  }
+  // Deliberately non-creating: these helpers are called from pref read points
+  // that can run while a profile is still being initialized.
+  NitrousProxyService* service =
+      NitrousProxyServiceFactory::GetForProfileIfExists(profile);
+  return service && service->IsRouteEnforced();
+}
+
+bool IsRouteEnforcedForBrowserContext(content::BrowserContext* context) {
+  if (!context) {
+    return false;
+  }
+  return IsRouteEnforcedForProfile(Profile::FromBrowserContext(context));
+}
+
+bool IsRouteSubvertedForBrowserContext(content::BrowserContext* context) {
+  if (!context) {
+    return false;
+  }
+  Profile* profile = Profile::FromBrowserContext(context);
+  if (!profile) {
+    return false;
+  }
+  NitrousProxyService* service =
+      NitrousProxyServiceFactory::GetForProfileIfExists(profile);
+  return service && service->IsRouteSubverted();
+}
+
+bool IsRouteEnforcedForAnyProfile() {
+  if (!g_browser_process || !g_browser_process->profile_manager()) {
+    return false;
+  }
+  for (Profile* profile :
+       g_browser_process->profile_manager()->GetLoadedProfiles()) {
+    if (IsRouteEnforcedForProfile(profile)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace nitrous_proxy
