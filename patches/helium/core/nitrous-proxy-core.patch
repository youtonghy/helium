+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+export type NitrousProxyMode = 'off'|'http'|'https'|'socks5';
+
+export interface NitrousProxyConfig {
+  mode: NitrousProxyMode;
+  host: string;
+  port: number;
+  username: string;
+  // The stored password is never sent to the UI; this only reports whether one
+  // exists.
+  hasPassword: boolean;
+  enforce: boolean;
+}
+
+export interface NitrousProxyState {
+  config: NitrousProxyConfig;
+  // True when the route is enforced but no longer actually in effect, which
+  // means requests are being blocked.
+  subverted: boolean;
+  // Whether the route is also applied to browser-originated traffic.
+  systemRouteEnabled: boolean;
+  systemRouteSourceProfile: string;
+}
+
+export interface NitrousProxyUpdate {
+  mode?: NitrousProxyMode;
+  host?: string;
+  port?: number;
+  username?: string;
+  // Omit to keep the stored password; pass an empty string to clear it.
+  password?: string;
+  enforce?: boolean;
+}
+
+export interface NitrousProxyResult {
+  success: boolean;
+  error?: string;
+  config?: NitrousProxyConfig;
+}
+
+export interface NitrousProxyTestResult {
+  success: boolean;
+  error?: string;
+}
+
+export interface NitrousProxyBrowserProxy {
+  getProxyState(): Promise<NitrousProxyState>;
+  setProxyConfig(update: NitrousProxyUpdate): Promise<NitrousProxyResult>;
+  setSystemRouteEnabled(enabled: boolean): Promise<NitrousProxyState>;
+  testProxyConnection(): Promise<NitrousProxyTestResult>;
+}
+
+let instance: NitrousProxyBrowserProxy|null = null;
+
+export class NitrousProxyBrowserProxyImpl implements NitrousProxyBrowserProxy {
+  getProxyState() {
+    return sendWithPromise<NitrousProxyState>('getNitrousProxyState');
+  }
+
+  setProxyConfig(update: NitrousProxyUpdate) {
+    return sendWithPromise<NitrousProxyResult>('setNitrousProxyConfig', update);
+  }
+
+  setSystemRouteEnabled(enabled: boolean) {
+    return sendWithPromise<NitrousProxyState>(
+        'setNitrousProxySystemRoute', enabled);
+  }
+
+  testProxyConnection() {
+    return sendWithPromise<NitrousProxyTestResult>('testNitrousProxyConnection');
+  }
+
+  static getInstance(): NitrousProxyBrowserProxy {
+    return instance || (instance = new NitrousProxyBrowserProxyImpl());
+  }
+
+  static setInstance(proxy: NitrousProxyBrowserProxy) {
+    instance = proxy;
+  }
+}
