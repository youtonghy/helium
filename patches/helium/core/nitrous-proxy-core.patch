+  EXPECT_FALSE(user_sock_->IsConnected());
+}
+
+// With credentials configured, a proxy that picks no-auth is still fine.
+TEST_F(SOCKS5ClientSocketTest, CredentialsOfferedButProxySelectsNoAuth) {
+  credentials_.username = "user";
+  credentials_.password = "pw";
