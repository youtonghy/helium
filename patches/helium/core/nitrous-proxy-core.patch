+#include "chrome/browser/nitrous_proxy/nitrous_proxy_system_config.h"
+
+#include <string>
+
+#include "base/strings/stringprintf.h"
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_enforcement.h"
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_service.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/proxy_config/proxy_config_dictionary.h"
+#include "components/proxy_config/proxy_config_pref_names.h"
+
+namespace nitrous_proxy {
+
+namespace {
+
+// Loopback with a port that nothing listens on. Used as the sentinel route so
+// that browser-originated traffic fails instead of going out directly while a
+// profile route is enforced. Port 1 is privileged, so this cannot collide with
+// a user-run service by accident.
+constexpr char kUnreachableSentinelUri[] = "socks5://127.0.0.1:1";
+
+}  // namespace
+
+void RegisterSystemProxyLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(system_prefs::kEnabled, false);
+  registry->RegisterStringPref(system_prefs::kMode, "off");
+  registry->RegisterStringPref(system_prefs::kHost, std::string());
+  registry->RegisterIntegerPref(system_prefs::kPort, 0);
+  registry->RegisterStringPref(system_prefs::kSourceProfile, std::string());
+}
+
+void SyncSystemProxyPref(PrefService* local_state) {
+  if (!local_state) {
+    return;
+  }
+
+  if (local_state->GetBoolean(system_prefs::kEnabled)) {
+    ProxyConfig config;
+    config.mode = ProxyModeFromString(local_state->GetString(system_prefs::kMode));
+    config.host = local_state->GetString(system_prefs::kHost);
+    config.port = local_state->GetInteger(system_prefs::kPort);
+    if (config.is_enabled() && config.IsValid()) {
+      local_state->SetDict(proxy_config::prefs::kProxy,
+                           ProxyConfigDictionary::CreateFixedServers(
+                               config.ToProxyUri(),
+                               /*bypass_list=*/std::string()));
+      return;
+    }
+    // Enabled but unusable: fall through to the sentinel rather than direct.
+  }
+
+  if (IsRouteEnforcedForAnyProfile()) {
+    local_state->SetDict(proxy_config::prefs::kProxy,
+                         ProxyConfigDictionary::CreateFixedServers(
+                             kUnreachableSentinelUri,
+                             /*bypass_list=*/std::string()));
+    return;
+  }
+
+  local_state->SetDict(proxy_config::prefs::kProxy,
+                       ProxyConfigDictionary::CreateDirect());
+}
+
+void SetSystemProxyFromConfig(PrefService* local_state,
+                              const ProxyConfig& config,
+                              const std::string& source_profile) {
+  if (!local_state) {
+    return;
+  }
+  if (!config.is_enabled() || !config.IsValid()) {
+    ClearSystemProxy(local_state);
+    return;
+  }
+  local_state->SetBoolean(system_prefs::kEnabled, true);
+  local_state->SetString(system_prefs::kMode, ProxyModeToString(config.mode));
+  local_state->SetString(system_prefs::kHost, config.host);
+  local_state->SetInteger(system_prefs::kPort, config.port);
+  local_state->SetString(system_prefs::kSourceProfile, source_profile);
+  SyncSystemProxyPref(local_state);
+}
+
+void ClearSystemProxy(PrefService* local_state) {
+  if (!local_state) {
+    return;
+  }
+  local_state->SetBoolean(system_prefs::kEnabled, false);
+  local_state->SetString(system_prefs::kMode, "off");
+  local_state->SetString(system_prefs::kHost, std::string());
+  local_state->SetInteger(system_prefs::kPort, 0);
+  local_state->SetString(system_prefs::kSourceProfile, std::string());
+  SyncSystemProxyPref(local_state);
+}
+
+}  // namespace nitrous_proxy
