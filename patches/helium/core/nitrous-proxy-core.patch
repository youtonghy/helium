+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_service.h"
+
+#include "chrome/browser/nitrous_proxy/nitrous_proxy_pref_names.h"
+
+#include <memory>
+#include <string>
+
+#include "components/prefs/pref_service.h"
+#include "components/proxy_config/proxy_config_dictionary.h"
+#include "components/proxy_config/proxy_config_pref_names.h"
+#include "components/proxy_config/proxy_prefs.h"
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace nitrous_proxy {
+
+namespace {
+
+class NitrousProxyServiceTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    NitrousProxyService::RegisterProfilePrefs(prefs_.registry());
+    // Normally registered by PrefProxyConfigTrackerImpl; the service derives
+    // this pref, so the test registry needs it too.
+    prefs_.registry()->RegisterDictionaryPref(proxy_config::prefs::kProxy);
+    service_ = std::make_unique<NitrousProxyService>(&prefs_, nullptr);
+  }
+
+  ProxyConfig MakeValidConfig() const {
+    ProxyConfig config;
+    config.mode = ProxyMode::kSocks5;
+    config.host = "proxy.example";
+    config.port = 1080;
+    config.enforce = true;
+    return config;
+  }
+
+  ProxyPrefs::ProxyMode NativeMode() const {
+    const ProxyConfigDictionary dict(
+        prefs_.GetDict(proxy_config::prefs::kProxy).Clone());
+    ProxyPrefs::ProxyMode mode = ProxyPrefs::MODE_SYSTEM;
+    EXPECT_TRUE(dict.GetMode(&mode));
+    return mode;
+  }
+
+  std::string NativeServers() const {
+    const ProxyConfigDictionary dict(
+        prefs_.GetDict(proxy_config::prefs::kProxy).Clone());
+    std::string servers;
+    if (!dict.GetProxyServer(&servers)) {
+      return std::string();
+    }
+    return servers;
+  }
+
+  sync_preferences::TestingPrefServiceSyncable prefs_;
+  std::unique_ptr<NitrousProxyService> service_;
+};
+
+TEST_F(NitrousProxyServiceTest, DefaultsToDirect) {
+  EXPECT_FALSE(service_->GetConfig().is_enabled());
+  EXPECT_FALSE(service_->IsRouteEnforced());
+  EXPECT_EQ(ProxyPrefs::MODE_DIRECT, NativeMode());
+}
+
+// The derived spec must be a single bare URI. A per-scheme spec would let any
+// unlisted scheme fall back to a direct connection.
+TEST_F(NitrousProxyServiceTest, DerivesBareUriCoveringAllSchemes) {
+  ASSERT_TRUE(service_->SetConfig(MakeValidConfig()));
+
+  EXPECT_EQ(ProxyPrefs::MODE_FIXED_SERVERS, NativeMode());
+  EXPECT_EQ("socks5://proxy.example:1080", NativeServers());
+  EXPECT_EQ(std::string::npos, NativeServers().find('='));
+}
+
+TEST_F(NitrousProxyServiceTest, EachModeMapsToItsScheme) {
+  ProxyConfig config = MakeValidConfig();
+  config.mode = ProxyMode::kHttp;
+  ASSERT_TRUE(service_->SetConfig(config));
+  EXPECT_EQ("http://proxy.example:1080", NativeServers());
+
+  config.mode = ProxyMode::kHttps;
+  ASSERT_TRUE(service_->SetConfig(config));
+  EXPECT_EQ("https://proxy.example:1080", NativeServers());
+}
+
+TEST_F(NitrousProxyServiceTest, DisablingRestoresDirect) {
+  ASSERT_TRUE(service_->SetConfig(MakeValidConfig()));
+  ASSERT_EQ(ProxyPrefs::MODE_FIXED_SERVERS, NativeMode());
+
+  ProxyConfig off;
+  off.mode = ProxyMode::kOff;
+  ASSERT_TRUE(service_->SetConfig(off));
+  EXPECT_EQ(ProxyPrefs::MODE_DIRECT, NativeMode());
+  EXPECT_FALSE(service_->IsRouteEnforced());
+}
+
+// An invalid edit must be rejected outright rather than partially written,
+// otherwise an enforced route could be downgraded to a direct connection.
+TEST_F(NitrousProxyServiceTest, RejectsInvalidConfigWithoutWriting) {
+  ASSERT_TRUE(service_->SetConfig(MakeValidConfig()));
+
+  ProxyConfig empty_host = MakeValidConfig();
+  empty_host.host.clear();
+  EXPECT_FALSE(service_->SetConfig(empty_host));
+
+  ProxyConfig bad_port = MakeValidConfig();
+  bad_port.port = 0;
+  EXPECT_FALSE(service_->SetConfig(bad_port));
+
+  bad_port.port = 65536;
+  EXPECT_FALSE(service_->SetConfig(bad_port));
+
+  // The previously accepted route is still in force.
+  EXPECT_EQ("socks5://proxy.example:1080", NativeServers());
+  EXPECT_TRUE(service_->IsRouteEnforced());
+}
+
+// A host carrying separator characters could otherwise inject extra servers or
+// scheme mappings into the proxy rules string.
+TEST_F(NitrousProxyServiceTest, RejectsHostWithRuleSeparators) {
+  for (const char* host : {"a;b", "a=b", "a b", "a/b", "host:1080"}) {
+    ProxyConfig config = MakeValidConfig();
+    config.host = host;
+    EXPECT_FALSE(service_->SetConfig(config)) << host;
+  }
+}
+
+TEST_F(NitrousProxyServiceTest, EnforceFlagIsIndependentOfBeingEnabled) {
+  ProxyConfig config = MakeValidConfig();
+  config.enforce = false;
+  ASSERT_TRUE(service_->SetConfig(config));
+
+  EXPECT_TRUE(service_->GetConfig().is_enabled());
+  EXPECT_FALSE(service_->IsRouteEnforced());
+  EXPECT_FALSE(service_->IsRouteSubverted());
+}
+
+TEST_F(NitrousProxyServiceTest, NotSubvertedWhileNativePrefMatches) {
+  ASSERT_TRUE(service_->SetConfig(MakeValidConfig()));
+  EXPECT_FALSE(service_->IsRouteSubverted());
+}
+
+// Simulates an extension or policy taking over the native pref.
+TEST_F(NitrousProxyServiceTest, SubvertedWhenNativePrefIsOverridden) {
+  ASSERT_TRUE(service_->SetConfig(MakeValidConfig()));
+
+  prefs_.SetDict(proxy_config::prefs::kProxy,
+                 ProxyConfigDictionary::CreateDirect());
+  EXPECT_TRUE(service_->IsRouteSubverted());
+
+  prefs_.SetDict(proxy_config::prefs::kProxy,
+                 ProxyConfigDictionary::CreateFixedServers(
+                     "socks5://elsewhere.example:1080", std::string()));
+  EXPECT_TRUE(service_->IsRouteSubverted());
+
+  // An added fallback is also a way out we did not authorize.
+  prefs_.SetDict(proxy_config::prefs::kProxy,
+                 ProxyConfigDictionary::CreateFixedServers(
+                     "socks5://proxy.example:1080,direct://", std::string()));
+  EXPECT_TRUE(service_->IsRouteSubverted());
+}
+
+TEST_F(NitrousProxyServiceTest, NotSubvertedWhenRouteIsNotEnforced) {
+  ProxyConfig config = MakeValidConfig();
+  config.enforce = false;
+  ASSERT_TRUE(service_->SetConfig(config));
+
+  prefs_.SetDict(proxy_config::prefs::kProxy,
+                 ProxyConfigDictionary::CreateDirect());
+  EXPECT_FALSE(service_->IsRouteSubverted());
+}
+
+// Without an encryptor the password must stay in memory for the session rather
+// than being persisted in the clear.
+TEST_F(NitrousProxyServiceTest, PasswordIsNotPersistedInPlaintext) {
+  ProxyConfig config = MakeValidConfig();
+  config.username = "user";
+  config.password = "secret";
+  ASSERT_TRUE(service_->SetConfig(config));
+
+  EXPECT_EQ("secret", service_->GetConfig().password);
+  EXPECT_EQ(std::string(),
+            prefs_.GetString(prefs::kPasswordEncrypted));
+}
+
+TEST_F(NitrousProxyServiceTest, ClearingPasswordClearsStoredValue) {
+  ProxyConfig config = MakeValidConfig();
+  config.password = "secret";
+  ASSERT_TRUE(service_->SetConfig(config));
+  ASSERT_EQ("secret", service_->GetConfig().password);
+
+  config.password.clear();
+  ASSERT_TRUE(service_->SetConfig(config));
+  EXPECT_EQ(std::string(), service_->GetConfig().password);
+}
+
+TEST_F(NitrousProxyServiceTest, UiPayloadOmitsPasswordButReportsPresence) {
+  ProxyConfig config = MakeValidConfig();
+  config.username = "user";
+  config.password = "secret";
+  ASSERT_TRUE(service_->SetConfig(config));
+
+  const base::DictValue ui = service_->GetConfigForUi();
+  EXPECT_EQ("socks5", *ui.FindString("mode"));
+  EXPECT_EQ("proxy.example", *ui.FindString("host"));
+  EXPECT_EQ(1080, ui.FindInt("port"));
+  EXPECT_EQ("user", *ui.FindString("username"));
+  EXPECT_TRUE(ui.FindBool("hasPassword").value_or(false));
+  EXPECT_FALSE(ui.contains("password"));
+}
+
+// An absent password field means "keep the stored one"; the UI never echoes it
+// back, so treating absence as a clear would silently drop the credential.
+TEST_F(NitrousProxyServiceTest, UiUpdateWithoutPasswordKeepsStoredOne) {
+  ProxyConfig config = MakeValidConfig();
+  config.username = "user";
+  config.password = "secret";
+  ASSERT_TRUE(service_->SetConfig(config));
+
+  base::DictValue payload;
+  payload.Set("mode", "socks5");
+  payload.Set("host", "other.example");
+  payload.Set("port", 9050);
+  payload.Set("username", "user");
+  payload.Set("enforce", true);
+
+  const base::DictValue result = service_->SetConfigFromUi(payload);
+  ASSERT_TRUE(result.FindBool("success").value_or(false));
+  EXPECT_EQ("secret", service_->GetConfig().password);
+  EXPECT_EQ("socks5://other.example:9050", NativeServers());
+}
+
+TEST_F(NitrousProxyServiceTest, UiUpdateReportsInvalidConfig) {
+  base::DictValue payload;
+  payload.Set("mode", "socks5");
+  payload.Set("host", "");
+  payload.Set("port", 1080);
+
+  const base::DictValue result = service_->SetConfigFromUi(payload);
+  EXPECT_FALSE(result.FindBool("success").value_or(true));
+  EXPECT_EQ("invalid_config", *result.FindString("error"));
+}
+
+TEST_F(NitrousProxyServiceTest, ConfigSurvivesServiceRestart) {
+  ASSERT_TRUE(service_->SetConfig(MakeValidConfig()));
+
+  // A fresh service over the same prefs must re-apply the route, so that a
+  // route configured in a previous session is in force before any request.
+  prefs_.SetDict(proxy_config::prefs::kProxy,
+                 ProxyConfigDictionary::CreateDirect());
+  service_ = std::make_unique<NitrousProxyService>(&prefs_, nullptr);
+
+  EXPECT_EQ("socks5://proxy.example:1080", NativeServers());
+  EXPECT_TRUE(service_->IsRouteEnforced());
+}
