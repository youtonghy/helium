+void HttpNetworkSession::ApplySocksCredentials(SocksCredentials credentials) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (params_.socks_credentials == credentials) {
+    return;
+  }
+
+  params_.socks_credentials = credentials;
+  normal_socket_pool_manager_->UpdateSocksCredentials(credentials);
+  websocket_socket_pool_manager_->UpdateSocksCredentials(
+      std::move(credentials));
+
+  // Existing connections were authenticated with the previous credentials.
+  // Close them so subsequent requests re-handshake with the new ones.
+  CloseAllConnections(ERR_ABORTED, "SOCKS credentials changed");
+}
