+
+class Profile;
+
+namespace settings {
+
+class NitrousProxyHandler : public SettingsPageUIHandler {
+ public:
+  explicit NitrousProxyHandler(Profile* profile);
+  ~NitrousProxyHandler() override;
+
+  NitrousProxyHandler(const NitrousProxyHandler&) = delete;
+  NitrousProxyHandler& operator=(const NitrousProxyHandler&) = delete;
+
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  void HandleGetProxyState(const base::ListValue& args);
+  void HandleSetProxyConfig(const base::ListValue& args);
+  void HandleSetSystemRoute(const base::ListValue& args);
+  void HandleTestConnection(const base::ListValue& args);
+
+  // Reachability check against the configured proxy endpoint. Only the user's
+  // own proxy is contacted; no third-party host is involved.
+  void OnTestHostResolved(
+      std::string callback_id,
+      int result,
+      const net::ResolveErrorInfo& resolve_error_info,
+      const net::AddressList& resolved_addresses,
+      const net::HostResolverEndpointResults& alternative_endpoints);
+  void OnTestSocketConnected(std::string callback_id,
+                             int result,
+                             const std::optional<net::IPEndPoint>& local_addr,
+                             const std::optional<net::IPEndPoint>& peer_addr,
+                             mojo::ScopedDataPipeConsumerHandle receive_stream,
+                             mojo::ScopedDataPipeProducerHandle send_stream);
+  void ResolveTestResult(const std::string& callback_id,
+                         bool success,
+                         const std::string& error);
+
+  base::DictValue BuildState() const;
+
+  raw_ptr<Profile> profile_;
+  std::unique_ptr<network::SimpleHostResolver> host_resolver_;
+  mojo::Remote<network::mojom::TCPConnectedSocket> test_socket_;
+  base::WeakPtrFactory<NitrousProxyHandler> weak_ptr_factory_{this};
+};
+
+}  // namespace settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_NITROUS_PROXY_HANDLER_H_
