+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef NET_BASE_SOCKS_CREDENTIALS_H_
+#define NET_BASE_SOCKS_CREDENTIALS_H_
+
+#include <string>
+
+#include "net/base/net_export.h"
+
+namespace net {
+
+// Username/password for SOCKS5 authentication (RFC 1929).
+//
+// SOCKS5 authenticates during its own handshake rather than through an HTTP
+// challenge, so these credentials cannot live in HttpAuthCache: that cache
+// DCHECKs that the scheme is http/https/ws/wss. They are instead carried on
+// CommonConnectJobParams for the lifetime of the session.
+//
+// RFC 1929 length-prefixes both fields with a single byte, so neither may
+// exceed 255 bytes.
+struct NET_EXPORT SocksCredentials {
+  static constexpr size_t kMaxFieldLength = 255;
+
+  std::string username;
+  std::string password;
+
+  bool IsValid() const {
+    return !username.empty() && username.size() <= kMaxFieldLength &&
+           password.size() <= kMaxFieldLength;
+  }
+
+  bool operator==(const SocksCredentials&) const = default;
+};
+
+}  // namespace net
+
+#endif  // NET_BASE_SOCKS_CREDENTIALS_H_
