+#ifndef CHROME_BROWSER_NITROUS_PROXY_NITROUS_PROXY_SYSTEM_CONFIG_H_
+#define CHROME_BROWSER_NITROUS_PROXY_NITROUS_PROXY_SYSTEM_CONFIG_H_
+
+#include <string>
+
+class PrefRegistrySimple;
+class PrefService;
+
+namespace nitrous_proxy {
+
+struct ProxyConfig;
+
+namespace system_prefs {
+
+// Local-state route used for traffic the browser issues on its own behalf
+// (component updates, Safe Browsing, network time, crash upload). These are
+// served by the system NetworkContext, which reads local state and therefore
+// cannot follow a per-profile route.
+inline constexpr char kEnabled[] = "nitrous.proxy.system.enabled";
+inline constexpr char kMode[] = "nitrous.proxy.system.mode";
+inline constexpr char kHost[] = "nitrous.proxy.system.host";
+inline constexpr char kPort[] = "nitrous.proxy.system.port";
+// Name of the profile the route was copied from, for display only.
+inline constexpr char kSourceProfile[] = "nitrous.proxy.system.source_profile";
+
+}  // namespace system_prefs
+
+void RegisterSystemProxyLocalStatePrefs(PrefRegistrySimple* registry);
+
+// Re-derives the local-state `proxy` pref from the stored system route.
+//
+// When no system route is set but some profile enforces one, system traffic is
+// pointed at an unreachable address instead of being left direct. Leaving it
+// direct would send browser-originated requests from the real IP, which is
+// exactly the leak an enforced route is meant to prevent.
+void SyncSystemProxyPref(PrefService* local_state);
+
+// Copies `config` into the local-state route. `source_profile` is recorded so
+// the settings page can say which profile the system route came from.
+void SetSystemProxyFromConfig(PrefService* local_state,
+                              const ProxyConfig& config,
+                              const std::string& source_profile);
+
+void ClearSystemProxy(PrefService* local_state);
+
+}  // namespace nitrous_proxy
+
+#endif  // CHROME_BROWSER_NITROUS_PROXY_NITROUS_PROXY_SYSTEM_CONFIG_H_
