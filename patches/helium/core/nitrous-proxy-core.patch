+
+// Profile-scoped source of truth for the Nitrous proxy route. The native
+// `proxy` pref is derived from these values; it is never authoritative.
+inline constexpr char kMode[] = "nitrous.proxy.mode";
+inline constexpr char kHost[] = "nitrous.proxy.host";
+inline constexpr char kPort[] = "nitrous.proxy.port";
+inline constexpr char kUsername[] = "nitrous.proxy.username";
+// Ciphertext produced by os_crypt_async, base64 encoded for JSON storage.
+inline constexpr char kPasswordEncrypted[] = "nitrous.proxy.password_encrypted";
+
+// When true the route is mandatory: traffic must never fall back to a direct
+// connection, even if the upstream proxy is unreachable.
+inline constexpr char kEnforce[] = "nitrous.proxy.enforce";
+
+}  // namespace nitrous_proxy::prefs
