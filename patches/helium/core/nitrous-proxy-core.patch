+  MockWrite data_writes[] = {
+      MockWrite(ASYNC, base::as_byte_span(kGreetWithAuthRequest)),
+      MockWrite(ASYNC, base::as_byte_span(kAuthRequest))};
+  MockRead data_reads[] = {
+      MockRead(ASYNC, base::as_byte_span(kGreetSelectUserPass)),
+      MockRead(ASYNC, base::as_byte_span(kAuthFailure))};
