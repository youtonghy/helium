+TEST(PersonaIdentityTemplateTest, CapturedVariantsShareOneIdentity) {
+  const PersonaIdentityTemplate* identity =
+      FindPersonaIdentityTemplate(kChromium149MacArmIdentityTemplateId);
+  ASSERT_TRUE(identity);
+  EXPECT_EQ(149, identity->chrome_major);
+  EXPECT_EQ("macOS", identity->ua_ch_platform);
+  EXPECT_EQ("arm", identity->architecture);
+  EXPECT_EQ("64", identity->bitness);
+  ASSERT_EQ(2u, identity->network_variant_ids.size());
+  EXPECT_EQ(net::kChromium149DefaultTemplateId,
+            identity->network_variant_ids[0]);
+  EXPECT_EQ(net::kChromium149MldsaTemplateId,
+            identity->network_variant_ids[1]);
+
+  EXPECT_EQ(std::vector<uint32_t>({kChromium149MacArmIdentityTemplateId}),
+            GetRotatablePersonaIdentityTemplateIds());
+}
+
+TEST(PersonaIdentityTemplateTest, SelectsNetworkVariantByGeneration) {
+  const PersonaIdentityTemplate* identity =
+      FindPersonaIdentityTemplate(kChromium149MacArmIdentityTemplateId);
+  ASSERT_TRUE(identity);
+  EXPECT_EQ(net::kChromium149DefaultTemplateId,
+            SelectNetworkVariant(*identity, 0));
+  EXPECT_EQ(net::kChromium149MldsaTemplateId,
+            SelectNetworkVariant(*identity, 1));
+  EXPECT_EQ(net::kChromium149DefaultTemplateId,
+            SelectNetworkVariant(*identity, 2));
+}
+
+TEST(PersonaIdentityTemplateTest, SelectNextDoesNotDependOnCatalogSize) {
+  constexpr std::array<uint32_t, 3> kIds = {10, 20, 30};
+  EXPECT_EQ(20u, SelectNextPersonaIdentityTemplateId(kIds, 10));
+  EXPECT_EQ(10u, SelectNextPersonaIdentityTemplateId(kIds, 30));
+  EXPECT_EQ(10u, SelectNextPersonaIdentityTemplateId(kIds, 999));
+  EXPECT_EQ(0u, SelectNextPersonaIdentityTemplateId(base::span<const uint32_t>(),
+                                                    10));
+}
+
