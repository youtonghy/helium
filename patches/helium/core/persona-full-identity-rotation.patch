+base::DictValue PersonaService::RotateIdentity() {
+  base::DictValue state = ReadState();
+  const std::vector<uint32_t> ids = GetRotatablePersonaIdentityTemplateIds();
+  if (!prefs_ || ids.size() < 2u) {
+    return MakeResponse(
+        false, std::move(state),
+        base::DictValue().Set("identityRotation", "unavailable"));
+  }
+
+  const blink::HeliumPersonaSnapshot snapshot = GetActiveSnapshot();
+  const uint32_t current_id = GetActiveIdentityTemplateId();
+  const PersonaIdentityTemplate* current =
+      current_id ? FindPersonaIdentityTemplate(current_id)
+                 : MatchPersonaIdentityTemplate(
+                       snapshot.user_agent, snapshot.os,
+                       snapshot.ua_ch_platform,
+                       snapshot.ua_ch_platform_version,
+                       snapshot.ua_ch_full_version,
+                       snapshot.ua_ch_architecture, snapshot.ua_ch_bitness,
+                       snapshot.ua_ch_mobile, snapshot.ua_ch_wow64);
+  if (current && snapshot.platform != current->navigator_platform) {
+    current = nullptr;
+  }
+  if (!snapshot.enabled || !current) {
+    return MakeResponse(
+        false, std::move(state),
+        base::DictValue().Set("identityRotation", "unavailable"));
+  }
+
+  const uint32_t next_id = SelectNextPersonaIdentityTemplateId(ids, current->id);
+  if (!next_id || next_id == current->id ||
+      !FindPersonaIdentityTemplate(next_id)) {
+    return MakeResponse(
+        false, std::move(state),
+        base::DictValue().Set("identityRotation", "unavailable"));
+  }
+
+  base::DictValue rotation_epoch =
+      prefs_->GetDict(kPersonaFingerprintRotationEpochPref).Clone();
+  rotation_epoch.Set("global", MakeIsoTimestamp());
+  rotation_epoch.Set(
+      "globalGeneration",
+      base::NumberToString(NextGeneration(
+          ReadGeneration(rotation_epoch.Find("globalGeneration")))));
+  rotation_epoch.Set("identityTemplateId", static_cast<int>(next_id));
+  prefs_->SetDict(kPersonaFingerprintRotationEpochPref,
+                  std::move(rotation_epoch));
+  return MakeResponse(true, ReadState());
+}
+
+bool PersonaService::CanRotateIdentity() const {
+  return GetRotatablePersonaIdentityTemplateIds().size() > 1u;
+}
+
+uint32_t PersonaService::GetActiveIdentityTemplateId() const {
+  if (!prefs_) {
+    return 0;
+  }
+  const std::optional<int> id =
+      prefs_->GetDict(kPersonaFingerprintRotationEpochPref)
+          .FindInt("identityTemplateId");
+  return id && *id > 0 ? static_cast<uint32_t>(*id) : 0;
+}
