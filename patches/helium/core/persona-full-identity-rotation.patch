+void PersonaHandler::HandleRotatePersonaIdentity(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1U, args.size());
+  CHECK(args[0].is_string());
+  std::string callback_id = args[0].GetString();
+
+  helium_persona::PersonaService* persona_service =
+      GetPersonaService(profile_);
+  CHECK(persona_service);
+  base::DictValue response = persona_service->RotateIdentity();
+  if (!response.FindBool("ok").value_or(false)) {
+    ResolveJavascriptCallback(base::Value(callback_id), response);
+    return;
+  }
+
+  ProfileNetworkContextService* network_service =
+      ProfileNetworkContextServiceFactory::GetForContext(profile_);
+  CHECK(network_service);
+  network_service->ApplyNetworkPersonaConfig(base::BindOnce(
+      &PersonaHandler::OnRotatePersonaIdentityNetworkApplied,
+      weak_ptr_factory_.GetWeakPtr(), std::move(callback_id),
+      std::move(response)));
+}
+
+void PersonaHandler::OnRotatePersonaIdentityNetworkApplied(
+    std::string callback_id,
+    base::DictValue response,
+    bool accepted) {
+  if (!accepted) {
+    response.Set("ok", false);
+    response.EnsureDict("fieldErrors")
+        ->Set("identityRotation", "networkUpdateFailed");
+    ResolveJavascriptCallback(base::Value(callback_id), response);
+    return;
+  }
+
+  ResolveJavascriptCallback(base::Value(callback_id), response.Clone());
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](Profile* profile) {
+                       helium_persona::ReloadPersonaTabs(profile);
+                     },
+                     profile_.get()));
+}
+
