+constexpr base::TimeDelta kProxyConfigFlushTimeout = base::Seconds(15);
+
+class ProxyConfigFlushOperation
+    : public base::RefCounted<ProxyConfigFlushOperation> {
+ public:
+  ProxyConfigFlushOperation(size_t pending,
+                            base::OnceCallback<void(bool)> callback)
+      : pending_(pending), callback_(std::move(callback)) {}
+
+  void Start() {
+    timeout_.Start(
+        FROM_HERE, kProxyConfigFlushTimeout,
+        base::BindOnce(&ProxyConfigFlushOperation::OnTimeout,
+                       base::WrapRefCounted(this)));
+  }
+
+  void OnResult(bool accepted) {
+    if (!callback_) {
+      return;
+    }
+    accepted_ &= accepted;
+    CHECK_GT(pending_, 0u);
+    if (--pending_ == 0u) {
+      Finish(accepted_);
+    }
+  }
+
+  base::WeakPtr<ProxyConfigFlushOperation> GetWeakPtr() {
+    return weak_ptr_factory_.GetWeakPtr();
+  }
+
+ private:
+  friend class base::RefCounted<ProxyConfigFlushOperation>;
+  ~ProxyConfigFlushOperation() = default;
+
+  void OnTimeout() { Finish(false); }
+
+  void Finish(bool accepted) {
+    if (!callback_) {
+      return;
+    }
+    scoped_refptr<ProxyConfigFlushOperation> keep_alive(this);
+    weak_ptr_factory_.InvalidateWeakPtrs();
+    timeout_.Stop();
+    std::move(callback_).Run(accepted);
+  }
+
+  size_t pending_;
+  bool accepted_ = true;
+  base::OnceCallback<void(bool)> callback_;
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<ProxyConfigFlushOperation> weak_ptr_factory_{this};
+};
