+void LocalFrameMojoHandler::GetHeliumPersonaSurfaceProbe(
+    GetHeliumPersonaSurfaceProbeCallback callback) {
+  auto probe = mojom::blink::HeliumPersonaSurfaceProbe::New();
+  if (frame_->Client() && frame_->Client()->GetWebFrame() &&
+      frame_->Client()->GetWebFrame()->Client()) {
+    probe->snapshot = frame_->Client()
+                          ->GetWebFrame()
+                          ->Client()
+                          ->GetHeliumPersonaSnapshot();
+  }
+  if (Document* document = GetDocument()) {
+    probe->canvas_noise_token_present =
+        document->CanvasNoiseToken().has_value();
+    probe->audio_noise_token_present =
+        document->AudioNoiseToken().has_value();
+    probe->hardware_noise_token_present =
+        document->HardwareNoiseToken().has_value();
+    probe->font_metric_noise_token_present =
+        document->FontMetricNoiseToken().has_value();
+    probe->client_rect_noise_token_present =
+        document->ClientRectNoiseToken().has_value();
+  }
+  std::move(callback).Run(std::move(probe));
+}
