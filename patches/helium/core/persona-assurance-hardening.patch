+void NetworkContext::SetNetworkPersonaRequestsBlocked(
+    bool blocked,
+    SetNetworkPersonaRequestsBlockedCallback callback) {
+  network_persona_requests_blocked_ = blocked;
+  if (!blocked) {
+    std::move(callback).Run(true);
+    return;
+  }
+
+  // Aborting the last loader can delete its factory, so iterate a pointer
+  // snapshot instead of the owning set.
+  std::vector<PrefetchMatchingURLLoaderFactory*> factories;
+  factories.reserve(url_loader_factories_.size());
+  for (const auto& factory : url_loader_factories_) {
+    factories.push_back(factory.get());
+  }
+  for (PrefetchMatchingURLLoaderFactory* factory : factories) {
+    if (url_loader_factories_.find(factory) != url_loader_factories_.end()) {
+      factory->AbortAllRequestsForNetworkPersonaTransition();
+    }
+  }
+#if BUILDFLAG(ENABLE_WEBSOCKETS)
+  websocket_factory_.reset();
+#endif
+  web_transports_.clear();
+
+  if (url_request_context_ &&
+      url_request_context_->http_transaction_factory()) {
+    url_request_context_->http_transaction_factory()
+        ->GetSession()
+        ->CloseAllConnections(net::ERR_NETWORK_ACCESS_REVOKED,
+                              "Persona network identity transition");
+  }
+  std::move(callback).Run(true);
+}
