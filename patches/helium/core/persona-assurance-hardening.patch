+void CorsURLLoaderFactory::AbortAllRequestsForNetworkPersonaTransition() {
+  prevent_self_deletion_ = true;
+  std::vector<CorsURLLoader*> cors_loaders;
+  cors_loaders.reserve(cors_url_loaders_.size());
+  for (const auto& loader : cors_url_loaders_) {
+    cors_loaders.push_back(loader.get());
+  }
+  for (CorsURLLoader* loader : cors_loaders) {
+    if (cors_url_loaders_.find(loader) != cors_url_loaders_.end()) {
+      loader->CancelForNetworkPersonaTransition();
+    }
+  }
+
+  std::vector<URLLoader*> url_loaders;
+  url_loaders.reserve(url_loaders_.size());
+  for (const auto& loader : url_loaders_) {
+    url_loaders.push_back(loader.get());
+  }
+  for (URLLoader* loader : url_loaders) {
+    if (url_loaders_.find(loader) != url_loaders_.end()) {
+      loader->CancelForNetworkPersonaTransition();
+    }
+  }
+  prevent_self_deletion_ = false;
+  DeleteIfNeeded();
+  // `this` may be deleted here.
+}
