+class TestProxyConfigClient final
+    : public network::mojom::ProxyConfigClient {
+ public:
+  enum class FlushBehavior { kAutoAck, kDelayedAck, kDrop, kHang };
+
+  explicit TestProxyConfigClient(FlushBehavior behavior)
+      : behavior_(behavior) {}
+
+  void Bind(
+      mojo::PendingReceiver<network::mojom::ProxyConfigClient> receiver) {
+    receiver_.Bind(std::move(receiver));
+  }
+
+  void OnProxyConfigUpdated(
+      const net::ProxyConfigWithAnnotation& config) override {
+    updates_.push_back(config);
+  }
+
+  void FlushProxyConfig(FlushProxyConfigCallback callback) override {
+    switch (behavior_) {
+      case FlushBehavior::kAutoAck:
+        std::move(callback).Run();
+        return;
+      case FlushBehavior::kDelayedAck:
+        pending_flush_ = std::move(callback);
+        return;
+      case FlushBehavior::kDrop:
+        receiver_.reset();
+        return;
+      case FlushBehavior::kHang:
+        pending_flush_ = std::move(callback);
+        return;
+    }
+  }
+
+  void CompleteFlush() {
+    ASSERT_TRUE(pending_flush_);
+    std::move(pending_flush_).Run();
+  }
+
+  void set_behavior(FlushBehavior behavior) { behavior_ = behavior; }
+
+  size_t update_count() const { return updates_.size(); }
+
+  const net::ProxyConfigWithAnnotation& last_update() const {
+    CHECK(!updates_.empty());
+    return updates_.back();
+  }
+
+ private:
+  FlushBehavior behavior_;
+  std::vector<net::ProxyConfigWithAnnotation> updates_;
+  FlushProxyConfigCallback pending_flush_;
+  mojo::Receiver<network::mojom::ProxyConfigClient> receiver_{this};
+};
