+void PersonaService::GetPersonaAudit(OperationCallback callback) const {
+  base::DictValue audit = BuildPersonaAudit();
+  const PersonaResolution resolution = ResolveActivePersona();
+  if (resolution.status == PersonaResolutionStatus::kPersonaUnavailable ||
+      !profile_) {
+    SetEmptyRuntimeEvidence(&audit, "not_applicable");
+    std::move(callback).Run(std::move(audit));
+    return;
+  }
+
+  std::vector<content::GlobalRenderFrameHostId> frame_ids;
+  ProfileBrowserCollection* browser_collection =
+      ProfileBrowserCollection::GetForProfile(profile_);
+  if (browser_collection) {
+    browser_collection->ForEach(
+        [&frame_ids](BrowserWindowInterface* browser) {
+          TabStripModel* tab_strip = browser->GetTabStripModel();
+          if (!tab_strip) {
+            return true;
+          }
+          for (int i = 0; i < tab_strip->count(); ++i) {
+            content::WebContents* web_contents =
+                tab_strip->GetWebContentsAt(i);
+            if (!web_contents || !web_contents->GetPrimaryMainFrame()) {
+              continue;
+            }
+            web_contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+                [&frame_ids](content::RenderFrameHost* frame) {
+                  if (frame->IsRenderFrameLive() &&
+                      frame->GetLifecycleState() ==
+                          content::RenderFrameHost::LifecycleState::kActive &&
+                      !frame->GetWebUI()) {
+                    frame_ids.push_back(frame->GetGlobalId());
+                  }
+                });
+          }
+          return true;
+        });
+  }
+  if (frame_ids.empty()) {
+    SetEmptyRuntimeEvidence(&audit, "not_applicable");
+    std::move(callback).Run(std::move(audit));
+    return;
+  }
+  PersonaSurfaceProbeOperation::Run(resolution.snapshot, std::move(frame_ids),
+                                    std::move(audit), std::move(callback));
+}
