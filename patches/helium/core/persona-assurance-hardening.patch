+void SystemNetworkContextManager::
+    SetNetworkPersonaRequestsBlockedForProfile(
+        const base::FilePath& profile_path,
+        bool blocked,
+        base::OnceCallback<void(bool)> callback) {
+  if (blocked) {
+    network_persona_request_gate_profiles_.insert(profile_path);
+  } else {
+    network_persona_request_gate_profiles_.erase(profile_path);
+  }
+  network_persona_request_gate_callbacks_.push_back(
+      NetworkPersonaRequestGateUpdate{blocked, std::move(callback)});
+  UpdateNetworkPersonaRequestGate();
+}
+
+void SystemNetworkContextManager::UpdateNetworkPersonaRequestGate() {
+  if (network_persona_request_gate_update_in_flight_) {
+    return;
+  }
+
+  const bool requested_blocked =
+      !network_persona_request_gate_profiles_.empty();
+  if (network_persona_request_gate_applied_ == requested_blocked) {
+    CompleteNetworkPersonaRequestGateUpdates(true);
+    return;
+  }
+
+  network_persona_request_gate_update_in_flight_ = true;
+  GetContext()->SetNetworkPersonaRequestsBlocked(
+      requested_blocked,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              &SystemNetworkContextManager::OnNetworkPersonaRequestGateUpdated,
+              weak_factory_.GetWeakPtr(), requested_blocked),
+          false));
+}
+
+void SystemNetworkContextManager::OnNetworkPersonaRequestGateUpdated(
+    bool requested_blocked,
+    bool accepted) {
+  network_persona_request_gate_update_in_flight_ = false;
+  if (!accepted) {
+    network_persona_request_gate_applied_.reset();
+    CompleteNetworkPersonaRequestGateUpdates(false);
+    return;
+  }
+
+  network_persona_request_gate_applied_ = requested_blocked;
+  UpdateNetworkPersonaRequestGate();
+}
+
+void SystemNetworkContextManager::CompleteNetworkPersonaRequestGateUpdates(
+    bool accepted) {
+  std::vector<NetworkPersonaRequestGateUpdate> callbacks;
+  callbacks.swap(network_persona_request_gate_callbacks_);
+  for (auto& update : callbacks) {
+    // A callback is only successful when the aggregate gate reached the state
+    // that this request asked for. A later profile release must not satisfy an
+    // earlier block request merely because both updates shared one ACK.
+    const bool reached_requested_state =
+        network_persona_request_gate_applied_.has_value() &&
+        update.desired_blocked == *network_persona_request_gate_applied_;
+    std::move(update.callback).Run(accepted && reached_requested_state);
+  }
+}
