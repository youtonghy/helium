+constexpr base::TimeDelta kNetworkPersonaUpdateTimeout = base::Seconds(15);
+
+class TimedBooleanBarrier : public base::RefCounted<TimedBooleanBarrier> {
+ public:
+  static base::RepeatingCallback<void(bool)> Create(
+      size_t pending,
+      base::OnceCallback<void(bool)> callback) {
+    CHECK_GT(pending, 0u);
+    auto operation = base::MakeRefCounted<TimedBooleanBarrier>(
+        pending, std::move(callback));
+    operation->Start();
+    return base::BindRepeating(&TimedBooleanBarrier::OnResult,
+                               operation->weak_ptr_factory_.GetWeakPtr());
+  }
+
+  TimedBooleanBarrier(size_t pending, base::OnceCallback<void(bool)> callback)
+      : pending_(pending), callback_(std::move(callback)) {}
+
+ private:
+  friend class base::RefCounted<TimedBooleanBarrier>;
+  ~TimedBooleanBarrier() = default;
+
+  void Start() {
+    timeout_.Start(FROM_HERE, kNetworkPersonaUpdateTimeout,
+                   base::BindOnce(&TimedBooleanBarrier::Finish,
+                                  base::WrapRefCounted(this), false));
+  }
+
+  void OnResult(bool accepted) {
+    if (!callback_) {
+      return;
+    }
+    accepted_ &= accepted;
+    CHECK_GT(pending_, 0u);
+    if (--pending_ == 0u) {
+      Finish(accepted_);
+    }
+  }
+
+  void Finish(bool accepted) {
+    if (!callback_) {
+      return;
+    }
+    scoped_refptr<TimedBooleanBarrier> keep_alive(this);
+    weak_ptr_factory_.InvalidateWeakPtrs();
+    timeout_.Stop();
+    std::move(callback_).Run(accepted);
+  }
+
+  size_t pending_;
+  bool accepted_ = true;
+  base::OnceCallback<void(bool)> callback_;
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<TimedBooleanBarrier> weak_ptr_factory_{this};
+};
