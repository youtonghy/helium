+
+class PersonaSurfaceProbeOperation
+    : public base::RefCounted<PersonaSurfaceProbeOperation> {
+ public:
+  static void Run(
+      blink::HeliumPersonaSnapshot expected_snapshot,
+      std::vector<content::GlobalRenderFrameHostId> frame_ids,
+      base::DictValue audit,
+      base::OnceCallback<void(base::DictValue)> callback) {
+    auto operation = base::MakeRefCounted<PersonaSurfaceProbeOperation>(
+        std::move(expected_snapshot), frame_ids.size(), std::move(audit),
+        std::move(callback));
+    operation->Start(std::move(frame_ids));
+  }
+
+  PersonaSurfaceProbeOperation(
+      blink::HeliumPersonaSnapshot expected_snapshot,
+      size_t frame_count,
+      base::DictValue audit,
+      base::OnceCallback<void(base::DictValue)> callback)
+      : expected_snapshot_(std::move(expected_snapshot)),
+        expected_tokens_(ExpectedNoiseTokens(expected_snapshot_)),
+        total_(frame_count),
+        pending_(frame_count),
+        audit_(std::move(audit)),
+        callback_(std::move(callback)) {}
+
+  void Start(std::vector<content::GlobalRenderFrameHostId> frame_ids) {
+    timeout_.Start(FROM_HERE, kPersonaSurfaceProbeTimeout,
+                   base::BindOnce(&PersonaSurfaceProbeOperation::OnTimeout,
+                                  base::WrapRefCounted(this)));
+    for (const content::GlobalRenderFrameHostId& frame_id : frame_ids) {
+      content::RenderFrameHost* frame =
+          content::RenderFrameHost::FromID(frame_id);
+      if (!frame || !frame->IsRenderFrameLive() ||
+          frame->GetLifecycleState() !=
+              content::RenderFrameHost::LifecycleState::kActive) {
+        OnProbe(nullptr);
+        continue;
+      }
+      frame->GetHeliumPersonaSurfaceProbe(base::BindOnce(
+          &PersonaSurfaceProbeOperation::OnProbe,
+          weak_ptr_factory_.GetWeakPtr()));
+    }
+  }
+
+  void OnProbe(blink::mojom::HeliumPersonaSurfaceProbePtr probe) {
+    if (!callback_) {
+      return;
+    }
+    CHECK_GT(pending_, 0u);
+    --pending_;
+    if (!probe) {
+      ++unreachable_;
+    } else {
+      bool matches = probe->snapshot == expected_snapshot_;
+      const std::array<bool, 5> applied_tokens = AppliedNoiseTokens(*probe);
+      for (size_t i = 0; i < expected_tokens_.size(); ++i) {
+        if (expected_tokens_[i] != applied_tokens[i]) {
+          ++token_mismatches_[i];
+          matches = false;
+        }
+      }
+      if (matches) {
+        ++matched_;
+      } else {
+        ++mismatched_;
+      }
+    }
+    if (pending_ == 0u) {
+      Finish();
+    }
+  }
+
+ private:
+  friend class base::RefCounted<PersonaSurfaceProbeOperation>;
+  ~PersonaSurfaceProbeOperation() = default;
+
+  void OnTimeout() {
+    unreachable_ += pending_;
+    pending_ = 0u;
+    Finish();
+  }
+
+  void Finish() {
+    if (!callback_) {
+      return;
+    }
+    scoped_refptr<PersonaSurfaceProbeOperation> keep_alive(this);
+    weak_ptr_factory_.InvalidateWeakPtrs();
+    timeout_.Stop();
+
+    const char* renderer_status =
+        mismatched_ > 0u      ? "mismatched"
+        : unreachable_ > 0u  ? (matched_ > 0u ? "partially_verified"
+                                               : "unreachable")
+                              : "runtime_snapshot_verified";
+    base::DictValue tokens;
+    for (size_t i = 0; i < kNoiseTokenNames.size(); ++i) {
+      const char* token_status = token_mismatches_[i] > 0u
+                                     ? "mismatched"
+                                 : unreachable_ > 0u ? "partially_verified"
+                                                     : "matched";
+      tokens.Set(kNoiseTokenNames[i],
+                 base::DictValue()
+                     .Set("expected", expected_tokens_[i])
+                     .Set("status", token_status)
+                     .Set("mismatched", token_mismatches_[i]));
+    }
+    audit_.EnsureDict("surfaces")->Set("renderer", renderer_status);
+    audit_.Set(
+        "runtimeEvidence",
+        base::DictValue()
+            .Set("scope", "active_primary_frame_tree")
+            .Set("frames", base::DictValue()
+                               .Set("status", renderer_status)
+                               .Set("total", static_cast<int>(total_))
+                               .Set("matched", static_cast<int>(matched_))
+                               .Set("mismatched",
+                                    static_cast<int>(mismatched_))
+                               .Set("unreachable",
+                                    static_cast<int>(unreachable_)))
+            .Set("noiseTokens", std::move(tokens)));
+    if (mismatched_ > 0u || unreachable_ > 0u) {
+      audit_.Set("ok", false);
+    } else if (base::DictValue* assurance = audit_.FindDict("assurance")) {
+      assurance->EnsureList("reasons")
+          ->Append("renderer_runtime_snapshot_verified");
+    }
+    std::move(callback_).Run(std::move(audit_));
+  }
+
+  const blink::HeliumPersonaSnapshot expected_snapshot_;
+  const std::array<bool, 5> expected_tokens_;
+  const size_t total_;
+  size_t pending_;
+  size_t matched_ = 0u;
+  size_t mismatched_ = 0u;
+  size_t unreachable_ = 0u;
+  std::array<int, 5> token_mismatches_ = {};
+  base::DictValue audit_;
+  base::OnceCallback<void(base::DictValue)> callback_;
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<PersonaSurfaceProbeOperation> weak_ptr_factory_{this};
+};
