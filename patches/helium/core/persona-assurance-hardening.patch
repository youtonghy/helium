+void ProfileNetworkContextService::ReleaseNetworkPersonaRequestGate(
+    NetworkPersonaUpdateCallback callback) {
+  SetNetworkPersonaRequestsBlocked(false, std::move(callback));
+}
+
+void ProfileNetworkContextService::SetNetworkPersonaRequestsBlocked(
+    bool blocked,
+    NetworkPersonaUpdateCallback callback) {
+  if (is_shutting_down_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (blocked) {
+    network_persona_requests_blocked_ = true;
+    FanOutNetworkPersonaRequestGate(true, std::move(callback));
+    return;
+  }
+
+  // Keep new partitions blocked until every partition in the first release
+  // snapshot has acknowledged. A second pass catches partitions created while
+  // that snapshot was in flight.
+  FanOutNetworkPersonaRequestGate(
+      false,
+      base::BindOnce(
+          &ProfileNetworkContextService::
+              OnNetworkPersonaRequestGateReleaseFirstPass,
+          weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void ProfileNetworkContextService::FanOutNetworkPersonaRequestGate(
+    bool blocked,
+    NetworkPersonaUpdateCallback callback) {
+  if (is_shutting_down_ || !profile_ || !g_browser_process) {
+    std::move(callback).Run(false);
+    return;
+  }
+  std::vector<content::StoragePartition*> partitions;
+  profile_->ForEachLoadedStoragePartition(
+      [&](content::StoragePartition* storage_partition) {
+        partitions.push_back(storage_partition);
+      });
+
+  auto barrier =
+      TimedBooleanBarrier::Create(partitions.size() + 1, std::move(callback));
+
+  g_browser_process->system_network_context_manager()
+      ->SetNetworkPersonaRequestsBlockedForProfile(
+          profile_->GetPath(), blocked, base::BindOnce(barrier));
+  for (content::StoragePartition* partition : partitions) {
+    partition->GetNetworkContext()->SetNetworkPersonaRequestsBlocked(
+        blocked,
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(base::BindOnce(barrier),
+                                                    false));
+  }
+}
+
+void ProfileNetworkContextService::
+    OnNetworkPersonaRequestGateReleaseFirstPass(
+        NetworkPersonaUpdateCallback callback,
+        bool accepted) {
+  if (is_shutting_down_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (!accepted) {
+    RestoreNetworkPersonaRequestGateAfterFailedRelease(std::move(callback));
+    return;
+  }
+  network_persona_requests_blocked_ = false;
+  FanOutNetworkPersonaRequestGate(
+      false,
+      base::BindOnce(
+          &ProfileNetworkContextService::
+              OnNetworkPersonaRequestGateReleaseConverged,
+          weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void ProfileNetworkContextService::
+    OnNetworkPersonaRequestGateReleaseConverged(
+        NetworkPersonaUpdateCallback callback,
+        bool accepted) {
+  if (is_shutting_down_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (!accepted) {
+    RestoreNetworkPersonaRequestGateAfterFailedRelease(std::move(callback));
+    return;
+  }
+  std::move(callback).Run(true);
+}
+
+void ProfileNetworkContextService::
+    RestoreNetworkPersonaRequestGateAfterFailedRelease(
+        NetworkPersonaUpdateCallback callback) {
+  if (is_shutting_down_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  network_persona_requests_blocked_ = true;
+  FanOutNetworkPersonaRequestGate(
+      true,
+      base::BindOnce(
+          [](NetworkPersonaUpdateCallback callback, bool) {
+            std::move(callback).Run(false);
+          },
+          std::move(callback)));
+}
