+std::optional<uint64_t> GetHardwareNoiseHash(ExecutionContext* context,
+                                             uint64_t field) {
+  if (!context || !context->HardwareNoiseToken()) {
+    return std::nullopt;
+  }
+  return NoiseHash(*context->HardwareNoiseToken()) ^
+         (field * 0x9e3779b97f4a7c15ULL);
+}
+
+GLfloat ApplyHardwareFloatNoise(GLfloat value, uint64_t hash) {
+  if (value <= 0.0f) {
+    return value;
+  }
+  const GLfloat direction = (hash & 1) ? 1.0f : -1.0f;
+  const GLfloat magnitude = 1.0f + static_cast<GLfloat>((hash >> 1) % 5);
+  return std::max<GLfloat>(0.0f, value + direction * magnitude * 0.01f);
+}
+
+GLint ApplyHardwareIntNoise(GLint value, uint64_t hash) {
+  if (value <= 0) {
+    return value;
+  }
+  const GLint delta = (hash & 1) ? 1 : -1;
+  return std::max<GLint>(1, value + delta);
+}
