+bool HeliumPersonaAllowsPermissionType(BrowserContext* browser_context,
+                                       PermissionType permission_type) {
+  if (!browser_context) {
+    return true;
+  }
+  const blink::HeliumPersonaSnapshot persona_snapshot =
+      GetContentClient()->browser()->GetHeliumPersonaSnapshot(browser_context);
+  if (!persona_snapshot.IsEnabled()) {
+    return true;
+  }
+  switch (permission_type) {
+    case PermissionType::GEOLOCATION:
+    case PermissionType::GEOLOCATION_APPROXIMATE:
+      return persona_snapshot.allow_geolocation;
+    case PermissionType::NOTIFICATIONS:
+      return persona_snapshot.allow_notifications;
+    case PermissionType::MIDI:
+    case PermissionType::MIDI_SYSEX:
+      return persona_snapshot.allow_midi;
+    case PermissionType::CLIPBOARD_READ_WRITE:
+    case PermissionType::CLIPBOARD_SANITIZED_WRITE:
+      return persona_snapshot.allow_clipboard;
+    case PermissionType::IDLE_DETECTION:
+      return persona_snapshot.allow_idle_detection;
+    case PermissionType::WINDOW_MANAGEMENT:
+      return persona_snapshot.allow_window_management;
+    case PermissionType::SENSORS:
+      return persona_snapshot.allow_sensor_apis;
+    case PermissionType::NFC:
+      return persona_snapshot.allow_web_nfc;
+    case PermissionType::PAYMENT_HANDLER:
+      return persona_snapshot.allow_payment_handler;
+    default:
+      return true;
+  }
+}
