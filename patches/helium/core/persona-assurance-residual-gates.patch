+void NetworkContext::CancelURLRequestsForNetworkPersonaTransition() {
+  if (!url_request_context_) {
+    return;
+  }
+
+  base::WeakPtr<NetworkContext> weak_this = weak_factory_.GetWeakPtr();
+  while (true) {
+    net::URLRequest* pending_request = nullptr;
+    for (const net::URLRequest* request :
+         *url_request_context_->url_requests()) {
+      if (request->is_pending()) {
+        pending_request = const_cast<net::URLRequest*>(request);
+        break;
+      }
+    }
+    if (!pending_request) {
+      return;
+    }
+
+    pending_request->CancelWithError(net::ERR_NETWORK_ACCESS_REVOKED);
+    if (!weak_this) {
+      return;
+    }
+  }
+}
