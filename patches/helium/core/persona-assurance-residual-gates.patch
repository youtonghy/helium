+  RemoveAllClients();
+  document_endpoints_.clear();
+  isolation_info_.clear();
+  expired_sources_.clear();
+
+  for (const url::Origin& origin : document_origins) {
+    context_->NotifyEndpointsUpdatedForOrigin(
+        FilterEndpointsByOrigin(document_endpoints_, origin));
+  }
+}
