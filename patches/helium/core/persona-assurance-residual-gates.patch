+void ConfiguredProxyResolutionService::SetNetworkRequestsBlocked(bool blocked) {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  if (network_requests_blocked_ == blocked) {
+    return;
+  }
+  network_requests_blocked_ = blocked;
+  if (!blocked) {
+    // Resume lazily from the next ResolveProxy(). Applying synchronously here
+    // could start PAC/WPAD traffic in the Persona gate release call stack.
+    return;
+  }
+
+  preserve_pac_retry_state_for_next_reset_ = false;
+  ResetProxyConfig(false);
+  base::WeakPtr<ConfiguredProxyResolutionService> weak_this =
+      weak_ptr_factory_.GetWeakPtr();
+  while (!pending_requests_.empty()) {
+    ConfiguredProxyResolutionRequest* request = *pending_requests_.begin();
+    request->QueryComplete(ERR_NETWORK_ACCESS_REVOKED);
+    if (!weak_this || !network_requests_blocked_) {
+      return;
+    }
+  }
+}
