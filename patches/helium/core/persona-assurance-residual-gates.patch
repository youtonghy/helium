+void P2PSocketManager::SetNetworkRequestsBlocked(bool blocked) {
+  if (network_requests_blocked_ == blocked) {
+    return;
+  }
+  network_requests_blocked_ = blocked;
+
+  if (!blocked) {
+    if (network_notification_client_ && !observing_network_changes_) {
+      net::NetworkChangeNotifier::AddNetworkChangeObserver(this);
+      observing_network_changes_ = true;
+      OnNetworkChanged(net::NetworkChangeNotifier::CONNECTION_NONE);
+    }
+    return;
+  }
+
+  // Complete renderer DNS callbacks before invalidating manager callbacks.
+  // Moving the set prevents OnAddressResolved() from mutating our iteration.
+  decltype(dns_requests_) dns_requests;
+  dns_requests.swap(dns_requests_);
+  base::WeakPtr<P2PSocketManager> weak_this = weak_factory_.GetWeakPtr();
+  for (const auto& request : dns_requests) {
+    request->CancelForNetworkPersonaTransition();
+    if (!weak_this || !network_requests_blocked_) {
+      return;
+    }
+  }
+
+  weak_factory_.InvalidateWeakPtrs();
+  sockets_.clear();
+  default_local_address_requests_.clear();
+  proxy_resolving_socket_factory_.reset();
+  pending_network_change_notification_ = false;
+  if (observing_network_changes_) {
+    net::NetworkChangeNotifier::RemoveNetworkChangeObserver(this);
+    observing_network_changes_ = false;
+  }
+}
