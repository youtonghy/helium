+void PrefetchCache::Clear() {
+  weak_factory_.InvalidateWeakPtrs();
+  expiry_timer_.Stop();
+  while (!delayed_erase_queue_.empty()) {
+    delayed_erase_queue_.pop();
+  }
+  while (!list_.empty()) {
+    Erase(list_.head()->value());
+  }
+}
