+network::mojom::NetworkPersonaConfigPtr
+ProfileNetworkContextService::CreateNetworkPersonaConfig() const {
+  const base::DictValue& state =
+      profile_->GetPrefs()->GetDict(helium_persona::prefs::kState);
+  const std::string* active_id = state.FindString("activePersonaId");
+  const base::ListValue* personas = state.FindList("personas");
+  const base::DictValue* active_persona = nullptr;
+  if (active_id && personas) {
+    for (const base::Value& value : *personas) {
+      if (!value.is_dict()) {
+        continue;
+      }
+      const std::string* id = value.GetDict().FindString("id");
+      if (id && *id == *active_id) {
+        active_persona = &value.GetDict();
+        break;
+      }
+    }
+  }
+  if (!active_persona ||
+      !active_persona->FindBool("enabled").value_or(false)) {
+    return nullptr;
+  }
+  const std::string& salt = profile_->GetPrefs()->GetString(
+      helium_persona::prefs::kFingerprintProfileSalt);
+  if (salt.empty()) {
+    return nullptr;
+  }
+  const base::DictValue& rotation = profile_->GetPrefs()->GetDict(
+      helium_persona::prefs::kFingerprintRotationEpoch);
+  auto config = network::mojom::NetworkPersonaConfig::New();
+  if (const std::string* generation =
+          rotation.FindString("globalGeneration")) {
+    base::StringToUint64(*generation, &config->generation);
+  }
+  config->template_id = 0;
+  const auto seed = crypto::hash::Sha256(salt + "\n" + *active_id);
+  config->deterministic_seed.assign(seed.begin(), seed.end());
+  return config;
+}
+
+void ProfileNetworkContextService::UpdateNetworkPersona() {
+  profile_->ForEachLoadedStoragePartition(
+      [&](content::StoragePartition* storage_partition) {
+        storage_partition->GetNetworkContext()->UpdateNetworkPersona(
+            CreateNetworkPersonaConfig(), base::DoNothing());
+      });
+}
