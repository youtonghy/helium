+  snapshot.font_families = {"Arial"};
+  snapshot.font_aliases = {" sans-serif = Arial ", "broken"};
+
+  EXPECT_TRUE(PersonaFontPolicy::IsFamilyAllowed(snapshot, "Arial"));
+  EXPECT_FALSE(
+      PersonaFontPolicy::IsFamilyAllowed(snapshot, "sans-serif=Arial"));
+  EXPECT_EQ(PersonaFontPolicy::ResolveAlias(snapshot, "SANS-SERIF"),
+            std::optional<String>("Arial"));
+  EXPECT_FALSE(PersonaFontPolicy::ResolveAlias(snapshot, "serif"));
+}
