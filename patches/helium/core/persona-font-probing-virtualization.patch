+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_HELIUM_PERSONA_PERSONA_FONT_POLICY_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_HELIUM_PERSONA_PERSONA_FONT_POLICY_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/strings/string_util.h"
+#include "third_party/blink/public/common/helium_persona/persona_snapshot.h"
+
+namespace blink {
+
+inline std::optional<std::pair<std::string, std::string>>
+ParsePersonaFontAlias(std::string_view value) {
+  const size_t separator = value.find('=');
+  if (separator == std::string_view::npos) {
+    return std::nullopt;
+  }
+  std::string alias(value.substr(0, separator));
+  std::string family(value.substr(separator + 1));
+  base::TrimWhitespaceASCII(alias, base::TRIM_ALL, &alias);
+  base::TrimWhitespaceASCII(family, base::TRIM_ALL, &family);
+  if (alias.empty() || family.empty()) {
+    return std::nullopt;
+  }
+  return std::make_pair(std::move(alias), std::move(family));
+}
+
+inline bool PersonaFontFamilyAllowed(const HeliumPersonaSnapshot& snapshot,
+                                     std::string_view family_name) {
+  if (!snapshot.IsEnabled() || family_name.empty()) {
+    return false;
+  }
+  for (const std::string& family : snapshot.font_families) {
+    if (base::EqualsCaseInsensitiveASCII(family, family_name)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+inline std::optional<std::string> ResolvePersonaFontAlias(
+    const HeliumPersonaSnapshot& snapshot,
+    std::string_view alias_name) {
+  if (!snapshot.IsEnabled() || alias_name.empty()) {
+    return std::nullopt;
+  }
+  for (const std::string& alias : snapshot.font_aliases) {
+    const auto parsed = ParsePersonaFontAlias(alias);
+    if (parsed &&
+        base::EqualsCaseInsensitiveASCII(parsed->first, alias_name) &&
+        PersonaFontFamilyAllowed(snapshot, parsed->second)) {
+      return parsed->second;
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace blink
+
