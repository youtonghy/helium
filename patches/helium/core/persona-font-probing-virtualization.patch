+TEST(PersonaFontPolicyTest, AllowsConfiguredFamiliesCaseInsensitively) {
+  HeliumPersonaSnapshot snapshot;
+  snapshot.enabled = true;
+  snapshot.font_families = {"Arial", "Helvetica Neue"};
+
+  EXPECT_TRUE(PersonaFontPolicy::IsFamilyAllowed(snapshot, "arial"));
+  EXPECT_TRUE(
+      PersonaFontPolicy::IsFamilyAllowed(snapshot, "HELVETICA NEUE"));
+  EXPECT_FALSE(PersonaFontPolicy::IsFamilyAllowed(snapshot, "Menlo"));
+}
+
+TEST(PersonaFontPolicyTest, ParsesAliasWithoutExposingRawAliasString) {
+  HeliumPersonaSnapshot snapshot;
