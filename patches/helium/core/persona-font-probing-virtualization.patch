+    std::string target = value.substr(separator + 1);
+    base::TrimWhitespaceASCII(alias, base::TRIM_ALL, &alias);
+    base::TrimWhitespaceASCII(target, base::TRIM_ALL, &target);
+    bool target_is_configured = false;
+    for (const base::Value& family : *families) {
+      if (family.is_string() && base::EqualsCaseInsensitiveASCII(
+                                    family.GetString(), target)) {
+        target_is_configured = true;
