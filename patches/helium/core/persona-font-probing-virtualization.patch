+#include "third_party/blink/renderer/platform/fonts/font_description.h"
+
+namespace blink {
+
+const HeliumPersonaSnapshot* PersonaFontPolicy::Snapshot(
+    const ExecutionContext* context) {
+  if (const auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    if (!window->GetFrame() || !window->GetFrame()->Client() ||
+        !window->GetFrame()->Client()->GetWebFrame() ||
+        !window->GetFrame()->Client()->GetWebFrame()->Client()) {
+      return nullptr;
+    }
+    const HeliumPersonaSnapshot& snapshot =
+        window->GetFrame()->Client()->GetWebFrame()->Client()
+            ->GetHeliumPersonaSnapshot();
+    return snapshot.IsEnabled() ? &snapshot : nullptr;
+  }
+  if (const auto* worker = DynamicTo<WorkerGlobalScope>(context)) {
+    const HeliumPersonaSnapshot& snapshot = worker->GetHeliumPersonaSnapshot();
+    return snapshot.IsEnabled() ? &snapshot : nullptr;
+  }
+  return nullptr;
+}
+
+bool PersonaFontPolicy::IsActive(const ExecutionContext* context) {
+  return Snapshot(context) != nullptr;
+}
+
+bool PersonaFontPolicy::IsFamilyAllowed(const ExecutionContext* context,
+                                        const String& family) {
+  const HeliumPersonaSnapshot* snapshot = Snapshot(context);
+  return snapshot && IsFamilyAllowed(*snapshot, family);
+}
+
+bool PersonaFontPolicy::IsFamilyAllowed(
+    const HeliumPersonaSnapshot& snapshot,
+    const String& family) {
+  return PersonaFontFamilyAllowed(snapshot, family.Utf8());
+}
+
+std::optional<String> PersonaFontPolicy::ResolveAlias(
+    const ExecutionContext* context,
+    const String& alias) {
+  const HeliumPersonaSnapshot* snapshot = Snapshot(context);
+  return snapshot ? ResolveAlias(*snapshot, alias) : std::nullopt;
+}
+
+std::optional<String> PersonaFontPolicy::ResolveAlias(
+    const HeliumPersonaSnapshot& snapshot,
+    const String& alias) {
+  const std::optional<std::string> family =
+      ResolvePersonaFontAlias(snapshot, alias.Utf8());
+  return family ? std::optional<String>(String::FromUtf8(*family))
+                : std::nullopt;
+}
+
+std::optional<String> PersonaFontPolicy::FirstAvailableFamily(
+    const ExecutionContext* context,
+    const FontDescription& description) {
+  const HeliumPersonaSnapshot* snapshot = Snapshot(context);
+  if (!snapshot) {
+    return std::nullopt;
+  }
+  for (const std::string& family : snapshot->font_families) {
+    const AtomicString candidate = AtomicString::FromUtf8(family);
+    if (!candidate.empty() &&
+        FontCache::Get().IsPlatformFamilyMatchAvailable(description,
+                                                        candidate)) {
+      return candidate.GetString();
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace blink
